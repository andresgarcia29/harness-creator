#!/usr/bin/env bash
# ship.sh — ÚNICA puerta de salida a main. Los agentes piden shippear;
# este script decide. Determinista, cero tokens en el camino verde.
#
# Uso: ship.sh <task-id> <repo>
#      ship.sh --precheck <task-id> <repo>
#
# --precheck corre los MISMOS gates mecánicos (lenguaje, seguridad, tests no
# debilitados) sobre el worktree, SIN veredicto, sin lock y sin push. Existe
# por una razón de velocidad medida: un review que se cae por un test roto o
# un lint quema una ronda completa de reviewer (10-20 min de reloj) para
# decir lo que un script dice en segundos y gratis. El implementer lo corre
# antes de entregar; /review no lanza a nadie si el precheck no está verde.
# Deja el sello en tasks/<task>/precheck-<repo>.json (commit + ok).
#
# Opera sobre el WORKTREE de la tarea (worktrees/<task>/<repo>), nunca
# sobre el clon canónico. Serie solo lo que tiene orden real:
# rebase → trailer → carril. Después, los gates independientes corren EN
# PARALELO (lenguaje+buf ∥ gitleaks+semgrep ∥ tests-no-debilitados ∥
# veredicto+evidencia+policy) y se reportan TODOS los rojos juntos — un
# solo prompt de fix con todo, en vez de descubrirlos ronda por ronda.
# Al final, en serie otra vez: lock → push.
#
# Portabilidad: bash 3.2 (macOS), BSD grep. Sin flock (lock por mkdir).
set -euo pipefail

PRECHECK=0
if [ "${1:-}" = "--precheck" ]; then PRECHECK=1; shift; fi
TASK="${1:?uso: ship.sh [--precheck] <task-id> <repo>}"
REPO="${2:?uso: ship.sh [--precheck] <task-id> <repo>}"
WS="$(cd "$(dirname "$0")/.." && pwd)"
WT="$WS/worktrees/$TASK/$REPO"
BASE="$WS/repos/$REPO"
MAX_RETRY={{LOOP_BUDGET}}
# El flujo a main que el humano eligió en la entrevista. Este script SOLO
# implementa trunk direct-to-prod: hace `git push origin HEAD:main`. Las
# otras dos respuestas (trunk-staging, prs) se ofrecían, se registraban en
# harness-answers.yaml, y NADIE las leía, así que quien eligió "prs" por
# política de su empresa recibía commits directos a main, en silencio.
#
# Se falla CERRADO y no se finge: implementar PRs o staging cambia también
# lo que significa "shippeado" para deploy-watch y para /archive, y hacerlo
# a medias produciría un archive que fusiona specs de un cambio que sigue
# sin mergear. Mientras tanto, el que configuró otra cosa se entera acá y
# no en producción.
FLOW="{{FLOW}}"
# La grafía varía (la entrevista ofrecía "trunk direct-to-prod" y el answers
# documenta "trunk-direct-to-prod"), así que se normaliza en vez de exigir una
# forma exacta. Un placeholder sin sustituir o vacío se trata como trunk: es
# lo que este script hace y lo que hacen todas las instancias de hoy, y un
# placeholder crudo es un problema de generación que le toca al doctor, no un
# motivo para frenar un ship.
flow_norm="$(printf '%s' "$FLOW" | tr 'A-Z' 'a-z' | tr -d ' +_-')"
case "$flow_norm" in
  trunk|trunkdirecttoprod|""|'{{flow}}') : ;;
  *)
    echo "❌ harness-answers.yaml declara flow: $FLOW, y ship.sh solo implementa"
    echo "   trunk direct-to-prod (push a main tras los gates)."
    echo "   NO voy a pushear a main a espaldas de una política que dice otra cosa."
    echo "   ↳ opciones: cambiá flow a 'trunk' si eso es lo que querés de verdad,"
    echo "     o abrí el PR a mano desde la rama task/<id> tras un --precheck verde."
    exit 7 ;;
esac
LOCKDIR="$WS/locks/$REPO.lock.d"
mkdir -p "$WS/locks" "$WS/tasks/$TASK"

[ -d "$WT" ] || { echo "❌ no existe el worktree $WT"; echo "   ↳ remediación: scripts/worktree-task.sh $TASK $REPO"; exit 2; }
[ -d "$BASE/.git" ] || { echo "❌ no existe el clon base $BASE"; exit 2; }

# El bus: lo que este gate decide se cuenta. Fail-open — si emit.sh no está,
# ship.sh funciona igual (el bus es observación, no control).
# shellcheck source=/dev/null
[ -f "$WS/scripts/emit.sh" ] && . "$WS/scripts/emit.sh" || emit() { :; }

# Instrumentación en UN solo punto: si estamos empezando un gate, el anterior
# pasó. El trap sabe cuál falló. Cero riesgo de olvidarse de instrumentar uno.
gate() {
  [ -n "${CURRENT_GATE:-}" ] && [ "$CURRENT_GATE" != "preflight" ] \
    && emit gate "$CURRENT_GATE" true
  echo "── gate: $1 ──"; CURRENT_GATE="$1"
}

# El error de un gate es un PROMPT: al fallar cualquier gate, el trap
# imprime la instrucción de autocorrección (el agente que lee esto
# arregla en una iteración, sin adivinar). También libera el lock.
CURRENT_GATE="preflight"; LOCK_HELD=""
stamp_precheck() {  # stamp_precheck <ok:true|false>: sello que /review lee
  local ok="$1" head
  head="$(git -C "$WT" rev-parse HEAD 2>/dev/null || echo unknown)"
  printf '{"schema":1,"task_id":"%s","repo":"%s","commit":"%s","ok":%s,"at":"%s"}\n' \
    "$TASK" "$REPO" "$head" "$ok" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    > "$WS/tasks/$TASK/precheck-$REPO.json"
}
on_exit() {
  local rc=$?
  [ -n "$LOCK_HELD" ] && rm -rf "$LOCKDIR"
  if [ "$rc" -eq 0 ]; then
    [ -n "${CURRENT_GATE:-}" ] && emit gate "$CURRENT_GATE" true
    return 0
  fi
  if [ "$PRECHECK" -eq 1 ]; then
    stamp_precheck false
    emit gate "precheck de $REPO rojo ($CURRENT_GATE): ronda de review AHORRADA" false
    echo ""
    echo "⛔ precheck rojo en '$CURRENT_GATE' (exit $rc). NO entregues a review."
    echo "   → Los errores completos están arriba. Corrígelos TODOS en una"
    echo "     iteración (el error de cada gate trae su remediación) y re-corre"
    echo "     scripts/ship.sh --precheck $TASK $REPO."
    echo "   → Esto NO consume presupuesto de loop: el reviewer todavía no vio nada."
    return 0
  fi
  # UN GATE QUE BLOQUEA ES LA MEJOR NOTICIA DEL SISTEMA: es la prueba de que el
  # harness frena a su propio agente. Se cuenta igual de fuerte que un éxito.
  emit gate "$CURRENT_GATE — BLOQUEÓ el ship de $REPO (exit $rc)" false
  echo ""
  echo "⛔ gate '$CURRENT_GATE' falló (exit $rc)."
  echo "   → Lee el error de arriba. Corrige SOLO eso en el worktree $WT,"
  echo "     commitea con el trailer 'Task: $TASK' y re-corre ship.sh."
  echo "   → Presupuesto de autofix: 2 rondas. Si esta es la tercera, PARA"
  echo "     y escala a humano con el error completo (Ley 6)."
}
trap on_exit EXIT

# ── Lock por repo: merge queue de pobre, portable (sin flock) ─────────
# Dos ventanas de muerte que hay que cerrar (las dos costaron un lock inmortal):
#   1. mkdir OK → SIGKILL → pid nunca escrito. El reclamo de huérfanos exigía
#      [ -f pid ], así que un lock sin pid no era reclamable por NADIE: todo
#      ship futuro de ese repo esperaba 10 min y moría, para siempre, hasta que
#      un humano hiciera rm -rf. Reproducido antes de arreglarlo.
#   2. mkdir OK → fallo → el trap corría con LOCK_HELD vacío y no limpiaba.
#      LOCK_HELD se marca AHORA justo después del mkdir, no después del pid.
acquire_lock() {
  local waited=0 nopid=0
  until mkdir "$LOCKDIR" 2>/dev/null; do
    if [ -f "$LOCKDIR/pid" ]; then
      # lock huérfano: el proceso dueño ya no existe
      if ! kill -0 "$(cat "$LOCKDIR/pid" 2>/dev/null)" 2>/dev/null; then
        echo "⚠️  lock huérfano de pid $(cat "$LOCKDIR/pid" 2>/dev/null); lo reclamo"
        rm -rf "$LOCKDIR"; nopid=0; continue
      fi
      nopid=0
    else
      # Sin pid: o el dueño está EN la ventana de adquisición (microsegundos),
      # o murió dentro de ella y el lock quedó inmortal. Damos gracia; si a los
      # 15s sigue sin pid, no hay dueño vivo que lo vaya a escribir.
      nopid=$((nopid+1))
      if [ "$nopid" -ge 15 ]; then
        echo "⚠️  lock sin pid tras 15s — huérfano de una muerte en la ventana de adquisición; lo reclamo"
        rm -rf "$LOCKDIR"; nopid=0; continue
      fi
      sleep 1; continue
    fi
    waited=$((waited+3))
    [ "$waited" -ge 600 ] && { echo "❌ lock de $REPO ocupado >10min ($LOCKDIR) — otro ship en curso"; exit 6; }
    sleep 3
  done
  LOCK_HELD=1                 # ANTES del pid: si morimos ahora, el trap limpia
  echo $$ > "$LOCKDIR/pid"
}

# ── Gates ─────────────────────────────────────────────────────────────
gate_trailer() {
  gate "trailer Task: $TASK"
  local total with_trailer
  total=$(git rev-list --count origin/main..HEAD)
  [ "$total" -gt 0 ] || { echo "❌ no hay commits nuevos sobre origin/main"; exit 3; }
  with_trailer=$(git log origin/main..HEAD --format=%B | grep -cE "^Task: $TASK\$" || true)
  [ "$with_trailer" -ge "$total" ] || {
    echo "❌ $((total-with_trailer)) de $total commits sin trailer 'Task: $TASK'"
    echo "   ↳ remediación: git rebase origin/main --exec 'git commit --amend --no-edit --trailer \"Task: $TASK\"'"
    exit 3
  }
}

# gate_lane — el carril lo declara el intake; el diff lo confirma este gate.
# express prometió: un solo repo (implícito: el worktree ES un repo), cero
# contratos, cero migraciones, cero infra. Si el diff rompe la promesa, el
# ship no pasa: la tarea escala de carril y re-entra por /rfc. Equivocarse
# de carril cuesta una re-entrada — jamás un ship sin la deliberación que
# tocaba. Por esto los carriles no relajan la seguridad: la clasificación
# del intake es una propuesta; este gate es quien la verifica.
gate_lane() {
  gate "carril (lane)"
  local st="$WS/tasks/$TASK/state.json" lane
  lane="$(jq -r '.lane // "full"' "$st" 2>/dev/null || echo full)"
  [ "$lane" = "express" ] || return 0
  local pat="${LANE_GUARD_PATTERN:-(\.proto\$|(^|/)proto/|(^|/)migrations?/|\.sql\$|(^|/)helm/|(^|/)charts/|(^|/)terraform/|(^|/)openapi\.|(^|/)swagger\.)}"
  local hits
  hits="$(git diff origin/main..HEAD --name-only | grep -E "$pat" || true)"
  if [ -n "$hits" ]; then
    echo "❌ carril express, pero el diff toca contratos/migraciones/infra:"
    echo "$hits" | sed 's/^/   · /'
    echo "   ↳ remediación: este cambio SÍ necesita deliberación. Escala el carril:"
    echo "     python3 scripts/harness-policy.py escalate tasks/$TASK --to standard --actor orchestrator"
    echo "     y corre /rfc $TASK — el trabajo hecho se conserva en el worktree."
    exit 3
  fi
}

run_lang_gates() {
  # ¿Reconocimos el stack de este repo? Si al final sigue en 0, el gate no
  # verificó NADA, y eso tiene que verse: era el silencio más caro del script.
  LANG_SEEN=0
  if [ -f go.mod ]; then
    gate go; go vet ./... && go build ./... && go test ./...
    LANG_SEEN=1
  fi
  # Repo TS cuyo package.json NO está en la raíz (monorepo, apps/, packages/):
  # el bloque entero se saltaba EN SILENCIO, el precheck salía verde y el
  # commit roto viajaba hasta el gate de ship. Un gate que no encuentra qué
  # verificar tiene que decirlo, no ausentarse.
  if [ ! -f package.json ] && git ls-files '*/package.json' 2>/dev/null | grep -q .; then
    gate ts
    echo "⛔ el gate ts NO PUEDE CORRER: $REPO no tiene package.json en la raíz,"
    echo "   pero sí en subdirectorios:"
    git ls-files '*/package.json' 2>/dev/null | head -5 | sed 's/^/     · /'
    echo "   Hasta ahora esto se saltaba en silencio: ni typecheck ni tests, y el"
    echo "   precheck salía verde igual."
    echo "   ↳ remediación: declara un package.json en la raíz con scripts typecheck"
    echo "     y test que deleguen a los paquetes (npm -w, pnpm -r, turbo, lo que use)."
    exit 3
  fi
  if [ -f package.json ]; then
    LANG_SEEN=1
    gate ts
    # UN GATE QUE NO PUEDE CORRER NO REPORTA ROJO. Misma regla que import-linter
    # y go-arch-lint abajo, que ya la respetan: si falta la herramienta se dice,
    # no se finge un veredicto. Aquí faltaba.
    #
    # CASO REAL: el worktree nace de origin/main, o sea SIN node_modules y sin
    # los tipos que genera `astro sync`. tsc no ve los ambientes y escupe
    # errores que PARECEN deuda vieja (import.meta.env, astro:assets). Fueron 8
    # errores fantasma, un intento de landing perdido, y CERO líneas de código
    # que tocar: con las deps instaladas el gate pasó solo. Un rojo falso no
    # cuesta una ronda nada más, enseña al agente a desconfiar de los gates.
    # PREPARAR NO ES VERIFICAR, y por eso esto se puede hacer solo.
    #
    # ship.sh verifica y no actúa: un gate que "arregla" el código que juzga
    # deja de ser un gate. Pero instalar dependencias no toca el artefacto que
    # se shippea, es la condición para poder mirarlo. La frontera se sostiene
    # con una PRUEBA, no con una promesa: después de preparar, el árbol
    # VERSIONADO tiene que estar idéntico. Si el install movió el lockfile o
    # cualquier archivo trackeado, eso ya no fue preparar y el gate se niega.
    #
    # Antes esto era una negativa que te devolvía el trabajo a vos. La
    # remediación era mecánica y siempre la misma, así que pedirla era una
    # parada de ceremonia: el humano corría dos comandos y el gate pasaba sin
    # tocar una línea de código.
    if [ ! -d node_modules ] || { ls astro.config.* >/dev/null 2>&1 && [ ! -f .astro/types.d.ts ]; }; then
      before="$(git status --porcelain -uno -- . | sort)"
      if [ ! -d node_modules ]; then
        echo "→ preparo la toolchain: faltan node_modules (worktree recién creado)"
        bash "$WS/scripts/fe.sh" 'install' "$REPO" "$TASK" >/dev/null 2>&1 || true
        # Verifico que la preparación FUNCIONÓ. Dar por hecho que un comando
        # hizo lo suyo es la misma fe ciega que este gate existe para evitar.
        if [ ! -d node_modules ]; then
          echo "⛔ el gate ts NO PUEDE CORRER: no pude instalar las dependencias de $REPO."
          echo "   Sin ellas los errores de tipos serían fantasma (faltan los .d.ts"
          echo "   de las deps), no deuda real del cambio."
          echo "   ↳ remediación: bash scripts/fe.sh 'install' $REPO $TASK"
          exit 3
        fi
      fi
      if ls astro.config.* >/dev/null 2>&1 && [ ! -f .astro/types.d.ts ]; then
        echo "→ preparo la toolchain: falta .astro/types.d.ts (lo genera astro sync)"
        npx astro sync >/dev/null 2>&1 || true
        if [ ! -f .astro/types.d.ts ]; then
          echo "⛔ el gate ts NO PUEDE CORRER: 'astro sync' no generó .astro/types.d.ts."
          echo "   Ese archivo declara astro:assets e import.meta.env; sin él, tsc los"
          echo "   reporta como errores fantasma."
          echo "   ↳ remediación: (cd $WT && npx astro sync) y mirá qué dice"
          exit 3
        fi
      fi
      after="$(git status --porcelain -uno -- . | sort)"
      if [ "$before" != "$after" ]; then
        echo "⛔ preparar la toolchain modificó archivos VERSIONADOS de $REPO:"
        printf '%s\n' "$after" | head -5 | sed 's/^/     · /'
        echo "   Eso ya no es preparar: es cambiar el artefacto que este gate juzga,"
        echo "   y ahí me detengo. Suele ser un lockfile desincronizado del package.json."
        echo "   ↳ remediación: corre el install en el worktree, revisá el diff y"
        echo "     commiteálo como parte del cambio si corresponde."
        exit 3
      fi
      echo "  ✅ toolchain lista (sin tocar archivos versionados), sigo con el gate"
    fi
    # EL TYPECHECK DEL REPO MANDA SOBRE EL NUESTRO. `tsc --noEmit` no es el
    # typecheck de todo proyecto TS: uno de Astro se chequea con `astro check`
    # (tsc solo ve una parte y no mira los .astro), y un monorepo con `tsc -b`.
    # Si el repo declara cómo se chequea, se usa eso.
    checked=0
    if   jq -e '.scripts.typecheck'     package.json >/dev/null 2>&1; then npm run typecheck; checked=1
    elif jq -e '.scripts["check:types"]' package.json >/dev/null 2>&1; then npm run check:types; checked=1
    elif jq -e '.scripts.check'         package.json >/dev/null 2>&1; then npm run check; checked=1
    elif [ -f tsconfig.json ]; then npx tsc --noEmit; checked=1          # gate DURO: sin || true
    fi
    # Es TypeScript y no encontramos cómo chequearlo. Eso NO es un verde: es
    # justo el agujero por el que llegó un commit roto hasta el gate de ship.
    if [ "$checked" -eq 0 ] \
       && jq -e '.devDependencies.typescript // .dependencies.typescript' package.json >/dev/null 2>&1; then
      echo "⛔ $REPO trae typescript como dependencia pero el gate no encontró cómo typechequearlo:"
      echo "   sin tsconfig.json en la raíz y sin script typecheck / check:types / check."
      echo "   Hasta ahora esto pasaba EN SILENCIO y el precheck salía verde."
      echo "   ↳ remediación: declara en package.json el script que ya usás para chequear"
      echo "     tipos (\"typecheck\": \"astro check\" / \"tsc --noEmit\" / \"tsc -b\")."
      exit 3
    fi
    # `npm test --if-present` se callaba cuando NO había script test: un repo
    # sin tests salía verde sin decir una palabra. El silencio de un
    # verificador se lee igual que un verde.
    if jq -e '.scripts.test' package.json >/dev/null 2>&1; then
      npm test
    else
      echo "⚠️  $REPO no declara script 'test' en package.json: el gate ts NO corrió tests."
      echo "   No lo bloqueo (puede ser legítimo), pero que quede dicho: este gate"
      echo "   verificó tipos y nada más."
    fi
  fi
  if [ -f pyproject.toml ]; then
    LANG_SEEN=1
    gate python
    ruff check .
    if command -v uv >/dev/null; then uv run pytest -q; else pytest -q; fi
  fi
  if [ -f pubspec.yaml ]; then
    gate flutter; flutter analyze && flutter test
    LANG_SEEN=1
  fi
  # ── Stacks que faltaban ───────────────────────────────────────────────
  # Hasta aquí el gate solo reconocía Go, Node, Python y Dart. Un repo Rust,
  # Java, Ruby, PHP, .NET o Elixir no tenía rama: el precheck salía VERDE con
  # el build roto y ship.sh lo pushaba a main sin compilar ni testear, sin
  # decir una palabra. Para un instalador que se dice universal, ese era el
  # agujero más grande (regla 8 de CONTRIBUTING).
  #
  # Cada uno sigue la regla de la casa: si el marcador está pero la toolchain
  # no, se dice, no se finge un veredicto.
  need() {  # need <bin> <stack>: ¿está la toolchain? si no, avisa honesto
    command -v "$1" >/dev/null && return 0
    echo "⚠️  $REPO es $2 pero '$1' no está instalado: ese gate NO CORRIÓ."
    emit assumption "$REPO ($2) NO compilado ni testeado: falta '$1' en el PATH"
    return 1
  }
  if [ -f Cargo.toml ]; then
    LANG_SEEN=1
    if need cargo Rust; then gate rust; cargo build --locked && cargo test; fi
  fi
  if [ -f pom.xml ]; then
    LANG_SEEN=1
    if need mvn Java-Maven; then gate java-maven; mvn -B -q verify; fi
  fi
  if [ -f build.gradle ] || [ -f build.gradle.kts ]; then
    LANG_SEEN=1
    if [ -x ./gradlew ]; then gate java-gradle; ./gradlew --quiet build
    elif need gradle Java-Gradle; then gate java-gradle; gradle --quiet build; fi
  fi
  if [ -f Gemfile ]; then
    LANG_SEEN=1
    if need bundle Ruby; then
      gate ruby
      if [ -f Rakefile ]; then bundle exec rake
      elif [ -d spec ]; then bundle exec rspec
      else echo "⚠️  $REPO es Ruby pero no tiene Rakefile ni spec/: no encontré qué correr"
           emit assumption "$REPO (Ruby) sin suite reconocible: el gate no corrió tests"; fi
    fi
  fi
  if [ -f composer.json ]; then
    LANG_SEEN=1
    if need composer PHP; then
      gate php
      if [ -f phpunit.xml ] || [ -f phpunit.xml.dist ]; then
        composer install --no-interaction --quiet && vendor/bin/phpunit
      else
        echo "⚠️  $REPO es PHP sin phpunit.xml: no encontré qué correr"
        emit assumption "$REPO (PHP) sin config de phpunit: el gate no corrió tests"
      fi
    fi
  fi
  if ls ./*.sln ./*.csproj >/dev/null 2>&1; then
    LANG_SEEN=1
    if need dotnet dotNET; then gate dotnet; dotnet build --nologo -v q && dotnet test --nologo -v q; fi
  fi
  if [ -f mix.exs ]; then
    LANG_SEEN=1
    if need mix Elixir; then gate elixir; mix compile --warnings-as-errors && mix test; fi
  fi
  # Gates de arquitectura y SQL: la CONFIG del repo es el opt-in (sin config,
  # silencio). Con config presente son gates duros — igual que go/ts. Config
  # sin herramienta instalada = warning honesto, no un gate fingido.
  if [ -f .importlinter ] || grep -q '\[tool\.importlinter\]' pyproject.toml 2>/dev/null; then
    if command -v lint-imports >/dev/null; then gate "import-linter"; lint-imports
    else echo "⚠️  config de import-linter presente pero lint-imports no instalado — gate saltado"; fi
  fi
  if [ -f .go-arch-lint.yml ]; then
    if command -v go-arch-lint >/dev/null; then gate "go-arch-lint"; go-arch-lint check
    else echo "⚠️  .go-arch-lint.yml presente pero go-arch-lint no instalado — gate saltado"; fi
  fi
  # squawk: lint de migraciones SQL NUEVAS del diff (las viejas no se re-litigan)
  # La migración manda, no la herramienta: primero se mira el diff y DESPUÉS
  # si hay con qué lintearlo. Al revés, sin squawk instalado el bloque entero
  # se saltaba en silencio y un ALTER bloqueante llegaba a prod por el mismo
  # agujero que squawk existe para cerrar. import-linter y go-arch-lint, sus
  # vecinos de arriba, ya avisaban honestamente; este era el único que no.
  local migs
  migs="$(git diff origin/main..HEAD --name-only --diff-filter=A | grep -E '(^|/)migrations?/.*\.sql$' || true)"
  if [ -n "$migs" ]; then
    if command -v squawk >/dev/null; then
      gate "squawk (migraciones)"; squawk $migs
    else
      echo "⚠️  este cambio agrega migraciones SQL y squawk NO está instalado:"
      printf '%s\n' "$migs" | sed 's/^/     · /'
      echo "   NO se lintearon: un ALTER bloqueante o un índice sin CONCURRENTLY"
      echo "   pasaría sin que nadie lo vea. Instalá squawk (npm i -g squawk-cli)."
      emit assumption "migraciones de $REPO NO lintadas: squawk no está instalado"
    fi
  fi
  if [ -f buf.yaml ]; then
    LANG_SEEN=1
    gate buf
    # breaking: SIEMPRE duro (--against apunta al gitdir del clon base)
    buf breaking --against "$BASE/.git#branch=origin/main"
    # lint: RATCHET — solo violaciones NUEVAS respecto a main bloquean.
    # La deuda preexistente no secuestra shipping ajeno (la baja el
    # ratchet-keeper con su propio ciclo). Se ignoran números de línea
    # para tolerar corrimientos.
    norm() { jq -c 'del(.start_line,.end_line,.start_column,.end_column)' 2>/dev/null | sort; }
    head_lint="$(buf lint --error-format=json 2>/dev/null | norm || true)"
    main_lint="$(cd "$BASE" && buf lint --error-format=json 2>/dev/null | norm || true)"
    new_lint="$(comm -13 <(printf '%s' "$main_lint") <(printf '%s' "$head_lint"))"
    if [ -n "$new_lint" ]; then
      echo "❌ buf lint: violaciones NUEVAS introducidas por este cambio:"
      echo "$new_lint" | jq -r '"   \(.path): \(.message)"' 2>/dev/null || echo "$new_lint"
      echo "   ↳ remediación: corrige SOLO estas (la deuda preexistente de main no bloquea)"
      exit 3
    fi
    [ -n "$main_lint" ] && echo "⚠️  buf lint: $(printf '%s\n' "$main_lint" | grep -c .) violaciones PREEXISTENTES en main (no bloquean; candidatas al ratchet-keeper)"
  fi

  # EL SILENCIO MÁS CARO: si ningún marcador matcheó, este gate no compiló ni
  # testeó NADA y hasta hoy salía verde igual. Un repo docs o de contratos
  # puede no tener stack legítimamente, así que no se bloquea, pero deja de
  # pasar callado: queda como supuesto arriba del resumen de sesión.
  if [ "$LANG_SEEN" -eq 0 ]; then
    echo "⚠️  no reconozco el stack de $REPO: este gate NO compiló ni testeó nada."
    echo "   Marcadores que busco: go.mod, package.json, pyproject.toml,"
    echo "   pubspec.yaml, Cargo.toml, pom.xml, build.gradle, Gemfile,"
    echo "   composer.json, *.csproj/*.sln, mix.exs, buf.yaml."
    echo "   Si este repo SÍ se construye, agregá su rama en run_lang_gates:"
    echo "   un eje sin implementación es un vendor cableado (CONTRIBUTING #8)."
    emit assumption "$REPO NO compilado ni testeado: run_lang_gates no reconoce su stack"
  fi
}

run_security_gates() {
  # gitleaks es una CAPACIDAD ELEGIBLE en la entrevista, no un supuesto. Sin
  # guarda, la instancia que no lo palomeó tenía TODO precheck y TODO ship en
  # rojo con exit 127, y el bootstrap tampoco lo instalaba porque no fue
  # elegido: un bucle sin salida. Su vecino semgrep ya estaba guardado.
  if command -v gitleaks >/dev/null; then
    gate gitleaks
    # detect sobre el rango real a pushear (protect --staged es no-op aquí)
    gitleaks detect --no-banner --log-opts="origin/main..HEAD"
  else
    echo "⚠️  gitleaks no instalado: el gate de secretos NO CORRIÓ en $REPO."
    echo "   Esto no es un verde: es un tramo sin verificar. Si elegiste gitleaks,"
    echo "   instálalo (bash scripts/bootstrap.sh); si no, quítalo de tu política."
    emit assumption "secretos de $REPO NO escaneados: gitleaks no está instalado"
  fi
  if [ -f "$WS/semgrep/rules.yaml" ]; then
    gate semgrep
    semgrep scan --config "$WS/semgrep/rules.yaml" --error --quiet .
  fi
}

# gate_tests_untouched — el gate confía en el test suite; el test suite es un
# archivo que el agente puede editar. Sin este gate, la forma MÁS BARATA de
# pasar a verde no es arreglar el código: es debilitar el test (SWE-Bench+:
# ~31% de parches "exitosos" pasaban por tests débiles).
#
# v2, con las lecciones de campo: (1) cuenta LLAMADAS reales de aserción
# (una línea de import con la palabra expect o un comentario con asserted ya
# no cuentan); (2) contabilidad NETA por archivo: una línea MOVIDA aparece en
# el lado - y en el +, neto 0; un move entre archivos de test (suma global
# <= 0, sin skips ni borrados) pasa con aviso; (3) el escape exige DECLARAR:
# el delta-spec debe nombrar CADA archivo debilitado DENTRO de una sección
# MODIFIED/REMOVED (escribir la palabra en la prosa ya no abre nada).
#
# Residuales conscientes (rúbrica del reviewer, no de este gate): borrar
# filas de una tabla Go table-driven, y reemplazos tautológicos
# (expect(true).toBe(true)). -M explícito en TODOS los git diff: sin él, un
# rename cuenta como D+A según la config diff.renames del usuario.
gate_tests_untouched() {
  gate "tests no debilitados"
  local pat="${TEST_PATH_PATTERN:-(test|spec|Test|_test\.|\.test\.|\.spec\.|/tests?/|/spec/)}"
  local touched
  touched="$(git diff -M origin/main..HEAD --name-status \
    | awk -F'\t' '{ for (i = 2; i <= NF; i++) print $i }' | grep -E "$pat" | sort -u || true)"
  [ -n "$touched" ] || return 0

  local deleted
  deleted="$(git diff -M origin/main..HEAD --diff-filter=D --name-only | grep -E "$pat" || true)"

  # UN pase del diff completo en awk (BSD-safe: sin \b ni \s; gsub cuenta
  # OCURRENCIAS, no líneas). Salida: "<aserciones_netas>\t<skips_netos>\t<archivo>".
  local report
  report="$(git diff -M origin/main..HEAD | TESTPAT="$pat" awk '
    BEGIN {
      pat  = ENVIRON["TESTPAT"]
      asrt = "assert[A-Za-z_]*[[:space:]]*\\(|assert\\.[A-Za-z_]+[[:space:]]*\\(" \
           "|(^|[^A-Za-z0-9_])assert[[:space:]]+[^=[:space:]]" \
           "|expect[[:space:]]*\\(|require\\.[A-Za-z]+\\(" \
           "|t\\.(Error|Fatal|FailNow|Run)|\\.should\\.|@Test" \
           "|(^|[^A-Za-z0-9_.])(it|test|describe)[[:space:]]*\\("
      skp  = "(^|[^A-Za-z0-9_.])(xit|xdescribe|xtest)[[:space:]]*\\(" \
           "|\\.skip[[:space:]]*\\(|\\.only[[:space:]]*\\(|@skip|@unittest\\.skip" \
           "|pytest\\.mark\\.skip|t\\.Skip|#\\[ignore\\]|@Disabled|@Ignore"
      cmnt = "^(//|/\\*|\\*|#[^[]|import[[:space:]]|from[[:space:]])"
    }
    function flush() {
      if (cur != "" && cur ~ pat && (na != 0 || ns != 0))
        printf "%d\t%d\t%s\n", na, ns, cur
      cur = ""; na = 0; ns = 0
    }
    /^diff --git / { flush(); minus = ""; next }
    /^--- /   { minus = $0; sub(/^--- /, "", minus)
                gsub(/^"|"$/, "", minus); sub(/^a\//, "", minus); next }
    /^\+\+\+ / { cur = $0; sub(/^\+\+\+ /, "", cur)
                gsub(/^"|"$/, "", cur); sub(/^b\//, "", cur)
                if (cur == "/dev/null") cur = minus; next }
    /^-/ { l = substr($0, 2); sub(/^[[:space:]]+/, "", l)
           if (l ~ cmnt) next
           if (l ~ skp) ns -= 1
           na += gsub(asrt, "", l); next }
    /^\+/ { l = substr($0, 2); sub(/^[[:space:]]+/, "", l)
            if (l ~ cmnt) next
            if (l ~ skp) ns += 1
            na -= gsub(asrt, "", l); next }
    END { flush() }
  ')"

  # La declaración legítima: contenido BAJO encabezados MODIFIED/REMOVED del
  # delta-spec, y debe nombrar el basename de CADA archivo debilitado.
  local delta="$WS/tasks/$TASK/delta-spec.md" declared=""
  [ -f "$delta" ] && declared="$(awk '
    /^#/ { insec = (toupper($0) ~ /(MODIFIED|REMOVED)/); next }
    insec { print }
  ' "$delta")"
  declares() { printf '%s\n' "$declared" | grep -qiF "$(basename "$1")"; }

  local bad=0 global_na=0 f na ns
  if [ -n "$deleted" ]; then
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      if declares "$f"; then
        echo "   ⚠️  test borrado y DECLARADO en el delta-spec: $f (queda en el registro)"
      else
        echo "   · test BORRADO sin declarar: $f"
        bad=1
      fi
    done <<DELEOF
$deleted
DELEOF
  fi
  if [ -n "$report" ]; then
    while IFS="$(printf '\t')" read -r na ns f; do
      [ -n "$f" ] || continue
      global_na=$((global_na+na))
      [ "$na" -gt 0 ] || [ "$ns" -gt 0 ] || continue
      if declares "$f"; then
        echo "   ⚠️  tests tocados y DECLARADOS en el delta-spec: $f"
        continue
      fi
      [ "$na" -gt 0 ] && echo "   · $f: $na aserciones netas eliminadas"
      [ "$ns" -gt 0 ] && echo "   · $f: $ns skips/only netos añadidos"
      bad=1
    done <<REPEOF
$report
REPEOF
    # move entre archivos de test: neto por archivo != 0 pero global <= 0 y
    # sin skips ni borrados: reorganizar suites es legítimo, no debilitar
    if [ "$bad" -eq 1 ] && [ "$global_na" -le 0 ] && [ -z "$deleted" ] \
       && ! printf '%s\n' "$report" | awk -F'\t' '$2 > 0 { found=1 } END { exit !found }'; then
      echo "   ⚠️  aserciones movidas ENTRE archivos de test (neto global $global_na): no es debilitamiento"
      bad=0
    fi
  fi
  [ "$bad" -eq 0 ] && return 0
  echo "❌ este cambio DEBILITA tests y el delta-spec no lo declara (archivos arriba):"
  echo "   ↳ remediación: los tests son el CONTRATO, no el obstáculo. Si el"
  echo "     comportamiento DEBE cambiar, decláralo en tasks/$TASK/delta-spec.md:"
  echo "     bajo '## MODIFIED Requirements' o '## REMOVED Requirements' la entrada"
  echo "     debe NOMBRAR cada archivo de test afectado. Si no, arregla el CÓDIGO"
  echo "     hasta que el test pase como está."
  exit 3
}

# gate_evidence — nuestra ley es "los agentes proponen, los sistemas
# deterministas verifican". La compliance matrix la ESCRIBE un agente: hasta
# ahora, el verificador proponía. Este gate no juzga el código; solo comprueba
# mecánicamente que el artefacto citado por cada requirement (a) existe y (b)
# fue REALMENTE leído (lo registra el hook track-read.sh). Es una intersección
# de conjuntos: cero LLM, cero opinión.
gate_evidence() {
  local v="$WS/tasks/$TASK/verdict-$REPO.json"
  jq -e 'has("compliance")' "$v" >/dev/null 2>&1 || return 0
  gate "evidencia de compliance"
  local log="$WS/tasks/$TASK/evidence.log"
  local missing=0 unread=0 row art
  while IFS= read -r art; do
    [ -n "$art" ] || continue
    if [ ! -e "$WS/$art" ] && [ ! -e "$WT/$art" ]; then
      echo "   ✗ citado pero NO EXISTE: $art"; missing=$((missing+1)); continue
    fi
    if [ -f "$log" ] && grep -qF -- "$art" "$log"; then :; else
      echo "   ✗ citado pero NADIE LO LEYÓ: $art"; unread=$((unread+1))
    fi
  done <<EOF
$(jq -r '.compliance[]? | select(.covered==true) |
  if (.tests? | type) == "array" then .tests[]
  else (.evidence_path // .test // empty) end' "$v" 2>/dev/null)
EOF
  if [ "$missing" -gt 0 ] || [ "$unread" -gt 0 ]; then
    echo "❌ la compliance matrix cita evidencia que no existe ($missing) o que nunca se leyó ($unread)"
    echo "   ↳ remediación: un requirement solo pasa a covered:true si el reviewer"
    echo "     ABRIÓ el artefacto que lo prueba (test, log, screenshot). Corre el"
    echo "     test, lee su salida, y cita la ruta real en .compliance[].evidence."
    echo "     'Confía en mí' no es evidencia — por eso existe este gate."
    exit 3
  fi
}

check_verdict() {
  gate "veredicto de review"
  local v="$WS/tasks/$TASK/verdict-$REPO.json" qa_state=""
  [ -f "$v" ] || { echo "❌ sin veredicto en $v"; echo "   ↳ remediación: corre /review $TASK $REPO primero"; exit 3; }
  # Dos condiciones, dos remediaciones opuestas: el review lo arregla el
  # implementer con los blocking; un qa:"pending" NO tiene blocking que
  # corregir: le falta correr la fase. Un mensaje único mandaba a leer una
  # lista vacía y quemaba una ronda, así que se diagnostican por separado.
  jq -e '.verdict=="pass"' "$v" >/dev/null \
    || { echo "❌ el review no es pass (verdict=$(jq -r '.verdict' "$v"))"
         echo "   ↳ remediación: corrige los $(jq '.blocking|length' "$v") items blocking listados en $v"
         echo "     (cada uno trae la suya) y re-corre /review $TASK $REPO"; exit 3; }
  jq -e '.qa=="pass"' "$v" >/dev/null \
    || { qa_state="$(jq -r '.qa' "$v")"
         echo "❌ QA no es pass (qa=$qa_state)"
         if [ "$qa_state" = "pending" ]; then
           echo "   ↳ el review pasó pero la fase QA nunca corrió. QA NO implica navegador:"
           echo "     · backend / criterios ya cubiertos por tests → QA determinista:"
           echo "       python3 scripts/evidence.py run --task-dir tasks/$TASK --repo $REPO \\"
           echo "         --runner qa --kind test --cwd worktrees/$TASK/$REPO -- <comando de test>"
           echo "     · frontend / criterios de cara al usuario → agente qa (Playwright)"
           echo "     Escribe el resultado en tasks/$TASK/qa-$REPO.json y re-corre /review"
           echo "     $TASK $REPO, que lo fusiona al veredicto (ver /review paso 1 y 3)."
         else
           echo "   ↳ remediación: QA encontró fallas; regrésalas al implementer como"
           echo "     blocking y re-corre QA sobre el HEAD nuevo (ver tasks/$TASK/qa-$REPO.json)"
         fi
         exit 3; }
  # compliance: todo requirement del delta-spec cubierto por tests
  jq -e '(.requirements_uncovered // 0) == 0' "$v" >/dev/null \
    || { echo "❌ $(jq -r '.requirements_uncovered' "$v") requirements del delta-spec sin test que los proteja"
         echo "   ↳ remediación: escribe el test faltante (ver .compliance[] con covered:false en $v) o pide al humano una excepción explícita"; exit 3; }
}

# El veredicto no es una afirmación libre: policy v1 comprueba estado, rondas
# y separación de roles; evidence v1 liga cada resultado al HEAD exacto y al
# hash de su salida. Ambos validadores son stdlib Python y fail-closed.
gate_policy_and_evidence() {
  gate "policy + evidencia v1"
  local v="$WS/tasks/$TASK/verdict-$REPO.json"
  local head
  head="$(git rev-parse HEAD)"
  python3 "$WS/scripts/harness-policy.py" --policy "$WS/harness-policy.json" \
    validate-ship "$WS/tasks/$TASK" --commit "$head" --verdict "$v"
  python3 "$WS/scripts/evidence.py" verify \
    --task-dir "$WS/tasks/$TASK" --repo "$REPO" --commit "$head" \
    --verdict "$v" --require-kind test
}

# ── Gates en paralelo ─────────────────────────────────────────────────
# Los grupos no comparten orden real entre sí (cada uno es read-only sobre
# el worktree o corre su propia toolchain); DENTRO de un grupo el orden se
# conserva (check_verdict antes que evidence). Cada grupo corre en subshell
# con su propio CURRENT_GATE y escribe su exit a un archivo: un rojo no
# oculta a los demás, y el implementer recibe TODOS los errores en un solo
# prompt de fix en vez de descubrirlos ronda por ronda.
GDIR=""; PAR_PIDS=""; PAR_SLOTS=""
par() {  # par <slot> <gate-fn>... — corre un grupo de gates en background
  local slot="$1"; shift
  (
    # PAR_SLOT: copia a scope de subshell. El trap EXIT de un subshell que
    # muere por set -e corre DESPUÉS de desmontar los locals de la función
    # (bash 3.2 y 5.x): referenciar $slot ahí es unbound variable.
    PAR_SLOT="$slot"
    CURRENT_GATE=""
    group_exit() {
      local rc=$?
      if [ "$rc" -eq 0 ]; then
        [ -n "${CURRENT_GATE:-}" ] && emit gate "$CURRENT_GATE" true
      else
        emit gate "$CURRENT_GATE — BLOQUEÓ el ship de $REPO (exit $rc)" false
        echo "⛔ gate '$CURRENT_GATE' falló (exit $rc)"
      fi
      echo "$rc" > "$GDIR/$PAR_SLOT.rc"
    }
    trap group_exit EXIT
    local fn; for fn in "$@"; do "$fn"; done
  ) > "$GDIR/$slot.out" 2>&1 &
  PAR_PIDS="$PAR_PIDS $!"
  PAR_SLOTS="$PAR_SLOTS $slot"
}

run_parallel_gates() {
  # cierra el gate serial anterior (mismo contrato que gate())
  [ -n "${CURRENT_GATE:-}" ] && [ "$CURRENT_GATE" != "preflight" ] \
    && emit gate "$CURRENT_GATE" true
  CURRENT_GATE=""
  GDIR="$(mktemp -d "${TMPDIR:-/tmp}/ship-gates.XXXXXX")"
  PAR_PIDS=""; PAR_SLOTS=""
  # En precheck no hay veredicto todavía (ese es justamente el punto: correr
  # lo mecánico ANTES de gastar una ronda de reviewer). El resto es idéntico:
  # mismo código, mismos umbrales, mismas remediaciones.
  if [ "${PRECHECK:-0}" -eq 1 ]; then
    echo "── gates en paralelo: lang ∥ security ∥ tests (sin veredicto: precheck) ──"
  else
    echo "── gates en paralelo: lang ∥ security ∥ tests ∥ veredicto ──"
  fi
  par lang      run_lang_gates
  par security  run_security_gates
  par tests     gate_tests_untouched
  [ "${PRECHECK:-0}" -eq 1 ] || par veredicto check_verdict gate_evidence gate_policy_and_evidence
  local pid; for pid in $PAR_PIDS; do wait "$pid" 2>/dev/null || true; done
  local slot rc failed=""
  for slot in $PAR_SLOTS; do
    cat "$GDIR/$slot.out"
    rc="$(cat "$GDIR/$slot.rc" 2>/dev/null || echo 1)"
    [ "$rc" -eq 0 ] || failed="$failed $slot"
  done
  rm -rf "$GDIR"
  if [ -n "$failed" ]; then
    CURRENT_GATE="gates paralelos:$failed"
    echo "❌ gates rojos:$failed — TODOS los errores están arriba. Corrige TODO"
    echo "   en UNA iteración (cada gate trae su remediación) y re-corre ship.sh."
    exit 3
  fi
}

# ── Precheck: los gates mecánicos ANTES de gastar una ronda de review ─
# Sin lock (no toca main), sin rebase (no reescribe la historia del
# implementer) y sin veredicto. Solo responde una pregunta: ¿este worktree
# pasaría hoy los gates que no dependen de juicio humano ni de review?
if [ "$PRECHECK" -eq 1 ]; then
  cd "$WT"
  git fetch origin --quiet 2>/dev/null || true   # fail-open: sin red, compara contra el origin/main local
  echo "══ precheck $REPO (task $TASK) ══"
  run_parallel_gates
  stamp_precheck true
  emit gate "precheck de $REPO verde, listo para review" true
  echo "✅ precheck verde. Sello: tasks/$TASK/precheck-$REPO.json"
  echo "→ siguiente: /review $TASK $REPO"
  exit 0
fi

# ── Loop de ship ──────────────────────────────────────────────────────
acquire_lock
cd "$WT"
attempt=0
while [ "$attempt" -lt "$MAX_RETRY" ]; do
  attempt=$((attempt+1))
  echo "══ ship $REPO (task $TASK) intento $attempt/$MAX_RETRY ══"
  git fetch origin
  git rebase origin/main || { git rebase --abort; echo "❌ conflicto de rebase — resuélvelo en el worktree $WT"; exit 4; }
  gate_trailer
  gate_lane
  run_parallel_gates
  if git push origin HEAD:main; then
    sha="$(git rev-parse --short HEAD)"
    echo "{\"repo\":\"$REPO\",\"sha\":\"$sha\",\"shipped_at\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}" >> "$WS/tasks/$TASK/ship.log"
    # Cierra el último gate ANTES de anunciar el ship: si lo dejara al trap,
    # el "veredicto ✅" saldría en el bus DESPUÉS del "shippeé" y la historia
    # tendría el penúltimo paso después del último.
    [ -n "${CURRENT_GATE:-}" ] && emit gate "$CURRENT_GATE" true && CURRENT_GATE=""
    emit ship "$REPO @ $sha — pasó los gates y está en main" true
    echo "✅ shipped $REPO @ $sha"
    echo "→ siguiente: scripts/deploy-watch.sh $TASK $REPO (o /ship se encarga)"
    exit 0
  fi
  echo "⚠️ push rechazado (non-fast-forward), reintentando tras rebase…"
done
echo "❌ agotados $MAX_RETRY intentos — escala a humano"
exit 5
