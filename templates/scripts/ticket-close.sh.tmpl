#!/usr/bin/env bash
# ticket-close.sh — cierra el loop harness → tracker. Cero tokens.
# shipped: comenta commits por repo + resultado del deploy, label → shipped, y
#          en Linear mueve el ESTADO a completado, que es la marca real de
#          cierre: un label puede no existir en el team y el ticket quedaría
#          igual de abierto que antes (#113).
# failed:  comenta el diagnóstico, label regresa a agent-ready. El estado NO se
#          toca: alguien lo va a retomar, y decidir su triage no es de acá.
#
# Exit: 0 ok · 1 uso · 2 el ticket no existe · 4 error auth/red
#       6 la LINEAR_API_KEY alcanza otra organizacion de Linear
#
# Uso: ticket-close.sh <TICKET-ID> --status shipped|failed [--note "..."]
# Requiere LINEAR_API_KEY (vía with-secrets.sh).
set -euo pipefail
ID="${1:?uso: ticket-close.sh <TICKET-ID> --status shipped|failed}"
STATUS=""; NOTE=""
shift
while [ $# -gt 0 ]; do case "$1" in
  --status) STATUS="$2"; shift 2;;
  --note)   NOTE="$2"; shift 2;;
  *) echo "flag desconocido: $1"; exit 1;;
esac; done
[ "$STATUS" = "shipped" ] || [ "$STATUS" = "failed" ] || { echo "❌ --status shipped|failed"; exit 1; }
WS="$(cd "$(dirname "$0")/.." && pwd)"
PROVIDER="{{TICKETS_PROVIDER}}"

close_github() {
  command -v gh >/dev/null || { echo "❌ gh no está instalado (tickets: github)"; exit 4; }
  local raw="$ID" repo num
  case "$raw" in
    */*\#*) repo="${raw%%#*}"; num="${raw##*#}" ;;
    \#*)     repo="{{TICKETS_REPO}}"; num="${raw#\#}" ;;
    *)       repo="{{TICKETS_REPO}}"; num="$raw" ;;
  esac
  # $body y $STATUS los armó el bloque común de arriba.
  gh issue comment "$num" --repo "$repo" --body "$body" >/dev/null 2>&1 \
    || { echo "❌ no pude comentar en $repo#$num (¿auth?)"; exit 4; }
  if [ "$STATUS" = "shipped" ]; then
    gh issue edit "$num" --repo "$repo" --remove-label in-harness \
      --add-label shipped >/dev/null 2>&1 || echo "⚠️  no pude mover el label a 'shipped'"
    echo "✅ $repo#$num comentado y etiquetado shipped"
  else
    gh issue edit "$num" --repo "$repo" --remove-label in-harness \
      --add-label agent-ready >/dev/null 2>&1 || echo "⚠️  no pude devolver el label a 'agent-ready'"
    echo "✅ $repo#$num comentado y devuelto a agent-ready"
  fi
  exit 0
}

case "$PROVIDER" in
  linear) : ;;   # sigue abajo, es el camino original
  github) : ;;   # se despacha después de armar la evidencia
  none|"") echo "❌ sin tracker configurado (tickets.provider: none): nada que cerrar."; exit 0 ;;
  *) echo "❌ proveedor de tickets desconocido: '$PROVIDER' (implementados: linear, github)"; exit 4 ;;
esac
if [ "$PROVIDER" = "linear" ]; then
  # El carril de Linear vive en scripts/linear.sh (#113): el diagnóstico de "el
  # ticket no existe" vs "tu key es de otra organización" ya se había arreglado
  # en ticket-pull.sh, y este script seguía diciendo "❌ ticket COR-944 no
  # existe" sobre un ticket que existía. Arreglarlo acá copiando la fórmula
  # habría dejado la misma trampa armada para el próximo script del carril.
  # shellcheck source=/dev/null
  . "$WS/scripts/linear.sh"
  linear_require_key
fi

gql() { linear_gql "$1"; }

# 1 · Recolectar evidencia: commits con el trailer, por repo
evidence=""
for base in "$WS/repos"/*/; do
  repo="$(basename "$base")"
  commits="$(git -C "$base" log --all --grep "Task: $ID" --format='%h %s' 2>/dev/null || true)"
  [ -n "$commits" ] && evidence="$evidence
**$repo**
\`\`\`
$commits
\`\`\`"
done
[ -f "$WS/tasks/$ID/ship.log" ] && evidence="$evidence
**ship.log**
\`\`\`
$(cat "$WS/tasks/$ID/ship.log")
\`\`\`"

if [ "$STATUS" = "shipped" ]; then
  body="✅ Shipped por el harness.$evidence
${NOTE:+Nota: $NOTE}"
  target_label="shipped"
else
  body="❌ Falló en el harness. ${NOTE:-ver task log en tasks/$ID/}"
  target_label="agent-ready"
fi

# El cuerpo del comentario es del HARNESS, no del proveedor: se arma una vez y
# cada driver solo lo publica. Así agregar un tracker no puede cambiar qué
# evidencia se reporta.
[ "$PROVIDER" = "github" ] && close_github

# 2 · Resolver ids y publicar (linear)
resp="$(gql "$(jq -n --arg id "$ID" '{query:"query($id:String!){ issue(id:$id){ id team{id} labels{nodes{id name}} } }", variables:{id:$id}}')")"
issue="$(echo "$resp" | jq '.data.issue')"
# "❌ ticket $ID no existe" a secas era el peor desvío posible: manda a buscar un
# ticket borrado cuando el ticket está abierto en el navegador y lo que no
# coincide es la ORGANIZACIÓN de la credencial (#113).
if [ "$issue" = "null" ] || [ -z "$issue" ]; then
  linear_no_existe "$ID" "$resp" || exit $?
fi
uuid="$(echo "$issue" | jq -r '.id')"
team_id="$(echo "$issue" | jq -r '.team.id')"

gql "$(jq -n --arg id "$uuid" --arg body "$body" \
  '{query:"mutation($id:String!,$body:String!){ commentCreate(input:{issueId:$id, body:$body}){ success } }", variables:{id:$id, body:$body}}')" >/dev/null
echo "✅ comentario publicado"

label_id="$(gql "$(jq -n --arg t "$team_id" '{query:"query($t:String!){ team(id:$t){ labels{nodes{id name}} } }", variables:{t:$t}}')" \
  | jq -r --arg n "$target_label" '.data.team.labels.nodes[] | select(.name==$n) | .id')"
if [ -n "$label_id" ]; then
  new_ids="$(echo "$issue" | jq -c --arg add "$label_id" '[.labels.nodes[] | select(.name=="in-harness" or .name=="agent-ready" | not) | .id] + [$add]')"
  gql "$(jq -n --arg id "$uuid" --argjson ids "$new_ids" '{query:"mutation($id:String!,$ids:[String!]){ issueUpdate(id:$id, input:{labelIds:$ids}){ success } }", variables:{id:$id, ids:$ids}}')" >/dev/null
  echo "✅ label → $target_label"
else
  echo "⚠️  no existe el label $target_label en el team — créalo en Linear"
fi

# ── EL CIERRE TIENE QUE CERRAR (#113) ─────────────────────────────────
# Este script se llama ticket-close y no cerraba nada: comentaba y movía un
# label. Medido en campo cerrando COR-944: el label `shipped` ni siquiera existía
# en el team de destino, así que el aviso de arriba salió, el script siguió, y el
# "cierre" no dejó NINGUNA marca de estado. El ticket quedó exactamente igual que
# antes, con una tarea entera shippeada y desplegada detrás.
#
# La señal real de cierre en Linear es el ESTADO, no un label: los labels son
# convención de cada team y pueden no existir, mientras que todo team tiene un
# estado de tipo `completed` porque el propio Linear lo exige.
#
# Solo en `shipped`. Un `failed` vuelve a agent-ready para que alguien lo retome,
# y moverle el estado ahí sería decidir una política de triage que este script no
# tiene por qué tener.
if [ "$STATUS" = "shipped" ]; then
  # `type` y no el nombre: "Done", "Completado", "Shipped" y "Merged" son todos
  # nombres legítimos del mismo estado, y elegir por nombre es adivinar el idioma
  # del team. Entre varios completed gana el de menor `position`, que es el que
  # Linear muestra primero.
  state_id="$(gql "$(jq -n --arg t "$team_id" '{query:"query($t:String!){ team(id:$t){ states{ nodes{ id name type position } } } }", variables:{t:$t}}')" \
    | jq -r '[.data.team.states.nodes[] | select(.type=="completed")] | sort_by(.position) | .[0].id // empty')"
  if [ -n "$state_id" ]; then
    ok="$(gql "$(jq -n --arg id "$uuid" --arg s "$state_id" '{query:"mutation($id:String!,$s:String!){ issueUpdate(id:$id, input:{stateId:$s}){ success } }", variables:{id:$id, s:$s}}')" \
      | jq -r '.data.issueUpdate.success // false')"
    if [ "$ok" = "true" ]; then
      echo "✅ estado → completado (la marca de cierre que un label no da)"
    else
      echo "⚠️  no pude mover el estado a completado: el ticket queda comentado y etiquetado, pero ABIERTO"
    fi
  else
    echo "⚠️  el team no declara ningún estado de tipo 'completed': no hay a dónde cerrar."
    echo "   El ticket queda comentado y etiquetado, pero ABIERTO. No lo doy por cerrado."
  fi
fi
