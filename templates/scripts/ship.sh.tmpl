#!/usr/bin/env bash
# ship.sh — ÚNICA puerta de salida a main. Los agentes piden shippear;
# este script decide. Determinista, cero tokens en el camino verde.
#
# Uso: ship.sh <task-id> <repo>
#      ship.sh --precheck <task-id> <repo>
#
# --precheck corre los MISMOS gates mecánicos (lenguaje, seguridad, tests no
# debilitados) sobre el worktree, SIN veredicto, sin lock y sin push. Existe
# por una razón de velocidad medida: un review que se cae por un test roto o
# un lint quema una ronda completa de reviewer (10-20 min de reloj) para
# decir lo que un script dice en segundos y gratis. El implementer lo corre
# antes de entregar; /review no lanza a nadie si el precheck no está verde.
# Deja el sello en tasks/<task>/precheck-<repo>.json (commit + ok).
#
# Opera sobre el WORKTREE de la tarea (worktrees/<task>/<repo>), nunca
# sobre el clon canónico. Serie solo lo que tiene orden real:
# rebase → trailer → carril. Después, los gates independientes corren EN
# PARALELO (lenguaje+buf ∥ gitleaks+semgrep ∥ tests-no-debilitados ∥
# veredicto+evidencia+policy) y se reportan TODOS los rojos juntos — un
# solo prompt de fix con todo, en vez de descubrirlos ronda por ronda.
# Al final, en serie otra vez: lock → push.
#
# Portabilidad: bash 3.2 (macOS), BSD grep. Sin flock (lock por mkdir).
set -euo pipefail

PRECHECK=0
LANG_ONLY=0
CI_MODE=0
case "${1:-}" in
  --precheck)   PRECHECK=1; shift ;;
  # Modo interno: corre SOLO los gates de lenguaje y sale. Existe para que
  # evidence.py pueda ejecutarlos como un comando y sellar su salida contra el
  # commit exacto (ver run_lang_gates_sealed). No es parte de la interfaz.
  --lang-gates) LANG_ONLY=1; shift ;;
  # ── MODO CI: los MISMOS gates, sobre un checkout pelado ─────────────
  # Existe para que la cola de merge del forge corra la verificacion en infra
  # NEUTRAL en vez de en la laptop del que pushea. Con varias personas, "los
  # sistemas deterministas verifican" es cierto solo hasta la laptop menos
  # actualizada del equipo: cualquiera puede editar su ship.sh local.
  #
  # Corre el MISMO codigo a proposito. Un workflow que reimplemente los gates
  # se desincroniza del harness en la primera version, y entonces CI y local
  # dicen cosas distintas sobre el mismo commit, que es peor que no tener CI.
  #
  # Lo que NO hace: veredicto, evidencia, lock, push ni fases. Nada de eso
  # existe en un checkout de CI, y fingirlo seria inventar.
  --ci)         CI_MODE=1; shift ;;
esac
if [ "$CI_MODE" -eq 1 ]; then
  TASK="${HARNESS_CI_TASK:-ci}"
  REPO="${1:-$(basename "$(pwd)")}"
  WS="$(cd "$(dirname "$0")/.." && pwd)"
  WT="$(pwd)"
else
TASK="${1:?uso: ship.sh [--precheck|--ci] <task-id> <repo>}"
REPO="${2:?uso: ship.sh [--precheck] <task-id> <repo>}"
WS="$(cd "$(dirname "$0")/.." && pwd)"
WT="$WS/worktrees/$TASK/$REPO"
fi

BASE="$WS/repos/$REPO"
# ── DOS PRESUPUESTOS QUE NO TIENEN NADA QUE VER ───────────────────────
# Antes los dos salían de {{LOOP_BUDGET}}, que son las RONDAS DE REVIEW (juicio
# de LLM). Perder una carrera de push contra otro workspace no es una ronda de
# review: es contención mecánica, y con varias personas pusheando al mismo
# trunk es rutina. Con loop_budget=3, tres movimientos de main en una ventana
# ocupada agotaban el "presupuesto" y escalaban a humano sin que nada
# estuviera roto.
PUSH_RETRY_BUDGET="${HARNESS_PUSH_RETRIES:-20}"
# Backoff con JITTER: sin él, N workspaces que pierden la misma carrera
# reintentan en fase y se vuelven a pisar (manada). El jitter los desincroniza.
PUSH_BACKOFF_MAX="${HARNESS_PUSH_BACKOFF_MAX:-30}"
# El flujo a main que el humano eligió en la entrevista. Este script SOLO
# implementa trunk direct-to-prod: hace `git push origin HEAD:$BASE_REF`. Las
# otras dos respuestas (trunk-staging, prs) se ofrecían, se registraban en
# harness-answers.yaml, y NADIE las leía, así que quien eligió "prs" por
# política de su empresa recibía commits directos a main, en silencio.
#
# Se falla CERRADO y no se finge: implementar PRs o staging cambia también
# lo que significa "shippeado" para deploy-watch y para /archive, y hacerlo
# a medias produciría un archive que fusiona specs de un cambio que sigue
# sin mergear. Mientras tanto, el que configuró otra cosa se entera acá y
# no en producción.
FLOW="{{FLOW}}"
# La grafía varía (la entrevista ofrecía "trunk direct-to-prod" y el answers
# documenta "trunk-direct-to-prod"), así que se normaliza en vez de exigir una
# forma exacta. Un placeholder sin sustituir o vacío se trata como trunk: es
# lo que este script hace y lo que hacen todas las instancias de hoy, y un
# placeholder crudo es un problema de generación que le toca al doctor, no un
# motivo para frenar un ship.
flow_norm="$(printf '%s' "$FLOW" | tr 'A-Z' 'a-z' | tr -d ' +_-')"
case "$flow_norm" in
  trunk|trunkdirecttoprod|""|'{{flow}}') FLOW_MODE=trunk ;;
  prs|pr) FLOW_MODE=prs ;;
  *)
    echo "❌ harness-answers.yaml declara flow: $FLOW, y ship.sh implementa dos:"
    echo "   'trunk' (push directo tras los gates) y 'prs' (rama + PR)."
    echo "   NO voy a pushear a espaldas de una política que dice otra cosa."
    echo "   ↳ opciones: cambiá flow a 'trunk' o a 'prs', o abrí el PR a mano"
    echo "     desde la rama task/<id> tras un --precheck verde."
    exit 7 ;;
esac
LOCKDIR="$WS/locks/$REPO.lock.d"
[ "$CI_MODE" -eq 1 ] || mkdir -p "$WS/locks" "$WS/tasks/$TASK"

[ -d "$WT" ] || { echo "❌ no existe el worktree $WT"; echo "   ↳ remediación: scripts/worktree-task.sh $TASK $REPO"; exit 2; }
# En CI no hay clon canonico: el checkout ES el repo, y de ahi salen tanto el
# diff como la baseline de buf. Exigir repos/<repo> ahi seria pedir un layout
# de workspace que un runner de CI no tiene por que tener.
if [ "$CI_MODE" -eq 1 ]; then
  BASE="$WT"
else
  [ -d "$BASE/.git" ] || { echo "❌ no existe el clon base $BASE"; exit 2; }
fi
# ── LA RAMA TRUNK NO SIEMPRE SE LLAMA "main" ──────────────────────────
# Catorce ocurrencias de origin/$BASE_REF en este archivo y seis en
# worktree-task.sh daban por hecho el nombre. Cualquier repo con `master`,
# `trunk` o `develop` (todo GitHub/GitLab pre-2021 sin migrar) moría en la
# creación del worktree con "invalid reference", y de paso block-direct-push
# tampoco protegía esas ramas porque solo bloqueaba `main`.
#
# La técnica correcta ya estaba en el repo: skills-sync.sh resuelve la rama
# por defecto con origin/HEAD desde siempre.
base_branch() {  # base_branch [dir] → la rama trunk del repo, sin prefijo
  local d="${1:-.}" b
  # OJO con `[ ... ] && cmd` bajo `set -e`: si la condición es falsa el
  # AND-list devuelve 1 y MATA el script. Lo aprendimos acá mismo: el
  # precheck salía con exit 128 sin imprimir una línea. Se usa `if`.
  if [ -n "${HARNESS_BASE_BRANCH:-}" ]; then printf '%s' "$HARNESS_BASE_BRANCH"; return 0; fi
  b="$(git -C "$d" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')"
  [ -n "$b" ] || b=main
  printf '%s' "$b"
}
BASE_REF="$(base_branch "$WT")"

# LA RAMA BASE SE VALIDA, NO SE SUPONE. Varios gates comparan contra
# `origin/$BASE_REF` (tests no debilitados, carril, migraciones nuevas) y todos
# envuelven su git en `|| true` para tolerar un repo sin cambios. Si la ref no
# existe, git falla, el `|| true` se lo traga, el diff sale VACÍO y los gates
# pasan en verde SIN HABER MIRADO NADA. Reproducido: con una rama base falsa,
# el precheck imprimía "✅ precheck verde".
#
# Es el mismo patrón que venimos persiguiendo, y aquí desarma justo el gate
# anti-trampa, así que se comprueba una vez, temprano y fuerte.
if ! git -C "$WT" rev-parse --verify --quiet "origin/$BASE_REF" >/dev/null 2>&1; then
  git -C "$WT" fetch origin --quiet 2>/dev/null || true      # worktree stale
  if ! git -C "$WT" rev-parse --verify --quiet "origin/$BASE_REF" >/dev/null 2>&1; then
    echo "❌ no existe la rama base 'origin/$BASE_REF' en $WT."
    echo "   NO puedo correr los gates que comparan contra el trunk: verían un"
    echo "   diff vacío y pasarían en verde sin mirar nada. Eso sería peor que"
    echo "   fallar, así que fallo."
    echo "   ↳ remediación: git -C $WT fetch origin"
    echo "     o exportá HARNESS_BASE_BRANCH con el nombre correcto"
    echo "     (detectado: '$BASE_REF'; ramas remotas: $(git -C "$WT" branch -r 2>/dev/null | tr -d ' ' | tr '\n' ' '))"
    exit 2
  fi
fi

# El bus: lo que este gate decide se cuenta. Fail-open — si emit.sh no está,
# ship.sh funciona igual (el bus es observación, no control).
# shellcheck source=/dev/null
[ -f "$WS/scripts/emit.sh" ] && . "$WS/scripts/emit.sh" || emit() { :; }

# Instrumentación en UN solo punto: si estamos empezando un gate, el anterior
# pasó. El trap sabe cuál falló. Cero riesgo de olvidarse de instrumentar uno.
gate() {
  [ -n "${CURRENT_GATE:-}" ] && [ "$CURRENT_GATE" != "preflight" ] \
    && emit gate "$CURRENT_GATE" true
  echo "── gate: $1 ──"; CURRENT_GATE="$1"
}

# El error de un gate es un PROMPT: al fallar cualquier gate, el trap
# imprime la instrucción de autocorrección (el agente que lee esto
# arregla en una iteración, sin adivinar). También libera el lock.
CURRENT_GATE="preflight"; LOCK_HELD=""
stamp_precheck() {  # stamp_precheck <ok:true|false>: sello que /review lee
  local ok="$1" head
  head="$(git -C "$WT" rev-parse HEAD 2>/dev/null || echo unknown)"
  printf '{"schema":1,"task_id":"%s","repo":"%s","commit":"%s","ok":%s,"at":"%s"}\n' \
    "$TASK" "$REPO" "$head" "$ok" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    > "$WS/tasks/$TASK/precheck-$REPO.json"
}
# ── Procedencia: qué harness, de qué máquina, con qué gates ───────────
# Con varios workspaces, los gates corren en la laptop del que pushea y NADA
# en el remoto compartido dice cuál de ellos, con qué versión ni con qué set de
# reglas. Un workspace atrasado (o retocado) shippea con gates más débiles y su
# commit en main queda indistinguible de los demás.
#
# Una git note lo deja auditable DESDE EL REMOTO sin reescribir la historia
# (que rompería el patch_id y de paso el trailer). Es best-effort a propósito:
# no poder anotar la procedencia no es motivo para deshacer un push que ya
# pasó todos los gates. La solución de fondo es correr los gates en CI
# (flow: prs), donde este problema deja de existir por construcción.
stamp_provenance() {  # stamp_provenance <sha-completo>
  local sha="$1" ver="?" man="?" who
  # `if` y no `[ ... ] && VAR=...`: es la regla de la casa por el set -e, y ya
  # costó un exit 128 sin una línea de salida en este mismo archivo.
  if [ -f "$WS/harness-answers.yaml" ]; then
    ver="$(awk -F'"' '/^harness_version:/ {print $2; exit}' "$WS/harness-answers.yaml" 2>/dev/null || echo "?")"
  fi
  # El digest del set de templates vive en `.harness-templates` de la INSTANCIA,
  # que es lo que escribe el generador. `templates/MANIFEST.sha256` es la ruta
  # del repo del PLUGIN y en una instancia no existe: leerla de ahí habría
  # dejado siempre "?" y la nota de procedencia no habría servido para lo único
  # que existe, distinguir un workspace atrasado de uno al día.
  if [ -f "$WS/.harness-templates" ]; then
    man="$(tr -d ' \n' < "$WS/.harness-templates" 2>/dev/null | cut -c1-16 || echo "?")"
  fi
  who="$(id -un 2>/dev/null || echo "?")@$(hostname -s 2>/dev/null || echo "?")"
  git notes --ref=harness add -f -m "harness_version: $ver
gates_manifest: $man
workspace: $who
task: $TASK" "$sha" >/dev/null 2>&1 || return 0
  git push origin refs/notes/harness >/dev/null 2>&1 \
    || echo "   ℹ️  procedencia anotada localmente; no pude publicarla (git push origin refs/notes/harness)"
}

# ── LA FASE LA REGISTRA EL HECHO, NO EL RECORDATORIO ──────────────────
# `review → ship` era prosa en el prompt de /ship y de /auto. Si el orquestador
# se la olvidaba (y se la olvidaba), state.json quedaba en `review` con el
# codigo ya en main: quien auditara por el estado reconstruia una historia
# falsa, y un /auto <task-id> posterior re-entraba a revisar algo publicado.
# Verificado en dos corridas reales.
#
# POLICY-SHIP-004 ya encierra la condicion correcta (no se avanza hasta que
# TODOS los repos con veredicto shippearon), asi que esto se intenta despues de
# cada repo y solo prospera en el ultimo. La regla no se duplica aca.
#
# FAIL-OPEN A PROPOSITO: el push YA ocurrio. Si la contabilidad falla, el cambio
# esta igual de publicado, y salir en rojo aqui diria que el ship fallo cuando
# no fallo. Se avisa fuerte y se sigue.
request_ship_phase() {
  local out rc=0
  [ -f "$WS/tasks/$TASK/state.json" ] || return 0
  out="$(python3 "$WS/scripts/harness-policy.py" --policy "$WS/harness-policy.json" \
        transition "$WS/tasks/$TASK" ship --actor ship.sh 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "   fase: review → ship (la registró el push, no el prompt)"
    return 0
  fi
  case "$out" in
    *POLICY-SHIP-004*)
      echo "   fase: sigue en review, faltan repos por shippear (es lo correcto)" ;;
    *POLICY-TRANSITION-001*)
      echo "   fase: ya estaba avanzada, no la muevo" ;;
    *)
      echo "   ⚠️  no pude registrar la fase: $(printf '%s' "$out" | head -1)"
      echo "      El push SÍ ocurrió. Registrala a mano o el estado va a mentir." ;;
  esac
  return 0
}

on_exit() {
  local rc=$?
  # El marcador se escribe DESDE EL TRAP, no después de llamar a run_lang_gates.
  # Es la unica forma de conservar `set -e` sobre los gates: cualquier
  # construccion tipo `run_lang_gates || rc=$?` DESACTIVA set -e dentro de la
  # funcion, y entonces un `pytest` que falla no aborta, los gates siguientes
  # corren igual y la funcion devuelve 0. Reproducido: el precheck imprimia
  # "verde" con la suite rota Y sellaba evidencia con exit_code 0.
  if [ "${LANG_ONLY:-0}" -eq 1 ]; then
    printf '%s' "${TESTS_RAN:-0}" > "$WS/tasks/$TASK/.langseen-$REPO" 2>/dev/null || true
  fi
  [ -n "$LOCK_HELD" ] && rm -rf "$LOCKDIR"
  if [ "$rc" -eq 0 ]; then
    [ -n "${CURRENT_GATE:-}" ] && emit gate "$CURRENT_GATE" true
    return 0
  fi
  if [ "$PRECHECK" -eq 1 ] && [ "${CI_MODE:-0}" -eq 0 ]; then
    stamp_precheck false
    emit gate "precheck de $REPO rojo ($CURRENT_GATE): ronda de review AHORRADA" false
    echo ""
    echo "⛔ precheck rojo en '$CURRENT_GATE' (exit $rc). NO entregues a review."
    echo "   → Los errores completos están arriba. Corrígelos TODOS en una"
    echo "     iteración (el error de cada gate trae su remediación) y re-corre"
    echo "     scripts/ship.sh --precheck $TASK $REPO."
    echo "   → Esto NO consume presupuesto de loop: el reviewer todavía no vio nada."
    return 0
  fi
  # UN GATE QUE BLOQUEA ES LA MEJOR NOTICIA DEL SISTEMA: es la prueba de que el
  # harness frena a su propio agente. Se cuenta igual de fuerte que un éxito.
  emit gate "$CURRENT_GATE — BLOQUEÓ el ship de $REPO (exit $rc)" false
  echo ""
  echo "⛔ gate '$CURRENT_GATE' falló (exit $rc)."
  echo "   → Lee el error de arriba. Corrige SOLO eso en el worktree $WT,"
  echo "     commitea con el trailer 'Task: $TASK' y re-corre ship.sh."
  echo "   → Presupuesto de autofix: 2 rondas. Si esta es la tercera, PARA"
  echo "     y escala a humano con el error completo (Ley 6)."
}
trap on_exit EXIT

# ── Lock por repo: merge queue de pobre, portable (sin flock) ─────────
# Dos ventanas de muerte que hay que cerrar (las dos costaron un lock inmortal):
#   1. mkdir OK → SIGKILL → pid nunca escrito. El reclamo de huérfanos exigía
#      [ -f pid ], así que un lock sin pid no era reclamable por NADIE: todo
#      ship futuro de ese repo esperaba 10 min y moría, para siempre, hasta que
#      un humano hiciera rm -rf. Reproducido antes de arreglarlo.
#   2. mkdir OK → fallo → el trap corría con LOCK_HELD vacío y no limpiaba.
#      LOCK_HELD se marca AHORA justo después del mkdir, no después del pid.
pid_alive() {  # pid_alive <pid> → 0 vivo · 1 muerto · 2 no se pudo saber
  # `kill -0` falla en TRES casos y antes se leían todos como "muerto":
  #   · el proceso no existe          → muerto de verdad
  #   · el pid está vacío o corrupto  → NO se pudo saber
  #   · EPERM: existe pero es de otro usuario → está VIVO, y liberar su lock
  #     mete dos ships concurrentes en el mismo repo
  # Ante la duda se conserva el lock: esperar de más cuesta minutos, robarlo
  # cuesta una carrera de rebase contra main.
  case "${1:-}" in ''|*[!0-9]*) return 2 ;; esac
  if kill -0 "$1" 2>/dev/null; then return 0; fi
  # EPERM: el proceso EXISTE pero es de otro usuario, o sea que está VIVO. El
  # texto varía por shell e idioma ("Operation not permitted", "permission
  # denied", "no permitido"), así que se normaliza a minúsculas y se cubren
  # las formas conocidas. Ante un mensaje que no reconocemos, se devuelve
  # "no se pudo saber" (2), no "muerto": el sesgo va siempre a conservar.
  err="$(kill -0 "$1" 2>&1 || true)"
  low="$(printf '%s' "$err" | tr 'A-Z' 'a-z')"
  case "$low" in
    *"not permitted"*|*permission*|*permitida*|*permitido*|*permiso*) return 0 ;;
    *"no such process"*|*"no existe"*|*"proceso"*) return 1 ;;
    "") return 1 ;;
    *) return 2 ;;
  esac
}
acquire_lock() {
  local waited=0 nopid=0
  until mkdir "$LOCKDIR" 2>/dev/null; do
    if [ -f "$LOCKDIR/pid" ]; then
      # lock huérfano: el proceso dueño ya no existe
      lpid="$(cat "$LOCKDIR/pid" 2>/dev/null)"
      # `pid_alive "$lpid"; alive_rc=$?` MATABA EL SCRIPT. pid_alive devuelve 1
      # (muerto) o 2 (ilegible) como valores de DATO, no como error, pero es una
      # sentencia suelta en el cuerpo del until y ahi `set -e` si aplica: con un
      # lock huerfano el script salia con exit 1 sin imprimir una linea, el trap
      # lo reportaba como "preflight", y como LOCK_HELD estaba vacio el lock
      # SOBREVIVIA. O sea que todo el camino de reclamo era codigo muerto y el
      # repo quedaba trabado para siempre hasta un rm -rf a mano. Reproducido.
      # Con `if` el valor se lee sin que errexit lo confunda con un fallo.
      if pid_alive "$lpid"; then alive_rc=0; else alive_rc=$?; fi
      if [ "$alive_rc" -eq 1 ]; then
        echo "⚠️  lock huérfano de pid $lpid (proceso inexistente); lo reclamo"
        rm -rf "$LOCKDIR"; nopid=0; continue
      elif [ "$alive_rc" -eq 2 ]; then
        echo "⚠️  el pid del lock es ilegible ('$lpid'): NO lo reclamo. 'No pude"
        echo "   mirar' no es 'está muerto'. Si el dueño de verdad murió:"
        echo "   rm -rf $LOCKDIR"
      fi
      nopid=0
    else
      # Sin pid: o el dueño está EN la ventana de adquisición (microsegundos),
      # o murió dentro de ella y el lock quedó inmortal. Damos gracia; si a los
      # 15s sigue sin pid, no hay dueño vivo que lo vaya a escribir.
      nopid=$((nopid+1))
      if [ "$nopid" -ge 15 ]; then
        echo "⚠️  lock sin pid tras 15s — huérfano de una muerte en la ventana de adquisición; lo reclamo"
        rm -rf "$LOCKDIR"; nopid=0; continue
      fi
      sleep 1; continue
    fi
    waited=$((waited+3))
    [ "$waited" -ge 600 ] && { echo "❌ lock de $REPO ocupado >10min ($LOCKDIR) — otro ship en curso"; exit 6; }
    sleep 3
  done
  LOCK_HELD=1                 # ANTES del pid: si morimos ahora, el trap limpia
  echo $$ > "$LOCKDIR/pid"
}

# ── Gates ─────────────────────────────────────────────────────────────
gate_trailer() {
  gate "trailer Task: $TASK"
  local total with_trailer
  total=$(git rev-list --count origin/$BASE_REF..HEAD)
  [ "$total" -gt 0 ] || { echo "❌ no hay commits nuevos sobre origin/$BASE_REF"; exit 3; }
  with_trailer=$(git log origin/$BASE_REF..HEAD --format=%B | grep -cE "^Task: $TASK\$" || true)
  [ "$with_trailer" -ge "$total" ] || {
    echo "❌ $((total-with_trailer)) de $total commits sin trailer 'Task: $TASK'"
    echo "   ↳ remediación: git rebase origin/$BASE_REF --exec 'git commit --amend --no-edit --trailer \"Task: $TASK\"'"
    exit 3
  }
}

# gate_lane — el carril lo declara el intake; el diff lo confirma este gate.
# express prometió: un solo repo (implícito: el worktree ES un repo), cero
# contratos, cero migraciones, cero infra. Si el diff rompe la promesa, el
# ship no pasa: la tarea escala de carril y re-entra por /rfc. Equivocarse
# de carril cuesta una re-entrada — jamás un ship sin la deliberación que
# tocaba. Por esto los carriles no relajan la seguridad: la clasificación
# del intake es una propuesta; este gate es quien la verifica.
gate_lane() {
  gate "carril (lane)"
  local st="$WS/tasks/$TASK/state.json" lane
  lane="$(jq -r '.lane // "full"' "$st" 2>/dev/null || echo full)"
  [ "$lane" = "express" ] || return 0
  local pat="${LANE_GUARD_PATTERN:-(\.proto\$|(^|/)proto/|(^|/)migrations?/|\.sql\$|(^|/)helm/|(^|/)charts/|(^|/)terraform/|(^|/)openapi\.|(^|/)swagger\.)}"
  local hits
  hits="$(git diff origin/$BASE_REF..HEAD --name-only | grep -E "$pat" || true)"
  if [ -n "$hits" ]; then
    echo "❌ carril express, pero el diff toca contratos/migraciones/infra:"
    echo "$hits" | sed 's/^/   · /'
    echo "   ↳ remediación: este cambio SÍ necesita deliberación. Escala el carril:"
    echo "     python3 scripts/harness-policy.py escalate tasks/$TASK --to standard --actor orchestrator"
    echo "     y corre /rfc $TASK — el trabajo hecho se conserva en el worktree."
    exit 3
  fi
}

run_lang_gates() {
  # ¿Reconocimos el stack de este repo? Si al final sigue en 0, el gate no
  # verificó NADA, y eso tiene que verse: era el silencio más caro del script.
  LANG_SEEN=0
  # ── "RECONOCI EL STACK" NO ES "CORRI TESTS" ─────────────────────────
  # El sello de evidencia usaba LANG_SEEN como prueba de que algo se verifico,
  # y LANG_SEEN solo dice que se encontro un marcador (go.mod, pyproject...).
  # Un repo con pyproject.toml pero sin pytest instalado tenia LANG_SEEN=1 y
  # cero tests corridos: se acuñaba un EV-TEST que decia "este arbol pasa la
  # suite" sin que ninguna suite hubiera corrido. TESTS_RAN mide lo que el
  # sello afirma, que es lo unico honesto que puede medir.
  TESTS_RAN=0
  if [ -f go.mod ]; then
    # UN COMANDO POR LINEA, NUNCA `A && B`: bajo set -e una AND-list que falla
    # NO aborta (set -e se ignora en todo comando de una lista AND-OR que no
    # sea el ultimo), asi que la funcion seguia y devolvia 0. O sea que un
    # `go test` en rojo salia VERDE del gate. Reproducido; era el silencio mas
    # caro que quedaba, y afectaba a seis stacks.
    gate go
    go vet ./...
    go build ./...
    go test ./...
    TESTS_RAN=1
    LANG_SEEN=1
  fi
  # Go FUERA de la raíz. Caso de campo: repo con package.json en la raíz y
  # toda la lógica de orquestación en controller/ con su go.mod; la rama de
  # arriba solo mira la raíz, así que los tests Go jamás corrían en el
  # precheck y en cada ronda hubo que sellar evidencia a mano. Cada go.mod es
  # un módulo autocontenido: el gate corre POR subdirectorio. Profundidad
  # acotada (2 niveles) y sin vendored: un go.mod de vendor/ no es un stack.
  local gomod gomoddir
  for gomod in $(git ls-files '*/go.mod' 2>/dev/null \
      | grep -v -E '(^|/)(vendor|node_modules|third_party|testdata)/' \
      | awk -F/ 'NF<=3'); do
    gomoddir="${gomod%/go.mod}"
    LANG_SEEN=1
    gate "go ($gomoddir)"
    ( cd "$gomoddir"
      go vet ./...
      go build ./...
      go test ./... )
    TESTS_RAN=1
  done
  # Repo TS cuyo package.json NO está en la raíz (monorepo, apps/, packages/):
  # el bloque entero se saltaba EN SILENCIO, el precheck salía verde y el
  # commit roto viajaba hasta el gate de ship. Un gate que no encuentra qué
  # verificar tiene que decirlo, no ausentarse.
  if [ ! -f package.json ] && git ls-files '*/package.json' 2>/dev/null | grep -q .; then
    gate ts
    echo "⛔ el gate ts NO PUEDE CORRER: $REPO no tiene package.json en la raíz,"
    echo "   pero sí en subdirectorios:"
    git ls-files '*/package.json' 2>/dev/null | head -5 | sed 's/^/     · /'
    echo "   Hasta ahora esto se saltaba en silencio: ni typecheck ni tests, y el"
    echo "   precheck salía verde igual."
    echo "   ↳ remediación: declara un package.json en la raíz con scripts typecheck"
    echo "     y test que deleguen a los paquetes (npm -w, pnpm -r, turbo, lo que use)."
    exit 3
  fi
  if [ -f package.json ]; then
    LANG_SEEN=1
    gate ts
    # UN GATE QUE NO PUEDE CORRER NO REPORTA ROJO. Misma regla que import-linter
    # y go-arch-lint abajo, que ya la respetan: si falta la herramienta se dice,
    # no se finge un veredicto. Aquí faltaba.
    #
    # CASO REAL: el worktree nace de origin/$BASE_REF, o sea SIN node_modules y sin
    # los tipos que genera `astro sync`. tsc no ve los ambientes y escupe
    # errores que PARECEN deuda vieja (import.meta.env, astro:assets). Fueron 8
    # errores fantasma, un intento de landing perdido, y CERO líneas de código
    # que tocar: con las deps instaladas el gate pasó solo. Un rojo falso no
    # cuesta una ronda nada más, enseña al agente a desconfiar de los gates.
    # PREPARAR NO ES VERIFICAR, y por eso esto se puede hacer solo.
    #
    # ship.sh verifica y no actúa: un gate que "arregla" el código que juzga
    # deja de ser un gate. Pero instalar dependencias no toca el artefacto que
    # se shippea, es la condición para poder mirarlo. La frontera se sostiene
    # con una PRUEBA, no con una promesa: después de preparar, el árbol
    # VERSIONADO tiene que estar idéntico. Si el install movió el lockfile o
    # cualquier archivo trackeado, eso ya no fue preparar y el gate se niega.
    #
    # Antes esto era una negativa que te devolvía el trabajo a vos. La
    # remediación era mecánica y siempre la misma, así que pedirla era una
    # parada de ceremonia: el humano corría dos comandos y el gate pasaba sin
    # tocar una línea de código.
    if [ ! -d node_modules ] || { ls astro.config.* >/dev/null 2>&1 && [ ! -f .astro/types.d.ts ]; }; then
      before="$(git status --porcelain -uno -- . | sort)"
      if [ ! -d node_modules ]; then
        echo "→ preparo la toolchain: faltan node_modules (worktree recién creado)"
        bash "$WS/scripts/fe.sh" 'install' "$REPO" "$TASK" >/dev/null 2>&1 || true
        # Verifico que la preparación FUNCIONÓ. Dar por hecho que un comando
        # hizo lo suyo es la misma fe ciega que este gate existe para evitar.
        if [ ! -d node_modules ]; then
          echo "⛔ el gate ts NO PUEDE CORRER: no pude instalar las dependencias de $REPO."
          echo "   Sin ellas los errores de tipos serían fantasma (faltan los .d.ts"
          echo "   de las deps), no deuda real del cambio."
          echo "   ↳ remediación: bash scripts/fe.sh 'install' $REPO $TASK"
          exit 3
        fi
      fi
      if ls astro.config.* >/dev/null 2>&1 && [ ! -f .astro/types.d.ts ]; then
        echo "→ preparo la toolchain: falta .astro/types.d.ts (lo genera astro sync)"
        npx astro sync >/dev/null 2>&1 || true
        if [ ! -f .astro/types.d.ts ]; then
          echo "⛔ el gate ts NO PUEDE CORRER: 'astro sync' no generó .astro/types.d.ts."
          echo "   Ese archivo declara astro:assets e import.meta.env; sin él, tsc los"
          echo "   reporta como errores fantasma."
          echo "   ↳ remediación: (cd $WT && npx astro sync) y mirá qué dice"
          exit 3
        fi
      fi
      after="$(git status --porcelain -uno -- . | sort)"
      if [ "$before" != "$after" ]; then
        echo "⛔ preparar la toolchain modificó archivos VERSIONADOS de $REPO:"
        printf '%s\n' "$after" | head -5 | sed 's/^/     · /'
        echo "   Eso ya no es preparar: es cambiar el artefacto que este gate juzga,"
        echo "   y ahí me detengo. Suele ser un lockfile desincronizado del package.json."
        echo "   ↳ remediación: corre el install en el worktree, revisá el diff y"
        echo "     commiteálo como parte del cambio si corresponde."
        exit 3
      fi
      echo "  ✅ toolchain lista (sin tocar archivos versionados), sigo con el gate"
    fi
    # EL TYPECHECK DEL REPO MANDA SOBRE EL NUESTRO. `tsc --noEmit` no es el
    # typecheck de todo proyecto TS: uno de Astro se chequea con `astro check`
    # (tsc solo ve una parte y no mira los .astro), y un monorepo con `tsc -b`.
    # Si el repo declara cómo se chequea, se usa eso.
    checked=0
    if   jq -e '.scripts.typecheck'     package.json >/dev/null 2>&1; then npm run typecheck; checked=1
    elif jq -e '.scripts["check:types"]' package.json >/dev/null 2>&1; then npm run check:types; checked=1
    elif jq -e '.scripts.check'         package.json >/dev/null 2>&1; then npm run check; checked=1
    elif [ -f tsconfig.json ]; then npx tsc --noEmit; checked=1          # gate DURO: sin || true
    fi
    # Es TypeScript y no encontramos cómo chequearlo. Eso NO es un verde: es
    # justo el agujero por el que llegó un commit roto hasta el gate de ship.
    if [ "$checked" -eq 0 ] \
       && jq -e '.devDependencies.typescript // .dependencies.typescript' package.json >/dev/null 2>&1; then
      echo "⛔ $REPO trae typescript como dependencia pero el gate no encontró cómo typechequearlo:"
      echo "   sin tsconfig.json en la raíz y sin script typecheck / check:types / check."
      echo "   Hasta ahora esto pasaba EN SILENCIO y el precheck salía verde."
      echo "   ↳ remediación: declara en package.json el script que ya usás para chequear"
      echo "     tipos (\"typecheck\": \"astro check\" / \"tsc --noEmit\" / \"tsc -b\")."
      exit 3
    fi
    # `npm test --if-present` se callaba cuando NO había script test: un repo
    # sin tests salía verde sin decir una palabra. El silencio de un
    # verificador se lee igual que un verde.
    if jq -e '.scripts.test' package.json >/dev/null 2>&1; then
      npm test
      TESTS_RAN=1
    else
      echo "⚠️  $REPO no declara script 'test' en package.json: el gate ts NO corrió tests."
      echo "   No lo bloqueo (puede ser legítimo), pero que quede dicho: este gate"
      echo "   verificó tipos y nada más."
    fi
  fi
  if [ -f pyproject.toml ]; then
    LANG_SEEN=1
    gate python
    # RUFF Y PYTEST SON DEPENDENCIAS DEL PROYECTO, NO DEL SISTEMA. `uv sync`
    # los deja en .venv/bin, o sea FUERA del PATH: llamarlos pelados da
    # `command not found` y exit 127, y ningun repo Python podia shippear
    # (issue #29, reportado por el propio harness). La linea de pytest ya
    # pasaba por `uv run`; la de ruff no, y esa asimetria era todo el bug.
    #
    # Y si no hay NI uv NI la herramienta en el PATH, no se finge un veredicto:
    # se dice que ese tramo no se verifico, igual que hacen gitleaks,
    # import-linter y los seis stacks que pasan por need(). Un 127 rojo enseña
    # a desconfiar del gate tanto como un verde falso.
    #
    # PERO `command -v uv` NO CONTESTA LA PREGUNTA QUE IMPORTA (issue #30).
    # Con uv instalado y ruff ausente del venv, `uv run ruff` sale 2 ("Failed
    # to spawn: ruff") y bajo `set -e` eso mata el gate ANTES de llegar al
    # else honesto: la rama que explica cómo arreglarlo era inalcanzable justo
    # cuando hacía falta, y el usuario veía un exit 2 pelado. La pregunta no es
    # "¿existe uv?" sino "¿corre esta herramienta?", y eso se contesta
    # corriéndola una vez, no deduciéndolo.
    py_tool() {  # py_tool <bin> → cómo invocarlo, o nada si no corre
      if command -v uv >/dev/null && uv run "$1" --version >/dev/null 2>&1; then
        printf 'uv run %s' "$1"
      elif command -v "$1" >/dev/null; then
        printf '%s' "$1"
      fi
    }
    RUFF="$(py_tool ruff)"
    PYTEST="$(py_tool pytest)"
    if [ -n "$RUFF" ]; then
      # ── ruff: RATCHET, la misma forma que buf lint (issue #31) ───────
      # ship.sh ya declaraba el principio abajo, en el gate de buf ("la deuda
      # preexistente no secuestra shipping ajeno") y lo aplicaba a UN solo
      # linter. El otro, ruff, bloqueaba con todo: medido en un repo real, 144
      # violaciones heredadas en main dejaban a TODA tarea de ese repo sin
      # poder llegar a review ni a main, aunque no tocara una sola de las 144.
      # Un gate que castiga por deuda ajena se termina desactivando, y ahí se
      # pierde también lo que sí servía.
      #
      # La baseline es un checkout de origin/$BASE_REF, no el clon canónico:
      # ruff lintea un ÁRBOL DE TRABAJO, no una ref, y repos/<repo> puede estar
      # en otra rama o sucio. buf puede darse el lujo de leer el clon porque
      # compara refs; acá haría comparar contra un árbol cualquiera.
      py_lint() {  # py_lint <dir> → "archivo\tcódigo\tmensaje" ordenado
        local root; root="$(cd "$1" && pwd -P)"
        # Se invoca SIEMPRE desde el worktree (ahí está el venv que uv resuelve)
        # y se le pasa el árbol a mirar: ruff toma la config del árbol linteado.
        # Salir 1 es "encontré violaciones", no "fallé": no puede abortar nada.
        $RUFF check --output-format json "$root" 2>/dev/null \
          | jq -r --arg r "$root/" '.[] | [(.filename | ltrimstr($r)), .code, .message] | @tsv' 2>/dev/null \
          | sort || true
      }
      py_base="$(mktemp -d)"
      if git -C "$WT" worktree add --detach --quiet "$py_base/base" "origin/$BASE_REF" 2>/dev/null; then
        py_main_lint="$(py_lint "$py_base/base")"
      else
        echo "⚠️  no pude sacar un checkout de origin/$BASE_REF para la baseline de ruff."
        echo "   Sin baseline no hay ratchet: bloqueo con TODA la deuda, y lo digo."
        py_main_lint=""
      fi
      py_head_lint="$(py_lint .)"
      git -C "$WT" worktree remove --force "$py_base/base" 2>/dev/null || true
      rm -rf "$py_base"
      py_new_lint="$(comm -13 <(printf '%s' "$py_main_lint") <(printf '%s' "$py_head_lint"))"
      if [ -n "$py_new_lint" ]; then
        echo "❌ ruff: violaciones NUEVAS introducidas por este cambio:"
        printf '%s\n' "$py_new_lint" | awk -F'\t' '{print "   " $1 ": " $2 " " $3}'
        echo "   ↳ remediación: corrige SOLO estas (la deuda preexistente de $BASE_REF no bloquea)"
        exit 3
      fi
      if [ -n "$py_main_lint" ]; then
        echo "⚠️  ruff: $(printf '%s\n' "$py_main_lint" | grep -c .) violaciones PREEXISTENTES en $BASE_REF (no bloquean; candidatas al ratchet-keeper)"
      fi
    else
      echo "⚠️  $REPO es Python pero no encuentro ruff (ni uv que sepa invocarlo): el lint NO CORRIÓ."
      echo "   ↳ instalá uv y corré 'uv sync --extra dev' (ruff tiene que quedar EN el venv),"
      echo "     o poné ruff en el PATH."
      emit assumption "$REPO (Python): lint NO ejecutado, falta ruff/uv"
    fi
    if [ -n "$PYTEST" ]; then
      $PYTEST -q
      TESTS_RAN=1
    else
      echo "⚠️  $REPO es Python pero no encuentro pytest (ni uv que sepa invocarlo): los tests NO CORRIERON."
      echo "   ↳ instalá uv y corré 'uv sync --extra dev' (pytest tiene que quedar EN el venv),"
      echo "     o poné pytest en el PATH."
      emit assumption "$REPO (Python): tests NO ejecutados, falta pytest/uv"
    fi
  fi
  if [ -f pubspec.yaml ]; then
    gate flutter
    flutter analyze
    flutter test
    TESTS_RAN=1
    LANG_SEEN=1
  fi
  # ── Stacks que faltaban ───────────────────────────────────────────────
  # Hasta aquí el gate solo reconocía Go, Node, Python y Dart. Un repo Rust,
  # Java, Ruby, PHP, .NET o Elixir no tenía rama: el precheck salía VERDE con
  # el build roto y ship.sh lo pushaba a main sin compilar ni testear, sin
  # decir una palabra. Para un instalador que se dice universal, ese era el
  # agujero más grande (regla 8 de CONTRIBUTING).
  #
  # Cada uno sigue la regla de la casa: si el marcador está pero la toolchain
  # no, se dice, no se finge un veredicto.
  need() {  # need <bin> <stack>: ¿está la toolchain? si no, avisa honesto
    command -v "$1" >/dev/null && return 0
    echo "⚠️  $REPO es $2 pero '$1' no está instalado: ese gate NO CORRIÓ."
    emit assumption "$REPO ($2) NO compilado ni testeado: falta '$1' en el PATH"
    return 1
  }
  if [ -f Cargo.toml ]; then
    LANG_SEEN=1
    if need cargo Rust; then gate rust; cargo build --locked; cargo test; TESTS_RAN=1; fi
  fi
  if [ -f pom.xml ]; then
    LANG_SEEN=1
    if need mvn Java-Maven; then gate java-maven; mvn -B -q verify; TESTS_RAN=1; fi
  fi
  if [ -f build.gradle ] || [ -f build.gradle.kts ]; then
    LANG_SEEN=1
    if [ -x ./gradlew ]; then gate java-gradle; ./gradlew --quiet build; TESTS_RAN=1
    elif need gradle Java-Gradle; then gate java-gradle; gradle --quiet build; TESTS_RAN=1; fi
  fi
  if [ -f Gemfile ]; then
    LANG_SEEN=1
    if need bundle Ruby; then
      gate ruby
      if [ -f Rakefile ]; then bundle exec rake; TESTS_RAN=1
      elif [ -d spec ]; then bundle exec rspec; TESTS_RAN=1
      else echo "⚠️  $REPO es Ruby pero no tiene Rakefile ni spec/: no encontré qué correr"
           emit assumption "$REPO (Ruby) sin suite reconocible: el gate no corrió tests"; fi
    fi
  fi
  if [ -f composer.json ]; then
    LANG_SEEN=1
    if need composer PHP; then
      gate php
      if [ -f phpunit.xml ] || [ -f phpunit.xml.dist ]; then
        composer install --no-interaction --quiet
        vendor/bin/phpunit
        TESTS_RAN=1
      else
        echo "⚠️  $REPO es PHP sin phpunit.xml: no encontré qué correr"
        emit assumption "$REPO (PHP) sin config de phpunit: el gate no corrió tests"
      fi
    fi
  fi
  if ls ./*.sln ./*.csproj >/dev/null 2>&1; then
    LANG_SEEN=1
    if need dotnet dotNET; then gate dotnet; dotnet build --nologo -v q; dotnet test --nologo -v q; TESTS_RAN=1; fi
  fi
  if [ -f mix.exs ]; then
    LANG_SEEN=1
    if need mix Elixir; then gate elixir; mix compile --warnings-as-errors; mix test; TESTS_RAN=1; fi
  fi
  # ── Terraform: lo único que valida ANTES del auto-apply ──────────────
  # Caso de campo: los repos de infra pasaban el precheck sin verificar NADA
  # (caían al aviso de stack no reconocido, que no bloquea) y son justo los
  # que auto-aplican producción al mergear. Para un repo infra este es el
  # único gate entre un typo de HCL y el apply. Detección espejo de
  # discover.sh: *.tf en la raíz o subdirs hasta profundidad 4.
  local tf_files tf_dir
  tf_files="$(git ls-files '*.tf' 2>/dev/null \
    | grep -v -E '(^|/)\.terraform/' | awk -F/ 'NF<=4' || true)"
  if [ -n "$tf_files" ]; then
    LANG_SEEN=1
    if need terraform Terraform; then
      gate terraform
      # fmt es recursivo desde la raíz: una pasada cubre todos los subdirs.
      terraform fmt -check -recursive
      # init/validate van POR directorio con .tf (cada uno es un root/módulo).
      for tf_dir in $(printf '%s\n' "$tf_files" \
          | awk -F/ '{ if (NF == 1) print "."; else { sub("/[^/]*$", ""); print } }' \
          | sort -u); do
        echo "  → terraform validate: $tf_dir"
        ( cd "$tf_dir"
          terraform init -backend=false -input=false >/dev/null
          terraform validate )
      done
      # validate NO es una suite: TESTS_RAN queda como esté, igual que squawk
      # y buf. El sello de evidencia no puede afirmar "corrí tests" porque un
      # HCL parseó.
    fi
  fi
  # Gates de arquitectura y SQL: la CONFIG del repo es el opt-in (sin config,
  # silencio). Con config presente son gates duros — igual que go/ts. Config
  # sin herramienta instalada = warning honesto, no un gate fingido.
  if [ -f .importlinter ] || grep -q '\[tool\.importlinter\]' pyproject.toml 2>/dev/null; then
    if command -v lint-imports >/dev/null; then gate "import-linter"; lint-imports
    else echo "⚠️  config de import-linter presente pero lint-imports no instalado — gate saltado"; fi
  fi
  if [ -f .go-arch-lint.yml ]; then
    if command -v go-arch-lint >/dev/null; then gate "go-arch-lint"; go-arch-lint check
    else echo "⚠️  .go-arch-lint.yml presente pero go-arch-lint no instalado — gate saltado"; fi
  fi
  # squawk: lint de migraciones SQL NUEVAS del diff (las viejas no se re-litigan)
  # La migración manda, no la herramienta: primero se mira el diff y DESPUÉS
  # si hay con qué lintearlo. Al revés, sin squawk instalado el bloque entero
  # se saltaba en silencio y un ALTER bloqueante llegaba a prod por el mismo
  # agujero que squawk existe para cerrar. import-linter y go-arch-lint, sus
  # vecinos de arriba, ya avisaban honestamente; este era el único que no.
  local migs
  migs="$(git diff origin/$BASE_REF..HEAD --name-only --diff-filter=A | grep -E '(^|/)migrations?/.*\.sql$' || true)"
  if [ -n "$migs" ]; then
    if command -v squawk >/dev/null; then
      gate "squawk (migraciones)"; squawk $migs
    else
      echo "⚠️  este cambio agrega migraciones SQL y squawk NO está instalado:"
      printf '%s\n' "$migs" | sed 's/^/     · /'
      echo "   NO se lintearon: un ALTER bloqueante o un índice sin CONCURRENTLY"
      echo "   pasaría sin que nadie lo vea. Instalá squawk (npm i -g squawk-cli)."
      emit assumption "migraciones de $REPO NO lintadas: squawk no está instalado"
    fi
  fi
  if [ -f buf.yaml ]; then
    LANG_SEEN=1
    gate buf
    # LA BASELINE TAMBIÉN ENVEJECE. `--against` lee los refs del clon canónico
    # (repos/<repo>), que solo se refrescan cuando alguien corre pull-all.sh,
    # mientras que el worktree se fetchea en CADA ship. Con varias personas
    # pusheando al mismo trunk, los dos "main" divergen en minutos y este gate
    # empieza a comparar contra un pasado: puede acusar como NUEVAS violaciones
    # que ya están en main, o dejar pasar un breaking real contra el main de
    # verdad. Un fetch acá cuesta segundos y vale la comparación entera.
    git -C "$BASE" fetch origin --quiet 2>/dev/null \
      || echo "⚠️  no pude refrescar la baseline de $REPO (offline): buf compara contra los refs locales de repos/$REPO, que pueden estar atrás"
    # breaking: SIEMPRE duro (--against apunta al gitdir del clon base)
    buf breaking --against "$BASE/.git#branch=origin/$BASE_REF"
    # lint: RATCHET — solo violaciones NUEVAS respecto a main bloquean.
    # La deuda preexistente no secuestra shipping ajeno (la baja el
    # ratchet-keeper con su propio ciclo). Se ignoran números de línea
    # para tolerar corrimientos.
    norm() { jq -c 'del(.start_line,.end_line,.start_column,.end_column)' 2>/dev/null | sort; }
    head_lint="$(buf lint --error-format=json 2>/dev/null | norm || true)"
    main_lint="$(cd "$BASE" && buf lint --error-format=json 2>/dev/null | norm || true)"
    new_lint="$(comm -13 <(printf '%s' "$main_lint") <(printf '%s' "$head_lint"))"
    if [ -n "$new_lint" ]; then
      echo "❌ buf lint: violaciones NUEVAS introducidas por este cambio:"
      echo "$new_lint" | jq -r '"   \(.path): \(.message)"' 2>/dev/null || echo "$new_lint"
      echo "   ↳ remediación: corrige SOLO estas (la deuda preexistente de main no bloquea)"
      exit 3
    fi
    [ -n "$main_lint" ] && echo "⚠️  buf lint: $(printf '%s\n' "$main_lint" | grep -c .) violaciones PREEXISTENTES en main (no bloquean; candidatas al ratchet-keeper)"
  fi

  # EL SILENCIO MÁS CARO: si ningún marcador matcheó, este gate no compiló ni
  # testeó NADA y hasta hoy salía verde igual. Un repo docs o de contratos
  # puede no tener stack legítimamente, así que no se bloquea, pero deja de
  # pasar callado: queda como supuesto arriba del resumen de sesión.
  if [ "$LANG_SEEN" -eq 0 ]; then
    echo "⚠️  no reconozco el stack de $REPO: este gate NO compiló ni testeó nada."
    echo "   Marcadores que busco: go.mod (raíz o subdirs, prof. 2),"
    echo "   package.json, pyproject.toml, pubspec.yaml, Cargo.toml, pom.xml,"
    echo "   build.gradle, Gemfile, composer.json, *.csproj/*.sln, mix.exs,"
    echo "   buf.yaml y *.tf (raíz o subdirs, prof. 4)."
    echo "   Si este repo SÍ se construye, agregá su rama en run_lang_gates:"
    echo "   un eje sin implementación es un vendor cableado (CONTRIBUTING #8)."
    emit assumption "$REPO NO compilado ni testeado: run_lang_gates no reconoce su stack"
  fi
}

# ── La corrida de gates de lenguaje, SELLADA como evidencia ───────────
# POR QUÉ: la suite completa se corría CUATRO veces por tarea sin un solo
# rework: (1) el precheck del implementer, (2) su evidence.py run, (3) el QA
# determinista, (4) este gate en el ship. Las cuatro sobre el mismo código.
# run_lang_gates ya compila, typechequea y corre la suite; sellar SU salida es
# evidencia real y no cuesta una corrida extra.
#
# En SHIP el sello importa por otra razón además: tras el rebase el árbol es
# otro (trae los commits ajenos que aterrizaron) y ninguna prueba anterior
# habla de él. Esta es la única que sí.
#
# No afloja la separación de roles, la refuerza: hasta ahora la única prueba la
# producía el implementer, que es parte interesada; ahora el verificador
# determinista produce la suya. `implementation_agents` sigue saliendo del
# veredicto, y verdict-scaffold.sh excluye a "ship" de ese campo para que un
# ship previo no pueda contaminarlo.
run_lang_gates_sealed() {
  local runner dirty
  # En CI no hay tasks/<id>/ ni veredicto al que atar una evidencia, y sellar
  # contra un directorio inventado dejaria un EV que no respalda nada. Los
  # gates corren igual; lo que no corre es el sello.
  if [ "${CI_MODE:-0}" -eq 1 ]; then run_lang_gates; return $?; fi
  if [ "${PRECHECK:-0}" -eq 1 ]; then
    runner="${HARNESS_EVIDENCE_RUNNER:-implementer}"
  else
    runner="ship"
  fi
  # La evidencia exige árbol limpio (evidence.py se niega, y con razón: sellar
  # con cambios sin commitear certifica código que no es el que corrió). En
  # precheck eso es normal a mitad de trabajo, así que se degrada a la corrida
  # de siempre y se DICE: no sellar es perder una comodidad, fingir un sello
  # sería perder la prueba.
  dirty="$(git -C "$WT" status --porcelain -uno 2>/dev/null || echo "?")"
  if [ -n "$dirty" ]; then
    if [ "${PRECHECK:-0}" -eq 1 ]; then
      echo "→ árbol con cambios sin commitear: corro los gates SIN sellar evidencia"
      echo "  (commitea y re-corre el precheck para que el sello salga de acá y"
      echo "   no tengas que correr la suite otra vez con evidence.py)"
    else
      # En SHIP un arbol sucio no es "a mitad de trabajo": es un problema que va
      # a explotar dos pasos mas adelante (sin evidencia fresca el gate de
      # frescura falla, y el rebase del proximo intento se niega). Decirlo aca
      # ahorra descubrirlo por un mensaje que habla de otra cosa.
      echo "⚠️  el worktree tiene cambios SIN COMMITEAR sobre archivos versionados:"
      printf '%s\n' "$dirty" | head -5 | sed 's/^/     /'
      echo "   NO puedo sellar evidencia contra un commit con el árbol así, y el"
      echo "   rebase del próximo intento se va a negar por lo mismo. Suele ser un"
      echo "   artefacto que los tests reescriben y que el repo versiona por error."
    fi
    run_lang_gates
    return $?
  fi
  if [ ! -f "$WS/scripts/evidence.py" ]; then
    run_lang_gates; return $?
  fi
  echo "→ gates de lenguaje sellados como evidencia (runner: $runner)"
  # El nombre del gate especifico (python, go, buf...) lo pone `gate()` DENTRO
  # del proceso hijo, asi que el subshell de este slot no lo ve: al fallar
  # reportaba `gate '' falló`, un mensaje sin sujeto. Se nombra el tramo acá
  # para que el rojo del padre diga de que habla; el detalle fino sigue en la
  # salida del hijo, que se imprime completa.
  CURRENT_GATE="gates de lenguaje de $REPO"
  local out evrc=0
  out="$(python3 "$WS/scripts/evidence.py" run \
    --task-dir "$WS/tasks/$TASK" --repo "$REPO" --runner "$runner" \
    --kind test --cwd "$WT" \
    -- bash "$WS/scripts/ship.sh" --lang-gates "$TASK" "$REPO" 2>&1)" || evrc=$?

  # ── UN SELLO QUE NO PROBÓ NADA ES PEOR QUE NO TENER SELLO ───────────
  # Si run_lang_gates no reconoció el stack, no compiló ni testeó NADA, y aun
  # así acuñaríamos un EV-TEST con exit_code 0. Ese manifiesto es justo el que
  # satisface `--require-fresh-kind test`, o sea que el gate de frescura
  # pasaría sin que ningún test haya corrido: el verde silencioso exacto que
  # este archivo persigue en todos lados. Se borra y se declara.
  #
  # Y el anuncio va DESPUÉS de la decisión: esto imprimía EVIDENCE_ID= y dos
  # líneas más abajo decía que no sellaba. Caso de campo: cuatro agentes
  # distintos parsearon ese stdout y se llevaron un ID que apuntaba a
  # archivos ya borrados, y el fallo apareció recién en el ship.
  local evid
  evid="$(printf '%s\n' "$out" | sed -n 's/^EVIDENCE_ID=//p' | tail -1)"
  if [ "$(cat "$WS/tasks/$TASK/.langseen-$REPO" 2>/dev/null || echo 1)" = "0" ] && [ -n "$evid" ]; then
    rm -f "$WS/tasks/$TASK/evidence/$evid.json" "$WS/tasks/$TASK/evidence/$evid.log"
    printf '%s\n' "$out" | grep -v '^EVIDENCE_ID=' || true
    echo "⚠️  NO sello evidencia de $REPO: ninguna suite de tests llegó a correr"
    echo "   (stack no reconocido, o su herramienta de test no está). Un EV-TEST"
    echo "   de una corrida sin tests diría"
    echo "   'este árbol pasa la suite' sin que ninguna suite haya corrido."
    emit assumption "$REPO sin evidencia de test: ninguna suite llegó a correr"
  else
    printf '%s\n' "$out"
  fi
  return $evrc
}

run_security_gates() {
  # gitleaks es una CAPACIDAD ELEGIBLE en la entrevista, no un supuesto. Sin
  # guarda, la instancia que no lo palomeó tenía TODO precheck y TODO ship en
  # rojo con exit 127, y el bootstrap tampoco lo instalaba porque no fue
  # elegido: un bucle sin salida. Su vecino semgrep ya estaba guardado.
  if command -v gitleaks >/dev/null; then
    gate gitleaks
    # detect sobre el rango real a pushear (protect --staged es no-op aquí)
    gitleaks detect --no-banner --log-opts="origin/$BASE_REF..HEAD"
  else
    echo "⚠️  gitleaks no instalado: el gate de secretos NO CORRIÓ en $REPO."
    echo "   Esto no es un verde: es un tramo sin verificar. Si elegiste gitleaks,"
    echo "   instálalo (bash scripts/bootstrap.sh); si no, quítalo de tu política."
    emit assumption "secretos de $REPO NO escaneados: gitleaks no está instalado"
  fi
  if [ -f "$WS/semgrep/rules.yaml" ]; then
    gate semgrep
    semgrep scan --config "$WS/semgrep/rules.yaml" --error --quiet .
  fi
}

# gate_tests_untouched — el gate confía en el test suite; el test suite es un
# archivo que el agente puede editar. Sin este gate, la forma MÁS BARATA de
# pasar a verde no es arreglar el código: es debilitar el test (SWE-Bench+:
# ~31% de parches "exitosos" pasaban por tests débiles).
#
# v2, con las lecciones de campo: (1) cuenta LLAMADAS reales de aserción
# (una línea de import con la palabra expect o un comentario con asserted ya
# no cuentan); (2) contabilidad NETA por archivo: una línea MOVIDA aparece en
# el lado - y en el +, neto 0; un move entre archivos de test (suma global
# <= 0, sin skips ni borrados) pasa con aviso; (3) el escape exige DECLARAR:
# el delta-spec debe nombrar CADA archivo debilitado DENTRO de una sección
# MODIFIED/REMOVED (escribir la palabra en la prosa ya no abre nada).
#
# Residuales conscientes (rúbrica del reviewer, no de este gate): borrar
# filas de una tabla Go table-driven, y reemplazos tautológicos
# (expect(true).toBe(true)). -M explícito en TODOS los git diff: sin él, un
# rename cuenta como D+A según la config diff.renames del usuario.
gate_tests_untouched() {
  gate "tests no debilitados"
  local pat="${TEST_PATH_PATTERN:-(test|spec|Test|_test\.|\.test\.|\.spec\.|/tests?/|/spec/)}"
  # ARTEFACTOS COMPILADOS NO SON TESTS. El patron de arriba matchea por RUTA, y
  # `/tests?/` atrapa todo lo que cuelgue de tests/, incluidos los .pyc de
  # __pycache__. Borrar esos archivos (por ejemplo al dejar de versionarlos, que
  # es lo correcto) se leia como "test BORRADO sin declarar" y bloqueaba el ship.
  # Un falso positivo aca cuesta una ronda y ensena a desconfiar del gate.
  # Ninguno de estos puede contener una asercion, asi que se excluyen por nombre.
  local artifacts="${TEST_ARTIFACT_PATTERN:-(__pycache__/|\.pyc$|\.pyo$|\.class$|\.pytest_cache/|/node_modules/)}"
  local touched
  touched="$(git diff -M origin/$BASE_REF..HEAD --name-status \
    | awk -F'\t' '{ for (i = 2; i <= NF; i++) print $i }' \
    | grep -E "$pat" | grep -vE "$artifacts" | sort -u || true)"
  [ -n "$touched" ] || return 0

  local deleted
  deleted="$(git diff -M origin/$BASE_REF..HEAD --diff-filter=D --name-only \
    | grep -E "$pat" | grep -vE "$artifacts" || true)"

  # UN pase del diff completo en awk (BSD-safe: sin \b ni \s; gsub cuenta
  # OCURRENCIAS, no líneas). Salida: "<aserciones_netas>\t<skips_netos>\t<archivo>".
  local report
  report="$(git diff -M origin/$BASE_REF..HEAD | TESTPAT="$pat" awk '
    BEGIN {
      pat  = ENVIRON["TESTPAT"]
      asrt = "assert[A-Za-z_]*[[:space:]]*\\(|assert\\.[A-Za-z_]+[[:space:]]*\\(" \
           "|(^|[^A-Za-z0-9_])assert[[:space:]]+[^=[:space:]]" \
           "|expect[[:space:]]*\\(|require\\.[A-Za-z]+\\(" \
           "|t\\.(Error|Fatal|FailNow|Run)|\\.should\\.|@Test" \
           "|(^|[^A-Za-z0-9_.])(it|test|describe)[[:space:]]*\\("
      skp  = "(^|[^A-Za-z0-9_.])(xit|xdescribe|xtest)[[:space:]]*\\(" \
           "|\\.skip[[:space:]]*\\(|\\.only[[:space:]]*\\(|@skip|@unittest\\.skip" \
           "|pytest\\.mark\\.skip|t\\.Skip|#\\[ignore\\]|@Disabled|@Ignore"
      cmnt = "^(//|/\\*|\\*|#[^[]|import[[:space:]]|from[[:space:]])"
    }
    function flush() {
      if (cur != "" && cur ~ pat && (na != 0 || ns != 0))
        printf "%d\t%d\t%s\n", na, ns, cur
      cur = ""; na = 0; ns = 0
    }
    /^diff --git / { flush(); minus = ""; next }
    /^--- /   { minus = $0; sub(/^--- /, "", minus)
                gsub(/^"|"$/, "", minus); sub(/^a\//, "", minus); next }
    /^\+\+\+ / { cur = $0; sub(/^\+\+\+ /, "", cur)
                gsub(/^"|"$/, "", cur); sub(/^b\//, "", cur)
                if (cur == "/dev/null") cur = minus; next }
    /^-/ { l = substr($0, 2); sub(/^[[:space:]]+/, "", l)
           if (l ~ cmnt) next
           if (l ~ skp) ns -= 1
           na += gsub(asrt, "", l); next }
    /^\+/ { l = substr($0, 2); sub(/^[[:space:]]+/, "", l)
            if (l ~ cmnt) next
            if (l ~ skp) ns += 1
            na -= gsub(asrt, "", l); next }
    END { flush() }
  ')"

  # La declaración legítima: contenido BAJO encabezados MODIFIED/REMOVED del
  # delta-spec, y debe nombrar el basename de CADA archivo debilitado.
  # En CI no existe tasks/<id>/: la declaracion de un test debilitado viaja
  # por env (el workflow suele volcar ahi el cuerpo del PR). Sin ninguna de
  # las dos, un debilitamiento BLOQUEA: no hay forma de declararlo, y el
  # sesgo correcto es fail-closed.
  local delta="${HARNESS_DELTA_SPEC_FILE:-$WS/tasks/$TASK/delta-spec.md}" declared=""
  [ -f "$delta" ] && declared="$(awk '
    /^#/ { insec = (toupper($0) ~ /(MODIFIED|REMOVED)/); next }
    insec { print }
  ' "$delta")"
  declares() { printf '%s\n' "$declared" | grep -qiF "$(basename "$1")"; }

  local bad=0 global_na=0 f na ns
  if [ -n "$deleted" ]; then
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      if declares "$f"; then
        echo "   ⚠️  test borrado y DECLARADO en el delta-spec: $f (queda en el registro)"
      else
        echo "   · test BORRADO sin declarar: $f"
        bad=1
      fi
    done <<DELEOF
$deleted
DELEOF
  fi
  if [ -n "$report" ]; then
    while IFS="$(printf '\t')" read -r na ns f; do
      [ -n "$f" ] || continue
      global_na=$((global_na+na))
      [ "$na" -gt 0 ] || [ "$ns" -gt 0 ] || continue
      if declares "$f"; then
        echo "   ⚠️  tests tocados y DECLARADOS en el delta-spec: $f"
        continue
      fi
      [ "$na" -gt 0 ] && echo "   · $f: $na aserciones netas eliminadas"
      [ "$ns" -gt 0 ] && echo "   · $f: $ns skips/only netos añadidos"
      bad=1
    done <<REPEOF
$report
REPEOF
    # move entre archivos de test: neto por archivo != 0 pero global <= 0 y
    # sin skips ni borrados: reorganizar suites es legítimo, no debilitar
    if [ "$bad" -eq 1 ] && [ "$global_na" -le 0 ] && [ -z "$deleted" ] \
       && ! printf '%s\n' "$report" | awk -F'\t' '$2 > 0 { found=1 } END { exit !found }'; then
      echo "   ⚠️  aserciones movidas ENTRE archivos de test (neto global $global_na): no es debilitamiento"
      bad=0
    fi
  fi
  [ "$bad" -eq 0 ] && return 0
  echo "❌ este cambio DEBILITA tests y el delta-spec no lo declara (archivos arriba):"
  echo "   ↳ remediación: los tests son el CONTRATO, no el obstáculo. Si el"
  echo "     comportamiento DEBE cambiar, decláralo en tasks/$TASK/delta-spec.md:"
  echo "     bajo '## MODIFIED Requirements' o '## REMOVED Requirements' la entrada"
  echo "     debe NOMBRAR cada archivo de test afectado. Si no, arregla el CÓDIGO"
  echo "     hasta que el test pase como está."
  exit 3
}

# gate_evidence — nuestra ley es "los agentes proponen, los sistemas
# deterministas verifican". La compliance matrix la ESCRIBE un agente: hasta
# ahora, el verificador proponía. Este gate no juzga el código; solo comprueba
# mecánicamente que el artefacto citado por cada requirement (a) existe y (b)
# fue REALMENTE leído (lo registra el hook track-read.sh). Es una intersección
# de conjuntos: cero LLM, cero opinión.
gate_evidence() {
  local v="$WS/tasks/$TASK/verdict-$REPO.json"
  jq -e 'has("compliance")' "$v" >/dev/null 2>&1 || return 0
  gate "evidencia de compliance"
  local log="$WS/tasks/$TASK/evidence.log"
  local missing=0 unread=0 art base
  while IFS= read -r art; do
    [ -n "$art" ] || continue
    # La cita puede traer el CASO además del archivo: tests/x.py::caso
    # (pytest), archivo.go:42, rango :10-20, Clase#metodo. Caso de campo:
    # cuatro ships frenados con el review correcto porque el -e se aplicaba
    # a la cadena entera y "tests/x.py::caso" jamás existe en disco. La
    # existencia se comprueba sobre la base (el archivo); la lectura acepta
    # ambas grafías, porque el log registra lo que el comando dijo.
    base="$(printf '%s' "$art" | sed -e 's/::.*$//' -e 's/#[A-Za-z_][A-Za-z0-9_]*$//' -e 's/:[0-9][0-9]*\(-[0-9][0-9]*\)*$//')"
    [ -n "$base" ] || base="$art"
    if [ ! -e "$WS/$base" ] && [ ! -e "$WT/$base" ]; then
      echo "   ✗ citado pero NO EXISTE: $art"; missing=$((missing+1)); continue
    fi
    if [ -f "$log" ] && { grep -qF -- "$art" "$log" || grep -qF -- "$base" "$log"; }; then :; else
      echo "   ✗ citado pero NADIE LO LEYÓ: $art"; unread=$((unread+1))
    fi
  done <<EOF
$(jq -r '.compliance[]? | select(.covered==true) |
  if (.tests? | type) == "array" then .tests[]
  else (.evidence_path // .test // empty) end' "$v" 2>/dev/null)
EOF
  if [ "$missing" -gt 0 ] || [ "$unread" -gt 0 ]; then
    echo "❌ la compliance matrix cita evidencia que no existe ($missing) o que nunca se leyó ($unread)"
    echo "   ↳ remediación: un requirement solo pasa a covered:true si el reviewer"
    echo "     ABRIÓ el artefacto que lo prueba (test, log, screenshot). Corre el"
    echo "     test, lee su salida, y cita la ruta real en .compliance[].evidence."
    echo "     'Confía en mí' no es evidencia — por eso existe este gate."
    echo "     Si operas el harness FUERA de Claude Code (sin el hook track-read),"
    echo "     el registro legítimo de una lectura real es:"
    echo "       bash scripts/mark-read.sh $TASK <ruta-del-artefacto>"
    exit 3
  fi
}

check_verdict() {
  gate "veredicto de review"
  local v="$WS/tasks/$TASK/verdict-$REPO.json" qa_state=""
  [ -f "$v" ] || { echo "❌ sin veredicto en $v"; echo "   ↳ remediación: corre /review $TASK $REPO primero"; exit 3; }
  # Dos condiciones, dos remediaciones opuestas: el review lo arregla el
  # implementer con los blocking; un qa:"pending" NO tiene blocking que
  # corregir: le falta correr la fase. Un mensaje único mandaba a leer una
  # lista vacía y quemaba una ronda, así que se diagnostican por separado.
  jq -e '.verdict=="pass"' "$v" >/dev/null \
    || { echo "❌ el review no es pass (verdict=$(jq -r '.verdict' "$v"))"
         echo "   ↳ remediación: corrige los $(jq '.blocking|length' "$v") items blocking listados en $v"
         echo "     (cada uno trae la suya) y re-corre /review $TASK $REPO"; exit 3; }
  jq -e '.qa=="pass"' "$v" >/dev/null \
    || { qa_state="$(jq -r '.qa' "$v")"
         echo "❌ QA no es pass (qa=$qa_state)"
         if [ "$qa_state" = "pending" ]; then
           echo "   ↳ el review pasó pero la fase QA nunca corrió. QA NO implica navegador:"
           echo "     · backend / criterios ya cubiertos por tests → QA determinista:"
           echo "       python3 scripts/evidence.py run --task-dir tasks/$TASK --repo $REPO \\"
           echo "         --runner qa --kind test --cwd worktrees/$TASK/$REPO -- <comando de test>"
           echo "     · frontend / criterios de cara al usuario → agente qa (Playwright)"
           echo "     Escribe el resultado en tasks/$TASK/qa-$REPO.json y re-corre /review"
           echo "     $TASK $REPO, que lo fusiona al veredicto (ver /review paso 1 y 3)."
         else
           echo "   ↳ remediación: QA encontró fallas; regrésalas al implementer como"
           echo "     blocking y re-corre QA sobre el HEAD nuevo (ver tasks/$TASK/qa-$REPO.json)"
         fi
         exit 3; }
  # ── UN `qa: "pass"` TIENE QUE TENER UN QA DETRAS ────────────────────
  # Hasta acá esto leía SOLO el campo del veredicto, o sea que la afirmación
  # más cara del pipeline ("alguien ejercitó el comportamiento") era palabra de
  # agente sin ningún artefacto que la respalde. Demostrado en una corrida real:
  # una tarea shippeó con qa:"pass", sin qa-<repo>.json y sin una sola evidencia
  # de runner=qa. La ley de la casa es que los agentes proponen y los sistemas
  # deterministas verifican; acá el verificador estaba proponiendo.
  #
  # Se acepta cualquiera de las dos formas que /review documenta: el artefacto
  # de la fase QA, o evidencia sellada con --runner qa. Lo que no se acepta es
  # ninguna de las dos.
  local qa_file="$WS/tasks/$TASK/qa-$REPO.json" qa_ev=0
  qa_ev="$(grep -l '"runner": *"qa"' "$WS/tasks/$TASK/evidence/"EV-*.json 2>/dev/null | wc -l | tr -d ' ')"
  if [ ! -f "$qa_file" ] && [ "${qa_ev:-0}" -eq 0 ]; then
    echo "❌ el veredicto dice qa=\"pass\" pero no hay NADA que lo respalde:"
    echo "   ni tasks/$TASK/qa-$REPO.json ni evidencia con --runner qa."
    echo "   ↳ remediación: corré la fase QA de verdad (ver /review paso 1 y 3):"
    echo "     · backend / criterios ya cubiertos por tests → QA determinista:"
    echo "       python3 scripts/evidence.py run --task-dir tasks/$TASK --repo $REPO \\"
    echo "         --runner qa --kind test --cwd worktrees/$TASK/$REPO -- <comando>"
    echo "     · frontend / cara al usuario → agente qa, y escribí qa-$REPO.json"
    echo "   Un pass de QA sin artefacto es la afirmación más cara del pipeline"
    echo "   sostenida por nada."
    exit 3
  fi

  # compliance: todo requirement del delta-spec cubierto por tests
  jq -e '(.requirements_uncovered // 0) == 0' "$v" >/dev/null \
    || { echo "❌ $(jq -r '.requirements_uncovered' "$v") requirements del delta-spec sin test que los proteja"
         echo "   ↳ remediación: escribe el test faltante (ver .compliance[] con covered:false en $v) o pide al humano una excepción explícita"; exit 3; }
}

# El veredicto no es una afirmación libre: policy v1 comprueba estado, rondas
# y separación de roles; evidence v1 liga cada resultado al HEAD exacto y al
# hash de su salida. Ambos validadores son stdlib Python y fail-closed.
gate_policy_and_evidence() {
  gate "policy + evidencia v1"
  local v="$WS/tasks/$TASK/verdict-$REPO.json"
  local head pid base_moved out reviewed
  head="$(git rev-parse HEAD)"

  # La identidad del CAMBIO (no la del commit). Con varias personas pusheando
  # al mismo trunk, el rebase de más abajo reescribe los SHA sin tocar el
  # contenido: exigir SHA idéntico tiraba el review y el QA por un movimiento
  # que el reviewer nunca miró. Ver scripts/change-id.sh.
  pid="$(bash "$WS/scripts/change-id.sh" "$WT" "$BASE_REF" 2>/dev/null || true)"

  # Cuánto avanzó la base desde lo que se revisó: el juicio caduca en el
  # tiempo, no solo en el texto. Best-effort (el commit viejo puede haber sido
  # recolectado); si no se puede medir, policy aplica solo la ventana temporal.
  base_moved=""
  reviewed="$(jq -r '.commit // ""' "$v" 2>/dev/null || true)"
  if [ -n "$reviewed" ] && git cat-file -e "$reviewed^{commit}" 2>/dev/null; then
    base_moved="$(git rev-list --count "$reviewed..origin/$BASE_REF" 2>/dev/null || true)"
  fi

  out="$(python3 "$WS/scripts/harness-policy.py" --policy "$WS/harness-policy.json" \
    validate-ship "$WS/tasks/$TASK" --commit "$head" --verdict "$v" \
    ${pid:+--patch-id "$pid"} ${base_moved:+--base-moved "$base_moved"})" || return 1
  printf '%s\n' "$out"

  # El commit revisado lo declara policy, no lo re-derivamos: dos derivaciones
  # del mismo hecho es una oportunidad de divergir.
  reviewed="$(printf '%s\n' "$out" | sed -n 's/^REVIEWED_COMMIT=//p' | tail -1)"
  [ -n "$reviewed" ] || reviewed="$head"

  # Los tipos exigidos salen del POLICY, no cableados acá. `required_evidence_kinds`
  # y `require_fresh_evidence` se declaraban en harness-policy.json y no los leía
  # nadie: editarlos no hacía nada, en silencio. Misma clase de perilla muerta
  # que `flow`, ya corregida arriba.
  local kinds kind kind_flags=""
  kinds="$(python3 "$WS/scripts/harness-policy.py" --policy "$WS/harness-policy.json" \
    evidence-policy --field required_evidence_kinds 2>/dev/null || echo test)"
  for kind in $kinds; do
    kind_flags="$kind_flags --require-kind $kind"
  done

  # La evidencia REVISADA se verifica acá, en paralelo con el resto: ya existe.
  # shellcheck disable=SC2086
  python3 "$WS/scripts/evidence.py" verify \
    --task-dir "$WS/tasks/$TASK" --repo "$REPO" --commit "$head" \
    --reviewed-commit "$reviewed" --verdict "$v" $kind_flags

  # La FRESCA no: la produce el slot `lang` de este mismo fan-out, y los slots
  # corren sin orden entre si. Exigirla acá era una carrera contra su propio
  # productor: verify (milisegundos) contra la suite (minutos), o sea un rojo
  # espurio "falta evidencia FRESCA" en el primer intento y un verde en el
  # segundo usando el sello del intento fallido. Se difiere al final, cuando el
  # wait ya garantizo que lang termino.
}

# Verificacion diferida de la evidencia FRESCA. Corre en SERIE, despues del wait
# de run_parallel_gates, que es la unica barrera que garantiza que el sello de
# `lang` ya existe. Se recalcula todo desde el veredicto y el policy en vez de
# heredarlo del slot: el subshell ya murio y su GDIR se borro.
gate_fresh_evidence() {
  local v="$WS/tasks/$TASK/verdict-$REPO.json" head reviewed want kinds kind flags=""
  [ -f "$v" ] || return 0
  head="$(git rev-parse HEAD)"
  reviewed="$(jq -r '.commit // ""' "$v" 2>/dev/null || true)"
  [ -n "$reviewed" ] || return 0
  if [ "$reviewed" = "$head" ]; then
    # "La citada YA es la fresca" solo vale si de verdad esta sellada en HEAD:
    # con la equivalencia por patch_id, un EV citado puede ser de OTRO sha del
    # mismo cambio, y entonces ninguna prueba citada toco este arbol.
    local id c all_at_head=1
    for id in $(jq -r '.evidence[]?' "$v" 2>/dev/null); do
      c="$(jq -r '.commit // ""' "$WS/tasks/$TASK/evidence/$id.json" 2>/dev/null || true)"
      [ "$c" = "$head" ] || { all_at_head=0; break; }
    done
    [ "$all_at_head" -eq 1 ] && return 0
  fi
  want="$(python3 "$WS/scripts/harness-policy.py" --policy "$WS/harness-policy.json" \
    evidence-policy --field require_fresh_evidence 2>/dev/null || echo true)"
  [ "$want" = "true" ] || return 0
  [ "$(cat "$WS/tasks/$TASK/.langseen-$REPO" 2>/dev/null || echo 1)" != "0" ] || {
    echo "⚠️  el árbol integrado de $REPO NO se pudo verificar: su stack no lo"
    echo "   reconoce ningún gate de lenguaje, así que no hay suite que correr"
    echo "   sobre el merge con los commits ajenos que aterrizaron."
    emit assumption "$REPO: merge result NO verificado (ninguna suite corrió) al reusar veredicto"
    return 0; }
  kinds="$(python3 "$WS/scripts/harness-policy.py" --policy "$WS/harness-policy.json" \
    evidence-policy --field required_evidence_kinds 2>/dev/null || echo test)"
  for kind in $kinds; do
    [ "$kind" = "test" ] && flags="$flags --require-fresh-kind $kind"
  done
  [ -n "$flags" ] || return 0
  gate "evidencia fresca del árbol integrado"
  # shellcheck disable=SC2086
  python3 "$WS/scripts/evidence.py" verify \
    --task-dir "$WS/tasks/$TASK" --repo "$REPO" --commit "$head" \
    --reviewed-commit "$reviewed" --verdict "$v" $flags
}

# ── Preflight del ship: lo HEAD-independiente, ANTES del lock ─────────
# Un veredicto roto (JSON reescrito, EV de otro cambio, qa pending) se
# descubría tras pagar lock + rebase + la suite completa EN PARALELO con el
# slot de veredicto, y el vecino que esperaba el lock moría de hambre a los
# 600s (exit 6). Todo esto se comprueba contra el commit del PROPIO
# veredicto, así que no depende del rebase: cuesta segundos y cero lock.
# NO es la autoridad: la corrida autoritativa es la fase 0 post-rebase (el
# rebase puede cambiar el patch_id o borrar un artefacto citado). Es un
# early-reject de cortesía, fail-closed igual.
gate_ship_preflight() {
  local v="$WS/tasks/$TASK/verdict-$REPO.json" vc kinds kind kind_flags=""
  echo "── preflight (sin lock): el veredicto se valida ANTES de retener nada ──"
  check_verdict
  gate_evidence
  vc="$(jq -r '.commit // ""' "$v" 2>/dev/null)"
  [ -n "$vc" ] || { echo "❌ el veredicto no declara commit"
    echo "   ↳ remediación: re-corre scripts/verdict-scaffold.sh $TASK $REPO"; exit 3; }
  gate "preflight: policy + evidencia contra el commit revisado"
  # validate-ship con --commit = verdict.commit: la rama de igualdad de
  # check_verdict_commit, así corren fase/estado/rondas/roles/pass-pass con
  # sus mensajes canónicos sin duplicar una línea de policy.
  python3 "$WS/scripts/harness-policy.py" --policy "$WS/harness-policy.json" \
    validate-ship "$WS/tasks/$TASK" --commit "$vc" --verdict "$v" >/dev/null
  kinds="$(python3 "$WS/scripts/harness-policy.py" --policy "$WS/harness-policy.json" \
    evidence-policy --field required_evidence_kinds 2>/dev/null || echo test)"
  for kind in $kinds; do kind_flags="$kind_flags --require-kind $kind"; done
  # shellcheck disable=SC2086
  python3 "$WS/scripts/evidence.py" verify \
    --task-dir "$WS/tasks/$TASK" --repo "$REPO" --commit "$vc" --verdict "$v" $kind_flags
  if [ -z "$(jq -r '.patch_id // ""' "$v" 2>/dev/null)" ]; then
    echo "⚠️  veredicto sin patch_id: si el trunk se movió, este ship exige SHA"
    echo "   exacto. Suele ser un reviewer que reescribió el JSON (ver reviewer.md)."
  fi
}

# ── Gates en paralelo ─────────────────────────────────────────────────
# Los grupos no comparten orden real entre sí (cada uno es read-only sobre
# el worktree o corre su propia toolchain); DENTRO de un grupo el orden se
# conserva (check_verdict antes que evidence). Cada grupo corre en subshell
# con su propio CURRENT_GATE y escribe su exit a un archivo: un rojo no
# oculta a los demás, y el implementer recibe TODOS los errores en un solo
# prompt de fix en vez de descubrirlos ronda por ronda.
#
# Y en DOS FASES: primero los baratos (subsegundo: tests-no-debilitados,
# veredicto, compliance, policy), después los caros (suites, scanners).
# Caso de campo: un requirements_uncovered=1 (200ms de jq) se descubría
# tras pagar una suite de 10 minutos que corría en paralelo.
GDIR=""; PAR_PIDS=""; PAR_SLOTS=""
par() {  # par <slot> <gate-fn>... — corre un grupo de gates en background
  local slot="$1"; shift
  (
    # PAR_SLOT: copia a scope de subshell. El trap EXIT de un subshell que
    # muere por set -e corre DESPUÉS de desmontar los locals de la función
    # (bash 3.2 y 5.x): referenciar $slot ahí es unbound variable.
    PAR_SLOT="$slot"
    CURRENT_GATE=""
    group_exit() {
      local rc=$?
      if [ "$rc" -eq 0 ]; then
        [ -n "${CURRENT_GATE:-}" ] && emit gate "$CURRENT_GATE" true
      else
        emit gate "$CURRENT_GATE — BLOQUEÓ el ship de $REPO (exit $rc)" false
        echo "⛔ gate '$CURRENT_GATE' falló (exit $rc)"
      fi
      echo "$rc" > "$GDIR/$PAR_SLOT.rc"
    }
    trap group_exit EXIT
    local fn; for fn in "$@"; do "$fn"; done
  ) > "$GDIR/$slot.out" 2>&1 &
  PAR_PIDS="$PAR_PIDS $!"
  PAR_SLOTS="$PAR_SLOTS $slot"
}

close_serial_gate() {
  # cierra el gate serial anterior (mismo contrato que gate())
  [ -n "${CURRENT_GATE:-}" ] && [ "$CURRENT_GATE" != "preflight" ] \
    && emit gate "$CURRENT_GATE" true
  CURRENT_GATE=""
}

collect_gate_slots() {  # collect_gate_slots <etiqueta>: espera, imprime TODO, agrega
  local pid slot rc failed=""
  for pid in $PAR_PIDS; do wait "$pid" 2>/dev/null || true; done
  for slot in $PAR_SLOTS; do
    cat "$GDIR/$slot.out"
    rc="$(cat "$GDIR/$slot.rc" 2>/dev/null || echo 1)"
    [ "$rc" -eq 0 ] || failed="$failed $slot"
  done
  rm -rf "$GDIR"; PAR_PIDS=""; PAR_SLOTS=""
  if [ -n "$failed" ]; then
    CURRENT_GATE="$1:$failed"
    echo "❌ gates rojos ($1):$failed — TODOS los errores están arriba. Corrige TODO"
    echo "   en UNA iteración (cada gate trae su remediación) y re-corre ship.sh."
    exit 3
  fi
}

run_phase0_gates() {
  close_serial_gate
  GDIR="$(mktemp -d "${TMPDIR:-/tmp}/ship-gates.XXXXXX")"
  PAR_PIDS=""; PAR_SLOTS=""
  # En precheck no hay veredicto todavía (ese es justamente el punto: correr
  # lo mecánico ANTES de gastar una ronda de reviewer). Los slots del
  # veredicto van SEPARADOS: dentro de uno solo, set -e aborta en el primer
  # die y se perdería el "todos los rojos juntos".
  if [ "${PRECHECK:-0}" -eq 1 ]; then
    echo "── fase 0: gates baratos: tests (sin veredicto: precheck) ──"
  else
    echo "── fase 0: gates baratos: tests ∥ veredicto ∥ compliance ∥ policy ──"
  fi
  par tests gate_tests_untouched
  if [ "${PRECHECK:-0}" -ne 1 ]; then
    par veredicto   check_verdict
    par compliance  gate_evidence
    par policy      gate_policy_and_evidence
  fi
  collect_gate_slots "fase 0 (ninguna suite corrió: esto costó segundos)"
}

run_parallel_gates() {
  close_serial_gate
  GDIR="$(mktemp -d "${TMPDIR:-/tmp}/ship-gates.XXXXXX")"
  PAR_PIDS=""; PAR_SLOTS=""
  echo "── gates caros en paralelo: lang ∥ security ──"
  par lang      run_lang_gates_sealed
  par security  run_security_gates
  collect_gate_slots "gates paralelos"
}

# ── Modo interno --lang-gates ─────────────────────────────────────────
# Va acá, después de TODAS las definiciones de función, porque bash resuelve
# funciones en tiempo de ejecución. Sin lock, sin rebase, sin veredicto:
# solo la corrida que evidence.py va a sellar.
if [ "$LANG_ONLY" -eq 1 ]; then
  cd "$WT"
  # SIN `|| rc=$?` NI NADA QUE LO ENVUELVA: eso desactivaria `set -e` dentro de
  # run_lang_gates y un gate rojo dejaria de abortar. El exit de esta invocacion
  # ES el veredicto que evidence.py sella, asi que tiene que ser el de verdad.
  # El marcador de "verifique algo" lo escribe el trap on_exit, que corre pase
  # lo que pase.
  run_lang_gates
  exit 0
fi

# ── Modo CI: los gates mecánicos sobre el checkout actual ─────────────
# Mismo codigo que el precheck, sin nada que dependa del workspace. Es lo que
# la cola de merge del forge ejecuta como required check.
if [ "$CI_MODE" -eq 1 ]; then
  cd "$WT"
  echo "══ gates del harness sobre $REPO (modo CI) ══"
  echo "   base: origin/$BASE_REF · commit: $(git rev-parse --short HEAD)"
  # PRECHECK=1 hace que la fase 0 omita los slots de veredicto (que aqui no
  # existen) y que el sellado de evidencia no intente escribir en tasks/.
  # Se reusa esa bandera en vez de inventar una tercera.
  PRECHECK=1
  run_phase0_gates
  run_parallel_gates
  echo "✅ gates verdes sobre el merge result. Este check es el que la cola de"
  echo "   merge exige, y corre en infra neutral: no depende de la laptop de nadie."
  exit 0
fi

# ── Precheck: los gates mecánicos ANTES de gastar una ronda de review ─
# Sin lock (no toca main), sin rebase (no reescribe la historia del
# implementer) y sin veredicto. Solo responde una pregunta: ¿este worktree
# pasaría hoy los gates que no dependen de juicio humano ni de review?
#
# TRAILER Y CARRIL TAMBIÉN VAN ACÁ. Antes vivían SOLO en el camino de ship, o
# sea que un commit sin `Task:` o un express que tocó un .proto se descubrían
# después de pagar review y QA completos. Los dos son operaciones de git que
# cuestan milisegundos, y el carril rojo es el retroceso más caro del pipeline
# (escala de carril → vuelta a /rfc → re-planear → re-implementar). Descubrirlo
# en el momento de máximo costo hundido era el peor orden posible.
gate_entry_precheck() {
  local total
  total="$(git rev-list --count "origin/$BASE_REF..HEAD" 2>/dev/null || echo 0)"
  if [ "${total:-0}" -eq 0 ]; then
    echo "ℹ️  todavía no hay commits sobre origin/$BASE_REF: sin trailer ni carril que verificar."
    return 0
  fi
  gate_trailer
  gate_lane
}

if [ "$PRECHECK" -eq 1 ]; then
  cd "$WT"
  git fetch origin --quiet 2>/dev/null || true   # fail-open: sin red, compara contra el origin/$BASE_REF local
  echo "══ precheck $REPO (task $TASK) ══"
  gate_entry_precheck
  run_phase0_gates
  run_parallel_gates
  stamp_precheck true
  emit gate "precheck de $REPO verde, listo para review" true
  echo "✅ precheck verde. Sello: tasks/$TASK/precheck-$REPO.json"
  echo "→ siguiente: /review $TASK $REPO"
  exit 0
fi

# ── Loop de ship ──────────────────────────────────────────────────────
cd "$WT"
gate_ship_preflight
acquire_lock
attempt=0
while [ "$attempt" -lt "$PUSH_RETRY_BUDGET" ]; do
  attempt=$((attempt+1))
  echo "══ ship $REPO (task $TASK) intento $attempt/$PUSH_RETRY_BUDGET ══"
  git fetch origin
  # EL CAMINO DE ERROR TAMBIEN TIENE QUE FUNCIONAR. Antes esto era
  # `git rebase ... || { git rebase --abort; echo ...; exit 4; }`, y cuando el
  # rebase fallaba SIN dejar un rebase en curso (arbol sucio, que es el caso
  # comun), el `--abort` salia 128, `set -e` mataba el script ahi mismo, y el
  # humano recibia "exit 128" sin una sola linea de diagnostico. Reproducido
  # pasando una feature de verdad por el harness.
  #
  # Y el mensaje unico tampoco servia: "conflicto de rebase" es falso cuando la
  # causa fue un archivo versionado que los tests reescribieron (.pyc, un
  # snapshot, un reporte de coverage). Son dos causas con remediaciones
  # distintas, asi que se diagnostican por separado.
  if ! rebase_out="$(git rebase origin/$BASE_REF 2>&1)"; then
    git rebase --abort >/dev/null 2>&1 || true
    echo "❌ no pude rebasear sobre origin/$BASE_REF:"
    printf '%s\n' "$rebase_out" | sed 's/^/   /'
    case "$rebase_out" in
      *"unstaged changes"*|*"local changes"*|*"cambios sin"*|*"would be overwritten"*)
        echo "   ↳ el worktree tiene cambios SIN COMMITEAR sobre archivos versionados."
        echo "     Suele ser un artefacto que los propios tests reescriben (.pyc,"
        echo "     snapshots, coverage) y que el repo versiona por accidente."
        echo "     Commiteálo, o agregalo al .gitignore de $REPO y re-corré." ;;
      *)
        echo "   ↳ conflicto real: resolvélo en el worktree $WT y re-corré ship.sh." ;;
    esac
    exit 4
  fi
  gate_trailer
  gate_lane
  run_phase0_gates
  run_parallel_gates
  gate_fresh_evidence
  # ── flow: prs — la rama y el PR, NUNCA main ─────────────────────────
  # Los gates son los MISMOS: lo unico que cambia es la puerta. Y cambia algo
  # mas, que es lo que hace falta decir sin ambiguedad: con PRs, cuando ship.sh
  # termina el cambio NO esta en main todavia. El sha que se verifico aqui
  # tampoco es el que va a aterrizar, porque la cola de merge del forge rebasea
  # o hace squash. Por eso ship.log NO registra un sha "shippeado" a secas:
  # registra el PR y deja `landed:false`, y deploy-watch resuelve el commit real
  # cuando el PR se mergee. Fingir aqui un ship producirla un /archive que
  # fusiona specs de un cambio que sigue sin mergear.
  if [ "$FLOW_MODE" = "prs" ]; then
    branch="$(git rev-parse --abbrev-ref HEAD)"
    [ "$branch" != "HEAD" ] || { echo "❌ el worktree está en detached HEAD: no hay rama que pushear"; exit 4; }
    # El rebase de arriba reescribio la historia de la rama, asi que a partir
    # del segundo intento el push necesita forzar. --force-with-lease y no
    # --force: si alguien mas movio ESA rama, se para en vez de pisarla.
    if ! git push origin "HEAD:refs/heads/$branch" 2>/dev/null; then
      git push --force-with-lease origin "HEAD:refs/heads/$branch" || {
        echo "❌ no pude publicar la rama $branch (¿alguien más la movió?)"
        echo "   ↳ --force-with-lease se niega a pisar trabajo ajeno: mirá la rama remota"
        exit 4; }
    fi
    sha="$(git rev-parse HEAD)"; short="$(git rev-parse --short HEAD)"
    # shellcheck source=/dev/null
    . "$WS/scripts/forge.sh" 2>/dev/null || true
    pr=""
    if command -v forge_pr_url >/dev/null 2>&1 || type forge_pr_url >/dev/null 2>&1; then
      pr="$(forge_pr_url "$WT" "$branch" 2>/dev/null || true)"
      if [ -z "$pr" ]; then
        pr="$(forge_pr_create "$WT" "$branch" \
              "$TASK: $REPO" \
              "Abierto por el harness tras pasar los gates de ship.sh.

Task: $TASK
Commit verificado: $sha
Veredicto: tasks/$TASK/verdict-$REPO.json

El sha que aterrice NO sera este si la cola de merge rebasea o hace squash." 2>/dev/null || true)"
      fi
    fi
    if [ -z "$pr" ]; then
      echo "⚠️  rama publicada, pero NO pude abrir ni encontrar el PR"
      echo "   (el forge no tiene driver acá, o falta su CLI, o no hay acceso)."
      emit assumption "$REPO: rama $branch publicada, PR no confirmado"
    fi
    printf '{"repo":"%s","sha":"%s","short":"%s","branch":"%s","pr":"%s","landed":false,"shipped_at":"%s"}\n' \
      "$REPO" "$sha" "$short" "$branch" "${pr:-}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$WS/tasks/$TASK/ship.log"
    stamp_provenance "$sha"
    [ -n "${CURRENT_GATE:-}" ] && emit gate "$CURRENT_GATE" true && CURRENT_GATE=""
    emit ship "$REPO: PR abierto desde $branch @ $short (falta el merge)" true
    # El anuncio final NO puede afirmar lo que el aviso de arriba acaba de
    # negar: si no hubo PR, decir "PR abierto" seria la mentira mas barata de
    # todas, la de la ultima linea que alguien lee.
    if [ -n "$pr" ]; then
      echo "✅ gates verdes y PR abierto: $pr"
      echo "   ⚠️  el cambio NO esta en $BASE_REF todavia: falta que el PR se mergee."
    else
      echo "✅ gates verdes y rama publicada en origin/$branch, SIN PR confirmado"
      echo "   ⚠️  el cambio NO esta en $BASE_REF y NO hay PR que lo lleve. Abrilo"
      echo "      a mano desde esa rama, o esto no llega a ningun lado."
    fi
    echo "→ siguiente: cuando mergee, scripts/deploy-watch.sh $TASK $REPO resuelve"
    echo "   el commit real y recien ahi corresponde /archive."
    request_ship_phase
    exit 0
  fi

  if git push origin HEAD:$BASE_REF; then
    sha="$(git rev-parse HEAD)"          # COMPLETO: deploy-watch lo compara
    short="$(git rev-parse --short HEAD)" # contra el headSha de la API del forge,
                                          # que siempre viene completo. Con el sha
                                          # corto la comparación no matcheaba nunca.
    echo "{\"repo\":\"$REPO\",\"sha\":\"$sha\",\"short\":\"$short\",\"shipped_at\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}" >> "$WS/tasks/$TASK/ship.log"
    stamp_provenance "$sha"
    # Cierra el último gate ANTES de anunciar el ship: si lo dejara al trap,
    # el "veredicto ✅" saldría en el bus DESPUÉS del "shippeé" y la historia
    # tendría el penúltimo paso después del último.
    [ -n "${CURRENT_GATE:-}" ] && emit gate "$CURRENT_GATE" true && CURRENT_GATE=""
    emit ship "$REPO @ $short — pasó los gates y está en main" true
    echo "✅ shipped $REPO @ $short"
    request_ship_phase
    echo "→ siguiente: scripts/deploy-watch.sh $TASK $REPO (o /ship se encarga)"
    exit 0
  fi
  # ── Perder la carrera es NORMAL, no un error ────────────────────────
  # Con varios workspaces contra el mismo trunk, que otro llegue primero entre
  # el último gate y el push es rutina. Antes esto consumía el presupuesto de
  # RONDAS DE REVIEW y a la tercera escalaba a humano por pura contención.
  # El backoff va ACÁ (antes del próximo fetch), y lleva jitter: sin él, los
  # que pierden la misma carrera reintentan en fase y se vuelven a pisar.
  if [ "$attempt" -lt "$PUSH_RETRY_BUDGET" ]; then
    base_wait=$(( attempt * attempt ))
    [ "$base_wait" -gt "$PUSH_BACKOFF_MAX" ] && base_wait="$PUSH_BACKOFF_MAX"
    jitter=$(( RANDOM % (base_wait + 1) ))
    wait_s=$(( base_wait + jitter ))
    echo "⚠️ push rechazado: otro workspace llegó primero a origin/$BASE_REF."
    echo "   Reintento en ${wait_s}s (intento $attempt/$PUSH_RETRY_BUDGET, con jitter para no pisarnos)."
    emit gate "ship de $REPO: perdí la carrera de push, reintento $((attempt+1))/$PUSH_RETRY_BUDGET" ""
    sleep "$wait_s"
  fi
done
echo "❌ agotados $PUSH_RETRY_BUDGET intentos de push contra origin/$BASE_REF."
echo "   El trunk se mueve más rápido de lo que tarda esta suite en correr. Esto"
echo "   NO es un problema del cambio: es contención. Opciones, en orden:"
echo "   · subí el presupuesto: HARNESS_PUSH_RETRIES=40 scripts/ship.sh $TASK $REPO"
echo "   · pasá a flow: prs (la cola de merge del forge serializa por vos, y la"
echo "     suite corre una vez sobre el merge result en vez de una vez por intento)"
exit 5
