# ── secretos ({{SECRETS_SOURCE}}) ─────────────────────────────────────
# ── EL ONBOARDING ES DE TU FUENTE, NO DE VAULT ────────────────────────
# Este bloque preguntaba SIEMPRE por un token de Vault y cableaba
# `vault-token` como archivo, sin mirar qué fuente declaró la instancia. Medido
# sobre las siete que `secrets.sh` implementa: seis no recibían NINGÚN paso de
# credencial y el bootstrap saltaba directo a `secrets.sh pull`, que falla sin
# decir cómo autenticarse. Con equipos que corren un harness por nube (uno en
# GCP SM, otro en AWS SM), el onboarding no existía en ninguno salvo el de
# Vault, y la propia cabecera de este script promete "pide el token de secretos
# (fuera del chat)" para cualquier fuente.
#
# Se DESPACHA por fuente, que es la regla 8 del repo: un eje que varía entre
# proyectos se detecta y se despacha, jamás se cablea a un vendor.
#
# Lo que este script NO hace es correr el login por vos: `gcloud auth login`,
# `aws sso login`, `doppler login` y `op signin` abren navegador o piden datos
# interactivos, y encadenarlos a ciegas desde un bootstrap es como se pierden
# sesiones ajenas. Lo que sí hace es lo que ningún prompt puede: COMPROBAR si la
# credencial está y sirve, y si no, nombrar el comando exacto.

# ¿La credencial de esta fuente está y sirve? Tres desenlaces, y ninguno se
# calla: sin CLI no se puede saber (ceguera), con CLI y check verde está lista,
# y con CLI y check rojo hay que autenticarse, con el comando delante.
# ── VIVO NO ES LO MISMO QUE SIRVE (issue #211) ────────────────────────
# `vault token lookup` responde una sola pregunta: ¿el servidor conoce este
# token? Un token OIDC de humano la contesta que sí y no tiene NINGUNA de las
# policies que esta instancia necesita. Caso de campo: el bootstrap cantó
# "VALIDADO", materializó 15 de 18 claves, y el fallo real apareció tres pasos
# más abajo como un 403 al mintear el token de nube. La causa nunca fue que el
# token estuviera muerto, y el error apareció lejos de ella.
#
# La comprobación correcta no necesita saber nada del proyecto: `secrets.sh`
# DECLARA sus rutas, así que se lee UNA con la MISMA operación que hará
# `dump_kv` y se falla acá, con el nombre de la ruta que no pudo leer.
#
# El valor del secreto JAMÁS se captura: stdout va a /dev/null y solo se mira
# el stderr, que no lo contiene. Un smoke que filtra lo que viene a proteger
# sería peor que no tenerlo.
vault_smoke() {  # vault_smoke <token> → 0 sirve (o no hay nada declarado) · 1 deny
  local linea ruta campo err pols
  linea="$(grep -E '^[[:space:]]*dump_(kv|file)[[:space:]]' "$WS/scripts/secrets.sh" 2>/dev/null | head -1)"
  # Instancia recién generada: {{VAULT_KEYS}} sin llenar, los ejemplos van
  # comentados. No hay ruta declarada, así que no hay nada que el token deba
  # poder leer: un rojo acá sería inventado.
  [ -z "$linea" ] && return 0
  ruta="$(printf '%s\n' "$linea" | awk '{print $3}')"
  campo="$(printf '%s\n' "$linea" | awk '{print $4}')"
  err="$(VAULT_ADDR="{{VAULT_ADDR}}" VAULT_TOKEN="$1" vault kv get -field="$campo" "$ruta" 2>&1 >/dev/null)" \
    && return 0
  case "$err" in
    *"permission denied"*)
      # Lo que ahorra la vuelta es el PAR: la ruta que no leyó y las policies
      # que sí tiene. Con eso, quien administra Vault cierra el hueco sin
      # adivinar. El harness no puede saber los nombres de las policies de un
      # proyecto (viven en el ACL de Vault, el único lugar donde son verdad),
      # y por eso los pide prestados al propio token en vez de declararlos.
      pols="$(VAULT_ADDR="{{VAULT_ADDR}}" VAULT_TOKEN="$1" vault token lookup -format=json 2>/dev/null \
        | jq -r '(.data.policies // ["?"]) | join(", ")' 2>/dev/null)"
      [ -n "$pols" ] || pols="?"
      warn "el token está VIVO pero NO PUEDE LEER $ruta (permission denied)."
      warn "  policies que el token SÍ tiene: $pols"
      warn "  esa ruta la declara scripts/secrets.sh. Pedí un token cuya policy la lea:"
      warn "      vault token create -period=768h -orphan -policy=<una que lea $ruta> -field=token"
      return 1 ;;
    *)
      # Ruta inexistente, sin red, mount equivocado: nada de eso es culpa del
      # token, y tratarlo como deny haría que el bootstrap pida tokens nuevos
      # para siempre por un typo en secrets.sh. `secrets.sh pull` ya cuenta lo
      # que no pudo leer.
      warn "smoke de $ruta no concluyente (no fue permission denied): sigo, secrets.sh pull dirá."
      return 0 ;;
  esac
}

onboard_cli() {  # onboard_cli <fuente> <bin> <comando-de-login> <comando-de-chequeo...>
  local fuente="$1" bin="$2" login="$3"; shift 3
  if ! command -v "$bin" >/dev/null 2>&1; then
    warn "fuente de secretos '$fuente' y su CLI ($bin) NO está instalado:"
    warn "  no puedo comprobar la credencial ni obtenerla. Esto NO es 'todo bien':"
    warn "  es que no pude mirar. Instalalo (catálogo: $bin) y re-corré el bootstrap."
    return 0
  fi
  if "$@" >/dev/null 2>&1; then
    ok "credencial de $fuente lista ($bin responde)"
  else
    warn "fuente de secretos '$fuente': $bin está pero NO hay credencial válida."
    warn "  ↳ autenticate y re-corré el bootstrap (el valor no pasa por el agente):"
    warn "      $login"
  fi
}

if [ "$SKIP_SECRETS" -eq 0 ] && [ "$CHECK" -eq 0 ]; then
  echo "══ bootstrap: secretos ══"
  TOKFILE="$HOME/.config/harness/vault-token"
  NEED_TOKEN=0
  case "{{SECRETS_SOURCE}}" in
    vault)
    if [ ! -f "$TOKFILE" ]; then
      NEED_TOKEN=1
    elif command -v vault >/dev/null 2>&1; then
      # Dos preguntas distintas, y hasta el issue #211 solo se hacía la primera:
      # ¿sigue vivo? y ¿puede leer lo que esta instancia declara? Un token que
      # contesta que sí a la primera y que no a la segunda deja un .secrets a
      # medias, que es el estado que #201 vino a cerrar.
      if ! VAULT_ADDR="{{VAULT_ADDR}}" VAULT_TOKEN="$(cat "$TOKFILE")" vault token lookup >/dev/null 2>&1; then
        warn "el token de Vault existente está EXPIRADO o revocado: hay que renovarlo"
        NEED_TOKEN=1
      elif ! vault_smoke "$(cat "$TOKFILE")"; then
        NEED_TOKEN=1   # vault_smoke ya dijo cuál ruta y con qué policies
      fi
    else
      # ── UN TOKEN SIN VALIDAR NO ES UN TOKEN VÁLIDO ──────────────────
      # Esta rama no existía, y su ausencia era silencio: con el CLI ausente
      # (una instalación que falló por plataforma o por red) las dos ramas de
      # arriba quedaban sin tomar, NEED_TOKEN se quedaba en 0 y el bootstrap
      # daba por bueno un token que nunca verificó contra ningún servidor. La
      # primera corrida al menos pide el token; de la segunda en adelante no
      # dice absolutamente nada. El síntoma aparece lejos: `secrets.sh pull`
      # trae 0 claves y el usuario culpa a sus policies o rota el token.
      warn "hay un token en $TOKFILE pero el CLI vault NO está: no puedo comprobar"
      warn "  si sigue vivo. Puede estar expirado y el harness no tiene cómo saberlo."
      warn "  ↳ instalá el CLI (catálogo: vault) y re-corré, o validalo a mano:"
      warn "      VAULT_ADDR={{VAULT_ADDR}} vault token lookup"
    fi
    ;;
    gcp-secret-manager)
      onboard_cli "gcp-secret-manager" gcloud \
        "gcloud auth login && gcloud auth application-default login" \
        gcloud auth application-default print-access-token ;;
    aws-secrets-manager)
      onboard_cli "aws-secrets-manager" aws \
        "aws sso login   (o aws configure, según cómo se autentique tu cuenta)" \
        aws sts get-caller-identity ;;
    doppler)
      onboard_cli "doppler" doppler \
        "doppler login && doppler setup" \
        doppler me ;;
    1password)
      onboard_cli "1password" op \
        "op signin" \
        op whoami ;;
    sops)
      # sops no tiene "login": tiene una LLAVE. Se comprueba la de age, que es
      # la que el harness puede ver desde acá; con KMS la credencial es la de la
      # nube y la comprueba su propio CLI cuando `sops -d` corre.
      if ! command -v sops >/dev/null 2>&1; then
        warn "fuente de secretos 'sops' y su CLI no está instalado: no puedo comprobar"
        warn "  la llave. Instalalo (catálogo: sops) y re-corré el bootstrap."
      elif [ -f "${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}" ]; then
        ok "credencial de sops lista (llave age en ${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt})"
      else
        warn "fuente de secretos 'sops': no encuentro la llave age."
        warn "  ↳ colocala en ${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt} (chmod 600), o exportá"
        warn "    SOPS_AGE_KEY_FILE. Si desciframos con KMS, la credencial es la de tu nube"
        warn "    (gcloud/aws) y este chequeo no aplica."
      fi ;;
    env)
      # No hay credencial que pedir: .secrets lo escribe el humano. Lo que sí se
      # puede comprobar es si existe, que es la precondición real de esta fuente.
      if [ -f "$WS/.secrets" ]; then
        ok "fuente de secretos 'env': .secrets ya existe (lo mantenés a mano)"
      else
        warn "fuente de secretos 'env': falta $WS/.secrets, y esta fuente no lo materializa."
        warn "  ↳ crealo a mano (KEY=VALUE, chmod 600); las claves que el harness espera"
        warn "    están en secrets.refs de harness-answers.yaml."
      fi ;;
    *)
      warn "fuente de secretos desconocida: '{{SECRETS_SOURCE}}'"
      warn "  ↳ válidas: vault | gcp-secret-manager | aws-secrets-manager | doppler |"
      warn "    sops | 1password | env. Se declara en harness-answers.yaml y se regenera." ;;
  esac
  if [ "$NEED_TOKEN" -eq 1 ]; then
    cat <<'TOKHELP'
──────────────────────────────────────────────────────────────
Esta instancia declaró secrets.source: {{SECRETS_SOURCE}}, así que hace falta
un token de Vault. (No es la única fuente soportada: secrets.sh también
despacha gcp-secret-manager, aws-secrets-manager, doppler, sops, 1password y
env. Se cambia en harness-answers.yaml y se regenera.)

OPCIÓN A · periodic token (recomendada, y NO tenés que re-autenticarte nunca)
     export VAULT_ADDR={{VAULT_ADDR}}
     vault login -method=<tu método: oidc|userpass|github>
     vault token create -period=768h -orphan \
       -policy=<la que lea las rutas de scripts/secrets.sh> -field=token
