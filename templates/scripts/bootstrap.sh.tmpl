#!/usr/bin/env bash
# bootstrap.sh — onboarding del harness en UNA pasada, idempotente.
# Instala/verifica las dependencias ELEGIDAS en la entrevista, pide el
# token de secretos (fuera del chat), materializa .secrets, construye el
# grafo de código y corre el doctor. Se puede correr N veces: solo actúa
# sobre lo que falta.
#
# Uso: bootstrap.sh [--check] [--skip-secrets]
#   --check         solo reporta qué falta, no instala nada
#   --skip-secrets  no toca token ni .secrets
set -uo pipefail
WS="$(cd "$(dirname "$0")/.." && pwd)"
CHECK=0; SKIP_SECRETS=0; MISSING=0; INSTALLED=0
for a in "$@"; do case "$a" in
  --check) CHECK=1 ;;
  --skip-secrets) SKIP_SECRETS=1 ;;
esac; done

ok()   { echo "✅ $1"; }
inst() { echo "📦 instalando: $1"; }
warn() { echo "⚠️  $1"; }

# link_into_path <bin> — go install/uv tool instalan fuera del PATH típico;
# busca el binario recién instalado y enlázalo a un directorio que SÍ esté en
# el PATH. Solo devuelve 0 si el binario quedó realmente invocable: esta
# función es lo único que separa "instalado" de "instalado pero invisible" en
# ensure(), y cantaba éxito en dos casos donde no había enlace ninguno:
#   · sin brew, "$(brew --prefix)/bin" colapsaba a "/bin" (el del SISTEMA);
#     `[ -d /bin ]` es verdadero, así que la guarda no cortaba, el `ln` moría
#     con Permission denied y el ok() se imprimía igual.
#   · el exit de `ln` no se miraba nunca.
# Resultado medido en una VPS sin sudo: "ln: Permission denied" seguido de
# "✅ go-arch-lint instalado", y el doctor contradiciéndolo cuatro líneas
# después. Falso verde, que es justo lo que el resto del harness persigue.
link_into_path() {
  local bin="$1" cand dest gobin
  if command -v brew >/dev/null 2>&1; then dest="$(brew --prefix)/bin"
  else dest="$HOME/.local/bin"; fi   # el mismo dir de usuario que usa uv tool
  mkdir -p "$dest" 2>/dev/null || return 1
  # sin go, "$(go env GOPATH)/bin" es la MISMA sustitución vacía que apuntaba a
  # "/bin": el candidato se omite en vez de mirar el /bin del sistema.
  gobin="$(go env GOPATH 2>/dev/null)"
  for cand in ${gobin:+"$gobin/bin/$bin"} "$HOME/go/bin/$bin" "$HOME/.local/bin/$bin"; do
    [ -x "$cand" ] || continue
    # cand == dest/bin: ya está donde toca, enlazarlo a sí mismo es un error
    # de `ln` y no arregla nada; lo que falta ahí es el PATH, y de eso decide
    # el `command -v` de abajo.
    if [ "$cand" != "$dest/$bin" ]; then ln -sf "$cand" "$dest/$bin" 2>/dev/null || continue; fi
    hash -r 2>/dev/null || true
    command -v "$bin" >/dev/null 2>&1 || continue   # dest fuera del PATH: no es éxito
    ok "$bin enlazado a $dest (estaba fuera del PATH)"
    return 0
  done
  return 1
}

# ── ESTE BOOTSTRAP SE GENERO PARA UNA PLATAFORMA ──────────────────────
# Los comandos de abajo se eligieron cuando se genero la instancia, mirando la
# maquina que la genero. Si esta instancia se clona a otra plataforma, algunos
# no aplican: las formulas normales de Homebrew sobreviven (brew corre en Linux
# tambien), pero los `--cask` no existen fuera de macOS y las entradas con
# variante Linux propia quedaron con la de mac. Se avisa una vez, al arrancar,
# en vez de fallar comando por comando sin explicar por que.
_bs_platform_note() {
  local here; here="$(uname -s)"
  # El patron matchea SOLO lineas de instalacion reales. Con un `grep --cask`
  # a secas, la funcion encontraba su PROPIO mensaje de aviso (que menciona
  # --cask) y avisaba siempre, incluso en un bootstrap sin un solo cask.
  # Verificado: un detector que se detecta a si mismo es un detector roto.
  if [ "$here" = "Linux" ] && grep -qE '^(ensure|require) .*--cask' "$0" 2>/dev/null; then
    warn "este bootstrap trae instalaciones con 'brew --cask', que NO existen en Linux"
    echo "   ↳ se generaron en macOS. Instala esas a mano, o regenera la instancia"
    echo "     declarando la plataforma destino (ver /harness-init, tabla de generación)."
  fi
}
_bs_platform_note

# ── EL GESTOR TIENE QUE EXISTIR ANTES DEL PRIMER ensure ───────────────
# Este bootstrap instala la mayoria de sus capacidades con `brew`, y hasta aqui
# NINGUNA linea comprobaba que brew existiera. En una maquina Linux recien
# creada (contenedor, CI, VPS de dev) no viene, asi que cada `ensure` fallaba
# por separado con "falló la instalación de X" y el usuario terminaba con un
# doctor en rojo cuya remediación era "corre scripts/bootstrap.sh": el que
# acababa de correr. Caso de campo medido: 14 de 24 lineas de instalacion no
# ejecutaron nada y quedaron 18 capacidades sin instalar, `bd` y el grafo
# incluidos, sin que apareciera la palabra "brew" una sola vez en la salida.
#
# Son dos fallas distintas y se tratan distinto:
#   1. brew esta instalado pero no en ESTE PATH (sesion no interactiva, que no
#      lee ~/.zshrc). Se resuelve solo, cargando su shellenv: es la misma
#      leccion que doctor.sh ya aprendio ("no esta en mi PATH" no es "no esta
#      instalado"), y reinstalar lo que ya esta es peor que no hacer nada.
#   2. brew no esta. Eso NO se resuelve solo por defecto: instalar un gestor de
#      paquetes entero es una decision de cadena de suministro del humano, no
#      de un script de onboarding. Se falla CERRADO con el comando exacto
#      (regla 3 y 5 del repo), y quien quiera automatizarlo lo declara con
#      HARNESS_BOOTSTRAP_INSTALL_BREW=1.
_bs_brew_preflight() {
  # Igual que _bs_platform_note: el patron matchea lineas de instalacion
  # REALES, para que esta funcion no se detecte a si misma ni a los comentarios
  # de ejemplo que trae el template.
  grep -qE '^(ensure|require) .*[[:space:]]brew[[:space:]]' "$0" 2>/dev/null || return 0
  command -v brew >/dev/null 2>&1 && return 0

  local p
  for p in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew "$HOME/.linuxbrew"; do
    if [ -x "$p/bin/brew" ]; then
      eval "$("$p/bin/brew" shellenv)" 2>/dev/null || true
      if command -v brew >/dev/null 2>&1; then
        ok "brew estaba instalado en $p pero fuera de este PATH: cargado para esta corrida"
        echo "   ↳ para que persista, 'eval \"\$($p/bin/brew shellenv)\"' va en ~/.zshenv"
        echo "     (zsh lo lee SIEMPRE, tambien en cron y en 'ssh host cmd'), no solo en ~/.zshrc"
        return 0
      fi
    fi
  done

  local cmd='/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'

  # ── COMO ROOT NO HAY BREW, Y NO ES UN FLAG QUE SE PUEDA SALTAR ──────
  # El instalador de Homebrew aborta con "Don't run this as root!" y no tiene
  # override: es decision de upstream, no una comprobacion nuestra. Eso deja al
  # caso mas comun del harness en Linux (un contenedor root-only: CI, devcontainer,
  # una VM de dev que se usa como root) SIN ningun camino con brew.
  #
  # Se detecta aqui porque el mensaje de abajo, sin esto, es un callejon sin
  # salida: manda a correr un comando que va a fallar siempre, y quien lo lea
  # va a perder el rato averiguando por que. Un mensaje de error que no
  # funciona es peor que no tener mensaje (regla 5: los errores son prompts).
  if [ "$(id -u)" = "0" ]; then
    warn "este bootstrap instala con 'brew', y Homebrew se NIEGA a correr como root"
    echo "   ↳ el instalador aborta con \"Don't run this as root!\" y no admite override."
    echo "     O sea: en esta máquina no hay camino con brew, ni instalándolo."
    echo "     Las salidas, en orden de menos a más trabajo:"
    echo "       1. correr el harness como usuario normal (con sudo donde haga falta)"
    echo "       2. instalar cada CLI desde su fuente oficial (ver install_alt e"
    echo "          install_linux en catalog/capabilities.yaml)"
    echo "     Lo que NO sirve: reintentar el instalador de Homebrew."
    [ "$CHECK" -eq 1 ] && return 1
    echo "   ↳ se corta aquí en vez de encadenar $(grep -cE '^(ensure|require) .*[[:space:]]brew[[:space:]]' "$0") fallos sin explicación."
    exit 1
  fi

  if [ "${HARNESS_BOOTSTRAP_INSTALL_BREW:-0}" = "1" ] && [ "$CHECK" -eq 0 ]; then
    inst "Homebrew (declarado con HARNESS_BOOTSTRAP_INSTALL_BREW=1)"
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
      || { warn "falló la instalación de Homebrew, hazla a mano: $cmd"; return 1; }
    for p in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew "$HOME/.linuxbrew"; do
      [ -x "$p/bin/brew" ] && { eval "$("$p/bin/brew" shellenv)" 2>/dev/null || true; break; }
    done
    command -v brew >/dev/null 2>&1 && { ok "Homebrew instalado"; return 0; }
    warn "Homebrew instalado pero no lo encuentro en el PATH"; return 1
  fi

  warn "este bootstrap instala con 'brew' y brew NO está en esta máquina"
  echo "   ↳ sin él, TODAS las líneas 'brew install' de abajo fallan una por una."
  echo "     Instálalo (corre en Linux y en macOS):"
  echo "       $cmd"
  echo "     Y en Linux, cárgalo en la shell:"
  echo "       eval \"\$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)\""
  echo "     Para que este bootstrap lo instale solo: HARNESS_BOOTSTRAP_INSTALL_BREW=1 $0"
  # --check REPORTA, no bloquea: es su contrato ("solo reporta qué falta").
  [ "$CHECK" -eq 1 ] && return 1
  echo "   ↳ se corta aquí en vez de encadenar $(grep -cE '^(ensure|require) .*[[:space:]]brew[[:space:]]' "$0") fallos sin explicación."
  exit 1
}
_bs_brew_preflight || true

# ensure <bin> <cmd de instalación...> — instala si falta (o reporta en --check)
ensure() {
  local bin="$1"; shift
  if command -v "$bin" >/dev/null 2>&1; then ok "$bin"; return 0; fi
  MISSING=$((MISSING+1))
  if [ "$CHECK" -eq 1 ]; then warn "falta: $bin (instalaría: $*)"; return 0; fi
  inst "$bin ($*)"
  if "$@"; then
    if command -v "$bin" >/dev/null 2>&1 || link_into_path "$bin"; then
      INSTALLED=$((INSTALLED+1)); ok "$bin instalado"
    else
      warn "$bin instalado pero no lo encuentro — agrega ~/go/bin y ~/.local/bin a tu PATH"
    fi
  else
    warn "falló la instalación de $bin — instálalo a mano: $*"
  fi
}

# require <bin> <instrucción> — NO auto-instala (SDKs pesados); solo verifica
require() {
  local bin="$1"; shift
  command -v "$bin" >/dev/null 2>&1 && ok "$bin" || { MISSING=$((MISSING+1)); warn "falta: $bin — instalación manual: $*"; }
}

echo "══ bootstrap: dependencias del harness ══"
# ── núcleo (siempre) ──────────────────────────────────────────────────
# jq es la única dependencia DURA: doctor.sh se muere en su línea 21 sin él, o
# sea antes de poder decir qué más falta. Por eso es el único `ensure` que no
# se delega a brew a ciegas y despacha por el gestor que la máquina tenga: era
# la primera línea del bootstrap y la primera en fallar en una máquina sin
# brew, dejando al usuario sin jq y sin diagnóstico. El catálogo ya declara
# esta misma alternativa en el `install_alt` de jq.
if command -v jq >/dev/null 2>&1;      then ok jq
elif command -v brew >/dev/null 2>&1;  then ensure jq brew install jq
elif command -v apt-get >/dev/null 2>&1; then ensure jq apt-get install -y jq
elif command -v dnf >/dev/null 2>&1;   then ensure jq dnf install -y jq
elif command -v apk >/dev/null 2>&1;   then ensure jq apk add --no-cache jq
else ensure jq brew install jq
fi

# ── elegidas en la entrevista (generado desde el catálogo) ────────────
{{ENSURE_LINES}}
# Ejemplos del formato que instancia el generador:
#   ensure gh brew install gh
#   ensure semgrep brew install semgrep
#   ensure d2 brew install d2
#   ensure bd brew install beads
#   ensure gitleaks brew install gitleaks
#   ensure go-arch-lint go install github.com/fe3dback/go-arch-lint@latest
#   ensure gotestsum go install gotest.tools/gotestsum@latest
#   ensure depcruise npm i -g dependency-cruiser
#   ensure diff-cover uv tool install diff-cover
#   ensure lint-imports uv tool install import-linter
#   ensure gcloud brew install --cask gcloud-cli
#   require flutter "https://docs.flutter.dev/get-started"
#   require kubectl "gcloud components install kubectl"

# PATHs típicos de go/uv/npm por si esta shell no los tiene
case ":$PATH:" in *":$HOME/go/bin:"*) ;; *) warn 'agrega $HOME/go/bin a tu PATH (binarios de go install)';; esac
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) warn 'agrega $HOME/.local/bin a tu PATH (binarios de uv tool)';; esac

# ── secretos ({{SECRETS_SOURCE}}) ─────────────────────────────────────
# ── EL ONBOARDING ES DE TU FUENTE, NO DE VAULT ────────────────────────
# Este bloque preguntaba SIEMPRE por un token de Vault y cableaba
# `vault-token` como archivo, sin mirar qué fuente declaró la instancia. Medido
# sobre las siete que `secrets.sh` implementa: seis no recibían NINGÚN paso de
# credencial y el bootstrap saltaba directo a `secrets.sh pull`, que falla sin
# decir cómo autenticarse. Con equipos que corren un harness por nube (uno en
# GCP SM, otro en AWS SM), el onboarding no existía en ninguno salvo el de
# Vault, y la propia cabecera de este script promete "pide el token de secretos
# (fuera del chat)" para cualquier fuente.
#
# Se DESPACHA por fuente, que es la regla 8 del repo: un eje que varía entre
# proyectos se detecta y se despacha, jamás se cablea a un vendor.
#
# Lo que este script NO hace es correr el login por vos: `gcloud auth login`,
# `aws sso login`, `doppler login` y `op signin` abren navegador o piden datos
# interactivos, y encadenarlos a ciegas desde un bootstrap es como se pierden
# sesiones ajenas. Lo que sí hace es lo que ningún prompt puede: COMPROBAR si la
# credencial está y sirve, y si no, nombrar el comando exacto.

# ¿La credencial de esta fuente está y sirve? Tres desenlaces, y ninguno se
# calla: sin CLI no se puede saber (ceguera), con CLI y check verde está lista,
# y con CLI y check rojo hay que autenticarse, con el comando delante.
onboard_cli() {  # onboard_cli <fuente> <bin> <comando-de-login> <comando-de-chequeo...>
  local fuente="$1" bin="$2" login="$3"; shift 3
  if ! command -v "$bin" >/dev/null 2>&1; then
    warn "fuente de secretos '$fuente' y su CLI ($bin) NO está instalado:"
    warn "  no puedo comprobar la credencial ni obtenerla. Esto NO es 'todo bien':"
    warn "  es que no pude mirar. Instalalo (catálogo: $bin) y re-corré el bootstrap."
    return 0
  fi
  if "$@" >/dev/null 2>&1; then
    ok "credencial de $fuente lista ($bin responde)"
  else
    warn "fuente de secretos '$fuente': $bin está pero NO hay credencial válida."
    warn "  ↳ autenticate y re-corré el bootstrap (el valor no pasa por el agente):"
    warn "      $login"
  fi
}

if [ "$SKIP_SECRETS" -eq 0 ] && [ "$CHECK" -eq 0 ]; then
  echo "══ bootstrap: secretos ══"
  TOKFILE="$HOME/.config/harness/vault-token"
  NEED_TOKEN=0
  case "{{SECRETS_SOURCE}}" in
    vault)
    if [ ! -f "$TOKFILE" ]; then
      NEED_TOKEN=1
    elif command -v vault >/dev/null 2>&1; then
      # vigencia: si el token murió, pedirlo de nuevo (fue el bug clásico)
      VAULT_ADDR="{{VAULT_ADDR}}" VAULT_TOKEN="$(cat "$TOKFILE")" vault token lookup >/dev/null 2>&1 \
        || { warn "el token de Vault existente está EXPIRADO o sin permisos — hay que renovarlo"; NEED_TOKEN=1; }
    else
      # ── UN TOKEN SIN VALIDAR NO ES UN TOKEN VÁLIDO ──────────────────
      # Esta rama no existía, y su ausencia era silencio: con el CLI ausente
      # (una instalación que falló por plataforma o por red) las dos ramas de
      # arriba quedaban sin tomar, NEED_TOKEN se quedaba en 0 y el bootstrap
      # daba por bueno un token que nunca verificó contra ningún servidor. La
      # primera corrida al menos pide el token; de la segunda en adelante no
      # dice absolutamente nada. El síntoma aparece lejos: `secrets.sh pull`
      # trae 0 claves y el usuario culpa a sus policies o rota el token.
      warn "hay un token en $TOKFILE pero el CLI vault NO está: no puedo comprobar"
      warn "  si sigue vivo. Puede estar expirado y el harness no tiene cómo saberlo."
      warn "  ↳ instalá el CLI (catálogo: vault) y re-corré, o validalo a mano:"
      warn "      VAULT_ADDR={{VAULT_ADDR}} vault token lookup"
    fi
    ;;
    gcp-secret-manager)
      onboard_cli "gcp-secret-manager" gcloud \
        "gcloud auth login && gcloud auth application-default login" \
        gcloud auth application-default print-access-token ;;
    aws-secrets-manager)
      onboard_cli "aws-secrets-manager" aws \
        "aws sso login   (o aws configure, según cómo se autentique tu cuenta)" \
        aws sts get-caller-identity ;;
    doppler)
      onboard_cli "doppler" doppler \
        "doppler login && doppler setup" \
        doppler me ;;
    1password)
      onboard_cli "1password" op \
        "op signin" \
        op whoami ;;
    sops)
      # sops no tiene "login": tiene una LLAVE. Se comprueba la de age, que es
      # la que el harness puede ver desde acá; con KMS la credencial es la de la
      # nube y la comprueba su propio CLI cuando `sops -d` corre.
      if ! command -v sops >/dev/null 2>&1; then
        warn "fuente de secretos 'sops' y su CLI no está instalado: no puedo comprobar"
        warn "  la llave. Instalalo (catálogo: sops) y re-corré el bootstrap."
      elif [ -f "${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt}" ]; then
        ok "credencial de sops lista (llave age en ${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt})"
      else
        warn "fuente de secretos 'sops': no encuentro la llave age."
        warn "  ↳ colocala en ${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/keys.txt} (chmod 600), o exportá"
        warn "    SOPS_AGE_KEY_FILE. Si desciframos con KMS, la credencial es la de tu nube"
        warn "    (gcloud/aws) y este chequeo no aplica."
      fi ;;
    env)
      # No hay credencial que pedir: .secrets lo escribe el humano. Lo que sí se
      # puede comprobar es si existe, que es la precondición real de esta fuente.
      if [ -f "$WS/.secrets" ]; then
        ok "fuente de secretos 'env': .secrets ya existe (lo mantenés a mano)"
      else
        warn "fuente de secretos 'env': falta $WS/.secrets, y esta fuente no lo materializa."
        warn "  ↳ crealo a mano (KEY=VALUE, chmod 600); las claves que el harness espera"
        warn "    están en secrets.refs de harness-answers.yaml."
      fi ;;
    *)
      warn "fuente de secretos desconocida: '{{SECRETS_SOURCE}}'"
      warn "  ↳ válidas: vault | gcp-secret-manager | aws-secrets-manager | doppler |"
      warn "    sops | 1password | env. Se declara en harness-answers.yaml y se regenera." ;;
  esac
  if [ "$NEED_TOKEN" -eq 1 ]; then
    cat <<'TOKHELP'
──────────────────────────────────────────────────────────────
Esta instancia declaró secrets.source: {{SECRETS_SOURCE}}, así que hace falta
un token de Vault. (No es la única fuente soportada: secrets.sh también
despacha gcp-secret-manager, aws-secrets-manager, doppler, sops, 1password y
env. Se cambia en harness-answers.yaml y se regenera.)

OPCIÓN A · periodic token (recomendada, y NO tenés que re-autenticarte nunca)
     export VAULT_ADDR={{VAULT_ADDR}}
     vault login -method=<tu método: oidc|userpass|github>
     vault token create -period=768h -orphan \
       -policy=<policies del harness> -field=token
   Un periodic token no expira mientras se renueve, y secrets.sh lo renueva
   solo en cada `pull`. Con -period=768h alcanza con que el harness corra una
   vez cada 32 días. O sea: se configura una vez y listo.

OPCIÓN B · root token (sin caducidad ni renovación)
     vault token create -field=token          # con una identidad root
   Sirve, y el harness lo acepta: no valida el tipo. Es lo más simple si no
   querés administrar policies.
   Lo que estás aceptando al elegirlo, para que sea una decisión y no una
   sorpresa: secrets.sh escribe VAULT_TOKEN dentro de .secrets, y TODO lo que
   corre por with-secrets.sh lo hereda. Con un root, cualquier comando que el
   harness ejecute en esta máquina tiene llave maestra de Vault, y la única
   revocación posible es rotar el root de Vault entero. Si esta máquina lee
   tickets o issues de terceros, tenelo presente: ese texto es dato no
   confiable y corre con estos secretos cargados.

El token vive en ~/.config/harness/vault-token (chmod 600) — nunca en el repo.
──────────────────────────────────────────────────────────────
TOKHELP
    if [ -t 0 ]; then
      # el valor NUNCA pasa por el agente: lo tecleas tú directo al archivo
      mkdir -p "$(dirname "$TOKFILE")"
      printf "pega tu token de Vault, periodic o root (no se muestra): "
      IFS= read -rs VTOK; echo
      if [ -n "$VTOK" ]; then
        printf '%s' "$VTOK" > "$TOKFILE"; chmod 600 "$TOKFILE"
        if command -v vault >/dev/null 2>&1 && VAULT_ADDR="{{VAULT_ADDR}}" VAULT_TOKEN="$VTOK" vault token lookup >/dev/null 2>&1; then
          ok "token guardado y VALIDADO"
        else
          warn "token guardado pero no pude validarlo (¿permisos/red?) — secrets.sh pull te dirá"
        fi
      else
        warn "sin token — colócalo después en $TOKFILE (chmod 600)"
      fi
      unset VTOK
    else
      warn "sin TTY: coloca tu token en $TOKFILE (chmod 600) y re-corre"
    fi
  fi
  if [ -x "$WS/scripts/secrets.sh" ]; then
    bash "$WS/scripts/secrets.sh" pull || warn "no pude materializar .secrets — revisa el token/red y re-corre scripts/secrets.sh pull"
  fi
fi

# ── grafo de código ───────────────────────────────────────────────────
# El grafo se construye AQUÍ, no la primera vez que un agente pregunta. Los
# prompts dicen "usa graphify query, no grep masivo": contra un grafo que no
# existe, esa query falla y el agente cae a grep, pagando justo los tokens
# que el grafo venía a ahorrar, y encima en medio de una tarea. El build
# inicial tarda minutos y es de una sola vez (después, refresh incremental
# por HEADs). Fail-open: sin graphify elegido, silencio.
if [ "$CHECK" -eq 0 ] && [ -x "$WS/scripts/graph-refresh.sh" ] && command -v graphify >/dev/null 2>&1; then
  echo "══ bootstrap: grafo de código ══"
  bash "$WS/scripts/graph-refresh.sh" \
    || warn "no pude construir el grafo; corre 'make graph' antes de la primera tarea"
elif [ "$CHECK" -eq 1 ] && command -v graphify >/dev/null 2>&1; then
  [ -f "$WS/graphify-out/graph.json" ] || [ -f "$WS/repos/graphify-out/graph.json" ] \
    && ok "grafo de graphify construido" \
    || warn "graphify sin grafo: el bootstrap lo construiría (o corre: make graph)"
fi

# ── veredicto ─────────────────────────────────────────────────────────
echo "══ bootstrap: doctor ══"
bash "$WS/scripts/doctor.sh" "$WS"
rc=$?
echo "══ bootstrap: $INSTALLED instaladas, $MISSING faltaban al inicio ══"
exit $rc
