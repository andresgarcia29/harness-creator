{
  "schema": 1,
  "workflow": {
    "initial_phase": "intake",
    "phase_order": [
      "intake",
      "rfc",
      "implement",
      "review",
      "ship",
      "deploy",
      "archive"
    ],
    "allowed_transitions": {
      "intake": [
        "rfc"
      ],
      "rfc": [
        "implement"
      ],
      "implement": [
        "review"
      ],
      "review": [
        "implement",
        "ship"
      ],
      "ship": [
        "deploy"
      ],
      "deploy": [
        "archive"
      ],
      "archive": [],
      "blocked": []
    },
    "lanes": {
      "quick": {
        "limits": {
          "max_files": 8,
          "max_lines": 200
        },
        "allowed_transitions": {
          "intake": [
            "implement"
          ],
          "implement": [
            "review"
          ],
          "review": [
            "implement",
            "ship"
          ],
          "ship": [
            "deploy"
          ],
          "deploy": [
            "archive"
          ],
          "archive": [],
          "blocked": []
        }
      },
      "express": {
        "allowed_transitions": {
          "intake": [
            "implement"
          ],
          "implement": [
            "review"
          ],
          "review": [
            "implement",
            "ship"
          ],
          "ship": [
            "deploy"
          ],
          "deploy": [
            "archive"
          ],
          "archive": [],
          "blocked": []
        }
      },
      "triado": {
        "allowed_transitions": {
          "intake": [
            "implement"
          ],
          "implement": [
            "review"
          ],
          "review": [
            "implement",
            "ship"
          ],
          "ship": [
            "deploy"
          ],
          "deploy": [
            "archive"
          ],
          "archive": [],
          "blocked": []
        }
      },
      "standard": {},
      "full": {}
    },
    "lane_escalation": [
      "quick",
      "express",
      "triado",
      "standard",
      "full"
    ],
    "allowed_pause_reasons": [
      "enrichment_questions",
      "draft_constitution",
      "irreversible_architecture",
      "adr_conflict",
      "rfc_no_convergence",
      "loop_budget_exhausted",
      "gate_autofix_exhausted",
      "deploy_failed",
      "prompt_injection",
      "requested_boundary",
      "custom_step_failed",
      "orchestrator_stalled"
    ]
  },
  "limits": {
    "max_review_rounds": {{LOOP_BUDGET}},
    "ctx_ceiling_by_role": {
      "orquestador": 220000,
      "reviewer": 200000
    }
  },
  "ship": {
    "require_independent_review": true,
    "require_fresh_evidence": true,
    "required_evidence_kinds": [
      "test"
    ],
    "verdict_reuse": {
      "enabled": true,
      "max_age_hours": 24,
      "max_base_commits": 200
    }
  }
}
