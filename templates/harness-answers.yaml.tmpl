# harness-answers.yaml — registro canónico de las decisiones de la entrevista.
# Lo escribe /harness-init; lo leen doctor.sh (verificación determinista) y
# /harness-update (re-instanciación). El ESQUEMA es fijo — doctor.sh lo parsea
# con grep/awk; cambiar la forma rompe la verificación. Cambiar VALORES está
# bien: edítalos y corre /harness-doctor.
#
# REGLA: aquí van referencias a secretos (env:// | vault:// | gcp-sm://),
# JAMÁS valores.

harness_version: "{{HARNESS_VERSION}}"
generated_at: "{{GENERATED_AT}}"

project:
  name: "{{PROJECT_NAME}}"
  ticket_prefix: "{{TICKET_PREFIX}}"

# Dónde se versiona ESTA instancia: "self" (git init en el workspace) o
# la URL del repo destino. Si ese repo estaba clonado en repos/, queda
# EXCLUIDO del clustering, del DAG y del manifest.
instance:
  repo: {{INSTANCE_REPO}}

# trunk | trunk-merge-commit | prs
# (trunk-staging NO está implementado y ship.sh falla cerrado)
#   trunk → push directo a la trunk tras los gates (fast-forward: los commits
#           de la tarea quedan sueltos en la historia)
#   trunk-merge-commit → lo MISMO (mismos gates, misma puerta), pero aterriza
#           con un merge commit. Es para cuando el humano quiere poder deshacer
#           un cambio grande de un tirón: con merge commit revertir es
#           `git revert -m 1 <sha>`, y con fast-forward hay que conocer el
#           rango exacto, que nadie tiene a mano. El primer padre es la trunk.
#   prs   → misma verificación, pero publica la rama y abre el PR: el cambio NO
#           está en la trunk cuando ship.sh termina, y deploy-watch espera al
#           merge para resolver el commit que de verdad aterrizó
flow: {{FLOW}}

# Sandwich de razonamiento: juicio caro solo donde hay juicio.
models:
  provider: {{MODEL_PROVIDER}}        # anthropic | vertex | bedrock | kimi | openrouter
  architect: {{MODEL_ARCHITECT}}      # ALIAS (fast|smart|deep): planeación, síntesis de RFC
  reviewer: {{MODEL_REVIEWER}}        # veredictos de review
  implementer: {{MODEL_IMPLEMENTER}}  # ejecución de tareas
  mechanical: {{MODEL_MECHANICAL}}    # digest, triage, commits
  escalation: {{MODEL_ESCALATION}}    # relanzar un agente atascado y cronjobs
                                      # caros. models.yaml lo usa en DOS
                                      # lugares (roles.escalation y
                                      # cronjobs.expensive); sin este campo el
                                      # placeholder quedaba literal y
                                      # stamp-models resolve fallaba en runtime.

loop_budget: {{LOOP_BUDGET}}

# Canal de vuelta al plugin: cuando un agente tropieza con un bug del HARNESS
# (no de tu código), lo verifica y levanta un issue en el repo de
# harness-creator (scripts/harness-bug.sh + skill harness-bug-report).
#   auto → reporta solo, tras las verificaciones deterministas (recomendado)
#   off  → nunca publica nada hacia afuera; el hallazgo se reporta al humano
# Nunca viajan valores de secretos: el cuerpo se redacta antes de publicar,
# hay dedupe por fingerprint y cuota de 3 issues por 24h.
upstream_issues: {{UPSTREAM_ISSUES}}

# Autonomía de /smart (ticket o prompt → producción, sin intervención):
#   full       → no pausa DESPUÉS del enrichment; gates + canary + rollback
#                son la red
#   checkpoint → además, UNA pausa: resumen antes del primer ship a main
# En los dos modos el paso 1 (enrichment) puede hacer UNA ronda de preguntas
# antes de arrancar: es la única interacción sancionada, y solo ocurre si hay
# algo que la evidencia del repo no puede responder. Concentrar ahí lo que el
# humano sabe es lo que permite que el resto corra sin interrupciones.
# Gradúa cuándo se toca main, NO cuánto piensa el humano: /smart redacta
# criterios y resuelve ambigüedad solo en ambos modos (ledger de
# supuestos). Para conducir fase por fase: comandos sueltos, no /smart.
autonomy: {{AUTONOMY}}

# MinionS (docs/harness/minions-decomposition.md): el supervisor descompone en
# sub-preguntas y workers baratos las responden EN PARALELO; el supervisor
# sintetiza. No es "elegir modelo barato": es descomposición + fan-out, y es lo
# que mantiene al architect como un HILO FINO (juicio, no lectura).
#   auto  → ON en standard/full, OFF en express (recomendado)
#   true  → siempre; false → nunca (el architect lee y razona monolítico)
minion_decompose: auto

# Orden de shipping: dependencias primero. Verificado por el arquitecto
# en cada plan; ship.sh no lo impone (los contratos expand/contract lo
# vuelven no-crítico), pero es la referencia.
dag:
{{DAG_LIST}}

# Topología de agentes decidida en la entrevista (clustering dinámico):
# un abogado por servicio que POSEE datos; un agente por cluster para
# repos homogéneos sin ownership de datos (terraform modules, frontends).
clusters:
{{CLUSTERS_LIST}}
#  - agent: svc-atlas
#    kind: service          # service | infra | frontend | contracts
#    repos: [atlas]
#    owns: "identidad y tenancy"
#  - agent: infra
#    kind: infra
#    repos: [terraform-core, terraform-app-module, helm-library]

# Capacidades palomeadas del catálogo. doctor.sh verifica:
#   bin: <x>   → command -v <x>
#   mcp: <x>   → clave <x> presente en .mcp.json
#   scope:     → core (falta = ❌ fallo) | cronjob (falta = ⚠️ warning,
#                solo lo usa un detector de cronjob)
# REGLA: con cronjobs deshabilitados NO se seleccionan capacidades
# cronjob-only; quedan comentadas como pendientes.
capabilities:
{{CAPABILITIES_LIST}}
#  - name: gh
#    bin: gh
#    tier: read-write
#    scope: core
#  - name: lychee
#    bin: lychee
#    tier: read-only
#    scope: cronjob        # detector de doc-gardener
#  - name: serena
#    mcp: serena
#    tier: read-write
#    profiles: [implementer]

secrets:
  source: {{SECRETS_SOURCE}}   # vault | gcp-secret-manager | env
  refs:
{{SECRETS_REFS}}
#    - env://<NOMBRE_DE_LA_VARIABLE>
#    - vault://<proyecto>/harness/argocd

# Driver de verificación de deploy POR REPO. Lo lee deploy-watch.sh, con esta
# precedencia: lo declarado aquí > el kind del repo en manifest.yaml (service/
# frontend/mobile → gitops; el resto → none) > gitops por compatibilidad.
#   gitops   → Actions + Kargo + health de ArgoCD + smoke del canary
#   actions  → solo la conclusión del workflow de CI (el más universal)
#   none     → este repo no se verifica tras el ship, y el watcher lo DICE
# Declara los repos cuyo kind no cuenta la historia completa: una library con
# workflow de release, un infra-live que aplica al mergear. doctor.sh avisa si
# un repo tiene workflows de deploy y su driver resuelve a none.
# Claves PLANAS por repo (el parser es awk línea a línea; nada anidado):
#   driver          gitops | actions | none
#   verify_cmd      comando post-deploy que interroga al ARTEFACTO desplegado;
#                   corre para TODOS los drivers (con none es tu única señal),
#                   bajo with-secrets. Dos primitivos que salieron del campo:
#                   1) lee el asset DESDE EL POD, no del CDN que cachea:
#                      "kubectl exec deploy/web -- cat /usr/share/nginx/html/index.html"
#                   2) compara pod vs CDN; curl SIEMPRE con --compressed (sin
#                      eso el body llega gzip y el grep calla):
#                      "curl -sS --compressed https://cdn.example.com/app.js"
#                   OJO: si el bundle genera el literal por template, el
#                   substring puede no existir tal cual en el fuente; verifica
#                   contra el artefacto desplegado, no contra el código.
#   verify_expect   substring esperado en la salida (opcional; sin él, exit 0)
#   verify_timeout  segundos (default 120)
#   post_ship       comando que ship-wave corre tras aterrizar el repo
#                   (publish/bump del consumidor); con flow: prs se difiere
#                   hasta el merge
deploy:
{{DEPLOY_LIST}}
#  atlas:
#    driver: gitops
#    verify_cmd: "curl -sS --compressed https://cdn.example.com/app.js"
#    verify_expect: "data-testid=checkout"
#  terraform-core:
#    driver: actions
#  design-system:
#    driver: actions
#    post_ship: "npm publish --tag latest"

# Port-forwards supervisados (scripts/port-forwards.sh up|ensure|down|status).
# Los puertos se declaran UNA vez, acá; la sonda es de IDENTIDAD, no de vida:
# declara qué respuesta ES tu servicio. probe_expect_status es el código
# esperado SIN credenciales (un 401 es identidad válida: prueba que el que
# contesta es tu servicio y no el port-forward viejo de otra cosa). El cmd lo
# pone la instancia (kubectl port-forward, ssh -L, cloud-sql-proxy...) y se
# lanza con exec: debe SER el proceso del forward, no un wrapper que forkea
# y sale (ssh: usa -N sin -f), o el supervisor no podría matarlo.
port_forwards:
{{PORT_FORWARDS_LIST}}
#  atlas:
#    port: 9090
#    cmd: "kubectl -n prod port-forward svc/atlas 9090:8080"
#    probe_method: POST
#    probe_path: /test/tenancy/create
#    probe_expect_status: 401
#    probe_expect_body: "invalid or missing X-E2E-Secret"

# Dónde viven los repos. Normalmente se detecta del remote; se declara solo
# si es un self-hosted con dominio propio. Lo lee scripts/forge.sh, que es por
# donde los cronjobs entregan PRs e issues.
forge: {{FORGE}}                   # github | gitlab | bitbucket

tickets:
  provider: {{TICKETS_PROVIDER}}   # linear | github | none
  repo: {{TICKETS_REPO}}           # solo github: owner/repo donde viven los
                                   # issues. Sin esto, ticket-pull no sabe de
                                   # qué repo es "123" y te lo dice en vez de
                                   # adivinar.

memory:
  provider: {{MEMORY_PROVIDER}}    # engram | none
  profiles: [{{MEMORY_PROFILES}}]  # default: orquestador, arquitecto
