#!/usr/bin/env bash
# secrets.sh — materializa secretos desde {{SECRETS_SOURCE}} hacia ./.secrets
# (KEY=VALUE, gitignoreado) y derivados multilínea en ./.secrets.d/.
# El repo NUNCA contiene valores; este archivo solo contiene REFERENCIAS.
#
# Uso: secrets.sh pull | secrets.sh check
set -euo pipefail
WS="$(cd "$(dirname "$0")/.." && pwd)"
OUT="$WS/.secrets"; OUTD="$WS/.secrets.d"
CMD="${1:-pull}"

# ── fuente: vault ─────────────────────────────────────────────────────
# Token periódico en ~/.config/harness/vault-token (chmod 600, fuera del
# repo). Policies mínimas: read del KV del harness; write solo app-plane.
pull_vault() {
  export VAULT_ADDR="{{VAULT_ADDR}}"
  local tokfile="$HOME/.config/harness/vault-token"
  [ -f "$tokfile" ] || { echo "❌ falta $tokfile (token de Vault, periodic o root, chmod 600)"; exit 1; }
  VAULT_TOKEN="$(cat "$tokfile")"; export VAULT_TOKEN
  # NO TODO TOKEN SE RENUEVA, Y FALLAR AL RENOVAR NO ES "EXPIRÓ". Un token root
  # (o cualquiera con TTL infinito) no es renovable: `vault token renew` falla
  # SIEMPRE, y el aviso de "¿expiró?" quedaba en cada `pull` para siempre. Un
  # warning permanente que no significa nada enseña a ignorar los warnings, que
  # es justo lo que no queremos el día que uno sí importe.
  #
  # Se distinguen los tres estados en vez de colapsarlos en uno:
  #   renovado · no lo necesita (renewable:false) · de verdad no anda
  tok_info="$(vault token lookup -format=json 2>/dev/null || true)"
  if [ -z "$tok_info" ]; then
    echo "⚠️  no pude consultar el token de Vault (¿expiró, sin red, sin permisos?)"
  elif [ "$(printf '%s' "$tok_info" | jq -r '.data.renewable // false' 2>/dev/null)" = "true" ]; then
    vault token renew >/dev/null 2>&1 \
      || echo "⚠️  el token es renovable pero la renovación falló (¿permisos?)"
  else
    # root o TTL infinito: correcto y esperado, no hay nada que renovar.
    ttl="$(printf '%s' "$tok_info" | jq -r '.data.ttl // 0' 2>/dev/null)"
    [ "${ttl:-0}" = "0" ] && echo "ℹ️  token sin caducidad (root o TTL infinito): no requiere renovación"
  fi

  : > "$OUT"; chmod 600 "$OUT"; mkdir -p "$OUTD"
  echo "VAULT_ADDR=$VAULT_ADDR" >> "$OUT"
  echo "VAULT_TOKEN=$VAULT_TOKEN" >> "$OUT"
  # Cada línea: <ENV_KEY> <kv-path> <campo>. Editar según el layout real.
{{VAULT_KEYS}}
#  dump_kv GH_TOKEN            {{VAULT_KV_BASE}}/github  pat
#  # Token Y direccion: un CLI no habla con un servidor que no sabe cual es.
#  # Sin la direccion, deploy-watch queda ciego aunque el token sea correcto.
#  dump_kv ARGOCD_AUTH_TOKEN   {{VAULT_KV_BASE}}/argocd  token
#  dump_kv ARGOCD_URL          {{VAULT_KV_BASE}}/argocd  url
#  dump_kv KARGO_TOKEN         {{VAULT_KV_BASE}}/kargo   token
#  dump_kv KARGO_API_ADDRESS   {{VAULT_KV_BASE}}/kargo   address
#  dump_file kubeconfig        {{VAULT_KV_BASE}}/kubeconfig value   # → .secrets.d/kubeconfig
  finish
}

MISSED=0
dump_kv() { # dump_kv <ENV_KEY> <kv-path> <campo>
  local v; v="$(vault kv get -field="$3" "$2" 2>/dev/null)" \
    || { echo "⚠️  no pude leer de Vault: $2 ($3)"; MISSED=$((MISSED+1)); return 0; }
  echo "$1=$v" >> "$OUT"
}

dump_file() { # dump_file <archivo> <kv-path> <campo> — multilínea → .secrets.d/
  vault kv get -field="$3" "$2" > "$OUTD/$1" 2>/dev/null \
    && chmod 600 "$OUTD/$1" || { echo "⚠️  no pude leer de Vault: $2 ($3)"; MISSED=$((MISSED+1)); }
}

# ── fuente: gcp secret manager ────────────────────────────────────────
pull_gcp_sm() {
  : > "$OUT"; chmod 600 "$OUT"
  # Cada línea: <ENV_KEY> <secret-name>. Editar según el proyecto.
{{GCP_SM_KEYS}}
#  dump_sm GH_TOKEN gh-harness-token
  # finish, NO un ✅ fijo: era la única fuente que no contaba sus fallos, así
  # que con gcloud sin autenticar TODAS las claves fallaban, .secrets quedaba
  # vacío y el script salía 0 diciendo "materializados". Vault y AWS ya lo
  # hacían bien tres funciones más arriba.
  finish
}
dump_sm() {
  local v; v="$(gcloud secrets versions access latest --secret="$2" 2>/dev/null)" \
    || { echo "⚠️  falta en Secret Manager: $2"; MISSED=$((MISSED+1)); return 0; }
  echo "$1=$v" >> "$OUT"
}

# ── fuente: aws secrets manager ───────────────────────────────────────
pull_aws_sm() {
  : > "$OUT"; chmod 600 "$OUT"
  # Cada línea: <ENV_KEY> <secret-id>. Editar según la cuenta.
{{AWS_SM_KEYS}}
#  dump_asm GH_TOKEN harness/github-token
  finish
}
dump_asm() {
  local v; v="$(aws secretsmanager get-secret-value --secret-id "$2" --query SecretString --output text 2>/dev/null)" \
    || { echo "⚠️  no pude leer de AWS SM: $2"; MISSED=$((MISSED+1)); return 0; }
  echo "$1=$v" >> "$OUT"
}

# ── fuente: doppler (proyecto/config del directorio) ──────────────────
pull_doppler() {
  doppler secrets download --no-file --format env > "$OUT" 2>/dev/null \
    && { chmod 600 "$OUT"; echo "✅ secretos materializados en $OUT (doppler)"; } \
    || { echo "❌ doppler falló — ¿doppler login / doppler setup?"; exit 1; }
}

# ── fuente: sops (archivo cifrado versionado) ─────────────────────────
pull_sops() {
  local enc="{{SOPS_FILE}}"   # ej. secrets.enc.env
  [ -f "$enc" ] || { echo "❌ no existe $enc"; exit 1; }
  sops -d "$enc" > "$OUT" 2>/dev/null \
    && { chmod 600 "$OUT"; echo "✅ secretos materializados en $OUT (sops)"; } \
    || { echo "❌ sops no pudo descifrar — ¿tienes la llave (age/KMS)?"; exit 1; }
}

# ── fuente: 1password (plantilla con referencias op://) ───────────────
pull_op() {
  local tpl=".secrets.tpl"    # KEY=op://vault/item/field, versionable
  [ -f "$tpl" ] || { echo "❌ no existe $tpl (plantilla con refs op://)"; exit 1; }
  op inject -i "$tpl" -o "$OUT" 2>/dev/null \
    && { chmod 600 "$OUT"; echo "✅ secretos materializados en $OUT (1password)"; } \
    || { echo "❌ op inject falló — ¿op signin?"; exit 1; }
}

# ── fuente: env (sin materialización; .secrets lo escribe el humano) ──
pull_env() {
  [ -f "$OUT" ] && echo "✅ .secrets ya existe (fuente: env — lo mantienes a mano)" \
    || { echo "❌ crea $OUT a mano (KEY=VALUE, chmod 600); ver secrets.refs en harness-answers.yaml"; exit 1; }
}

finish() {
  if [ "$MISSED" -eq 0 ]; then echo "✅ secretos materializados en $OUT"; else
    echo "❌ materialización INCOMPLETA: $MISSED claves no se pudieron leer"
    echo "   ↳ causa típica: token/credencial expirada o layout distinto"; exit 1
  fi
}

# Despacho por VALOR de la fuente, no por nombre de función interpolado.
# Antes el case llamaba a "pull_" + un placeholder con el nombre de la
# función, y bastaba con que el generador inyectara "pull_vault" en vez de
# "vault" para producir "pull_pull_vault: command not found" en TODA
# instalación fresca (issue #21): sin .secrets no hay credenciales para nada,
# y el error ni siquiera dice qué placeholder salió mal.
# Aquí el generador solo inyecta el mismo valor que ya escribió en
# harness-answers.yaml, los alias históricos siguen resolviendo, y una fuente
# desconocida falla nombrándose en vez de morir como comando inexistente.
SECRETS_SOURCE="{{SECRETS_SOURCE}}"
pull_dispatch() {
  local s="${SECRETS_SOURCE#pull_}"   # tolera generadores que inyectan la función
  case "$s" in
    vault)                              pull_vault ;;
    gcp-secret-manager|gcp_sm|gcp-sm)   pull_gcp_sm ;;
    aws-secrets-manager|aws_sm|aws-sm)  pull_aws_sm ;;
    doppler)                            pull_doppler ;;
    sops)                               pull_sops ;;
    1password|op|onepassword)           pull_op ;;
    env)                                pull_env ;;
    *)
      echo "❌ fuente de secretos desconocida: '$SECRETS_SOURCE'"
      echo "   ↳ válidas: vault | gcp-secret-manager | aws-secrets-manager | doppler | sops | 1password | env"
      echo "     corrige secrets.source en harness-answers.yaml y re-genera este script (/harness-init .)"
      exit 1 ;;
  esac
}

# ── doctor: lo REQUERIDO por los repos contra lo PROVISTO ─────────────
# Caso de campo: tres secretos existían en la fuente desde siempre y nadie
# los había registrado acá; el reporte decía "bloqueado: sin acceso" cuando
# la verdad era "faltan tres líneas dump_kv en este script". Esa diferencia
# vale horas. Las heurísticas de "requerido" son DECLARACIONES de los repos
# (.env.example, process.env.X en config, secretKeyRef en charts), no
# adivinanza; y el candidato solo se busca si hay CLI y token (best-effort).

req_scan() {  # escribe líneas "VAR<TAB>origen" al archivo $1
  local out="$1" r name f
  for r in "$WS"/repos/*/; do
    [ -d "$r" ] || continue
    name="$(basename "$r")"
    if [ -f "$WS/.cache/archived-repos.txt" ] \
        && grep -qxF "$name" "$WS/.cache/archived-repos.txt"; then continue; fi
    for f in "$r".env.example "$r".env.sample "$r".env.template; do
      [ -f "$f" ] || continue
      grep -E '^[A-Z_][A-Z0-9_]*=' "$f" 2>/dev/null | cut -d= -f1 \
        | sed "s|$|	repos/$name/$(basename "$f")|" >> "$out" || true
    done
    # process.env.X / os.environ, acotado a superficies de configuración
    for f in "$r"config/* "$r"profiles/* "$r"settings.py "$r"*.config.js \
             "$r"*.config.ts "$r"*.config.mjs "$r"*.config.cjs; do
      [ -f "$f" ] || continue
      { grep -oE 'process\.env\.[A-Z_][A-Z0-9_]*' "$f" 2>/dev/null | sed 's/^process\.env\.//'
        grep -oE 'os\.environ(\.get\(|\[)["'"'"'][A-Z_][A-Z0-9_]*' "$f" 2>/dev/null \
          | grep -oE '[A-Z_][A-Z0-9_]*$'; } \
        | sed "s|$|	repos/$name/${f#"$r"}|" >> "$out" || true
    done
    # secretKeyRef: el key: dentro de las 3 líneas siguientes (BSD awk)
    for f in "$r"chart/values*.yaml "$r"charts/*/values*.yaml "$r"helm/values*.yaml; do
      [ -f "$f" ] || continue
      awk -v src="repos/$name/${f#"$r"}" '
        /secretKeyRef:/ { win = 3; next }
        win > 0 && /key:[[:space:]]*/ {
          k = $0; sub(/^.*key:[[:space:]]*/, "", k); gsub(/["\047]/, "", k)
          sub(/[[:space:]]+$/, "", k)
          if (k != "") printf "%s\t%s\n", k, src
          win = 0; next
        }
        win > 0 { win = win - 1 }
      ' "$f" >> "$out" 2>/dev/null || true
    done
  done
}

provided_scan() {  # escribe una clave por línea al archivo $1
  local out="$1"
  [ -f "$OUT" ] && grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$OUT" 2>/dev/null \
    | cut -d= -f1 >> "$out" || true
  # las líneas dump_* que el generador inyectó en ESTE script
  grep -E '^[[:space:]]*dump_(kv|sm|asm)[[:space:]]' "$0" 2>/dev/null \
    | awk '{print $2}' >> "$out" || true
  # refs env:// del answers (comentarios fuera, issue #26)
  [ -f "$WS/harness-answers.yaml" ] && sed 's/#.*//' "$WS/harness-answers.yaml" \
    | grep -oE 'env://[A-Za-z_][A-Za-z0-9_]*' | sed 's|env://||' >> "$out" || true
  # baseline de la fuente (vault siembra sus dos)
  printf 'VAULT_ADDR\nVAULT_TOKEN\n' >> "$out"
  # alias que with-secrets.sh deriva al inyectar: provisto, no faltante
  grep -qx 'GH_TOKEN' "$out" && echo 'NODE_AUTH_TOKEN' >> "$out" || true
}

suggest_candidate() {  # suggest_candidate <VAR> → imprime el dump_kv sugerido, si hay
  local var="$1" path field
  command -v vault >/dev/null 2>&1 || return 1
  command -v jq >/dev/null 2>&1 || return 1
  [ -f "$WS/.vault-token" ] || [ -n "${VAULT_TOKEN:-}" ] || return 1
  for path in $(grep -E '^[[:space:]]*dump_kv[[:space:]]' "$0" 2>/dev/null \
      | awk '{print $3}' | sort -u); do
    field="$(vault kv get -format=json "$path" 2>/dev/null \
      | jq -r '.data.data | keys[]' 2>/dev/null \
      | grep -i -x -m1 "$var" || true)"
    if [ -n "$field" ]; then
      echo "   ↳ candidato: el path $path tiene el campo $field:"
      echo "     agrega  dump_kv $var $path $field  a scripts/secrets.sh"
      return 0
    fi
  done
  return 1
}

secrets_doctor() {
  local req prov missing var origins n=0
  req="$(mktemp)"; prov="$(mktemp)"
  req_scan "$req"
  provided_scan "$prov"
  if [ ! -s "$req" ]; then
    echo "✅ secrets doctor: ningún repo declara variables (nada que cruzar)"
    rm -f "$req" "$prov"; return 0
  fi
  missing="$(comm -23 <(cut -f1 "$req" | sort -u) <(sort -u "$prov"))"
  if [ -z "$missing" ]; then
    echo "✅ secrets doctor: todo lo que los repos declaran está provisto"
    rm -f "$req" "$prov"; return 0
  fi
  local suggested=0
  for var in $missing; do
    n=$((n+1))
    origins="$(grep "^$var	" "$req" | cut -f2 | sort -u | head -3 | tr '\n' ' ')"
    echo "❌ FALTA $var (requerida por: $origins)"
    if suggest_candidate "$var"; then suggested=$((suggested+1)); else
      echo "   ↳ remediación: agrega  dump_kv $var <path> <campo>  a scripts/secrets.sh"
    fi
  done
  if [ "$suggested" -eq 0 ] && ! { command -v vault >/dev/null 2>&1 \
      && { [ -f "$WS/.vault-token" ] || [ -n "${VAULT_TOKEN:-}" ]; }; }; then
    echo "ℹ️  no pude buscar candidatos (sin CLI de la fuente o sin token): la remediación queda manual"
  fi
  echo "── secrets doctor: $n variable(s) requeridas SIN proveer (detalle arriba)"
  rm -f "$req" "$prov"
  return 1
}

case "$CMD" in
  pull)   pull_dispatch ;;
  check)  [ -f "$OUT" ] && echo "✅ .secrets presente" || { echo "❌ sin .secrets — corre: scripts/secrets.sh pull"; exit 1; } ;;
  doctor) secrets_doctor ;;
  *) echo "uso: secrets.sh pull|check|doctor"; exit 1 ;;
esac
