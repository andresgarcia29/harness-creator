#!/usr/bin/env bash
# ship.sh — ÚNICA puerta de salida a main. Los agentes piden shippear;
# este script decide. Determinista, cero tokens en el camino verde.
#
# Uso: ship.sh <task-id> <repo>
#      ship.sh --precheck <task-id> <repo>
#
# --precheck corre los MISMOS gates mecánicos (lenguaje, seguridad, tests no
# debilitados) sobre el worktree, SIN veredicto, sin lock y sin push. Existe
# por una razón de velocidad medida: un review que se cae por un test roto o
# un lint quema una ronda completa de reviewer (10-20 min de reloj) para
# decir lo que un script dice en segundos y gratis. El implementer lo corre
# antes de entregar; /review no lanza a nadie si el precheck no está verde.
# Deja el sello en tasks/<task>/precheck-<repo>.json (commit + ok +
# verificado, que dice cuánto se miró de verdad: ver stamp_precheck), y avisa
# si la evidencia citable del repo quedó apuntando a otro commit
# (aviso_evidencia_desalineada: observador, no gate, jamás pone rojo).
#
# Opera sobre el WORKTREE de la tarea (worktrees/<task>/<repo>), nunca
# sobre el clon canónico. Serie solo lo que tiene orden real:
# rebase → trailer → carril. Después, los gates independientes corren EN
# PARALELO (lenguaje+buf ∥ gitleaks+semgrep ∥ tests-no-debilitados ∥
# veredicto+evidencia+policy) y se reportan TODOS los rojos juntos — un
# solo prompt de fix con todo, en vez de descubrirlos ronda por ronda.
# Al final, en serie otra vez: lock → push.
#
# ── CÓDIGOS DE SALIDA ─────────────────────────────────────────────────
# Los de verdad, los que este script asigna. Quien automatiza alrededor (CI,
# wrappers, /smart) decide por lo que dice esta tabla, así que no lista ninguno
# que el código no devuelva: tests/test_precheck.sh compara la tabla contra los
# `exit N` reales del archivo, en los dos sentidos.
# exit 0 · verde: gates pasados (precheck, --ci, --lang-gates) o cambio publicado.
# exit 2 · no puedo ni empezar: falta el repo en repos/, el worktree, el clon
#          base, no existe origin/<trunk>, o no se pudo leer la entrega
#          declarada de la tarea. Ningún gate llegó a correr.
# exit 3 · un gate dijo que NO: trailer, carril, lenguaje/tests, tests
#          debilitados, tests nuevos que pasan sin el cambio, veredicto,
#          compliance, policy o evidencia.
# exit 4 · git no pudo mover el cambio: rebase imposible, detached HEAD, o la
#          rama no se pudo publicar (flow: prs).
# exit 5 · agotados los reintentos de push: es contención con otro workspace,
#          no un rojo del cambio.
# exit 6 · el lock del repo siguió ocupado más de 10 min (otro ship en curso).
# exit 7 · el flow vigente (harness-answers.yaml, o el sellado al instalar si el
#          archivo no lo declara) no es uno de los que este script implementa.
# exit 8 · la tarea declaró entrega SIN publicación (delivery: review) y este
#          script publica: no es un rojo, es lo que pidió la invocación. Para
#          publicar se PROMUEVE la entrega (harness-policy.py delivery ... --to
#          prs|trunk) y se re-corre. Causa distinta al 7, mensaje distinto.
# Cualquier otro código != 0 es el del comando que falló bajo set -e (pytest,
# tsc, git, python3): este script no lo asigna, lo propaga tal cual.
#
# Portabilidad: bash 3.2 (macOS), BSD grep. Sin flock (lock por mkdir).
set -euo pipefail

PRECHECK=0
LANG_ONLY=0
CI_MODE=0
case "${1:-}" in
  --precheck)   PRECHECK=1; shift ;;
  # Modo interno: corre SOLO los gates de lenguaje y sale. Existe para que
  # evidence.py pueda ejecutarlos como un comando y sellar su salida contra el
  # commit exacto (ver run_lang_gates_sealed). No es parte de la interfaz.
  --lang-gates) LANG_ONLY=1; shift ;;
  # ── MODO CI: los MISMOS gates, sobre un checkout pelado ─────────────
  # Existe para que la cola de merge del forge corra la verificacion en infra
  # NEUTRAL en vez de en la laptop del que pushea. Con varias personas, "los
  # sistemas deterministas verifican" es cierto solo hasta la laptop menos
  # actualizada del equipo: cualquiera puede editar su ship.sh local.
  #
  # Corre el MISMO codigo a proposito. Un workflow que reimplemente los gates
  # se desincroniza del harness en la primera version, y entonces CI y local
  # dicen cosas distintas sobre el mismo commit, que es peor que no tener CI.
  #
  # Lo que NO hace: veredicto, evidencia, lock, push ni fases. Nada de eso
  # existe en un checkout de CI, y fingirlo seria inventar.
  --ci)         CI_MODE=1; shift ;;
esac
if [ "$CI_MODE" -eq 1 ]; then
  TASK="${HARNESS_CI_TASK:-ci}"
  REPO="${1:-$(basename "$(pwd)")}"
  WS="$(cd "$(dirname "$0")/.." && pwd)"
  WT="$(pwd)"
else
TASK="${1:?uso: ship.sh [--precheck|--ci] <task-id> <repo>}"
REPO="${2:?uso: ship.sh [--precheck] <task-id> <repo>}"
WS="$(cd "$(dirname "$0")/.." && pwd)"
WT="$WS/worktrees/$TASK/$REPO"
fi

BASE="$WS/repos/$REPO"
# ── DOS PRESUPUESTOS QUE NO TIENEN NADA QUE VER ───────────────────────
# Antes los dos salían de {{LOOP_BUDGET}}, que son las RONDAS DE REVIEW (juicio
# de LLM). Perder una carrera de push contra otro workspace no es una ronda de
# review: es contención mecánica, y con varias personas pusheando al mismo
# trunk es rutina. Con loop_budget=3, tres movimientos de main en una ventana
# ocupada agotaban el "presupuesto" y escalaban a humano sin que nada
# estuviera roto.
PUSH_RETRY_BUDGET="${HARNESS_PUSH_RETRIES:-20}"
# Backoff con JITTER: sin él, N workspaces que pierden la misma carrera
# reintentan en fase y se vuelven a pisar (manada). El jitter los desincroniza.
PUSH_BACKOFF_MAX="${HARNESS_PUSH_BACKOFF_MAX:-30}"

# ── EL ROJO QUE NO ES TUYO: HARNESS_KNOWN_BUG='<slot>=<url>' ──────────
# Caso de campo: un agente en una tarea de PRODUCTO choca con un bug del
# HARNESS (un gate que revienta, o que hace lo contrario de lo que su cabecera
# documenta). Sus dos únicas salidas eran ilegítimas: arreglar el harness (que
# no es su tarea, y descarrila la corrida en un bucle de "toco el gate, el gate
# me muerde") o quedarse bloqueado. Este knob abre UNA tercera: declarar el bug
# ya reportado y seguir, dejando rastro auditable.
#
# Los candados son el diseño, no un adorno:
#   · EXIGE EL SLOT, no solo la url. Un salto-todo sería una puerta trasera.
#     Los slots son los de collect_gate_slots, que es la granularidad que el
#     propio mensaje de error ya imprime.
#   · SLOTS VETADOS, jamás declarables: `security` y `veredicto`. Un secreto
#     filtrado nunca es un bug del harness (y ese slot junta gitleaks con
#     semgrep: no se puede abrir uno sin abrir el otro), y sin veredicto no
#     hubo review. Esta es la defensa principal.
#   · REPORTAR ES LA PRECONDICIÓN: la url tiene que estar YA en
#     .harness/upstream-issues.jsonl, y ahí solo llega por harness-bug.sh
#     report (que verifica propiedad del artefacto, drift, versión y repro) o
#     record. Sin eso, el knob sería un "confía en mí".
#   · ISSUE CERRADO = WORKAROUND VENCIDO: si gh dice CLOSED, se rechaza (el fix
#     existe: /harness-update). Sin gh o sin red se acepta, pero declarándolo.
#   · UN SOLO SLOT por invocación. Dos bugs del harness a la vez son dos issues
#     y dos corridas: la fricción es deliberada.
#   · NO PERSISTE (env var por invocación) y NO BORRA EL GATE: el rojo del slot
#     ya salió al bus, encima se emite un `assumption`, el sello del precheck
#     gana `known_bug` y la git note de procedencia también.
#
# LOS GATES SERIALES QUEDAN FUERA A PROPÓSITO. El trailer y el carril son sobre
# TUS commits (un bug del harness no te pone un trailer mal), el de disco ya
# tiene su escape con HARNESS_MIN_FREE_GB=0, y gate_test_muerde y el preflight
# corren bajo `set -e` en serie: envolverlos en `if !` desactivaría errexit
# adentro, que es el bug que este archivo ya pagó tres veces.
KNOWN_BUG="${HARNESS_KNOWN_BUG:-}"
KNOWN_BUG_USED=""

LOCKDIR="$WS/locks/$REPO.lock.d"
[ "$CI_MODE" -eq 1 ] || mkdir -p "$WS/locks" "$WS/tasks/$TASK"

# El repo de la INSTANCIA (el workspace) no se shippea por acá: mandar a
# worktree-task con "." producía un callejón sin salida (issue #37) y el
# humano acababa pusheando a mano por fuera del harness.
if [ ! -d "$WS/repos/$REPO/.git" ] && [ "$CI_MODE" -ne 1 ]; then
  echo "❌ '$REPO' no está en repos/ (ver manifest.yaml)."
  echo "   ↳ si intentas publicar el REPO DE LA INSTANCIA (el workspace: specs,"
  echo "     scripts, answers), su puerta es: scripts/instance-ship.sh"
  echo "     Para un repo de producto: clónalo bajo repos/ y regístralo en manifest.yaml"
  exit 2
fi
[ -d "$WT" ] || { echo "❌ no existe el worktree $WT"; echo "   ↳ remediación: scripts/worktree-task.sh $TASK $REPO"; exit 2; }
# En CI no hay clon canonico: el checkout ES el repo, y de ahi salen tanto el
# diff como la baseline de buf. Exigir repos/<repo> ahi seria pedir un layout
# de workspace que un runner de CI no tiene por que tener.
if [ "$CI_MODE" -eq 1 ]; then
  BASE="$WT"
else
  [ -d "$BASE/.git" ] || { echo "❌ no existe el clon base $BASE"; exit 2; }
fi
# ── LA RAMA TRUNK NO SIEMPRE SE LLAMA "main" ──────────────────────────
# Catorce ocurrencias de origin/$BASE_REF en este archivo y seis en
# worktree-task.sh daban por hecho el nombre. Cualquier repo con `master`,
# `trunk` o `develop` (todo GitHub/GitLab pre-2021 sin migrar) moría en la
# creación del worktree con "invalid reference", y de paso block-direct-push
# tampoco protegía esas ramas porque solo bloqueaba `main`.
#
# La técnica correcta ya estaba en el repo: skills-sync.sh resuelve la rama
# por defecto con origin/HEAD desde siempre.
base_branch() {  # base_branch [dir] → la rama trunk del repo, sin prefijo
  local d="${1:-.}" b
  # OJO con `[ ... ] && cmd` bajo `set -e`: si la condición es falsa el
  # AND-list devuelve 1 y MATA el script. Lo aprendimos acá mismo: el
  # precheck salía con exit 128 sin imprimir una línea. Se usa `if`.
  if [ -n "${HARNESS_BASE_BRANCH:-}" ]; then printf '%s' "$HARNESS_BASE_BRANCH"; return 0; fi
  # EL REMOTO ES LA AUTORIDAD (issue #32): origin/HEAD local se escribe UNA
  # vez al clonar, y un `remote set-head` posterior (cualquier flujo que
  # trabaje el clon en otra rama) lo envenena en silencio y para siempre. Se
  # consulta al remoto y se SANA el ref local de paso, para que los lectores
  # que no pueden pagar la red (hooks, change-id) hereden el valor correcto.
  # Offline se cae al ref local: degradar no puede significar inventar.
  b="$(git -C "$d" ls-remote --symref origin HEAD 2>/dev/null \
    | awk '/^ref:/ { sub("refs/heads/", "", $2); print $2; exit }')"
  if [ -n "$b" ]; then
    git -C "$d" remote set-head origin "$b" >/dev/null 2>&1 || true
  else
    b="$(git -C "$d" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')"
  fi
  [ -n "$b" ] || b=main
  printf '%s' "$b"
}
BASE_REF="$(base_branch "$WT")"

# LA RAMA BASE SE VALIDA, NO SE SUPONE. Varios gates comparan contra
# `origin/$BASE_REF` (tests no debilitados, carril, migraciones nuevas) y todos
# envuelven su git en `|| true` para tolerar un repo sin cambios. Si la ref no
# existe, git falla, el `|| true` se lo traga, el diff sale VACÍO y los gates
# pasan en verde SIN HABER MIRADO NADA. Reproducido: con una rama base falsa,
# el precheck imprimía "✅ precheck verde".
#
# Es el mismo patrón que venimos persiguiendo, y aquí desarma justo el gate
# anti-trampa, así que se comprueba una vez, temprano y fuerte.
if ! git -C "$WT" rev-parse --verify --quiet "origin/$BASE_REF" >/dev/null 2>&1; then
  git -C "$WT" fetch origin --quiet 2>/dev/null || true      # worktree stale
  if ! git -C "$WT" rev-parse --verify --quiet "origin/$BASE_REF" >/dev/null 2>&1; then
    echo "❌ no existe la rama base 'origin/$BASE_REF' en $WT."
    echo "   NO puedo correr los gates que comparan contra el trunk: verían un"
    echo "   diff vacío y pasarían en verde sin mirar nada. Eso sería peor que"
    echo "   fallar, así que fallo."
    echo "   ↳ remediación: git -C $WT fetch origin"
    echo "     o exportá HARNESS_BASE_BRANCH con el nombre correcto"
    echo "     (detectado: '$BASE_REF'; ramas remotas: $(git -C "$WT" branch -r 2>/dev/null | tr -d ' ' | tr '\n' ' '))"
    exit 2
  fi
fi

# ── LA ENTREGA LA DECLARA LA INVOCACIÓN, NO EL CHAT ───────────────────
# El dolor que esto cierra: el agente termina de implementar y PREGUNTA en el
# chat "no commiteé ni shippeé, ¿lo llevo por /review + ship?". Esa pregunta ya
# tenía respuesta antes de empezar: /smart entrega para revisar (nada se
# publica), /smart-pr entrega rama + PR, /smart-main entrega directo al trunk.
# La respuesta viaja como DATO en tasks/<id>/state.json (campo `delivery`, con
# el vocabulario del knob flow) y este script la LEE, en vez de esperar que
# alguien la repita en una frase.
#
# Contrato de `delivery-mode <task-dir>` (harness-policy.py): UNA línea con
# review|prs|trunk|flow y exit 0; exit 3 es "no pude mirar". `flow` significa
# que la tarea no declaró entrega: conducta de HOY, manda el flow del
# workspace. Ahí siguen las tareas viejas y /quick, que no cambian de conducta.
#
# Solo en el camino de SHIP: --precheck, --ci y --lang-gates no publican nada,
# así que la entrega declarada no les concierne y no se les pregunta.
#
# El LUGAR importa y está elegido: DESPUÉS de las comprobaciones de "no puedo
# ni empezar" (repo en repos/, worktree, clon base, origin/<trunk>) y muy ANTES
# del lock y del rebase. Arriba de esas comprobaciones, un ship mal invocado
# (el caso real: mandar acá el repo de la INSTANCIA) recibiría un mensaje sobre
# la entrega en vez del error que de verdad tiene, y el humano perdería la
# remediación correcta. Abajo del lock, una tarea que pidió NO publicar dejaría
# el repo serializado y la historia rebaseada antes de decir que no.
DELIVERY=flow
resolve_delivery() {  # → DELIVERY: prs|trunk|flow, o se niega (8 sin publicar, 2 ilegible)
  local out rc=0 line
  out="$(python3 "$WS/scripts/harness-policy.py" --policy "$WS/harness-policy.json" \
    delivery-mode "$WS/tasks/$TASK" 2>&1)" || rc=$?
  # La primera línea, con expansión y sin pipe: el contrato es UNA línea, y con
  # `head` en un pipe bajo `set -o pipefail` una salida larga mata al script por
  # SIGPIPE en vez de contestar. Un motivo extra en stderr no puede convertirse
  # en un modo de entrega inventado, así que solo se mira la primera.
  line="${out%%$'\n'*}"
  line="$(printf '%s' "$line" | tr -d ' \r')"
  if [ "$rc" -ne 0 ] || [ -z "$line" ]; then line=ilegible; fi
  case "$line" in
    prs|trunk|flow)
      DELIVERY="$line"; return 0 ;;
    review)
      # NO es un error: es exactamente lo que pidió la invocación, y por eso
      # lleva código propio. Con un exit 3 (gate rojo) el orquestador saldría a
      # "arreglar" un ship que hizo lo correcto, que es la ronda más cara de
      # todas: la que corrige algo que no está roto.
      echo "🛑 la tarea $TASK declaró entrega SIN publicación (delivery: review)."
      echo "   No es un rojo: es lo que pidió la invocación. Los commits del"
      echo "   worktree se quedan donde están; push, PR y trunk NO ocurren, y"
      echo "   esta corrida no toma el lock de $REPO ni rebasea nada."
      echo "   ↳ para publicar, la entrega se PROMUEVE y queda auditada:"
      echo "     python3 scripts/harness-policy.py delivery tasks/$TASK --to prs --actor humano"
      echo "     (o --to trunk para ir directo al trunk), y después re-corré:"
      echo "     scripts/ship.sh $TASK $REPO"
      exit 8 ;;
  esac
  # Tercer estado: no pude leer la entrega declarada. Caer al flow del workspace
  # sería elegir la puerta por mi cuenta y llamarlo "lo de siempre", que es
  # justo el silencio que este campo existe para cerrar.
  echo "❌ no pude leer la entrega declarada de la tarea $TASK:"
  if [ -n "$out" ]; then printf '%s\n' "$out" | sed 's/^/   · /'
  else echo "   · (el subcomando no imprimió nada y salió $rc)"; fi
  echo "   La entrega decide si este cambio va a una rama, al trunk o a ningún"
  echo "   lado. Sin ese dato NO publico: un default silencioso acá publicaría"
  echo "   justo lo que quizá se pidió no publicar."
  echo "   ↳ remediación: si tu scripts/harness-policy.py no conoce"
  echo "     'delivery-mode', la instancia está atrasada y hay que actualizarla."
  echo "     Si lo conoce, revisá que tasks/$TASK/state.json exista y sea JSON"
  echo "     legible (arriba está lo que contestó el subcomando)."
  echo "     Mientras tanto scripts/ship.sh --precheck $TASK $REPO corre igual:"
  echo "     el precheck no publica, así que no depende de esto."
  exit 2
}
if [ "$PRECHECK" -eq 0 ] && [ "$LANG_ONLY" -eq 0 ] && [ "$CI_MODE" -eq 0 ]; then
  resolve_delivery
fi
# El flujo a main que el humano eligió en la entrevista. Este script implementa
# tres (trunk, trunk-merge-commit, prs) y con cualquier otro falla CERRADO: la
# respuesta se ofrecía, se registraba en harness-answers.yaml y NADIE la leía,
# así que quien eligió "prs" por política de su empresa recibía commits directos
# a main, en silencio. Fingir un flujo que no está implementado cambiaría también
# lo que significa "shippeado" para deploy-watch y para /archive, y produciría un
# archive que fusiona specs de un cambio que sigue sin mergear. El que configuró
# otra cosa se entera acá y no en producción.
FLOW="{{FLOW}}"
# ── EL FLOW VIGENTE ES EL DEL ANSWERS, NO EL SELLADO AL INSTALAR ──────
# Caso de campo (#67): {{FLOW}} se sustituye UNA sola vez, en la instalación, y
# ship.sh no volvía a abrir el archivo. Editar harness-answers.yaml no cambiaba
# nada hasta el próximo /harness-update, así que quien pedía merge commit para
# poder revertir de un tirón recibía un fast-forward SIN UNA LÍNEA DE AVISO y se
# enteraba mirando el grafo después de publicar. Y el rechazo de más abajo decía
# "harness-answers.yaml declara flow: X" nombrando un archivo que jamás había
# leído: la decisión registrada era decorativa y el mensaje sostenía que no.
#
# Ahora manda el archivo, que es el registro canónico de la entrevista, y el
# valor sellado queda de respaldo para la instancia que no lo tenga (o que le
# haya borrado el knob). FLOW_SRC viaja con el valor para que el rechazo nombre
# de dónde salió de verdad.
FLOW_SRC="scripts/ship.sh (el valor sellado al instalar)"
flow_declared=""
if [ -n "${WS:-}" ] && [ -f "$WS/harness-answers.yaml" ]; then
  # `flow` es un knob de primer nivel: se ancla en la columna 0 para no
  # confundirlo con una clave homónima anidada bajo otro bloque.
  flow_declared="$(awk '
    /^flow:/ {
      v=$0; sub(/^flow:[[:space:]]*/, "", v)   # el valor
      sub(/[[:space:]]*#.*$/, "", v)           # comentario al margen
      gsub(/["\047]/, "", v)                   # comillas de cualquier signo
      sub(/[[:space:]]+$/, "", v)
      print v; exit
    }' "$WS/harness-answers.yaml" 2>/dev/null || true)"
  # Un placeholder sin sustituir en el answers no es una respuesta: esa
  # instancia se generó a medias y el sellado es mejor dato que un literal.
  case "$flow_declared" in *'{{'*) flow_declared="" ;; esac
fi
if [ -n "$flow_declared" ]; then
  FLOW="$flow_declared"
  FLOW_SRC="harness-answers.yaml"
fi
# La grafía varía (la entrevista ofrecía "trunk direct-to-prod" y el answers
# documenta "trunk-direct-to-prod"), así que se normaliza en vez de exigir una
# forma exacta. Un placeholder sin sustituir o vacío se trata como trunk: es
# lo que este script hace y lo que hacen todas las instancias de hoy, y un
# placeholder crudo es un problema de generación que le toca al doctor, no un
# motivo para frenar un ship.
flow_norm="$(printf '%s' "$FLOW" | tr 'A-Z' 'a-z' | tr -d ' +_-')"
# ── trunk con MERGE COMMIT: para poder deshacer de un tirón ───────────
# Caso de campo (#58): un humano autoriza un cambio grande que toca dos repos y
# se propaga por tokens a ocho frontends, y pide poder revertirlo si no le
# gusta. Con fast-forward, revertir exige conocer el rango exacto
# (`git revert --no-commit <pre>..<post>`), que el humano no tiene a mano y el
# harness no le entregaba en ningún lado. Con un merge commit es UN comando:
# `git revert -m 1 <sha>`.
#
# Antes no había camino legítimo: hacer el merge a mano viola la Ley 1 (a main
# solo por ship.sh) y el hook lo bloquea, y cambiar la entrega a `prs` para
# mergear con --merge contradice la entrega que la invocación registró. O sea
# el hueco exacto que describe la Ley 15: si no existe un camino legítimo, al
# harness le falta uno.
LAND_MERGE=0
case "$flow_norm" in
  trunk|trunkdirecttoprod|""|'{{flow}}') FLOW_MODE=trunk ;;
  trunkmergecommit|trunkmerge) FLOW_MODE=trunk; LAND_MERGE=1 ;;
  prs|pr) FLOW_MODE=prs ;;
  *)
    echo "❌ $FLOW_SRC declara flow: $FLOW, y ship.sh implementa tres:"
    echo "   'trunk' (push directo tras los gates), 'trunk-merge-commit' (igual,"
    echo "   pero aterriza con un merge commit para poder revertir de un tirón)"
    echo "   y 'prs' (rama + PR)."
    echo "   NO voy a pushear a espaldas de una política que dice otra cosa."
    echo "   ↳ opciones: poné flow a 'trunk', 'trunk-merge-commit' o 'prs' en"
    echo "     harness-answers.yaml (se relee en cada corrida: no hace falta"
    echo "     re-instanciar), o abrí el PR a mano desde la rama task/<id> tras"
    echo "     un --precheck verde."
    exit 7 ;;
esac
# ── La entrega de la TAREA manda sobre el default de la INSTANCIA ─────
# `flow` es lo que este workspace hace por defecto; `delivery` es lo que se
# pidió para ESTE trabajo. Cuando la tarea declaró prs o trunk, esa es la
# puerta: seguir el default sería publicar distinto de lo que pidió la
# invocación. La entrega solo elige entre las dos puertas implementadas, así
# que un flow que ship.sh no implementa sigue siendo el rojo de arriba: no se
# publica a espaldas de una política rota, ni con delivery declarado.
case "$DELIVERY" in
  prs|trunk)
    if [ "$DELIVERY" != "$FLOW_MODE" ]; then
      echo "ℹ️  entrega declarada de $TASK: $DELIVERY (manda sobre flow: $FLOW_MODE del workspace)"
    fi
    FLOW_MODE="$DELIVERY" ;;
esac
# fin-puerta-efectiva (marcador: tests/test_ship_gates.sh extrae hasta acá)

# El bus: lo que este gate decide se cuenta. Fail-open — si emit.sh no está,
# ship.sh funciona igual (el bus es observación, no control).
# shellcheck source=/dev/null
[ -f "$WS/scripts/emit.sh" ] && . "$WS/scripts/emit.sh" || emit() { :; }

# El acotador de sondas. NO es fail-open como el bus: una sonda sin límite es
# el modo de falla #57 (25 minutos colgado a 1% de CPU, sin una línea), así que
# si el helper falta se DICE y se sigue sin límite, en vez de fingir que hay uno.
# shellcheck source=/dev/null
if [ -f "$WS/scripts/bounded.sh" ]; then
  . "$WS/scripts/bounded.sh"
else
  run_bounded() {
    echo "⚠️  falta scripts/bounded.sh: esta sonda corre SIN límite de tiempo" >&2
    shift 2; "$@"
  }
fi

# Instrumentación en UN solo punto: si estamos empezando un gate, el anterior
# pasó. El trap sabe cuál falló. Cero riesgo de olvidarse de instrumentar uno.
#
# ── CUÁNTO TARDÓ, MEDIDO CON `SECONDS` Y NO CON `date` ────────────────
# `SECONDS` es un BUILTIN de bash (desde el 3.2, el de macOS): leerlo no
# cuesta un fork ni una syscall, es una variable que el shell ya mantiene.
# `date` costaría un fork+exec POR CADA gate DE CADA repo, y esto corre en el
# camino caliente: la medición no puede pagarse con velocidad de ship. Se
# emite como el 5º argumento de emit (`dur`), en vez de dejar que el panel lo
# derive restando timestamps: con dos ships de la misma tarea intercalados en
# el bus esa resta le atribuye el tiempo al gate equivocado.
# El 4º argumento va vacío a propósito: emit hace `${4:-${TASK:-}}`, así que
# "" es idéntico a no pasarlo, y es la única forma de llegar al 5º.
gate() {
  [ -n "${CURRENT_GATE:-}" ] && [ "$CURRENT_GATE" != "preflight" ] \
    && emit gate "$CURRENT_GATE" true "" "$((SECONDS - ${_G0:-$SECONDS}))"
  echo "── gate: $1 ──"; CURRENT_GATE="$1"; _G0=$SECONDS
}

# El error de un gate es un PROMPT: al fallar cualquier gate, el trap
# imprime la instrucción de autocorrección (el agente que lee esto
# arregla en una iteración, sin adivinar). También libera el lock.
# _G0: el `SECONDS` en que arrancó el gate en curso. Se declara ACÁ, junto a
# CURRENT_GATE y ANTES de armar el trap: bajo `set -u` una variable sin
# declarar mata el script, y on_exit puede dispararse antes del primer gate().
# Igual cada uso lleva ${_G0:-$SECONDS} (dur 0), porque los tests extraen
# estas funciones sueltas y una función que solo corre "en contexto" no es
# verificable.
CURRENT_GATE="preflight"; LOCK_HELD=""; _G0=$SECONDS
# ── "OK" NO ES "VERIFICADO" ───────────────────────────────────────────
# El sello decía solo {commit, ok}, y un precheck donde NINGÚN gate de lenguaje
# llegó a compilar ni testear (stack no reconocido, toolchain ausente) sellaba
# el MISMO ok:true que un verde con la suite corrida. Desde el sello los dos
# eran indistinguibles, así que /review los trataba igual: el aviso existía,
# pero solo en stdout, que ningún consumidor parsea. Es el "UNKNOWN se
# convierte en PASS" de HARDENING, en el único artefacto que sobrevive a la
# corrida.
#
# `ok` NO cambia de significado ni se endurece: sigue siendo "ningún gate dijo
# que no", y un repo de docs sin stack no es un rojo. Convertirlo en rojo
# fabricaría falsos rojos, que es la mitad simétrica del mismo defecto. Lo que
# gana el sello es decir CUÁNTO miró, para que el reviewer no tenga que
# adivinarlo.
#
# Tercer estado, no dos: si el marcador no está (los gates corrieron sin
# evidence.py, así que nadie dejó rastro de si algo se ejecutó), el sello dice
# "desconocido". "No pude saberlo" no es "no corrió nada" ni "corrió todo".
# CALIBRADO PARA SELLOS VERDES. TESTS_RAN=1 se asigna DESPUÉS de que el tramo
# pasa (`cargo test; TESTS_RAN=1`), así que una suite que corrió y FALLÓ deja el
# marcador en 0 y este campo dice "ninguno" en un sello ok:false. Es aceptable
# porque el único consumidor (/review) actúa sobre ok:true y ahí la asignación
# ya ocurrió; en un rojo el motivo lo da el gate que falló, no este campo. Queda
# DICHO para que nadie lo lea como "en el rojo tampoco corrió nada".
precheck_verificado() {  # → completo | ninguno | desconocido
  local m="$WS/tasks/$TASK/.langseen-$REPO" v
  # El marcador lo escribe el trap de la corrida `--lang-gates` con el valor de
  # TESTS_RAN: 1 = algún tramo compiló o testeó de verdad, 0 = ninguno.
  if [ ! -r "$m" ]; then printf 'desconocido'; return 0; fi
  if ! v="$(tr -d ' \n' < "$m")"; then printf 'desconocido'; return 0; fi
  # El orden del case ES la clasificación. Con `0)` primero y `*)` al final,
  # todo contenido raro que no fuera exactamente "0" caía en "completo": "00",
  # "10" y "2" sellaban un verde verificado que nadie escribió. Ahora se
  # descarta primero lo ilegible, después se exige un dígito 1-9 de verdad, y
  # "solo ceros" es el resto. Ningún patrón acá usa extglob: bash 3.2 lo corre.
  case "$v" in
    ''|*[!0-9]*)    printf 'desconocido' ;;
    *[1-9]*)        printf 'completo' ;;
    *)              printf 'ninguno' ;;
  esac
}
# El rastro del bug conocido, en formato JSON y en UN solo lugar: lo comparten
# el sello del precheck y ship.log. Es ADITIVO (vacío cuando no hubo knob) para
# no tocar el schema 1 ni los consumidores, que leen con jq y toleran claves
# nuevas. Tres copias de este printf serían tres formatos que tarde o temprano
# dejan de coincidir, y el que audita compara literales.
known_bug_frag() {  # → ,"known_bug":{...}  o vacío si no se usó el knob
  [ -n "$KNOWN_BUG_USED" ] || return 0
  printf ',"known_bug":{"slot":"%s","url":"%s"}' \
    "${KNOWN_BUG_USED%%=*}" "${KNOWN_BUG_USED#*=}"
}
stamp_precheck() {  # stamp_precheck <ok:true|false>: sello que /review lee
  local ok="$1" head verificado
  head="$(git -C "$WT" rev-parse HEAD 2>/dev/null || echo unknown)"
  verificado="$(precheck_verificado)"
  printf '{"schema":1,"task_id":"%s","repo":"%s","commit":"%s","ok":%s,"verificado":"%s","at":"%s"%s}\n' \
    "$TASK" "$REPO" "$head" "$ok" "$verificado" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    "$(known_bug_frag)" \
    > "$WS/tasks/$TASK/precheck-$REPO.json"
}
# ── LA EVIDENCIA DEL REPO, ¿MIRA AL COMMIT QUE ESTOY SELLANDO? ────────
# Caso de campo, dos veces en la misma sesión: el precheck selló ok:true sobre
# el hijo mientras las ÚNICAS evidencias del repo apuntaban al padre. El
# desalineamiento lo cazaba recién verdict-scaffold.sh, o sea DESPUÉS de lanzar
# la ronda de review: cuando se veía, la ronda ya estaba pagada. Y con
# --allow-empty el scaffold pasa igual, así que el aviso llegaba a veces nunca.
#
# ES UN OBSERVADOR, NO UN GATE: avisa y el precheck sigue verde. Ponerlo en rojo
# sería la mitad simétrica del defecto que este script ya rechazó más arriba (un
# repo sin stack no puede sellar evidencia en HEAD y eso es legítimo). Por la
# misma ley de familias, acá TODO va dentro de `if` o con `|| true`: un
# observador que mata el precheck mezcla las dos familias que CONTRIBUTING
# separa a propósito.
#
# El rebase puro NO cuenta como desalineamiento: la evidencia sellada sobre otra
# base con el MISMO patch_id es la misma prueba del mismo cambio (es lo que
# acepta evidence.py y lo que mira el predicado del scaffold). Avisar ahí sería
# fabricar una falsa alarma justo en el caso que el harness ya resolvió.
aviso_evidencia_desalineada() {
  local dir="$WS/tasks/$TASK/evidence" f head pid c p en_head=0 viejas=0
  [ -d "$dir" ] || return 0
  head="$(git -C "$WT" rev-parse HEAD 2>/dev/null || true)"
  [ -n "$head" ] || return 0
  pid="$(bash "$WS/scripts/change-id.sh" "$WT" "$BASE_REF" 2>/dev/null || true)"
  for f in "$dir"/EV-*.json; do
    [ -f "$f" ] || continue
    c="$(jq -r --arg t "$TASK" --arg r "$REPO" \
      'select(.task_id==$t and .repo==$r) | .commit // ""' "$f" 2>/dev/null || true)"
    [ -n "$c" ] || continue
    p="$(jq -r '.patch_id // ""' "$f" 2>/dev/null || true)"
    if [ "$c" = "$head" ] || { [ -n "$pid" ] && [ "$p" = "$pid" ]; }; then
      en_head=$((en_head+1))
    else
      viejas=$((viejas+1))
    fi
  done
  [ "$viejas" -gt 0 ] && [ "$en_head" -eq 0 ] || return 0
  echo "   ⚠️  las $viejas evidencia(s) de $REPO NO apuntan al HEAD que acabo de sellar"
  echo "      (${head}): son de otro commit y ninguna es del cambio actual."
  echo "      El sello dice que los gates pasaron acá, pero la prueba citable es de antes."
  echo "      Si entregás así, verdict-scaffold.sh lo caza DESPUÉS, con la ronda pagada."
  echo "      ↳ remediación: re-sellá la prueba sobre este HEAD:"
  echo "        python3 scripts/evidence.py run --task-dir tasks/$TASK --repo $REPO \\"
  echo "          --runner <implementer> --kind test --cwd worktrees/$TASK/$REPO -- <comando de test>"
  emit assumption "precheck de $REPO: $viejas evidencia(s) de otro commit y ninguna del HEAD sellado"
}
# ── Procedencia: qué harness, de qué máquina, con qué gates ───────────
# Con varios workspaces, los gates corren en la laptop del que pushea y NADA
# en el remoto compartido dice cuál de ellos, con qué versión ni con qué set de
# reglas. Un workspace atrasado (o retocado) shippea con gates más débiles y su
# commit en main queda indistinguible de los demás.
#
# Una git note lo deja auditable DESDE EL REMOTO sin reescribir la historia
# (que rompería el patch_id y de paso el trailer). Es best-effort a propósito:
# no poder anotar la procedencia no es motivo para deshacer un push que ya
# pasó todos los gates. La solución de fondo es correr los gates en CI
# (flow: prs), donde este problema deja de existir por construcción.
stamp_provenance() {  # stamp_provenance <sha-completo>
  local sha="$1" ver="?" man="?" who kbnote=""
  # Si este commit pasó con un gate declarado como bug conocido, la nota tiene
  # que decirlo: es el ÚNICO rastro que viaja con el commit al remoto, y sin él
  # un cambio que se saltó un slot queda indistinguible de uno que no.
  if [ -n "$KNOWN_BUG_USED" ]; then
    kbnote="
known_bug: ${KNOWN_BUG_USED#*=}"
  fi
  # `if` y no `[ ... ] && VAR=...`: es la regla de la casa por el set -e, y ya
  # costó un exit 128 sin una línea de salida en este mismo archivo.
  if [ -f "$WS/harness-answers.yaml" ]; then
    ver="$(awk -F'"' '/^harness_version:/ {print $2; exit}' "$WS/harness-answers.yaml" 2>/dev/null || echo "?")"
  fi
  # El digest del set de templates vive en `.harness-templates` de la INSTANCIA,
  # que es lo que escribe el generador. `templates/MANIFEST.sha256` es la ruta
  # del repo del PLUGIN y en una instancia no existe: leerla de ahí habría
  # dejado siempre "?" y la nota de procedencia no habría servido para lo único
  # que existe, distinguir un workspace atrasado de uno al día.
  if [ -f "$WS/.harness-templates" ]; then
    man="$(tr -d ' \n' < "$WS/.harness-templates" 2>/dev/null | cut -c1-16 || echo "?")"
  fi
  who="$(id -un 2>/dev/null || echo "?")@$(hostname -s 2>/dev/null || echo "?")"
  git notes --ref=harness add -f -m "harness_version: $ver
gates_manifest: $man
workspace: $who
task: $TASK$kbnote" "$sha" >/dev/null 2>&1 || return 0
  git push origin refs/notes/harness >/dev/null 2>&1 \
    || echo "   ℹ️  procedencia anotada localmente; no pude publicarla (git push origin refs/notes/harness)"
}

# ── LA FASE LA REGISTRA EL HECHO, NO EL RECORDATORIO ──────────────────
# `review → ship` era prosa en el prompt de /ship y de /smart. Si el orquestador
# se la olvidaba (y se la olvidaba), state.json quedaba en `review` con el
# codigo ya en main: quien auditara por el estado reconstruia una historia
# falsa, y un /smart <task-id> posterior re-entraba a revisar algo publicado.
# Verificado en dos corridas reales.
#
# POLICY-SHIP-004 ya encierra la condicion correcta (no se avanza hasta que
# TODOS los repos con veredicto shippearon), asi que esto se intenta despues de
# cada repo y solo prospera en el ultimo. La regla no se duplica aca.
#
# FAIL-OPEN A PROPOSITO: el push YA ocurrio. Si la contabilidad falla, el cambio
# esta igual de publicado, y salir en rojo aqui diria que el ship fallo cuando
# no fallo. Se avisa fuerte y se sigue.
request_ship_phase() {
  local out rc=0
  [ -f "$WS/tasks/$TASK/state.json" ] || return 0
  out="$(python3 "$WS/scripts/harness-policy.py" --policy "$WS/harness-policy.json" \
        transition "$WS/tasks/$TASK" ship --actor ship.sh 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "   fase: review → ship (la registró el push, no el prompt)"
    return 0
  fi
  case "$out" in
    *POLICY-SHIP-004*)
      echo "   fase: sigue en review, faltan repos por shippear (es lo correcto)" ;;
    *POLICY-TRANSITION-001*)
      echo "   fase: ya estaba avanzada, no la muevo" ;;
    *)
      echo "   ⚠️  no pude registrar la fase: $(printf '%s' "$out" | head -1)"
      echo "      El push SÍ ocurrió. Registrala a mano o el estado va a mentir." ;;
  esac
  return 0
}

# Un rojo por falta de disco no es del código: el compilador que no puede
# escribir su objeto y el runner sin espacio para su cache salen != 0 igual que
# un test roto, y el agente quema su presupuesto de autofix persiguiendo un bug
# que no existe. Caso de campo (COR-567): el disco raíz lleno puso en rojo
# gates de varios workspaces a la vez y ningún mensaje lo dijo.
#
# CONTEXTUALIZA, no juzga: se llama SOLO en los caminos rojos, no cambia el exit
# code ni el sello, y si df no está o contesta cualquier cosa se calla. Un aviso
# que pudiera tumbar el trap sería peor que el problema que describe.
disco_avisa() {
  local libre
  libre="$(df -Pk "$WS" 2>/dev/null | awk 'NR == 2 { print $4 }')"
  case "$libre" in ''|*[!0-9]*) return 0 ;; esac
  [ "$libre" -lt 1048576 ] || return 0
  echo "   ⚠️  quedan $((libre / 1024)) MB libres en el disco del workspace:"
  echo "      este rojo puede ser por FALTA DE DISCO, no por tu código."
  echo "      Libera espacio ANTES de tocar nada (docker system prune, worktrees"
  echo "      viejos) y re-corre: un fix sobre un rojo ambiental es ruido que"
  echo "      después hay que revertir."
  emit assumption "$REPO: gate '${CURRENT_GATE:-?}' rojo con menos de 1 GB libre (posible causa ambiental)"
}
on_exit() {
  local rc=$?
  # El marcador se escribe DESDE EL TRAP, no después de llamar a run_lang_gates.
  # Es la unica forma de conservar `set -e` sobre los gates: cualquier
  # construccion tipo `run_lang_gates || rc=$?` DESACTIVA set -e dentro de la
  # funcion, y entonces un `pytest` que falla no aborta, los gates siguientes
  # corren igual y la funcion devuelve 0. Reproducido: el precheck imprimia
  # "verde" con la suite rota Y sellaba evidencia con exit_code 0.
  if [ "${LANG_ONLY:-0}" -eq 1 ]; then
    printf '%s' "${TESTS_RAN:-0}" > "$WS/tasks/$TASK/.langseen-$REPO" 2>/dev/null || true
  fi
  [ -n "$LOCK_HELD" ] && rm -rf "$LOCKDIR"
  if [ "$rc" -eq 0 ]; then
    [ -n "${CURRENT_GATE:-}" ] && emit gate "$CURRENT_GATE" true "" "$((SECONDS - ${_G0:-$SECONDS}))"
    return 0
  fi
  if [ "$PRECHECK" -eq 1 ] && [ "${CI_MODE:-0}" -eq 0 ]; then
    stamp_precheck false
    emit gate "precheck de $REPO rojo ($CURRENT_GATE): ronda de review AHORRADA" false "" "$((SECONDS - ${_G0:-$SECONDS}))"
    echo ""
    echo "⛔ precheck rojo en '$CURRENT_GATE' (exit $rc). NO entregues a review."
    echo "   → Los errores completos están arriba. Corrígelos TODOS en una"
    echo "     iteración (el error de cada gate trae su remediación) y re-corre"
    echo "     scripts/ship.sh --precheck $TASK $REPO."
    echo "   → ¿El rojo es del HARNESS y no de tu cambio (el gate revienta, o hace"
    echo "     lo contrario de lo que su cabecera documenta)? Entonces NO arregles"
    echo "     el harness, NO lo pruebes, NO lo toques: no es tu tarea. El camino:"
    echo "     1. scripts/harness-bug.sh report --title ... --file ... --repro ... --impact ..."
    echo "     2. HARNESS_KNOWN_BUG='<slot>=<url-del-issue>' scripts/ship.sh --precheck $TASK $REPO"
    echo "     3. seguí con TU tarea; el fix del harness es de sus mantenedores."
    echo "   → Esto NO consume presupuesto de loop: el reviewer todavía no vio nada."
    disco_avisa
    return 0
  fi
  # UN GATE QUE BLOQUEA ES LA MEJOR NOTICIA DEL SISTEMA: es la prueba de que el
  # harness frena a su propio agente. Se cuenta igual de fuerte que un éxito.
  emit gate "$CURRENT_GATE — BLOQUEÓ el ship de $REPO (exit $rc)" false "" "$((SECONDS - ${_G0:-$SECONDS}))"
  echo ""
  echo "⛔ gate '$CURRENT_GATE' falló (exit $rc)."
  echo "   → Lee el error de arriba. Corrige SOLO eso en el worktree $WT,"
  echo "     commitea con el trailer 'Task: $TASK' y re-corre ship.sh."
  echo "   → ¿El rojo es del HARNESS y no de tu cambio (el gate revienta, o hace"
  echo "     lo contrario de lo que su cabecera documenta)? Entonces NO arregles"
  echo "     el harness, NO lo pruebes, NO lo toques: no es tu tarea. El camino:"
  echo "     1. scripts/harness-bug.sh report --title ... --file ... --repro ... --impact ..."
  echo "     2. HARNESS_KNOWN_BUG='<slot>=<url-del-issue>' scripts/ship.sh $TASK $REPO"
  echo "     3. seguí con TU tarea; el fix del harness es de sus mantenedores."
  echo "   → Presupuesto de autofix: 2 rondas. Si esta es la tercera, PARA"
  echo "     y escala a humano con el error completo (Ley 6)."
  disco_avisa
}
trap on_exit EXIT

# ── Lock por repo: merge queue de pobre, portable (sin flock) ─────────
# Dos ventanas de muerte que hay que cerrar (las dos costaron un lock inmortal):
#   1. mkdir OK → SIGKILL → pid nunca escrito. El reclamo de huérfanos exigía
#      [ -f pid ], así que un lock sin pid no era reclamable por NADIE: todo
#      ship futuro de ese repo esperaba 10 min y moría, para siempre, hasta que
#      un humano hiciera rm -rf. Reproducido antes de arreglarlo.
#   2. mkdir OK → fallo → el trap corría con LOCK_HELD vacío y no limpiaba.
#      LOCK_HELD se marca AHORA justo después del mkdir, no después del pid.
pid_alive() {  # pid_alive <pid> → 0 vivo · 1 muerto · 2 no se pudo saber
  # `kill -0` falla en TRES casos y antes se leían todos como "muerto":
  #   · el proceso no existe          → muerto de verdad
  #   · el pid está vacío o corrupto  → NO se pudo saber
  #   · EPERM: existe pero es de otro usuario → está VIVO, y liberar su lock
  #     mete dos ships concurrentes en el mismo repo
  # Ante la duda se conserva el lock: esperar de más cuesta minutos, robarlo
  # cuesta una carrera de rebase contra main.
  case "${1:-}" in ''|*[!0-9]*) return 2 ;; esac
  if kill -0 "$1" 2>/dev/null; then return 0; fi
  # EPERM: el proceso EXISTE pero es de otro usuario, o sea que está VIVO. El
  # texto varía por shell e idioma ("Operation not permitted", "permission
  # denied", "no permitido"), así que se normaliza a minúsculas y se cubren
  # las formas conocidas. Ante un mensaje que no reconocemos, se devuelve
  # "no se pudo saber" (2), no "muerto": el sesgo va siempre a conservar.
  err="$(kill -0 "$1" 2>&1 || true)"
  low="$(printf '%s' "$err" | tr 'A-Z' 'a-z')"
  case "$low" in
    *"not permitted"*|*permission*|*permitida*|*permitido*|*permiso*) return 0 ;;
    *"no such process"*|*"no existe"*|*"proceso"*) return 1 ;;
    "") return 1 ;;
    *) return 2 ;;
  esac
}
acquire_lock() {
  local waited=0 nopid=0
  until mkdir "$LOCKDIR" 2>/dev/null; do
    if [ -f "$LOCKDIR/pid" ]; then
      # lock huérfano: el proceso dueño ya no existe
      lpid="$(cat "$LOCKDIR/pid" 2>/dev/null)"
      # `pid_alive "$lpid"; alive_rc=$?` MATABA EL SCRIPT. pid_alive devuelve 1
      # (muerto) o 2 (ilegible) como valores de DATO, no como error, pero es una
      # sentencia suelta en el cuerpo del until y ahi `set -e` si aplica: con un
      # lock huerfano el script salia con exit 1 sin imprimir una linea, el trap
      # lo reportaba como "preflight", y como LOCK_HELD estaba vacio el lock
      # SOBREVIVIA. O sea que todo el camino de reclamo era codigo muerto y el
      # repo quedaba trabado para siempre hasta un rm -rf a mano. Reproducido.
      # Con `if` el valor se lee sin que errexit lo confunda con un fallo.
      if pid_alive "$lpid"; then alive_rc=0; else alive_rc=$?; fi
      if [ "$alive_rc" -eq 1 ]; then
        echo "⚠️  lock huérfano de pid $lpid (proceso inexistente); lo reclamo"
        rm -rf "$LOCKDIR"; nopid=0; continue
      elif [ "$alive_rc" -eq 2 ]; then
        echo "⚠️  el pid del lock es ilegible ('$lpid'): NO lo reclamo. 'No pude"
        echo "   mirar' no es 'está muerto'. Si el dueño de verdad murió:"
        echo "   rm -rf $LOCKDIR"
      fi
      nopid=0
    else
      # Sin pid: o el dueño está EN la ventana de adquisición (microsegundos),
      # o murió dentro de ella y el lock quedó inmortal. Damos gracia; si a los
      # 15s sigue sin pid, no hay dueño vivo que lo vaya a escribir.
      nopid=$((nopid+1))
      if [ "$nopid" -ge 15 ]; then
        echo "⚠️  lock sin pid tras 15s — huérfano de una muerte en la ventana de adquisición; lo reclamo"
        rm -rf "$LOCKDIR"; nopid=0; continue
      fi
      sleep 1; continue
    fi
    waited=$((waited+3))
    [ "$waited" -ge 600 ] && { echo "❌ lock de $REPO ocupado >10min ($LOCKDIR) — otro ship en curso"; exit 6; }
    sleep 3
  done
  LOCK_HELD=1                 # ANTES del pid: si morimos ahora, el trap limpia
  echo $$ > "$LOCKDIR/pid"
}

# ── Gates ─────────────────────────────────────────────────────────────
gate_trailer() {
  gate "trailer Task: $TASK"
  local total with_trailer
  total=$(git rev-list --count origin/$BASE_REF..HEAD)
  [ "$total" -gt 0 ] || { echo "❌ no hay commits nuevos sobre origin/$BASE_REF"; exit 3; }
  with_trailer=$(git log origin/$BASE_REF..HEAD --format=%B | grep -cE "^Task: $TASK\$" || true)
  [ "$with_trailer" -ge "$total" ] || {
    echo "❌ $((total-with_trailer)) de $total commits sin trailer 'Task: $TASK'"
    echo "   ↳ remediación: git rebase origin/$BASE_REF --exec 'git commit --amend --no-edit --trailer \"Task: $TASK\"'"
    exit 3
  }
}

# gate_lane — el carril lo declara el intake; el diff lo confirma este gate.
# express prometió: un solo repo (implícito: el worktree ES un repo), cero
# contratos, cero migraciones, cero infra. Si el diff rompe la promesa, el
# ship no pasa: la tarea escala de carril y re-entra por /rfc. Equivocarse
# de carril cuesta una re-entrada — jamás un ship sin la deliberación que
# tocaba. Por esto los carriles no relajan la seguridad: la clasificación
# del intake es una propuesta; este gate es quien la verifica.
#
# quick promete lo mismo que express y ADEMÁS un tamaño: es la promesa más
# barata de romper sin darse cuenta, porque nadie decide "voy a tocar 40
# archivos", se llega ahí de a uno. Por eso el techo lo mide este gate y no la
# buena memoria de quien implementa.
gate_lane() {
  gate "carril (lane)"
  local st="$WS/tasks/$TASK/state.json" lane
  lane="$(jq -r '.lane // "full"' "$st" 2>/dev/null || echo full)"
  # quick hereda ENTERA la lista de prohibiciones de express: recorta
  # deliberación, no verificación, así que lo que express no se permite
  # tampoco se lo permite un carril todavía más corto. Los carriles con
  # deliberación (standard, full) no pasan por acá: ahí un .proto ya se
  # discutió, y este gate no tiene nada que decir.
  case "$lane" in
    express|quick) ;;
    *) return 0 ;;
  esac
  local pat="${LANE_GUARD_PATTERN:-(\.proto\$|(^|/)proto/|(^|/)migrations?/|\.sql\$|(^|/)helm/|(^|/)charts/|(^|/)terraform/|(^|/)openapi\.|(^|/)swagger\.)}"
  local hits
  # Tres puntos: el carril promete sobre EL CAMBIO DE LA RAMA. Con dos puntos se
  # comparan las PUNTAS, así que un .proto que el trunk sumó después del branch
  # point aparece en el diff de esta rama y rompe una promesa que nadie hizo.
  hits="$(git diff "origin/$BASE_REF...HEAD" --name-only | grep -E "$pat" || true)"
  if [ -n "$hits" ]; then
    echo "❌ carril $lane, pero el diff toca contratos/migraciones/infra:"
    echo "$hits" | sed 's/^/   · /'
    echo "   ↳ remediación: este cambio SÍ necesita deliberación. Escala el carril:"
    echo "     python3 scripts/harness-policy.py escalate tasks/$TASK --to standard --actor orchestrator"
    echo "     y corre /rfc $TASK — el trabajo hecho se conserva en el worktree."
    exit 3
  fi
  [ "$lane" = "quick" ] || return 0
  gate_quick_size
}

# El techo de quick es DATO del policy, no una constante acá: un número
# cableado en el gate no se puede ajustar por instancia, y quien lo intente
# editaría harness-policy.json creyendo que sirve de algo. harness-policy.py
# es la autoridad sobre ese archivo (mismo motivo que evidence-policy): un jq
# propio en este script sería una segunda lectura del mismo dato, o sea una
# oportunidad de divergir justo en el gate que decide si el diff cumplió.
#
# Contrato de `lane-limits <carril>`: una línea clave=valor por techo y exit 0.
# Cualquier otra cosa (exit != 0 por policy roto, subcomando ausente en una
# instancia vieja, stdout sin números) NO se puede leer como "sin techo":
# quick promete un diff chico y el único que lo mide es este gate, así que un
# techo que no se pudo leer es un tercer estado, ni verde ni exceso.
gate_quick_size() {
  local lim lim_rc=0 max_files max_lines nums diff_rc=0 counts files lines
  lim="$(python3 "$WS/scripts/harness-policy.py" --policy "$WS/harness-policy.json" \
    lane-limits quick 2>&1)" || lim_rc=$?
  if [ "$lim_rc" -eq 0 ]; then
    max_files="$(printf '%s\n' "$lim" | sed -n 's/^max_files=\([0-9][0-9]*\)$/\1/p' | head -1)"
    max_lines="$(printf '%s\n' "$lim" | sed -n 's/^max_lines=\([0-9][0-9]*\)$/\1/p' | head -1)"
  fi
  if [ -z "${max_files:-}" ] || [ -z "${max_lines:-}" ]; then
    echo "❌ carril quick, pero no pude leer los límites del carril quick:"
    printf '%s\n' "$lim" | sed 's/^/   · /'
    echo "   Sin techos no hay promesa que verificar, y un techo inventado acá"
    echo "   sería peor que ninguno: diría que el diff cabe en un número que"
    echo "   nadie declaró."
    echo "   ↳ remediación: si tu scripts/harness-policy.py no conoce"
    echo "     'lane-limits', es anterior a quick y hay que actualizar la"
    echo "     instancia. Si lo conoce, revisá que harness-policy.json declare"
    echo "     workflow.lanes.quick.limits con max_files y max_lines enteros."
    exit 3
  fi
  # Contra el MERGE-BASE (tres puntos), no contra la punta del trunk: en el
  # camino de ship el rebase ya los iguala, pero el precheck corre sin rebase y
  # ahí la punta trae commits ajenos que este cambio jamás tocó. Cobrárselos al
  # carril mandaría a escalar por trabajo de otro.
  nums="$(git diff --numstat "origin/$BASE_REF...HEAD" 2>&1)" || diff_rc=$?
  if [ "$diff_rc" -ne 0 ]; then
    echo "❌ carril quick, pero no pude medir el diff contra origin/$BASE_REF:"
    printf '%s\n' "$nums" | sed 's/^/   · /'
    echo "   Un carril con techos que no puede contar no verifica nada, y salir"
    echo "   verde de acá sería afirmar un tamaño que nadie midió."
    echo "   ↳ remediación: corré 'git fetch origin' en el worktree y verificá"
    echo "     que la rama tenga ancestro común con origin/$BASE_REF."
    exit 3
  fi
  # Un binario cuenta como archivo y no suma líneas: numstat le pone guion
  # porque no tiene líneas que contar. Fingir un número ahí sería inventar.
  counts="$(printf '%s\n' "$nums" | awk 'NF{n++; if($1 ~ /^[0-9]+$/) a+=$1; if($2 ~ /^[0-9]+$/) d+=$2} END{printf "%d %d\n", n+0, a+d+0}')"
  files="${counts%% *}"
  lines="${counts##* }"
  if [ "$files" -le "$max_files" ] && [ "$lines" -le "$max_lines" ]; then
    return 0
  fi
  echo "❌ carril quick, pero el diff excede lo que quick promete:"
  echo "   archivos: $files (techo $max_files)"
  echo "   líneas cambiadas: $lines (techo $max_lines)"
  echo "   ↳ remediación: este cambio no es quick. Escalá a express, que"
  echo "     conserva TODA la verificación y devuelve la deliberación que quick"
  echo "     recorta:"
  echo "     python3 scripts/harness-policy.py escalate tasks/$TASK --to express --actor orchestrator --reason '$files archivos / $lines líneas'"
  echo "     y seguí con /smart $TASK: el trabajo hecho se conserva en el worktree."
  exit 3
}

run_lang_gates() {
  # ¿Reconocimos el stack de este repo? Si al final sigue en 0, el gate no
  # verificó NADA, y eso tiene que verse: era el silencio más caro del script.
  LANG_SEEN=0
  # ── "RECONOCI EL STACK" NO ES "CORRI TESTS" ─────────────────────────
  # El sello de evidencia usaba LANG_SEEN como prueba de que algo se verifico,
  # y LANG_SEEN solo dice que se encontro un marcador (go.mod, pyproject...).
  # Un repo con pyproject.toml pero sin pytest instalado tenia LANG_SEEN=1 y
  # cero tests corridos: se acuñaba un EV-TEST que decia "este arbol pasa la
  # suite" sin que ninguna suite hubiera corrido. TESTS_RAN mide lo que el
  # sello afirma, que es lo unico honesto que puede medir.
  TESTS_RAN=0
  if [ -f go.mod ]; then
    # UN COMANDO POR LINEA, NUNCA `A && B`: bajo set -e una AND-list que falla
    # NO aborta (set -e se ignora en todo comando de una lista AND-OR que no
    # sea el ultimo), asi que la funcion seguia y devolvia 0. O sea que un
    # `go test` en rojo salia VERDE del gate. Reproducido; era el silencio mas
    # caro que quedaba, y afectaba a seis stacks.
    gate go
    go vet ./...
    go build ./...
    go test ./...
    TESTS_RAN=1
    LANG_SEEN=1
  fi
  # Go FUERA de la raíz. Caso de campo: repo con package.json en la raíz y
  # toda la lógica de orquestación en controller/ con su go.mod; la rama de
  # arriba solo mira la raíz, así que los tests Go jamás corrían en el
  # precheck y en cada ronda hubo que sellar evidencia a mano. Cada go.mod es
  # un módulo autocontenido: el gate corre POR subdirectorio. Profundidad
  # acotada (2 niveles) y sin vendored: un go.mod de vendor/ no es un stack.
  local gomod gomoddir
  for gomod in $(git ls-files '*/go.mod' 2>/dev/null \
      | grep -v -E '(^|/)(vendor|node_modules|third_party|testdata)/' \
      | awk -F/ 'NF<=3'); do
    gomoddir="${gomod%/go.mod}"
    LANG_SEEN=1
    gate "go ($gomoddir)"
    ( cd "$gomoddir"
      go vet ./...
      go build ./...
      go test ./... )
    TESTS_RAN=1
  done
  # Repo TS cuyo package.json NO está en la raíz (monorepo, apps/, packages/):
  # el bloque entero se saltaba EN SILENCIO, el precheck salía verde y el
  # commit roto viajaba hasta el gate de ship. Un gate que no encuentra qué
  # verificar tiene que decirlo, no ausentarse.
  # Misma forma y mismo razonamiento que la guarda de Python de más abajo: el
  # silencio era el bug, no la ausencia. Se DICE y viaja como supuesto, pero no
  # bloquea: un exit 3 acá inventa un veredicto sobre el código cuando la verdad
  # es "no encontré qué mirar" (#60, medido del lado Python en un repo de
  # contratos). Y un package.json bajo un directorio generado o vendoreado no
  # es señal de que el repo sea TypeScript.
  local ts_sub
  ts_sub="$(git ls-files '*/package.json' 2>/dev/null \
            | grep -vE '(^|/)(gen|generated|vendor|node_modules|dist|build|target|third_party)/' || true)"
  if [ ! -f package.json ] && [ -n "$ts_sub" ]; then
    gate ts
    echo "⚠️  el gate ts NO PUEDE CORRER: $REPO no tiene package.json en la raíz,"
    echo "   pero sí en subdirectorios que no son generados:"
    printf '%s\n' "$ts_sub" | head -5 | sed 's/^/     · /'
    echo "   Esto NO es un verde: es un tramo SIN MIRAR, ni typecheck ni tests."
    echo "   ↳ para que se verifique: declara un package.json en la raíz con"
    echo "     scripts typecheck y test que deleguen a los paquetes (npm -w,"
    echo "     pnpm -r, turbo, lo que use)."
    emit assumption "$REPO: gate ts NO corrió (package.json solo en subdirectorios)"
  fi
  if [ -f package.json ]; then
    LANG_SEEN=1
    gate ts
    # UN GATE QUE NO PUEDE CORRER NO REPORTA ROJO. Misma regla que import-linter
    # y go-arch-lint abajo, que ya la respetan: si falta la herramienta se dice,
    # no se finge un veredicto. Aquí faltaba.
    #
    # CASO REAL: el worktree nace de origin/$BASE_REF, o sea SIN node_modules y sin
    # los tipos que genera `astro sync`. tsc no ve los ambientes y escupe
    # errores que PARECEN deuda vieja (import.meta.env, astro:assets). Fueron 8
    # errores fantasma, un intento de landing perdido, y CERO líneas de código
    # que tocar: con las deps instaladas el gate pasó solo. Un rojo falso no
    # cuesta una ronda nada más, enseña al agente a desconfiar de los gates.
    # PREPARAR NO ES VERIFICAR, y por eso esto se puede hacer solo.
    #
    # ship.sh verifica y no actúa: un gate que "arregla" el código que juzga
    # deja de ser un gate. Pero instalar dependencias no toca el artefacto que
    # se shippea, es la condición para poder mirarlo. La frontera se sostiene
    # con una PRUEBA, no con una promesa: después de preparar, el árbol
    # VERSIONADO tiene que estar idéntico. Si el install movió el lockfile o
    # cualquier archivo trackeado, eso ya no fue preparar y el gate se niega.
    #
    # Antes esto era una negativa que te devolvía el trabajo a vos. La
    # remediación era mecánica y siempre la misma, así que pedirla era una
    # parada de ceremonia: el humano corría dos comandos y el gate pasaba sin
    # tocar una línea de código.
    if [ ! -d node_modules ] || { ls astro.config.* >/dev/null 2>&1 && [ ! -f .astro/types.d.ts ]; }; then
      before="$(git status --porcelain -uno -- . | sort)"
      if [ ! -d node_modules ]; then
        echo "→ preparo la toolchain: faltan node_modules (worktree recién creado)"
        bash "$WS/scripts/fe.sh" 'install' "$REPO" "$TASK" >/dev/null 2>&1 || true
        # Verifico que la preparación FUNCIONÓ. Dar por hecho que un comando
        # hizo lo suyo es la misma fe ciega que este gate existe para evitar.
        if [ ! -d node_modules ]; then
          echo "⛔ el gate ts NO PUEDE CORRER: no pude instalar las dependencias de $REPO."
          echo "   Sin ellas los errores de tipos serían fantasma (faltan los .d.ts"
          echo "   de las deps), no deuda real del cambio."
          echo "   ↳ remediación: bash scripts/fe.sh 'install' $REPO $TASK"
          exit 3
        fi
      fi
      if ls astro.config.* >/dev/null 2>&1 && [ ! -f .astro/types.d.ts ]; then
        echo "→ preparo la toolchain: falta .astro/types.d.ts (lo genera astro sync)"
        npx astro sync >/dev/null 2>&1 || true
        if [ ! -f .astro/types.d.ts ]; then
          echo "⛔ el gate ts NO PUEDE CORRER: 'astro sync' no generó .astro/types.d.ts."
          echo "   Ese archivo declara astro:assets e import.meta.env; sin él, tsc los"
          echo "   reporta como errores fantasma."
          echo "   ↳ remediación: (cd $WT && npx astro sync) y mirá qué dice"
          exit 3
        fi
      fi
      after="$(git status --porcelain -uno -- . | sort)"
      if [ "$before" != "$after" ]; then
        echo "⛔ preparar la toolchain modificó archivos VERSIONADOS de $REPO:"
        printf '%s\n' "$after" | head -5 | sed 's/^/     · /'
        echo "   Eso ya no es preparar: es cambiar el artefacto que este gate juzga,"
        echo "   y ahí me detengo. Suele ser un lockfile desincronizado del package.json."
        echo "   ↳ remediación: corre el install en el worktree, revisá el diff y"
        echo "     commiteálo como parte del cambio si corresponde."
        exit 3
      fi
      echo "  ✅ toolchain lista (sin tocar archivos versionados), sigo con el gate"
    fi
    # EL TYPECHECK DEL REPO MANDA SOBRE EL NUESTRO. `tsc --noEmit` no es el
    # typecheck de todo proyecto TS: uno de Astro se chequea con `astro check`
    # (tsc solo ve una parte y no mira los .astro), y un monorepo con `tsc -b`.
    # Si el repo declara cómo se chequea, se usa eso.
    checked=0
    if   jq -e '.scripts.typecheck'     package.json >/dev/null 2>&1; then npm run typecheck; checked=1
    elif jq -e '.scripts["check:types"]' package.json >/dev/null 2>&1; then npm run check:types; checked=1
    elif jq -e '.scripts.check'         package.json >/dev/null 2>&1; then npm run check; checked=1
    elif [ -f tsconfig.json ]; then npx tsc --noEmit; checked=1          # gate DURO: sin || true
    fi
    # Es TypeScript y no encontramos cómo chequearlo. Eso NO es un verde: es
    # justo el agujero por el que llegó un commit roto hasta el gate de ship.
    if [ "$checked" -eq 0 ] \
       && jq -e '.devDependencies.typescript // .dependencies.typescript' package.json >/dev/null 2>&1; then
      echo "⛔ $REPO trae typescript como dependencia pero el gate no encontró cómo typechequearlo:"
      echo "   sin tsconfig.json en la raíz y sin script typecheck / check:types / check."
      echo "   Hasta ahora esto pasaba EN SILENCIO y el precheck salía verde."
      echo "   ↳ remediación: declara en package.json el script que ya usás para chequear"
      echo "     tipos (\"typecheck\": \"astro check\" / \"tsc --noEmit\" / \"tsc -b\")."
      exit 3
    fi
    # `npm test --if-present` se callaba cuando NO había script test: un repo
    # sin tests salía verde sin decir una palabra. El silencio de un
    # verificador se lee igual que un verde.
    if jq -e '.scripts.test' package.json >/dev/null 2>&1; then
      npm test
      TESTS_RAN=1
    else
      echo "⚠️  $REPO no declara script 'test' en package.json: el gate ts NO corrió tests."
      echo "   No lo bloqueo (puede ser legítimo), pero que quede dicho: este gate"
      echo "   verificó tipos y nada más."
    fi
  fi
  # Repo Python cuyo pyproject.toml NO está en la raíz (monorepo, services/,
  # src/): el bloque de abajo no entraba, ni ruff ni pytest corrían y el
  # precheck salía verde EN SILENCIO (COR-101). El silencio era el bug, y sigue
  # cerrado: esto se DICE, viaja como supuesto al bus y deja `verificado` en un
  # valor distinto de "completo", que el reviewer tiene orden de declarar.
  #
  # Lo que NO puede hacer es bloquear, y ese fue mi error al cerrarlo (#60): un
  # `exit 3` acá inventa un veredicto sobre el CÓDIGO cuando la verdad es "no
  # encontré qué mirar", que es exactamente lo que el resto de este archivo
  # tiene prohibido (muerde_go_base_compila, los CIEGOS de muerde, disco_avisa).
  # Costó caro: `proto` es un repo de contratos puros que no puede tener
  # pyproject en la raíz, es la RAÍZ del DAG de shipping, y quedó imposible de
  # entregar en verde, bloqueando toda tarea que tocara el contrato.
  #
  # Y los artefactos GENERADOS no son señal de que el repo sea de ese lenguaje:
  # el único pyproject de `proto` es el wheel que produce su generate.sh. Un
  # directorio generado o vendoreado no cuenta.
  local nogen='(^|/)(gen|generated|vendor|node_modules|dist|build|target|\.venv|third_party)/'
  local py_sub
  py_sub="$(git ls-files '*/pyproject.toml' 2>/dev/null | grep -vE "$nogen" || true)"
  if [ ! -f pyproject.toml ] && [ -n "$py_sub" ]; then
    gate python
    echo "⚠️  el gate python NO PUEDE CORRER: $REPO no tiene pyproject.toml en la raíz,"
    echo "   pero sí en subdirectorios que no son generados:"
    printf '%s\n' "$py_sub" | head -5 | sed 's/^/     · /'
    echo "   Esto NO es un verde: es un tramo SIN MIRAR, ni ruff ni pytest."
    echo "   ↳ para que se verifique: declara un pyproject.toml en la raíz que"
    echo "     federe los paquetes (por ejemplo [tool.uv.workspace] con sus"
    echo "     members), o mueve el proyecto a la raíz."
    emit assumption "$REPO: gate python NO corrió (pyproject solo en subdirectorios)"
  fi
  if [ -f pyproject.toml ]; then
    LANG_SEEN=1
    gate python
    # RUFF Y PYTEST SON DEPENDENCIAS DEL PROYECTO, NO DEL SISTEMA. `uv sync`
    # los deja en .venv/bin, o sea FUERA del PATH: llamarlos pelados da
    # `command not found` y exit 127, y ningun repo Python podia shippear
    # (issue #29, reportado por el propio harness). La linea de pytest ya
    # pasaba por `uv run`; la de ruff no, y esa asimetria era todo el bug.
    #
    # Y si no hay NI uv NI la herramienta en el PATH, no se finge un veredicto:
    # se dice que ese tramo no se verifico, igual que hacen gitleaks,
    # import-linter y los seis stacks que pasan por need(). Un 127 rojo enseña
    # a desconfiar del gate tanto como un verde falso.
    #
    # PERO `command -v uv` NO CONTESTA LA PREGUNTA QUE IMPORTA (issue #30).
    # Con uv instalado y ruff ausente del venv, `uv run ruff` sale 2 ("Failed
    # to spawn: ruff") y bajo `set -e` eso mata el gate ANTES de llegar al
    # else honesto: la rama que explica cómo arreglarlo era inalcanzable justo
    # cuando hacía falta, y el usuario veía un exit 2 pelado. La pregunta no es
    # "¿existe uv?" sino "¿corre esta herramienta?", y eso se contesta
    # corriéndola una vez, no deduciéndolo.
    py_tool() {  # py_tool <bin> → cómo invocarlo, o nada si no corre
      if command -v uv >/dev/null && uv run "$1" --version >/dev/null 2>&1; then
        printf 'uv run %s' "$1"
      elif command -v "$1" >/dev/null; then
        printf '%s' "$1"
      fi
    }
    RUFF="$(py_tool ruff)"
    PYTEST="$(py_tool pytest)"
    if [ -n "$RUFF" ]; then
      # ── ruff: RATCHET, la misma forma que buf lint (issue #31) ───────
      # ship.sh ya declaraba el principio abajo, en el gate de buf ("la deuda
      # preexistente no secuestra shipping ajeno") y lo aplicaba a UN solo
      # linter. El otro, ruff, bloqueaba con todo: medido en un repo real, 144
      # violaciones heredadas en main dejaban a TODA tarea de ese repo sin
      # poder llegar a review ni a main, aunque no tocara una sola de las 144.
      # Un gate que castiga por deuda ajena se termina desactivando, y ahí se
      # pierde también lo que sí servía.
      #
      # La baseline es un checkout de origin/$BASE_REF, no el clon canónico:
      # ruff lintea un ÁRBOL DE TRABAJO, no una ref, y repos/<repo> puede estar
      # en otra rama o sucio. buf puede darse el lujo de leer el clon porque
      # compara refs; acá haría comparar contra un árbol cualquiera.
      py_lint() {  # py_lint <dir> → "archivo\tcódigo\tmensaje" ordenado
        local root; root="$(cd "$1" && pwd -P)"
        # Se invoca SIEMPRE desde el worktree (ahí está el venv que uv resuelve)
        # y se le pasa el árbol a mirar: ruff toma la config del árbol linteado.
        # Salir 1 es "encontré violaciones", no "fallé": no puede abortar nada.
        $RUFF check --output-format json "$root" 2>/dev/null \
          | jq -r --arg r "$root/" '.[] | [(.filename | ltrimstr($r)), .code, .message] | @tsv' 2>/dev/null \
          | sort || true
      }
      py_base="$(mktemp -d)"
      if git -C "$WT" worktree add --detach --quiet "$py_base/base" "origin/$BASE_REF" 2>/dev/null; then
        py_main_lint="$(py_lint "$py_base/base")"
      else
        echo "⚠️  no pude sacar un checkout de origin/$BASE_REF para la baseline de ruff."
        echo "   Sin baseline no hay ratchet: bloqueo con TODA la deuda, y lo digo."
        py_main_lint=""
      fi
      py_head_lint="$(py_lint .)"
      git -C "$WT" worktree remove --force "$py_base/base" 2>/dev/null || true
      rm -rf "$py_base"
      py_new_lint="$(comm -13 <(printf '%s' "$py_main_lint") <(printf '%s' "$py_head_lint"))"
      if [ -n "$py_new_lint" ]; then
        echo "❌ ruff: violaciones NUEVAS introducidas por este cambio:"
        printf '%s\n' "$py_new_lint" | awk -F'\t' '{print "   " $1 ": " $2 " " $3}'
        echo "   ↳ remediación: corrige SOLO estas (la deuda preexistente de $BASE_REF no bloquea)"
        exit 3
      fi
      if [ -n "$py_main_lint" ]; then
        echo "⚠️  ruff: $(printf '%s\n' "$py_main_lint" | grep -c .) violaciones PREEXISTENTES en $BASE_REF (no bloquean; candidatas al ratchet-keeper)"
      fi
    else
      echo "⚠️  $REPO es Python pero no encuentro ruff (ni uv que sepa invocarlo): el lint NO CORRIÓ."
      echo "   ↳ instalá uv y corré 'uv sync --extra dev' (ruff tiene que quedar EN el venv),"
      echo "     o poné ruff en el PATH."
      emit assumption "$REPO (Python): lint NO ejecutado, falta ruff/uv"
    fi
    if [ -n "$PYTEST" ]; then
      # ── exit 5 de pytest NO es un fallo: es "no colecté ningún test" ──
      # Bajo `set -e` este tramo trataba el 5 como error fatal, y un repo sin
      # tests Python quedaba sin poder shippear JAMÁS. Caso de campo: un repo de
      # contratos puros (cero tests Python) con un pyproject en la raíz; el día
      # que `py_tool` resuelve pytest ahí, el ship muere para siempre por un
      # código que significa "no había nada que correr". Es la misma familia que
      # el disco lleno y la ceguera de deploy-watch: una causa ambiental
      # disfrazada de defecto de código.
      #
      # No bloquea, y TAMPOCO pasa en silencio, que sería el falso verde de
      # siempre: se dice, TESTS_RAN se queda en 0 (nada corrió, y el sello del
      # precheck lo declara "ninguno") y el supuesto viaja al bus. Mismo trato
      # que "no encuentro pytest", porque es el mismo hecho verificable: los
      # tests no se ejecutaron. Y es la misma lectura del 5 que ya hace
      # gate_test_muerde, que no puede leerlo distinto sin contradecirse.
      if $PYTEST -q; then
        TESTS_RAN=1
      else
        py_rc=$?
        if [ "$py_rc" -ne 5 ]; then exit "$py_rc"; fi
        echo "⚠️  $REPO: pytest no colectó NINGÚN test (exit 5). Eso no es un fallo:"
        echo "   o el repo no tiene tests Python, o un conftest/filtro no los encuentra."
        echo "   NO bloquea el ship, pero este tramo quedó SIN VERIFICAR y el sello lo dice."
        echo "   ↳ si el repo DEBERÍA tener tests, corré 'pytest --collect-only' para ver"
        echo "     por qué no los colecta (rootdir, testpaths, conftest roto)."
        emit assumption "$REPO (Python): pytest no colectó ningún test (exit 5), tramo sin verificar"
      fi
    else
      echo "⚠️  $REPO es Python pero no encuentro pytest (ni uv que sepa invocarlo): los tests NO CORRIERON."
      echo "   ↳ instalá uv y corré 'uv sync --extra dev' (pytest tiene que quedar EN el venv),"
      echo "     o poné pytest en el PATH."
      emit assumption "$REPO (Python): tests NO ejecutados, falta pytest/uv"
    fi
  fi
  if [ -f pubspec.yaml ]; then
    gate flutter
    flutter analyze
    flutter test
    TESTS_RAN=1
    LANG_SEEN=1
  fi
  # ── Stacks que faltaban ───────────────────────────────────────────────
  # Hasta aquí el gate solo reconocía Go, Node, Python y Dart. Un repo Rust,
  # Java, Ruby, PHP, .NET o Elixir no tenía rama: el precheck salía VERDE con
  # el build roto y ship.sh lo pushaba a main sin compilar ni testear, sin
  # decir una palabra. Para un instalador que se dice universal, ese era el
  # agujero más grande (regla 8 de CONTRIBUTING).
  #
  # Cada uno sigue la regla de la casa: si el marcador está pero la toolchain
  # no, se dice, no se finge un veredicto.
  need() {  # need <bin> <stack>: ¿está la toolchain? si no, avisa honesto
    command -v "$1" >/dev/null && return 0
    echo "⚠️  $REPO es $2 pero '$1' no está instalado: ese gate NO CORRIÓ."
    emit assumption "$REPO ($2) NO compilado ni testeado: falta '$1' en el PATH"
    return 1
  }
  if [ -f Cargo.toml ]; then
    LANG_SEEN=1
    if need cargo Rust; then gate rust; cargo build --locked; cargo test; TESTS_RAN=1; fi
  fi
  if [ -f pom.xml ]; then
    LANG_SEEN=1
    if need mvn Java-Maven; then gate java-maven; mvn -B -q verify; TESTS_RAN=1; fi
  fi
  if [ -f build.gradle ] || [ -f build.gradle.kts ]; then
    LANG_SEEN=1
    if [ -x ./gradlew ]; then gate java-gradle; ./gradlew --quiet build; TESTS_RAN=1
    elif need gradle Java-Gradle; then gate java-gradle; gradle --quiet build; TESTS_RAN=1; fi
  fi
  if [ -f Gemfile ]; then
    LANG_SEEN=1
    if need bundle Ruby; then
      gate ruby
      if [ -f Rakefile ]; then bundle exec rake; TESTS_RAN=1
      elif [ -d spec ]; then bundle exec rspec; TESTS_RAN=1
      else echo "⚠️  $REPO es Ruby pero no tiene Rakefile ni spec/: no encontré qué correr"
           emit assumption "$REPO (Ruby) sin suite reconocible: el gate no corrió tests"; fi
    fi
  fi
  if [ -f composer.json ]; then
    LANG_SEEN=1
    if need composer PHP; then
      gate php
      if [ -f phpunit.xml ] || [ -f phpunit.xml.dist ]; then
        composer install --no-interaction --quiet
        vendor/bin/phpunit
        TESTS_RAN=1
      else
        echo "⚠️  $REPO es PHP sin phpunit.xml: no encontré qué correr"
        emit assumption "$REPO (PHP) sin config de phpunit: el gate no corrió tests"
      fi
    fi
  fi
  if ls ./*.sln ./*.csproj >/dev/null 2>&1; then
    LANG_SEEN=1
    if need dotnet dotNET; then gate dotnet; dotnet build --nologo -v q; dotnet test --nologo -v q; TESTS_RAN=1; fi
  fi
  if [ -f mix.exs ]; then
    LANG_SEEN=1
    if need mix Elixir; then gate elixir; mix compile --warnings-as-errors; mix test; TESTS_RAN=1; fi
  fi
  # ── Terraform: lo único que valida ANTES del auto-apply ──────────────
  # Caso de campo: los repos de infra pasaban el precheck sin verificar NADA
  # (caían al aviso de stack no reconocido, que no bloquea) y son justo los
  # que auto-aplican producción al mergear. Para un repo infra este es el
  # único gate entre un typo de HCL y el apply. Detección espejo de
  # discover.sh: *.tf en la raíz o subdirs hasta profundidad 4.
  local tf_files tf_dir tf_tests
  tf_files="$(git ls-files '*.tf' 2>/dev/null \
    | grep -v -E '(^|/)\.terraform/' | awk -F/ 'NF<=4' || true)"
  if [ -n "$tf_files" ]; then
    LANG_SEEN=1
    if need terraform Terraform; then
      gate terraform
      # ── EL GATE NO PUEDE ENSUCIAR LO QUE JUZGA (COR-416/347) ──────────
      # Caso de campo visto en DOS repos independientes: `terraform init`
      # escribe .terraform/ y .terraform.lock.hcl en el directorio del módulo,
      # así que la PRIMERA corrida del precheck sellaba con el árbol limpio y
      # la SEGUNDA encontraba el árbol sucio... por artefactos del PROPIO gate.
      # El ship se frenaba por basura que nadie escribió a mano, y la
      # remediación que se le pedía al humano era borrar lo que el verificador
      # había dejado. Un verificador que ensucia lo que juzga se descalifica
      # solo: su veredicto deja de hablar del cambio y habla de sí mismo.
      #
      # Por eso los plugins van a un TF_DATA_DIR de scratch (fuera del
      # worktree) y el lockfile vuelve EXACTAMENTE como estaba: repuesto si
      # existía commiteado, borrado si no existía.
      tf_limpio() {  # tf_limpio <dir> <subcomando...>: init + subcomando sin dejar rastro
        local d="$1"; shift
        local scratch lock_prev="" rc=0
        scratch="$(mktemp -d)"
        # Un lock COMMITEADO es parte del artefacto juzgado, e init lo reescribe
        # (agrega hashes de plataforma): se guarda antes y se repone después.
        if [ -f "$d/.terraform.lock.hcl" ]; then
          lock_prev="$scratch/lock.previo"
          cp "$d/.terraform.lock.hcl" "$lock_prev"
        fi
        if ! ( cd "$d"
               TF_DATA_DIR="$scratch/data" terraform init -backend=false -input=false >/dev/null ); then
          rm -rf "$scratch"
          return 1
        fi
        # El subcomando corre CON el lock que init acaba de escribir, y la
        # limpieza va DESPUÉS. La versión anterior lo hacía al revés, razonando
        # que un `set -e` mataría la limpieza posterior si el subcomando salía
        # rojo. Ese razonamiento era falso: el subcomando va envuelto en un
        # `if`, que desactiva errexit para él, así que la línea de abajo SIEMPRE
        # corre. Y el precio del orden invertido era grave (#56): en un repo sin
        # lock commiteado, ese `rm -f` borraba el lock recién creado y entonces
        # `terraform validate` ya no resolvía los providers que init había
        # instalado. "Missing required provider" para todos, con el diff vacío:
        # el gate salía rojo SIEMPRE, sin camino legítimo a verde, y solo se
        # veía en repos sin lock commiteado (por eso pasó desapercibido).
        if ( cd "$d"; TF_DATA_DIR="$scratch/data" terraform "$@" ); then rc=0; else rc=$?; fi
        if [ -n "$lock_prev" ]; then cp "$lock_prev" "$d/.terraform.lock.hcl"
        else rm -f "$d/.terraform.lock.hcl"; fi
        rm -rf "$scratch"
        return "$rc"
      }
      # fmt es recursivo desde la raíz: una pasada cubre todos los subdirs.
      terraform fmt -check -recursive
      # init/validate van POR directorio con .tf (cada uno es un root/módulo).
      for tf_dir in $(printf '%s\n' "$tf_files" \
          | awk -F/ '{ if (NF == 1) print "."; else { sub("/[^/]*$", ""); print } }' \
          | sort -u); do
        echo "  → terraform validate: $tf_dir"
        tf_limpio "$tf_dir" validate
      done
      # ── terraform test: validate PARSEA, test EJECUTA (COR-625) ───────
      # Caso de campo: un repo de infra con tests/kargo_retry.tftest.hcl pasaba
      # el precheck entero sin correr UN SOLO test suyo, porque el bloque de
      # arriba solo mira sintaxis. `validate` dice "esto parsea"; `terraform
      # test` dice "esto se comporta". Por eso SOLO terraform test enciende
      # TESTS_RAN: el sello de evidencia no puede afirmar "corrí tests" porque
      # un HCL parseó, igual que no lo afirman squawk ni buf.
      tf_tests="$(git ls-files '*.tftest.hcl' 2>/dev/null \
        | grep -v -E '(^|/)\.terraform/' | awk -F/ 'NF<=5' || true)"
      if [ -n "$tf_tests" ]; then
        # terraform test corre desde la RAÍZ del módulo, no desde tests/: ahí
        # viven los archivos de test, pero el root de configuración es el padre.
        for tf_dir in $(printf '%s\n' "$tf_tests" \
            | awk -F/ '{ if (NF == 1) print "."; else { sub("/[^/]*$", ""); print } }' \
            | sed 's|/tests$||; s|^tests$|.|' | sort -u); do
          echo "  → terraform test: $tf_dir"
          tf_limpio "$tf_dir" test
        done
        TESTS_RAN=1
      fi
    fi
  fi
  # Gates de arquitectura y SQL: la CONFIG del repo es el opt-in (sin config,
  # silencio). Con config presente son gates duros — igual que go/ts. Config
  # sin herramienta instalada = warning honesto, no un gate fingido.
  if [ -f .importlinter ] || grep -q '\[tool\.importlinter\]' pyproject.toml 2>/dev/null; then
    if command -v lint-imports >/dev/null; then gate "import-linter"; lint-imports
    else echo "⚠️  config de import-linter presente pero lint-imports no instalado — gate saltado"; fi
  fi
  if [ -f .go-arch-lint.yml ]; then
    if command -v go-arch-lint >/dev/null; then gate "go-arch-lint"; go-arch-lint check
    else echo "⚠️  .go-arch-lint.yml presente pero go-arch-lint no instalado — gate saltado"; fi
  fi
  # squawk: lint de migraciones SQL NUEVAS del diff (las viejas no se re-litigan)
  # La migración manda, no la herramienta: primero se mira el diff y DESPUÉS
  # si hay con qué lintearlo. Al revés, sin squawk instalado el bloque entero
  # se saltaba en silencio y un ALTER bloqueante llegaba a prod por el mismo
  # agujero que squawk existe para cerrar. import-linter y go-arch-lint, sus
  # vecinos de arriba, ya avisaban honestamente; este era el único que no.
  local migs
  # Tres puntos: con puntas, una migración que el trunk BORRÓ tras el branch
  # point reaparece como "A" en el diff de la rama y se re-litiga como nueva.
  migs="$(git diff "origin/$BASE_REF...HEAD" --name-only --diff-filter=A | grep -E '(^|/)migrations?/.*\.sql$' || true)"
  if [ -n "$migs" ]; then
    if command -v squawk >/dev/null; then
      gate "squawk (migraciones)"; squawk $migs
    else
      echo "⚠️  este cambio agrega migraciones SQL y squawk NO está instalado:"
      printf '%s\n' "$migs" | sed 's/^/     · /'
      echo "   NO se lintearon: un ALTER bloqueante o un índice sin CONCURRENTLY"
      echo "   pasaría sin que nadie lo vea. Instalá squawk (npm i -g squawk-cli)."
      emit assumption "migraciones de $REPO NO lintadas: squawk no está instalado"
    fi
  fi
  if [ -f buf.yaml ]; then
    LANG_SEEN=1
    gate buf
    # LA BASELINE TAMBIÉN ENVEJECE. `--against` lee los refs del clon canónico
    # (repos/<repo>), que solo se refrescan cuando alguien corre pull-all.sh,
    # mientras que el worktree se fetchea en CADA ship. Con varias personas
    # pusheando al mismo trunk, los dos "main" divergen en minutos y este gate
    # empieza a comparar contra un pasado: puede acusar como NUEVAS violaciones
    # que ya están en main, o dejar pasar un breaking real contra el main de
    # verdad. Un fetch acá cuesta segundos y vale la comparación entera.
    git -C "$BASE" fetch origin --quiet 2>/dev/null \
      || echo "⚠️  no pude refrescar la baseline de $REPO (offline): buf compara contra los refs locales de repos/$REPO, que pueden estar atrás"
    # breaking: SIEMPRE duro (--against apunta al gitdir del clon base)
    buf breaking --against "$BASE/.git#branch=origin/$BASE_REF"
    # lint: RATCHET — solo violaciones NUEVAS respecto a main bloquean.
    # La deuda preexistente no secuestra shipping ajeno (la baja el
    # ratchet-keeper con su propio ciclo). Se ignoran números de línea
    # para tolerar corrimientos.
    norm() { jq -c 'del(.start_line,.end_line,.start_column,.end_column)' 2>/dev/null | sort; }
    head_lint="$(buf lint --error-format=json 2>/dev/null | norm || true)"
    main_lint="$(cd "$BASE" && buf lint --error-format=json 2>/dev/null | norm || true)"
    new_lint="$(comm -13 <(printf '%s' "$main_lint") <(printf '%s' "$head_lint"))"
    if [ -n "$new_lint" ]; then
      echo "❌ buf lint: violaciones NUEVAS introducidas por este cambio:"
      echo "$new_lint" | jq -r '"   \(.path): \(.message)"' 2>/dev/null || echo "$new_lint"
      echo "   ↳ remediación: corrige SOLO estas (la deuda preexistente de main no bloquea)"
      exit 3
    fi
    [ -n "$main_lint" ] && echo "⚠️  buf lint: $(printf '%s\n' "$main_lint" | grep -c .) violaciones PREEXISTENTES en main (no bloquean; candidatas al ratchet-keeper)"
  fi

  # EL SILENCIO MÁS CARO: si ningún marcador matcheó, este gate no compiló ni
  # testeó NADA y hasta hoy salía verde igual. Un repo docs o de contratos
  # puede no tener stack legítimamente, así que no se bloquea, pero deja de
  # pasar callado: queda como supuesto arriba del resumen de sesión.
  if [ "$LANG_SEEN" -eq 0 ]; then
    echo "⚠️  no reconozco el stack de $REPO: este gate NO compiló ni testeó nada."
    echo "   Marcadores que busco: go.mod (raíz o subdirs, prof. 2),"
    echo "   package.json, pyproject.toml, pubspec.yaml, Cargo.toml, pom.xml,"
    echo "   build.gradle, Gemfile, composer.json, *.csproj/*.sln, mix.exs,"
    echo "   buf.yaml y *.tf (raíz o subdirs, prof. 4)."
    echo "   Si este repo SÍ se construye, agregá su rama en run_lang_gates:"
    echo "   un eje sin implementación es un vendor cableado (CONTRIBUTING #8)."
    emit assumption "$REPO NO compilado ni testeado: run_lang_gates no reconoce su stack"
  fi
}

# ── La corrida de gates de lenguaje, SELLADA como evidencia ───────────
# POR QUÉ: la suite completa se corría CUATRO veces por tarea sin un solo
# rework: (1) el precheck del implementer, (2) su evidence.py run, (3) el QA
# determinista, (4) este gate en el ship. Las cuatro sobre el mismo código.
# run_lang_gates ya compila, typechequea y corre la suite; sellar SU salida es
# evidencia real y no cuesta una corrida extra.
#
# En SHIP el sello importa por otra razón además: tras el rebase el árbol es
# otro (trae los commits ajenos que aterrizaron) y ninguna prueba anterior
# habla de él. Esta es la única que sí.
#
# No afloja la separación de roles, la refuerza: hasta ahora la única prueba la
# producía el implementer, que es parte interesada; ahora el verificador
# determinista produce la suya. `implementation_agents` sigue saliendo del
# veredicto, y verdict-scaffold.sh excluye a "ship" de ese campo para que un
# ship previo no pueda contaminarlo.
run_lang_gates_sealed() {
  local runner dirty
  # En CI no hay tasks/<id>/ ni veredicto al que atar una evidencia, y sellar
  # contra un directorio inventado dejaria un EV que no respalda nada. Los
  # gates corren igual; lo que no corre es el sello.
  if [ "${CI_MODE:-0}" -eq 1 ]; then run_lang_gates; return $?; fi
  if [ "${PRECHECK:-0}" -eq 1 ]; then
    runner="${HARNESS_EVIDENCE_RUNNER:-implementer}"
  else
    runner="ship"
  fi
  # La evidencia exige árbol limpio (evidence.py se niega, y con razón: sellar
  # con cambios sin commitear certifica código que no es el que corrió). En
  # precheck eso es normal a mitad de trabajo, así que se degrada a la corrida
  # de siempre y se DICE: no sellar es perder una comodidad, fingir un sello
  # sería perder la prueba.
  dirty="$(git -C "$WT" status --porcelain -uno 2>/dev/null || echo "?")"
  if [ -n "$dirty" ]; then
    if [ "${PRECHECK:-0}" -eq 1 ]; then
      echo "→ árbol con cambios sin commitear: corro los gates SIN sellar evidencia"
      echo "  (commitea y re-corre el precheck para que el sello salga de acá y"
      echo "   no tengas que correr la suite otra vez con evidence.py)"
    else
      # En SHIP un arbol sucio no es "a mitad de trabajo": es un problema que va
      # a explotar dos pasos mas adelante (sin evidencia fresca el gate de
      # frescura falla, y el rebase del proximo intento se niega). Decirlo aca
      # ahorra descubrirlo por un mensaje que habla de otra cosa.
      echo "⚠️  el worktree tiene cambios SIN COMMITEAR sobre archivos versionados:"
      printf '%s\n' "$dirty" | head -5 | sed 's/^/     /'
      echo "   NO puedo sellar evidencia contra un commit con el árbol así, y el"
      echo "   rebase del próximo intento se va a negar por lo mismo. Suele ser un"
      echo "   artefacto que los tests reescriben y que el repo versiona por error."
    fi
    run_lang_gates
    return $?
  fi
  if [ ! -f "$WS/scripts/evidence.py" ]; then
    run_lang_gates; return $?
  fi
  echo "→ gates de lenguaje sellados como evidencia (runner: $runner)"
  # El nombre del gate especifico (python, go, buf...) lo pone `gate()` DENTRO
  # del proceso hijo, asi que el subshell de este slot no lo ve: al fallar
  # reportaba `gate '' falló`, un mensaje sin sujeto. Se nombra el tramo acá
  # para que el rojo del padre diga de que habla; el detalle fino sigue en la
  # salida del hijo, que se imprime completa.
  CURRENT_GATE="gates de lenguaje de $REPO"
  local out evrc=0
  out="$(python3 "$WS/scripts/evidence.py" run \
    --task-dir "$WS/tasks/$TASK" --repo "$REPO" --runner "$runner" \
    --kind test --cwd "$WT" \
    -- bash "$WS/scripts/ship.sh" --lang-gates "$TASK" "$REPO" 2>&1)" || evrc=$?

  # ── UN SELLO QUE NO PROBÓ NADA ES PEOR QUE NO TENER SELLO ───────────
  # Si run_lang_gates no reconoció el stack, no compiló ni testeó NADA, y aun
  # así acuñaríamos un EV-TEST con exit_code 0. Ese manifiesto es justo el que
  # satisface `--require-fresh-kind test`, o sea que el gate de frescura
  # pasaría sin que ningún test haya corrido: el verde silencioso exacto que
  # este archivo persigue en todos lados. Se borra y se declara.
  #
  # Y el anuncio va DESPUÉS de la decisión: esto imprimía EVIDENCE_ID= y dos
  # líneas más abajo decía que no sellaba. Caso de campo: cuatro agentes
  # distintos parsearon ese stdout y se llevaron un ID que apuntaba a
  # archivos ya borrados, y el fallo apareció recién en el ship.
  #
  # Y LA AUSENCIA DEL MARCADOR NO ES UN VERDE. Esto leía el marcador con
  # `|| echo 1`, o sea que si no estaba se CONSERVABA el sello. El marcador no
  # está en dos casos y ninguno dice "se verificó": nadie lo pudo escribir, o
  # un precheck del MISMO task+repo hizo su `rm -f` (más abajo) entre que este
  # hijo lo escribió y este padre lo leyó. Conservar ahí acuña un EV-TEST que
  # satisface `--require-fresh-kind test` salido de una corrida de la que no
  # sabemos si ejecutó una sola suite: el verde silencioso, otra vez, y por
  # fail-open. gate_fresh_evidence ya trata el mismo marcador como fail-closed;
  # esto lo alinea. Se sella SOLO con "completo": no saber pesa como no probar.
  local evid seen
  evid="$(printf '%s\n' "$out" | sed -n 's/^EVIDENCE_ID=//p' | tail -1)"
  seen="$(precheck_verificado)"
  if [ -n "$evid" ] && [ "$seen" != "completo" ]; then
    rm -f "$WS/tasks/$TASK/evidence/$evid.json" "$WS/tasks/$TASK/evidence/$evid.log"
    printf '%s\n' "$out" | grep -v '^EVIDENCE_ID=' || true
    if [ "$seen" = "ninguno" ]; then
      echo "⚠️  NO sello evidencia de $REPO: ninguna suite de tests llegó a correr"
      echo "   (stack no reconocido, o su herramienta de test no está). Un EV-TEST"
      echo "   de una corrida sin tests diría"
      echo "   'este árbol pasa la suite' sin que ninguna suite haya corrido."
      emit assumption "$REPO sin evidencia de test: ninguna suite llegó a correr"
    else
      echo "⚠️  NO sello evidencia de $REPO: no hay rastro de si algo corrió."
      echo "   Falta el marcador tasks/$TASK/.langseen-$REPO que deja la corrida"
      echo "   --lang-gates: no pude escribirlo, o lo borró otro precheck del"
      echo "   mismo task+repo corriendo a la vez. No sé si probó algo, así que"
      echo "   no lo certifico: un sello es una afirmación, no un default."
      echo "   ↳ re-corré el precheck sin corridas vecinas del mismo task+repo."
      emit assumption "$REPO sin evidencia de test: sin marcador, no hay rastro de si alguna suite corrió"
    fi
  else
    printf '%s\n' "$out"
  fi
  return $evrc
}

run_security_gates() {
  # gitleaks es una CAPACIDAD ELEGIBLE en la entrevista, no un supuesto. Sin
  # guarda, la instancia que no lo palomeó tenía TODO precheck y TODO ship en
  # rojo con exit 127, y el bootstrap tampoco lo instalaba porque no fue
  # elegido: un bucle sin salida. Su vecino semgrep ya estaba guardado.
  if command -v gitleaks >/dev/null; then
    gate gitleaks
    # detect sobre el rango real a pushear (protect --staged es no-op aquí)
    gitleaks detect --no-banner --log-opts="origin/$BASE_REF..HEAD"
  else
    echo "⚠️  gitleaks no instalado: el gate de secretos NO CORRIÓ en $REPO."
    echo "   Esto no es un verde: es un tramo sin verificar. Si elegiste gitleaks,"
    echo "   instálalo (bash scripts/bootstrap.sh); si no, quítalo de tu política."
    emit assumption "secretos de $REPO NO escaneados: gitleaks no está instalado"
  fi
  if [ -f "$WS/semgrep/rules.yaml" ]; then
    gate semgrep
    semgrep scan --config "$WS/semgrep/rules.yaml" --error --quiet .
    # ── LA SEGUNDA PASADA: LO QUE EL IGNORE POR DEFECTO ESCONDE ────────
    # semgrep trae un .semgrepignore propio que excluye, entre otras cosas,
    # *_test.go. En un escaneo de DIRECTORIO (el `.` de arriba) esos archivos
    # ni se abren, así que las ramas de las reglas que apuntan a tests jamás
    # se evalúan: el workspace mostraba 0 matches de "no sleep en tests" para
    # Go, y eso se leía como ausencia de deuda cuando era un gate ciego.
    # Reproducido: el mismo archivo da 0 hallazgos como directorio y 1 como
    # target explícito.
    #
    # Se pasan los archivos como TARGET EXPLÍCITO, que es lo que los saca del
    # ignore. No se escribe un .semgrepignore propio en el worktree aunque
    # también funcione: ensuciaría un árbol que otros gates están midiendo, y
    # pisaría el del repo si lo tiene.
    #
    # Los globs salen de las PROPIAS reglas (sus `include:`), no de una lista
    # cableada acá: si mañana una regla mira *.spec.rb, el gate la sigue sola.
    #
    # ── Y RATCHETEA, COMO buf Y ruff ──────────────────────────────────
    # Encender un gate que estuvo CIEGO no es lo mismo que agregar uno nuevo:
    # del otro lado hay deuda acumulada que nadie pudo ver. El propio reporte
    # lo dice ("era un falso verde, no una ausencia de deuda"), así que un
    # bloqueo sobre todo el repo pondría en rojo cada ship hasta que alguien
    # limpie sleeps que no escribió. Esa es la misma trampa que el ratchet de
    # buf lint existe para no tener.
    #
    # Bloquean solo los archivos que ESTE cambio tocó; el resto se cuenta y se
    # avisa, candidatos al ratchet-keeper. La deuda deja de ser invisible sin
    # secuestrar el shipping ajeno.
    local sg_glob sg_todos="" sg_tocados="" sg_f sg_viejos=0
    for sg_glob in $(semgrep_test_globs "$WS/semgrep/rules.yaml"); do
      sg_todos="$sg_todos $(git ls-files -- "$sg_glob" 2>/dev/null || true)"
      sg_tocados="$sg_tocados $(git diff --name-only --diff-filter=d \
        "origin/$BASE_REF...HEAD" -- "$sg_glob" 2>/dev/null || true)"
    done
    # shellcheck disable=SC2086
    set -- $sg_tocados
    if [ $# -gt 0 ]; then
      echo "   segunda pasada sobre $# archivo(s) de test que este cambio tocó"
      echo "   (el escaneo de directorio no los ve: los esconde el .semgrepignore)"
      semgrep scan --config "$WS/semgrep/rules.yaml" --error --quiet "$@"
    fi
    # Lo preexistente: se MIRA y se cuenta, pero no bloquea. Sin `--error` el
    # exit es 0 pase lo que pase, así que esto no puede tumbar el gate.
    # shellcheck disable=SC2086
    set -- $sg_todos
    if [ $# -gt 0 ]; then
      sg_viejos="$(semgrep scan --config "$WS/semgrep/rules.yaml" --quiet \
        --json "$@" 2>/dev/null | jq '.results | length' 2>/dev/null || echo 0)"
      case "$sg_viejos" in ''|*[!0-9]*) sg_viejos=0 ;; esac
      if [ "$sg_viejos" -gt 0 ]; then
        echo "⚠️  semgrep: $sg_viejos hallazgo(s) en archivos de test del repo"
        echo "   (incluidos los que este cambio NO tocó). No bloquean: son deuda"
        echo "   que el .semgrepignore por defecto mantuvo invisible hasta ahora,"
        echo "   y ponerla en rojo de golpe frenaría ships que no la causaron."
        echo "   ↳ candidatos al ratchet-keeper: semgrep scan --config \\"
        echo "     \"$WS/semgrep/rules.yaml\" --quiet \$(git ls-files '*_test.*')"
        emit assumption "$REPO: $sg_viejos hallazgo(s) de semgrep en tests preexistentes (no bloquean)"
      fi
    fi
  fi
}

# semgrep_test_globs <rules.yaml> → los globs que las reglas declaran mirar.
# Sale de los `include:` del propio archivo de reglas para que el gate no
# tenga una lista de extensiones cableada que envejece en silencio. Si no hay
# ninguno, no imprime nada y la segunda pasada no corre: un gate que no
# encuentra qué mirar se ausenta, no inventa un rojo.
semgrep_test_globs() {
  [ -f "$1" ] || return 0
  grep -o 'include:[^]]*]' "$1" 2>/dev/null \
    | tr ',' '\n' \
    | sed -n 's/.*"\([^"]*\)".*/\1/p' \
    | sort -u
}

# gate_tests_untouched — el gate confía en el test suite; el test suite es un
# archivo que el agente puede editar. Sin este gate, la forma MÁS BARATA de
# pasar a verde no es arreglar el código: es debilitar el test (SWE-Bench+:
# ~31% de parches "exitosos" pasaban por tests débiles).
#
# v2, con las lecciones de campo: (1) cuenta LLAMADAS reales de aserción
# (una línea de import con la palabra expect o un comentario con asserted ya
# no cuentan); (2) contabilidad NETA por archivo: una línea MOVIDA aparece en
# el lado - y en el +, neto 0; un move entre archivos de test (suma global
# <= 0, sin skips ni borrados) pasa con aviso; (3) el escape exige DECLARAR:
# el delta-spec debe nombrar CADA archivo debilitado DENTRO de una sección
# MODIFIED/REMOVED (escribir la palabra en la prosa ya no abre nada).
#
# v3: los skips de un archivo de test AÑADIDO no cuentan. En un archivo de
# alta TODAS las líneas son "+", así que un solo guard de entorno (el
# test.skip(!reachable, ...) que Playwright pide para no correr contra un
# servicio caído, el t.Skip de Go) daba neto 1 y salía exit 3. Un archivo que
# no existía no puede debilitar nada, y el gate no le dejaba salida legítima:
# su único escape es nombrarlo bajo MODIFIED/REMOVED del delta-spec, que en un
# archivo nuevo sería una declaración FALSA (el requirement es ADDED), o sea
# que la única forma de shippear un spec nuevo era mentirle al gate. El
# archivo igual se NOMBRA en la salida, para que el hecho quede auditable.
# Nada más se afloja: aserciones netas eliminadas, borrados sin declarar y
# skips sobre archivos EXISTENTES siguen bloqueando con exit 3, y el conteo de
# aserciones netas (por archivo y global) no cambia.
#
# El residual que esto DEJA ABIERTO, con su cobertura real medida: un archivo
# nuevo íntegramente skipeado pasa por test sin serlo. La red de abajo es
# gate_test_muerde, que corre cada test NUEVO contra el árbol base y exige que
# falle ahí (un test que nunca corre no falla). Pero esa red NO tapa el hueco
# entero, y conviene saber dónde termina:
#   · pytest y go test: cubren, porque el runner colecta el archivo por ruta.
#   · vitest/jest: cubren SOLO si están declarados en package.json, instalados
#     en node_modules, y su propia config COLECTA ese archivo (muerde_node).
#   · specs con runner propio (Playwright y todo .ts/.js fuera del include del
#     runner declarado): SIN RED, y de dos formas distintas. Sin vitest/jest,
#     muerde_salto declara el tramo sin mirarlo y retorna 0. Con vitest
#     declarado pero un include que no alcanza a e2e/, la invocación sale con
#     exit != 0 y ese gate lee cualquier exit != 0 como "el test muerde" (es
#     una decisión escrita, no un descuido: "el MOTIVO del fallo no se juzga"),
#     o sea que cobra verde por el error del runner equivocado.
# Traducido: un spec e2e nuevo enteramente skipeado hoy pasa los DOS gates. Se
# acepta a conciencia porque la alternativa era peor (bloquear todo spec e2e
# nuevo, sin salida legítima), la línea informativa deja el rastro para el
# reviewer, y el hueco está registrado para arreglarse en gate_test_muerde, que
# es donde vive la causa. No lo tapes acá: contar skips de un archivo que no
# existía es medir debilitamiento donde no hay nada que debilitar.
#
# Residuales conscientes (rúbrica del reviewer, no de este gate): borrar
# filas de una tabla Go table-driven, y reemplazos tautológicos
# (expect(true).toBe(true)). -M explícito en TODOS los git diff: sin él, un
# rename cuenta como D+A según la config diff.renames del usuario.
# ── delta_seccion: el contenido bajo un encabezado, SUBSECCIONES INCLUIDAS ──
# Caso de campo: el parser apagaba la sección con CUALQUIER línea que empezara
# por '#', así que un '### SOC-M1' bajo '## MODIFIED Requirements' descartaba
# todo lo que venía debajo. La remediación que el propio gate imprime pide
# nombrar cada archivo BAJO ese encabezado, que es justo lo que el código
# tiraba si estaba anidado: el operador hacía lo que le mandaban y seguía en
# rojo. El workaround que quedó registrado fue pegar los basenames en un
# párrafo suelto contra el '##', que no es lo que el formato pide.
#
# La regla correcta es por NIVEL: un encabezado más PROFUNDO es una subsección
# y no cierra nada; uno del mismo nivel o más superficial sí cierra.
# Portable a awk de BSD: se cuentan los '#' a mano, sin match() ni RSTART.
delta_seccion() {  # delta_seccion <archivo> <regex-extendida> → contenido
  awk -v pat="$2" '
    /^#/ {
      d = 0
      while (substr($0, d + 1, 1) == "#") d++
      if (toupper($0) ~ pat) { insec = 1; lvl = d }
      else if (insec && d <= lvl) { insec = 0 }
      next
    }
    insec { print }
  ' "$1"
}

gate_tests_untouched() {
  gate "tests no debilitados"
  local pat="${TEST_PATH_PATTERN:-(test|spec|Test|_test\.|\.test\.|\.spec\.|/tests?/|/spec/)}"
  # ARTEFACTOS COMPILADOS NO SON TESTS. El patron de arriba matchea por RUTA, y
  # `/tests?/` atrapa todo lo que cuelgue de tests/, incluidos los .pyc de
  # __pycache__. Borrar esos archivos (por ejemplo al dejar de versionarlos, que
  # es lo correcto) se leia como "test BORRADO sin declarar" y bloqueaba el ship.
  # Un falso positivo aca cuesta una ronda y ensena a desconfiar del gate.
  # Ninguno de estos puede contener una asercion, asi que se excluyen por nombre.
  local artifacts="${TEST_ARTIFACT_PATTERN:-(__pycache__/|\.pyc$|\.pyo$|\.class$|\.pytest_cache/|/node_modules/)}"
  # Tres puntos, el mismo ancla que gate_test_muerde y gate_quick_size: el
  # precheck corre SIN rebase, así que con dos puntos los commits que el trunk
  # sumó después del branch point aparecen INVERTIDOS en este diff. El test que
  # OTRO agregó se lee acá como borrado, y la aserción que OTRO añadió como
  # aserción eliminada: el gate acusaba de debilitar tests a quien no los tocó.
  local touched
  touched="$(git diff -M "origin/$BASE_REF...HEAD" --name-status \
    | awk -F'\t' '{ for (i = 2; i <= NF; i++) print $i }' \
    | grep -E "$pat" | grep -vE "$artifacts" | sort -u || true)"
  [ -n "$touched" ] || return 0

  local deleted
  deleted="$(git diff -M "origin/$BASE_REF...HEAD" --diff-filter=D --name-only \
    | grep -E "$pat" | grep -vE "$artifacts" || true)"

  # Archivos de test de ALTA: sus skips no cuentan (ver v3 en la cabecera).
  # Mismo filtrado por $pat y $artifacts que `deleted`.
  local added
  added="$(git diff -M "origin/$BASE_REF...HEAD" --diff-filter=A --name-only \
    | grep -E "$pat" | grep -vE "$artifacts" || true)"
  is_added() { printf '%s\n' "$added" | grep -qxF "$1"; }

  # UN pase del diff completo en awk (BSD-safe: sin \b ni \s; gsub cuenta
  # OCURRENCIAS, no líneas). Salida: "<aserciones_netas>\t<skips_netos>\t<archivo>".
  local report
  report="$(git diff -M "origin/$BASE_REF...HEAD" | TESTPAT="$pat" awk '
    BEGIN {
      pat  = ENVIRON["TESTPAT"]
      asrt = "assert[A-Za-z_]*[[:space:]]*\\(|assert\\.[A-Za-z_]+[[:space:]]*\\(" \
           "|(^|[^A-Za-z0-9_])assert[[:space:]]+[^=[:space:]]" \
           "|expect[[:space:]]*\\(|require\\.[A-Za-z]+\\(" \
           "|t\\.(Error|Fatal|FailNow|Run)|\\.should\\.|@Test" \
           "|(^|[^A-Za-z0-9_.])(it|test|describe)[[:space:]]*\\("
      skp  = "(^|[^A-Za-z0-9_.])(xit|xdescribe|xtest)[[:space:]]*\\(" \
           "|\\.skip[[:space:]]*\\(|\\.only[[:space:]]*\\(|@skip|@unittest\\.skip" \
           "|pytest\\.mark\\.skip|t\\.Skip|#\\[ignore\\]|@Disabled|@Ignore"
      cmnt = "^(//|/\\*|\\*|#[^[]|import[[:space:]]|from[[:space:]])"
    }
    function flush() {
      if (cur != "" && cur ~ pat && (na != 0 || ns != 0))
        printf "%d\t%d\t%s\n", na, ns, cur
      cur = ""; na = 0; ns = 0
    }
    /^diff --git / { flush(); minus = ""; next }
    /^--- /   { minus = $0; sub(/^--- /, "", minus)
                gsub(/^"|"$/, "", minus); sub(/^a\//, "", minus); next }
    /^\+\+\+ / { cur = $0; sub(/^\+\+\+ /, "", cur)
                gsub(/^"|"$/, "", cur); sub(/^b\//, "", cur)
                if (cur == "/dev/null") cur = minus; next }
    /^-/ { l = substr($0, 2); sub(/^[[:space:]]+/, "", l)
           if (l ~ cmnt) next
           if (l ~ skp) ns -= 1
           na += gsub(asrt, "", l); next }
    /^\+/ { l = substr($0, 2); sub(/^[[:space:]]+/, "", l)
            if (l ~ cmnt) next
            if (l ~ skp) ns += 1
            na -= gsub(asrt, "", l); next }
    END { flush() }
  ')"

  # La declaración legítima: contenido BAJO encabezados MODIFIED/REMOVED del
  # delta-spec, y debe nombrar el basename de CADA archivo debilitado.
  # En CI no existe tasks/<id>/: la declaracion de un test debilitado viaja
  # por env (el workflow suele volcar ahi el cuerpo del PR). Sin ninguna de
  # las dos, un debilitamiento BLOQUEA: no hay forma de declararlo, y el
  # sesgo correcto es fail-closed.
  local delta="${HARNESS_DELTA_SPEC_FILE:-$WS/tasks/$TASK/delta-spec.md}" declared=""
  [ -f "$delta" ] && declared="$(delta_seccion "$delta" '(MODIFIED|REMOVED)')"
  declares() { printf '%s\n' "$declared" | grep -qiF "$(basename "$1")"; }

  local bad=0 global_na=0 f na ns
  if [ -n "$deleted" ]; then
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      if declares "$f"; then
        echo "   ⚠️  test borrado y DECLARADO en el delta-spec: $f (queda en el registro)"
      else
        echo "   · test BORRADO sin declarar: $f"
        bad=1
      fi
    done <<DELEOF
$deleted
DELEOF
  fi
  if [ -n "$report" ]; then
    while IFS="$(printf '\t')" read -r na ns f; do
      [ -n "$f" ] || continue
      global_na=$((global_na+na))
      if [ "$ns" -gt 0 ] && is_added "$f"; then
        echo "   ⚠️  test AÑADIDO con $ns skips/only: $f (no cuentan: el archivo no existía, no hay nada que debilitar)"
        ns=0
      fi
      [ "$na" -gt 0 ] || [ "$ns" -gt 0 ] || continue
      if declares "$f"; then
        echo "   ⚠️  tests tocados y DECLARADOS en el delta-spec: $f"
        continue
      fi
      [ "$na" -gt 0 ] && echo "   · $f: $na aserciones netas eliminadas"
      [ "$ns" -gt 0 ] && echo "   · $f: $ns skips/only netos añadidos"
      bad=1
    done <<REPEOF
$report
REPEOF
    # move entre archivos de test: neto por archivo != 0 pero global <= 0 y
    # sin skips ni borrados: reorganizar suites es legítimo, no debilitar
    if [ "$bad" -eq 1 ] && [ "$global_na" -le 0 ] && [ -z "$deleted" ] \
       && ! printf '%s\n' "$report" | awk -F'\t' '$2 > 0 { found=1 } END { exit !found }'; then
      echo "   ⚠️  aserciones movidas ENTRE archivos de test (neto global $global_na): no es debilitamiento"
      bad=0
    fi
  fi
  [ "$bad" -eq 0 ] && return 0
  echo "❌ este cambio DEBILITA tests y el delta-spec no lo declara (archivos arriba):"
  echo "   ↳ remediación: los tests son el CONTRATO, no el obstáculo. Si el"
  echo "     comportamiento DEBE cambiar, decláralo en tasks/$TASK/delta-spec.md:"
  echo "     bajo '## MODIFIED Requirements' o '## REMOVED Requirements' la entrada"
  echo "     debe NOMBRAR cada archivo de test afectado. Si no, arregla el CÓDIGO"
  echo "     hasta que el test pase como está."
  exit 3
}

# ── gate_test_muerde: un test que no puede fallar no es un test ───────
# Caso de campo, y costó una ronda entera: un implementer escribió un assert que
# NO PODÍA FALLAR (evaluaba antes de que llegara el dato). La suite salió verde,
# el precheck salió verde, y la ronda 3 completa (commit, precheck, dos sellos de
# evidencia, dos agentes) se pagó por un test que no probaba nada. Los guardianes
# que ya teníamos miran otra cosa: gate_tests_untouched caza tests DEBILITADOS
# (aserciones que se van), no asserts nuevos VACUOS; y el mutation-sentinel es
# nocturno, o sea que su respuesta llega al día siguiente de la ronda que se pagó.
#
# La pregunta que los distingue es UNA y es mecánica: ¿este test FALLA sobre el
# árbol base? Un test que pasa con el cambio y sin el cambio no prueba la
# conducta nueva. Se contesta corriendo ESE test contra el merge-base, y no hay
# forma de contestarla leyendo el diff.
#
# DÓNDE CORRE: en --precheck y en --ci, NO en el camino de ship normal. No es un
# agujero: /review no lanza a nadie sin el sello del precheck, así que el
# precheck es obligatorio de facto; y el ship reintenta el push hasta 20 veces por
# contención, así que meterlo ahí pagaría un checkout del árbol base por intento
# para reconfirmar una respuesta que no cambia (el test es el mismo y el
# merge-base también).
#
# ALCANCE, diseñado para CERO falsos rojos:
#   (a) los archivos de test NUEVOS del diff contra el merge-base;
#   (b) los archivos de test NOMBRADOS por basename bajo '## ADDED' del
#       delta-spec (nuevos o ya existentes): nombrarlos es el opt-in, con la
#       misma convención que MODIFIED/REMOVED ya usa para declarar.
# Un test MODIFICADO y no nombrado queda FUERA a propósito: un retoque cosmético
# pasa sobre la base legítimamente, y ponerlo rojo fabricaría justo la clase de
# falso rojo que enseña a desconfiar de los gates. Y nombrarlo bajo
# MODIFIED/REMOVED lo SACA del alcance, porque esa es la remediación que este
# gate imprime: una remediación que no funcionara sería peor que ninguna.
#
# El patrón de "esto es un archivo de test" acá es MÁS ANGOSTO que el de
# gate_tests_untouched, y la divergencia es deliberada, no un descuido:
# untouched protege la SUITE entera por RUTA (borrar un helper de tests/ sí
# debilita la red), pero este gate COPIA lo que matchea al árbol base y le
# corre un runner encima. Con el patrón por directorio, la implementación que
# vive bajo tests/ (helpers, fixtures, factories de una suite E2E) viajaba a la
# base junto a su propio test: el test pasaba ahí POR CONSTRUCCIÓN y el gate lo
# declaraba vacuo, o sea un falso rojo sin salida legítima (declarar un archivo
# NUEVO bajo MODIFIED sería escribir algo falso para apagar un gate). Y por la
# otra puerta, un helper sin casos hacía salir 1 al runner ("No test files
# found") y el gate cobraba ese exit como MUERDE: un falso verde.
# La relación que tests/test_ship_gates.sh fija ahora es SUBSET, no igualdad:
# todo lo que este gate corre, untouched lo protege; un helper bajo tests/ no
# entra acá jamás.
muerde_limpia() {  # trap EXIT del subshell: el worktree temporal se va SIEMPRE
  local rc=$?
  # Un worktree fantasma no es basura inofensiva: queda registrado en el repo y
  # el próximo `worktree add` sobre el mismo path se niega. Por eso la limpieza
  # cuelga de un trap y no del camino feliz, y por eso, si falla, se DICE.
  if [ -n "${MUERDE_WT:-}" ]; then
    if ! git -C "$WT" worktree remove --force "$MUERDE_WT"; then
      echo "⚠️  no pude quitar el worktree temporal $MUERDE_WT; pruneo el registro"
      git -C "$WT" worktree prune \
        || echo "⚠️  'git worktree prune' tampoco pudo: mirá 'git -C $WT worktree list'"
    fi
  fi
  if [ -n "${MUERDE_TMP:-}" ]; then rm -rf "$MUERDE_TMP"; fi
  exit "$rc"
}
# La lección del issue #29 (la herramienta es del PROYECTO, no del sistema) con
# una vuelta más: acá pytest corre con el cwd puesto en el ÁRBOL BASE, así que
# `uv run` NO sirve: uv resuelve el proyecto desde el cwd y saldría a
# sincronizar un venv nuevo EN el árbol base (red y minutos) o a fallar. Lo que
# `uv sync` deja es un directorio, y a ese binario se lo invoca por ruta.
muerde_pytest() {  # → MUERDE_PY, o 1 con el motivo en MUERDE_MOTIVO
  if [ -x "$WT/.venv/bin/pytest" ]; then MUERDE_PY="$WT/.venv/bin/pytest"; return 0; fi
  if [ -x "$WT/venv/bin/pytest" ];  then MUERDE_PY="$WT/venv/bin/pytest";  return 0; fi
  if command -v pytest >/dev/null;  then MUERDE_PY="pytest";               return 0; fi
  MUERDE_MOTIVO="no encuentro pytest: ni .venv/bin/pytest del proyecto ni uno en el PATH ('uv sync --extra dev' lo deja en el venv)"
  return 1
}
# ── ¿este archivo YA EXISTENTE trae tests NUEVOS? ─────────────────────
# El gate razonaba por ARCHIVO: solo los archivos de test AÑADIDOS entraban al
# alcance. Pero el caso más común en la práctica es agregar un test DENTRO de
# un archivo que ya existía, y esa capacidad de morder no se verificaba nunca.
# Combinado con el falso verde de Go, la cobertura real del gate era casi nula.
#
# Se mira la DECLARACIÓN añadida, no cualquier línea: un archivo de test al que
# solo se le tocó un helper o un fixture no trae conducta nueva que probar, y
# meterlo al alcance haría correr la base para nada.
declara_tests_nuevos() {  # declara_tests_nuevos <archivo>
  git diff -M "origin/$BASE_REF...HEAD" -- "$1" \
    | grep -qE '^\+[[:space:]]*((func[[:space:]]+(Test|Benchmark|Fuzz|Example))|(def[[:space:]]+test_)|((it|test|Scenario)[[:space:]]*\()|((it|test)\.(each|only|concurrent)))'
}
muerde_go() {  # → 0 si hay toolchain Go
  if command -v go >/dev/null; then return 0; fi
  MUERDE_MOTIVO="'go' no está en el PATH"
  return 1
}
muerde_tf() {  # → 0 si hay CLI de terraform
  if command -v terraform >/dev/null; then return 0; fi
  MUERDE_MOTIVO="'terraform' no está en el PATH"
  return 1
}
# La raiz del modulo, no el directorio del archivo: terraform test corre desde
# el root de configuracion y sus tests viven en tests/ o al lado. Caso de
# campo (COR-625): tests/kargo_retry.tftest.hcl jamas entro al alcance y el
# precheck salio verde sin correrlo.
muerde_tf_root() {  # muerde_tf_root <archivo> → raíz del módulo
  local d
  d="$(dirname "$1")"
  case "$d" in
    */tests) d="${d%/tests}" ;;
    tests)   d="." ;;
  esac
  printf '%s' "$d"
}
# Misma asimetria que muerde_go_base_compila: un init que no resuelve en la
# BASE es ambiental y su rojo no prueba que el test muerda. El arbol base es
# un worktree temporal que el trap borra entero, asi que aca no hay que
# cuidar lockfiles: la higiene de COR-416 protege al worktree REAL.
muerde_tf_base_init() {  # muerde_tf_base_init <archivo>
  ( cd "$MUERDE_BASE/$(muerde_tf_root "$1")"
    terraform init -backend=false -input=false )
}
# ── ¿el ÁRBOL BASE resuelve su grafo de módulos? ──────────────────────
# Caso de campo: en un monorepo con `replace ... => ../../pkg`, el worktree
# temporal del gate nace SIN el go.work que hace resolver ese replace, así que
# la base ni compila:
#   pkg@v0.0.0: replacement directory ../../pkg does not exist
# El gate leía ese fallo de compilación como "el test MUERDE" y salía verde con
# CUALQUIER contenido de test, sin ningún test nuevo de por medio.
#
# La distinción que importa: que NO compile el TEST porque le falta el símbolo
# nuevo es exactamente lo que este gate quiere ver (muerde de verdad). Que no
# resuelva el grafo del módulo es ambiental y no prueba nada. Por eso se
# compila el paquete SIN sus tests: si eso ya falla, la base nunca fue
# construible y el rojo no es del test.
#
# Misma asimetría que muerde_node ya aplica con node_modules: un gate honesto
# que se salta es mejor que uno que aprueba todo.
muerde_go_base_compila() {  # muerde_go_base_compila <paquete>
  ( cd "$MUERDE_BASE"; go build "$1" )
}
muerde_node() {  # → MUERDE_NODE_RUNNERS con los runners declarados E instalados
  local pkg="$WT/package.json" unit=""
  MUERDE_NODE_RUNNERS=""
  if [ ! -f "$pkg" ]; then
    MUERDE_MOTIVO="no hay package.json en la raíz: no sé con qué runner correrlos"
    return 1
  fi
  if jq -e '.devDependencies.vitest // .dependencies.vitest' "$pkg" >/dev/null 2>&1; then unit="vitest"; fi
  if jq -e '.devDependencies.jest // .dependencies.jest' "$pkg" >/dev/null 2>&1; then
    if [ -n "$unit" ]; then
      MUERDE_MOTIVO="package.json declara vitest Y jest: el runner no es inequívoco, y elegir uno sería inventar el veredicto"
      return 1
    fi
    unit="jest"
  fi
  # Sin deps instaladas el árbol base fallaría por FALTA DE HERRAMIENTA, y este
  # gate lee cualquier exit != 0 como "el test muerde": sería un verde comprado
  # con una excusa. Se declara saltado en vez de cobrarlo como verificación.
  if [ -n "$unit" ] && [ -x "$WT/node_modules/.bin/$unit" ]; then
    MUERDE_NODE_RUNNERS="$unit"
  elif [ -n "$unit" ]; then
    MUERDE_MOTIVO="$unit declarado pero falta node_modules/.bin/$unit: sin deps no puedo distinguir 'el test falló' de 'no arrancó el runner'"
  fi
  # Playwright CONVIVE con el runner de unit y no lo vuelve ambiguo: e2e/ y src/
  # son jurisdicciones distintas, y quién colecta cada archivo lo decide la
  # COLECCIÓN (muerde_node_colecta), no una elección a ciegas hecha acá.
  if jq -e '.devDependencies["@playwright/test"] // .dependencies["@playwright/test"]' "$pkg" >/dev/null 2>&1 \
     && [ -x "$WT/node_modules/.bin/playwright" ]; then
    MUERDE_NODE_RUNNERS="${MUERDE_NODE_RUNNERS:+$MUERDE_NODE_RUNNERS }playwright"
  fi
  if [ -z "$MUERDE_NODE_RUNNERS" ]; then
    [ -n "$MUERDE_MOTIVO" ] || MUERDE_MOTIVO="package.json no declara vitest, jest ni @playwright/test: el runner no es inequívoco"
    return 1
  fi
  return 0
}
# ── ¿el runner declarado COLECTA este archivo? ────────────────────────
# Caso de campo: vitest.config.ts con include: ['src/**/*.{test,spec}.*'] y un
# spec nuevo en e2e/. La invocación directa salía exit != 0 ("No test files
# found") y este gate, que por decisión escrita no juzga el MOTIVO del fallo,
# lo cobraba como MUERDE: un verde comprado con un runner que jamás abrió el
# archivo. Antes de invocar se pregunta por la COLECCIÓN; lo que ningún runner
# declarado colecta es un tramo SIN RED, que no es ni verde ni rojo.
#
# La pregunta se hace con el cwd en el ÁRBOL BASE a propósito: la config que va
# a gobernar la invocación real es la de ese árbol, no la del worktree.
# ── NINGUNA sonda de un gate puede colgarse para siempre ──────────────
# Caso de campo (#57), y es el peor modo de falla que este archivo puede tener.
# `vitest list` en vitest 1.6 NO es un subcomando: lo toma como filtro de nombre
# de archivo y, fuera de CI, arranca en modo WATCH. Si algún test falla imprime
# "Watching for file changes..." y se queda ahí; el command-substitution nunca
# cierra. Medido: 25 minutos colgado a 1% de CPU, sin una sola línea de salida.
# Y le pasa a TODA tarea de frontend que cumpla el rojo primero, porque ahí el
# test nuevo es rojo sobre la base POR DEFINICIÓN, que es justo lo que este gate
# exige. El síntoma no se parece a un bug, se parece a "el precheck tarda".
#
# Tres capas, porque una sola vuelve a fallar con el próximo runner:
#   1. CI=true en toda invocación de un runner de node. Es la señal universal
#      de "no interactivo" que vitest, jest y playwright respetan.
#   2. --watch=false explícito en vitest (medido: 6.89s contra colgarse; y
#      `--run` NO alcanza en 1.6.1, sigue colgado).
#   3. un límite DURO de tiempo sobre la sonda: algo que tarda más de dos
#      minutos en contestar "¿colectás este archivo?" ya no está sondeando.
# La 3 existe porque las dos primeras dependen de que el runner se porte bien,
# y la lección de este bug es justamente que no hay que confiar en eso.
con_limite() {  # con_limite <segundos> <comando...>
  # ── ESTO ACOTABA A MEDIAS Y ESA MITAD ERA LA QUE NO IMPORTABA ───────
  # Era `perl -e 'alarm N; exec @ARGV'`, y contra un runner de node es
  # exactamente el caso que NO cubre: mata un proceso, no el árbol. Medido: el
  # padre muere a los 2s y el `$( )` sigue bloqueado 20s más porque un nieto
  # heredó stdout y sostiene el pipe. O sea que la capa 3 de este bloque, la
  # que existe porque las otras dos dependen de que el runner se porte bien,
  # dependía a su vez de que el runner no dejara hijos. Un runner de node
  # SIEMPRE deja hijos.
  # Peor: SIGALRM la atrapan muchos programas para sus propios timers, y el que
  # la ignora devolvía rc=0. Un cuelgue reportado como sonda limpia.
  # El detalle sigue en scripts/bounded.sh, que es donde vive el arreglo.
  #
  # La gracia va corta a propósito: una sonda que ya se pasó del límite no
  # merece 10s más de cortesía antes del SIGKILL.
  run_bounded "$1" 2 "${@:2}"
}
muerde_node_colecta() {  # muerde_node_colecta <archivo> → MUERDE_NODE_RUNNER
  local r out
  # shellcheck disable=SC2086
  for r in $MUERDE_NODE_RUNNERS; do
    out=""
    case "$r" in
      vitest)
        # En vitest >= 2.1 `list` es un subcomando y contesta al instante. En
        # 1.6 es un filtro, así que corre ese archivo y tarda unos segundos:
        # las dos ramas contestan lo mismo (la salida nombra el archivo si lo
        # colecta), y la vieja solo paga tiempo.
        out="$( cd "$MUERDE_BASE" && CI=true con_limite 120 \
                 "$WT/node_modules/.bin/vitest" list --watch=false "$1" 2>&1 )" || true
        # vitest < 2.1 no conoce `list`. "No pude preguntar" no es "no colecta":
        # se cae a la invocación directa, que es el statu quo exacto de antes.
        case "$out" in
          *"Unknown command"*|*"unknown option"*|*"Unknown option"*)
            MUERDE_NODE_RUNNER="vitest"; return 0 ;;
        esac ;;
      jest)
        out="$( cd "$MUERDE_BASE" && CI=true con_limite 120 \
                 "$WT/node_modules/.bin/jest" --listTests "$1" 2>&1 )" || true ;;
      playwright)
        out="$( cd "$MUERDE_BASE" && CI=true con_limite 120 \
                 "$WT/node_modules/.bin/playwright" test --list "$1" 2>&1 )" || true ;;
    esac
    if printf '%s' "$out" | grep -qF -- "$(basename "$1")"; then
      MUERDE_NODE_RUNNER="$r"
      return 0
    fi
  done
  return 1
}
muerde_corre() {  # muerde_corre <clase> <unidad> → el exit REAL sobre el árbol base
  case "$1" in
    py)
      # cwd = ÁRBOL BASE, para que rootdir, conftest.py y la config de pytest
      # salgan del árbol que se está probando y no del worktree. Y el ÁRBOL BASE
      # va delante en PYTHONPATH (raíz y src/, los dos layouts que existen)
      # porque el venv del proyecto suele traer el paquete instalado en editable
      # APUNTANDO AL WORKTREE: sin esas rutas el test importaría el código NUEVO,
      # pasaría, y este gate fabricaría un rojo. Un src/ que no exista lo ignora
      # Python; el rojo inventado no lo ignora nadie.
      ( cd "$MUERDE_BASE"
        PYTHONPATH="$MUERDE_BASE:$MUERDE_BASE/src${PYTHONPATH:+:$PYTHONPATH}" \
          "$MUERDE_PY" -q "$2" ) ;;
    go)
      ( cd "$MUERDE_BASE"; go test "$2" ) ;;
    tf)
      # -filter corre SOLO este archivo, unidad por unidad como el resto.
      # La ruta del filtro es relativa a la raiz del modulo, no al repo.
      ( d="$(muerde_tf_root "$2")"
        rel="$2"
        if [ "$d" != "." ]; then rel="${2#"$d"/}"; fi
        cd "$MUERDE_BASE/$d"
        terraform test -filter="$rel" ) ;;
    node)
      # CI=true también acá: `vitest run` ya es no interactivo, pero jest y
      # playwright tienen sus propios modos que esperan una tecla, y el bug de
      # #57 enseñó que un runner que se queda esperando cuelga el gate ENTERO.
      # Sin límite de tiempo a propósito: esto es la corrida de verdad, y una
      # suite grande tarda minutos legítimamente. Lo que se acota es la sonda.
      case "$MUERDE_NODE_RUNNER" in
        vitest)     ( cd "$MUERDE_BASE"; CI=true "$WT/node_modules/.bin/vitest" run "$2" ) ;;
        jest)       ( cd "$MUERDE_BASE"; CI=true "$WT/node_modules/.bin/jest" "$2" ) ;;
        playwright) ( cd "$MUERDE_BASE"; CI=true "$WT/node_modules/.bin/playwright" test "$2" ) ;;
      esac ;;
  esac
}
muerde_corre_grupo() {  # muerde_corre_grupo <clase> <lista>: unidad por unidad
  local clase="$1" u rc
  # Unidad por unidad y no todo junto: con una sola invocación, un test que sí
  # muerde tapa al vacuo que corrió al lado (basta un exit != 0 para todos), y
  # el rojo no podría nombrar cuál es cuál. Son archivos NUEVOS: son pocos.
  while IFS= read -r u; do
    [ -n "$u" ] || continue
    # Se ANUNCIA antes de correr, no después. Caso de campo (COR-683): un
    # precheck estuvo 41 minutos colgado en este gate sin una sola línea de
    # salida, y el reporte no pudo decir en qué archivo. La corrida real no
    # lleva límite de tiempo a propósito (una suite grande tarda minutos
    # legítimamente, y un timeout ahí fabricaría falsos rojos), así que lo que
    # se compra con esta línea es lo otro que el reporte pedía: que un cuelgue
    # deje de ser silencioso y se pueda nombrar el culpable de un vistazo.
    echo "   → corriendo sobre la base: $u"
    # Go: si la BASE no compila sin el cambio, su exit != 0 es ambiental y
    # cobrarlo como MUERDE es el falso verde que este bloque existe para matar.
    if [ "$clase" = "go" ] && ! muerde_go_base_compila "$u" > "$MUERDE_SALIDA" 2>&1; then
      echo "   ⚠️  $u: el ÁRBOL BASE no compila sin tu cambio: NO puedo verificar este test"
      MUERDE_CIEGOS="$MUERDE_CIEGOS   · $u
"
      tail -3 "$MUERDE_SALIDA" | sed 's/^/       /'
      continue
    fi
    # Terraform: si el init de la BASE no resuelve, el exit != 0 del test es
    # ambiental (modulos o providers sin resolver), no un test que muerde.
    if [ "$clase" = "tf" ] && ! muerde_tf_base_init "$u" > "$MUERDE_SALIDA" 2>&1; then
      echo "   ⚠️  $u: el ÁRBOL BASE no inicializa terraform: NO puedo verificar este test"
      MUERDE_CIEGOS="$MUERDE_CIEGOS   · $u
"
      tail -3 "$MUERDE_SALIDA" | sed 's/^/       /'
      continue
    fi
    # Node: si ningún runner declarado COLECTA el archivo, su exit != 0 sería el
    # "No test files found" del runner equivocado, no el rojo del test.
    if [ "$clase" = "node" ] && ! muerde_node_colecta "$u"; then
      echo "   ⚠️  $u: ningún runner declarado lo COLECTA (el include/testDir no lo alcanza): NO puedo verificarlo"
      MUERDE_SINRED="$MUERDE_SINRED   · $u
"
      continue
    fi
    if muerde_corre "$clase" "$u" > "$MUERDE_SALIDA" 2>&1; then rc=0; else rc=$?; fi
    # pytest reserva el exit 5 para "no colecté ningún caso": ahí no corrió
    # NINGÚN test, así que ese rojo no dice nada del cambio. Cobrarlo como
    # MUERDE sería un verde comprado con un runner que no miró nada.
    if [ "$clase" = "py" ] && [ "$rc" -eq 5 ]; then
      echo "   ⚠️  $u: pytest no colectó ningún caso (exit 5): NO hay test que verificar"
      MUERDE_SINRED="$MUERDE_SINRED   · $u
"
      tail -3 "$MUERDE_SALIDA" | sed 's/^/       /'
      continue
    fi
    if [ "$rc" -eq 0 ]; then
      echo "   ✗ $u: PASA sobre el árbol base"
      MUERDE_VACUOS="$MUERDE_VACUOS   · $u
"
    else
      # El MOTIVO del fallo no se juzga: un ImportError porque el módulo nuevo
      # todavía no existe es exactamente "este test no puede pasar sin el
      # cambio", que es lo que el gate pregunta. exit != 0 es exit != 0.
      echo "   ✓ $u: falla sobre el árbol base (exit $rc), o sea que MUERDE"
    fi
    tail -3 "$MUERDE_SALIDA" | sed 's/^/       /'
  done <<GRUPOEOF
$2
GRUPOEOF
}
muerde_salto() {  # muerde_salto <qué> <lista>: saltar se DICE, no se calla
  echo "⚠️  tests nuevos ($1) que NO pude verificar contra la base:"
  printf '%s' "$2" | sed 's/^/     · /'
  echo "   ↳ $MUERDE_MOTIVO"
  echo "   Esto NO es un verde: es un tramo sin mirar, y queda dicho."
  emit assumption "$REPO ($1): tests nuevos NO verificados contra la base ($MUERDE_MOTIVO)"
}
gate_test_muerde() {
  local pat="${TEST_FILE_PATTERN:-(_test\.|\.test\.|_spec\.|\.spec\.|(^|/)test_|\.tftest\.hcl$)}"
  local artifacts="${TEST_ARTIFACT_PATTERN:-(__pycache__/|\.pyc$|\.pyo$|\.class$|\.pytest_cache/|/node_modules/)}"
  local nuevos tocados delta added="" escape="" f dir
  local scope="" escapados=""
  local py_files="" go_dirs="" node_files="" tf_units="" otros=""
  local corre_py=0 corre_go=0 corre_node=0 corre_tf=0
  local MUERDE_PY="" MUERDE_NODE_RUNNERS="" MUERDE_NODE_RUNNER="" MUERDE_MOTIVO=""
  local mb head tmp
  # Tres puntos, el mismo ancla que gate_quick_size y por el mismo motivo: el
  # precheck corre SIN rebase, así que la punta del trunk trae commits ajenos que
  # esta tarea jamás tocó. El merge-base ES lo que "sin tu cambio" significa.
  nuevos="$(git diff -M "origin/$BASE_REF...HEAD" --diff-filter=A --name-only \
    | grep -E "$pat" | grep -vE "$artifacts" | sort -u || true)"
  tocados="$(git diff -M "origin/$BASE_REF...HEAD" --diff-filter=AM --name-only \
    | grep -E "$pat" | grep -vE "$artifacts" | sort -u || true)"
  delta="${HARNESS_DELTA_SPEC_FILE:-$WS/tasks/$TASK/delta-spec.md}"
  if [ -f "$delta" ]; then
    added="$(delta_seccion "$delta" 'ADDED')"
    escape="$(delta_seccion "$delta" '(MODIFIED|REMOVED)')"
  fi
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if printf '%s\n' "$nuevos" | grep -qxF -- "$f"; then :
    elif printf '%s\n' "$added" | grep -qiF -- "$(basename "$f")"; then :
    elif declara_tests_nuevos "$f"; then :
    else continue
    fi
    # ── El escape excusa un REFACTOR, jamás un caso NUEVO ────────────
    # Declarar un archivo bajo MODIFIED dice "toqué tests que ya existían", y
    # para eso el escape es correcto: un retoque cosmético pasa sobre la base
    # legítimamente y ponerlo rojo fabricaría un falso rojo. Lo que NO dice es
    # "no verifiques los casos que este archivo AGREGA".
    #
    # Caso de campo (COR-667), y el patrón es común, no excepcional: cualquier
    # fix que cambie una firma obliga a declarar MODIFIED su archivo de test.
    # En video-forge, cost_test.go se declaró MODIFIED (cambiaban las llamadas)
    # y ADEMÁS agregaba el único test que probaba el fix. El gate lo sacó del
    # alcance ENTERO e imprimió "sin tests nuevos que verificar": el precheck
    # salió verde sin mirar la única prueba del cambio. Un gate que da la señal
    # de seguridad sin la seguridad es peor que no tenerlo.
    #
    # Por eso el escape solo se concede si el archivo NO trae declaraciones de
    # test nuevas. Un refactor puro no las trae (declara_tests_nuevos mira las
    # líneas AÑADIDAS que declaran un test), así que la remediación que este
    # gate imprime sigue funcionando para el caso que la motivó.
    if printf '%s\n' "$escape" | grep -qiF -- "$(basename "$f")"; then
      if declara_tests_nuevos "$f"; then
        escapados="$escapados   ⚠️  $f: declarado bajo MODIFIED/REMOVED, pero AGREGA tests nuevos: sigue en el alcance
"
      else
        escapados="$escapados   ⚠️  $f: declarado bajo MODIFIED/REMOVED, fuera del alcance
"
        continue
      fi
    fi
    scope="$scope$f
"
  done <<TOCEOF
$tocados
TOCEOF
  if [ -n "$escapados" ]; then printf '%s' "$escapados"; fi
  if [ -z "$scope" ]; then
    echo "ℹ️  sin tests nuevos que verificar contra el árbol base"
    return 0
  fi
  gate "el test nuevo MUERDE (rojo sobre la base)"
  # El runner lo decide la EXTENSIÓN del archivo, no el stack del repo: un
  # monorepo con package.json y pyproject.toml a la vez no tiene un stack único,
  # y lo que hay que correr lo dice el test. Go va por PAQUETE porque `go test`
  # no acepta un archivo suelto sin arrastrar a sus vecinos del mismo paquete.
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in
      *.py) py_files="$py_files$f
" ;;
      *.go) dir="$(dirname "$f")"
            if [ "$dir" = "." ]; then dir="./"; else dir="./$dir"; fi
            go_dirs="$go_dirs$dir
" ;;
      *.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs) node_files="$node_files$f
" ;;
      *.tftest.hcl) tf_units="$tf_units$f
" ;;
      *) otros="$otros$f
" ;;
    esac
  done <<SCOPEOF
$scope
SCOPEOF
  if [ -n "$go_dirs" ]; then go_dirs="$(printf '%s' "$go_dirs" | sort -u)"; fi
  # Los runners se resuelven ANTES de tocar disco: si no hay ninguno, el gate se
  # declara saltado y no paga un checkout del árbol base para nada.
  if [ -n "$py_files" ]; then
    if muerde_pytest; then corre_py=1; else muerde_salto Python "$py_files"; fi
  fi
  if [ -n "$go_dirs" ]; then
    if muerde_go; then corre_go=1; else muerde_salto Go "$go_dirs"; fi
  fi
  if [ -n "$node_files" ]; then
    if muerde_node; then corre_node=1; else muerde_salto Node "$node_files"; fi
  fi
  if [ -n "$tf_units" ]; then
    if muerde_tf; then corre_tf=1; else muerde_salto Terraform "$tf_units"; fi
  fi
  if [ -n "$otros" ]; then
    MUERDE_MOTIVO="corro pytest (.py), go test (.go), vitest/jest/playwright (.ts/.js) y terraform test (.tftest.hcl); para el resto NO invento un comando, porque un runner adivinado diría 'el test muerde' cuando lo que falló fue la invocación"
    muerde_salto "sin runner dirigido" "$otros"
  fi
  if [ "$corre_py" -eq 0 ] && [ "$corre_go" -eq 0 ] && [ "$corre_node" -eq 0 ] \
     && [ "$corre_tf" -eq 0 ]; then
    echo "   (nada que correr: este gate NO dice verde ni rojo sobre estos tests)"
    return 0
  fi
  if ! mb="$(git merge-base HEAD "origin/$BASE_REF")"; then
    echo "⚠️  no pude resolver el merge-base con origin/$BASE_REF: el gate NO CORRIÓ."
    echo "   Sin árbol base no existe el 'sin tu cambio' contra el que medir, y"
    echo "   correr el test contra cualquier otra cosa sería inventar el veredicto."
    emit assumption "$REPO: tests nuevos NO verificados contra la base (sin merge-base con origin/$BASE_REF)"
    return 0
  fi
  head="$(git rev-parse HEAD)"
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/ship-muerde.XXXXXX")"
  # TODO el trabajo sucio va en un subshell con su propio trap EXIT: así el
  # worktree temporal se limpia por CUALQUIER salida (verde, rojo, o una muerte
  # por set -e a mitad de camino), que es la única forma de que la limpieza no
  # dependa de acordarse de llamarla en cada rama.
  (
    MUERDE_TMP="$tmp"; MUERDE_WT=""; MUERDE_BASE="$tmp/base"
    MUERDE_SALIDA="$tmp/salida"; MUERDE_VACUOS=""; MUERDE_CIEGOS=""; MUERDE_SINRED=""
    trap muerde_limpia EXIT
    if ! git -C "$WT" worktree add --detach --quiet "$MUERDE_BASE" "$mb"; then
      echo "⚠️  no pude crear el worktree temporal del árbol base ($mb): el gate NO CORRIÓ."
      echo "   No lo doy por verde: no miré nada."
      emit assumption "$REPO: tests nuevos NO verificados contra la base (no pude crear el worktree temporal)"
      exit 0
    fi
    MUERDE_WT="$MUERDE_BASE"
    # Se traen SOLO los archivos de test del alcance, desde HEAD y DENTRO del
    # temporal. El resto del árbol sigue siendo la base: eso es exactamente "tu
    # test sin tu cambio".
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      if ! git -C "$MUERDE_BASE" checkout "$head" -- "$f"; then
        echo "⚠️  no pude traer $f al árbol base: el gate NO CORRIÓ sobre estos tests."
        emit assumption "$REPO: tests nuevos NO verificados contra la base (no pude traer $f al árbol temporal)"
        exit 0
      fi
    done <<CKEOF
$scope
CKEOF
    # node_modules no está versionado, así que el árbol base nace sin él: se
    # presta el del worktree por enlace. Prestar deps no toca el artefacto que se
    # juzga (misma frontera que el gate ts declara al preparar la toolchain).
    if [ "$corre_node" -eq 1 ] && [ ! -e "$MUERDE_BASE/node_modules" ]; then
      ln -s "$WT/node_modules" "$MUERDE_BASE/node_modules"
    fi
    # ── EL ÁRBOL BASE NECESITA SU go.work (#75) ────────────────────────
    # Sin esto, el árbol base (un worktree bajo mktemp, o sea FUERA del
    # workspace) no tiene go.work alcanzable, el `replace ... => ../../pkg` del
    # layout monorepo no resuelve, y el paquete ni compila. El #43 hizo que eso
    # dejara de ser un falso verde y pasara a declararse como ceguera, que fue
    # la mejora correcta; pero la ceguera seguía siendo el estado NORMAL en los
    # SEIS servicios Go de la plataforma, o sea que el gate más caro del
    # precheck no verificaba nada en ninguno de ellos.
    #
    # Best-effort a propósito: si falla, la ceguera del #43 sigue diciendo la
    # verdad. Un gate que no puede prepararse NO puede convertirse en un verde.
    if [ "$corre_go" -eq 1 ] && [ -f "$WS/scripts/gowork.sh" ]; then
      bash "$WS/scripts/gowork.sh" --base "$MUERDE_BASE" >/dev/null 2>&1 \
        || echo "   (no pude armar el go.work del árbol base; lo que no compile queda declarado como ciego)"
    fi
    if [ "$corre_py" -eq 1 ];   then muerde_corre_grupo py   "$py_files";   fi
    if [ "$corre_go" -eq 1 ];   then muerde_corre_grupo go   "$go_dirs";    fi
    if [ "$corre_node" -eq 1 ]; then muerde_corre_grupo node "$node_files"; fi
    if [ "$corre_tf" -eq 1 ];   then muerde_corre_grupo tf   "$tf_units";   fi
    # Los CIEGOS no son verdes ni rojos: se dicen, y viajan como supuesto para
    # que el veredicto no herede un "todo verificado" que nadie verificó.
    if [ -n "$MUERDE_CIEGOS" ]; then
      echo "⚠️  tests nuevos que NO pude verificar contra la base (la base no compila):"
      printf '%s' "$MUERDE_CIEGOS"
      echo "   ↳ el árbol base no resuelve su grafo de módulos, así que su rojo NO"
      echo "     prueba que tu test muerda. Esto NO es un verde: es un tramo sin"
      echo "     mirar. Si el repo usa go.work, verificá el rojo a mano sobre la"
      echo "     base y pegá la salida en el veredicto."
      emit assumption "$REPO (Go): tests nuevos NO verificados contra la base (el árbol base no compila: replace/go.work sin resolver)"
    fi
    # SIN RED: el runner existe pero no colecta el archivo (o el archivo no
    # trae casos). No es verde ni rojo, y decirlo es la diferencia entre un
    # tramo declarado y un verde comprado con el exit del runner equivocado.
    if [ -n "$MUERDE_SINRED" ]; then
      echo "⚠️  tests nuevos SIN un caso que correr (ningún runner declarado los colectó):"
      printf '%s' "$MUERDE_SINRED"
      echo "   ↳ esto NO es un verde ni un rojo: es un tramo sin red, y queda dicho."
      emit assumption "$REPO: tests nuevos NO verificados contra la base (ningún runner declarado los colecta)"
    fi
    if [ -z "$MUERDE_VACUOS" ]; then
      if [ -z "$MUERDE_CIEGOS" ] && [ -z "$MUERDE_SINRED" ]; then
        echo "   ✅ todo el alcance falla sobre la base: estos tests prueban conducta nueva"
      else
        echo "   ✅ lo que SÍ pude correr falla sobre la base; el resto queda declarado arriba"
      fi
      exit 0
    fi
    echo "❌ estos tests PASAN también SIN tu cambio (sobre el árbol base):"
    printf '%s' "$MUERDE_VACUOS"
    echo "   ↳ remediación: este test pasa sin tu fix, o sea que no prueba la"
    echo "     conducta nueva: hazlo fallar primero (rojo sobre la base, verde"
    echo "     sobre tu cambio), o si es un refactor de test declaralo bajo"
    echo "     MODIFIED en el delta-spec, nombrando su archivo."
    exit 3
  )
}

# gate_evidence — nuestra ley es "los agentes proponen, los sistemas
# deterministas verifican". La compliance matrix la ESCRIBE un agente: hasta
# ahora, el verificador proponía. Este gate no juzga el código; solo comprueba
# mecánicamente que el artefacto citado por cada requirement (a) existe y (b)
# fue REALMENTE leído (lo registra el hook track-read.sh). Es una intersección
# de conjuntos: cero LLM, cero opinión.
gate_evidence() {
  local v="$WS/tasks/$TASK/verdict-$REPO.json"
  jq -e 'has("compliance")' "$v" >/dev/null 2>&1 || return 0
  gate "evidencia de compliance"
  local log="$WS/tasks/$TASK/evidence.log"
  local missing=0 unread=0 art base
  while IFS= read -r art; do
    [ -n "$art" ] || continue
    # La cita puede traer el CASO además del archivo: tests/x.py::caso
    # (pytest), archivo.go:42, rango :10-20, Clase#metodo. Caso de campo:
    # cuatro ships frenados con el review correcto porque el -e se aplicaba
    # a la cadena entera y "tests/x.py::caso" jamás existe en disco. La
    # existencia se comprueba sobre la base (el archivo); la lectura acepta
    # ambas grafías, porque el log registra lo que el comando dijo.
    base="$(printf '%s' "$art" | sed -e 's/::.*$//' -e 's/#[A-Za-z_][A-Za-z0-9_]*$//' -e 's/:[0-9][0-9]*\(-[0-9][0-9]*\)*$//')"
    [ -n "$base" ] || base="$art"
    if [ ! -e "$WS/$base" ] && [ ! -e "$WT/$base" ]; then
      echo "   ✗ citado pero NO EXISTE: $art"; missing=$((missing+1)); continue
    fi
    if [ -f "$log" ] && { grep -qF -- "$art" "$log" || grep -qF -- "$base" "$log"; }; then :; else
      echo "   ✗ citado pero NADIE LO LEYÓ: $art"; unread=$((unread+1))
    fi
  done <<EOF
$(jq -r '.compliance[]? | select(.covered==true) |
  if (.tests? | type) == "array" then .tests[]
  else (.evidence_path // .test // empty) end' "$v" 2>/dev/null)
EOF
  if [ "$missing" -gt 0 ] || [ "$unread" -gt 0 ]; then
    echo "❌ la compliance matrix cita evidencia que no existe ($missing) o que nunca se leyó ($unread)"
    echo "   ↳ remediación: un requirement solo pasa a covered:true si el reviewer"
    echo "     TOCÓ el artefacto que lo prueba (test, log, screenshot), y hay dos"
    echo "     formas de tocarlo, las dos válidas:"
    echo "       · ABRIRLO (Read, o cat/sed/git show por Bash: el hook los registra)"
    echo "       · EJECUTARLO con scripts/evidence.py run: la corrida apunta en el"
    echo "         log los archivos que el COMANDO NOMBRA."
    echo "     Ojo con la trampa que ya costó tres rondas: si corres"
    echo "     'go test ./internal/...' y citas internal/auth/auth_test.go, el"
    echo "     comando nunca nombró ese archivo, así que no queda registrado."
    echo "     Cita la ruta que ejecutaste, o abrila."
    echo "     'Confía en mí' no es evidencia, por eso existe este gate."
    echo "     Si operas el harness FUERA de Claude Code (sin el hook track-read),"
    echo "     el registro legítimo de una lectura real es:"
    echo "       bash scripts/mark-read.sh $TASK <ruta-del-artefacto>"
    exit 3
  fi
}

check_verdict() {
  gate "veredicto de review"
  local v="$WS/tasks/$TASK/verdict-$REPO.json" qa_state=""
  [ -f "$v" ] || { echo "❌ sin veredicto en $v"; echo "   ↳ remediación: corre /review $TASK $REPO primero"; exit 3; }
  # Dos condiciones, dos remediaciones opuestas: el review lo arregla el
  # implementer con los blocking; un qa:"pending" NO tiene blocking que
  # corregir: le falta correr la fase. Un mensaje único mandaba a leer una
  # lista vacía y quemaba una ronda, así que se diagnostican por separado.
  jq -e '.verdict=="pass"' "$v" >/dev/null \
    || { echo "❌ el review no es pass (verdict=$(jq -r '.verdict' "$v"))"
         echo "   ↳ remediación: corrige los $(jq '.blocking|length' "$v") items blocking listados en $v"
         echo "     (cada uno trae la suya) y re-corre /review $TASK $REPO"; exit 3; }
  jq -e '.qa=="pass"' "$v" >/dev/null \
    || { qa_state="$(jq -r '.qa' "$v")"
         echo "❌ QA no es pass (qa=$qa_state)"
         if [ "$qa_state" = "pending" ]; then
           echo "   ↳ el review pasó pero la fase QA nunca corrió. QA NO implica navegador:"
           echo "     · backend / criterios ya cubiertos por tests → QA determinista:"
           echo "       python3 scripts/evidence.py run --task-dir tasks/$TASK --repo $REPO \\"
           echo "         --runner qa --kind test --cwd worktrees/$TASK/$REPO -- <comando de test>"
           echo "     · frontend / criterios de cara al usuario → agente qa (Playwright)"
           echo "     Escribe el resultado en tasks/$TASK/qa-$REPO.json y re-corre /review"
           echo "     $TASK $REPO, que lo fusiona al veredicto (ver /review paso 1 y 3)."
         else
           echo "   ↳ remediación: QA encontró fallas; regrésalas al implementer como"
           echo "     blocking y re-corre QA sobre el HEAD nuevo (ver tasks/$TASK/qa-$REPO.json)"
         fi
         exit 3; }
  # ── UN `qa: "pass"` TIENE QUE TENER UN QA DETRAS ────────────────────
  # Hasta acá esto leía SOLO el campo del veredicto, o sea que la afirmación
  # más cara del pipeline ("alguien ejercitó el comportamiento") era palabra de
  # agente sin ningún artefacto que la respalde. Demostrado en una corrida real:
  # una tarea shippeó con qa:"pass", sin qa-<repo>.json y sin una sola evidencia
  # de runner=qa. La ley de la casa es que los agentes proponen y los sistemas
  # deterministas verifican; acá el verificador estaba proponiendo.
  #
  # Se acepta cualquiera de las dos formas que /review documenta: el artefacto
  # de la fase QA, o evidencia sellada con --runner qa. Lo que no se acepta es
  # ninguna de las dos.
  local qa_file="$WS/tasks/$TASK/qa-$REPO.json" qa_ev=0
  # `|| true` OBLIGATORIO (issue #33): grep -l sale 1 sin matches, pipefail
  # hereda ese 1 y set -e mataba la función AQUÍ, mudo, antes del if que
  # acepta el qa-<repo>.json: la rama que el comentario promete era
  # inalcanzable. Misma clase que el uv|ruff del issue #30.
  qa_ev="$(grep -l '"runner": *"qa"' "$WS/tasks/$TASK/evidence/"EV-*.json 2>/dev/null | wc -l | tr -d ' ' || true)"
  if [ ! -f "$qa_file" ] && [ "${qa_ev:-0}" -eq 0 ]; then
    echo "❌ el veredicto dice qa=\"pass\" pero no hay NADA que lo respalde:"
    echo "   ni tasks/$TASK/qa-$REPO.json ni evidencia con --runner qa."
    echo "   ↳ remediación: corré la fase QA de verdad (ver /review paso 1 y 3):"
    echo "     · backend / criterios ya cubiertos por tests → QA determinista:"
    echo "       python3 scripts/evidence.py run --task-dir tasks/$TASK --repo $REPO \\"
    echo "         --runner qa --kind test --cwd worktrees/$TASK/$REPO -- <comando>"
    echo "     · frontend / cara al usuario → agente qa, y escribí qa-$REPO.json"
    echo "   Un pass de QA sin artefacto es la afirmación más cara del pipeline"
    echo "   sostenida por nada."
    exit 3
  fi

  # compliance: todo requirement del delta-spec cubierto por tests
  jq -e '(.requirements_uncovered // 0) == 0' "$v" >/dev/null \
    || { echo "❌ $(jq -r '.requirements_uncovered' "$v") requirements del delta-spec sin test que los proteja"
         echo "   ↳ remediación: escribe el test faltante (ver .compliance[] con covered:false en $v) o pide al humano una excepción explícita"; exit 3; }
}

# El veredicto no es una afirmación libre: policy v1 comprueba estado, rondas
# y separación de roles; evidence v1 liga cada resultado al HEAD exacto y al
# hash de su salida. Ambos validadores son stdlib Python y fail-closed.
gate_policy_and_evidence() {
  gate "policy + evidencia v1"
  local v="$WS/tasks/$TASK/verdict-$REPO.json"
  local head pid base_moved out reviewed
  head="$(git rev-parse HEAD)"

  # La identidad del CAMBIO (no la del commit). Con varias personas pusheando
  # al mismo trunk, el rebase de más abajo reescribe los SHA sin tocar el
  # contenido: exigir SHA idéntico tiraba el review y el QA por un movimiento
  # que el reviewer nunca miró. Ver scripts/change-id.sh.
  #
  # El stderr NO se tira. change-id.sh sabe exactamente por qué no pudo calcular
  # el id (el diff contra origin/<base> está vacío, o no existe esa referencia) y
  # lo dice; tirarlo dejaba al operador con "POLICY-SHIP-002: falta --patch-id",
  # que nombra el síntoma y no la causa, y encima suena a bug del harness cuando
  # casi siempre es un worktree sin commits propios. Un gate mudo obliga a
  # adivinar, y adivinar cuesta una ronda.
  local pid_err
  pid_err="$(mktemp "${TMPDIR:-/tmp}/ship-changeid.XXXXXX")"
  pid="$(bash "$WS/scripts/change-id.sh" "$WT" "$BASE_REF" 2>"$pid_err" || true)"
  if [ -z "$pid" ]; then
    echo "⚠️  sin identidad de cambio (patch_id): el veredicto solo va a valer para"
    echo "   el SHA exacto, así que si el trunk se movió esto corta abajo."
    sed 's/^/   ↳ /' "$pid_err" 2>/dev/null
    echo "   ↳ remediación: commitea tu cambio en el worktree y verificá que"
    echo "     origin/$BASE_REF exista (git -C \"$WT\" fetch origin $BASE_REF)."
  fi
  rm -f "$pid_err"

  # Cuánto avanzó la base desde lo que se revisó: el juicio caduca en el
  # tiempo, no solo en el texto. Best-effort (el commit viejo puede haber sido
  # recolectado); si no se puede medir, policy aplica solo la ventana temporal.
  base_moved=""
  reviewed="$(jq -r '.commit // ""' "$v" 2>/dev/null || true)"
  if [ -n "$reviewed" ] && git cat-file -e "$reviewed^{commit}" 2>/dev/null; then
    base_moved="$(git rev-list --count "$reviewed..origin/$BASE_REF" 2>/dev/null || true)"
  fi

  out="$(python3 "$WS/scripts/harness-policy.py" --policy "$WS/harness-policy.json" \
    validate-ship "$WS/tasks/$TASK" --commit "$head" --verdict "$v" \
    ${pid:+--patch-id "$pid"} ${base_moved:+--base-moved "$base_moved"})" || return 1
  printf '%s\n' "$out"

  # El commit revisado lo declara policy, no lo re-derivamos: dos derivaciones
  # del mismo hecho es una oportunidad de divergir.
  reviewed="$(printf '%s\n' "$out" | sed -n 's/^REVIEWED_COMMIT=//p' | tail -1)"
  [ -n "$reviewed" ] || reviewed="$head"

  # Los tipos exigidos salen del POLICY, no cableados acá. `required_evidence_kinds`
  # y `require_fresh_evidence` se declaraban en harness-policy.json y no los leía
  # nadie: editarlos no hacía nada, en silencio. Misma clase de perilla muerta
  # que `flow`, ya corregida arriba.
  local kinds kind kind_flags=""
  kinds="$(python3 "$WS/scripts/harness-policy.py" --policy "$WS/harness-policy.json" \
    evidence-policy --field required_evidence_kinds 2>/dev/null || echo test)"
  for kind in $kinds; do
    kind_flags="$kind_flags --require-kind $kind"
  done

  # La evidencia REVISADA se verifica acá, en paralelo con el resto: ya existe.
  # shellcheck disable=SC2086
  python3 "$WS/scripts/evidence.py" verify \
    --task-dir "$WS/tasks/$TASK" --repo "$REPO" --commit "$head" \
    --reviewed-commit "$reviewed" --verdict "$v" $kind_flags

  # La FRESCA no: la produce el slot `lang` de este mismo fan-out, y los slots
  # corren sin orden entre si. Exigirla acá era una carrera contra su propio
  # productor: verify (milisegundos) contra la suite (minutos), o sea un rojo
  # espurio "falta evidencia FRESCA" en el primer intento y un verde en el
  # segundo usando el sello del intento fallido. Se difiere al final, cuando el
  # wait ya garantizo que lang termino.
}

# Verificacion diferida de la evidencia FRESCA. Corre en SERIE, despues del wait
# de run_parallel_gates, que es la unica barrera que garantiza que el sello de
# `lang` ya existe. Se recalcula todo desde el veredicto y el policy en vez de
# heredarlo del slot: el subshell ya murio y su GDIR se borro.
gate_fresh_evidence() {
  local v="$WS/tasks/$TASK/verdict-$REPO.json" head reviewed want kinds kind flags=""
  [ -f "$v" ] || return 0
  head="$(git rev-parse HEAD)"
  reviewed="$(jq -r '.commit // ""' "$v" 2>/dev/null || true)"
  [ -n "$reviewed" ] || return 0
  if [ "$reviewed" = "$head" ]; then
    # "La citada YA es la fresca" solo vale si de verdad esta sellada en HEAD:
    # con la equivalencia por patch_id, un EV citado puede ser de OTRO sha del
    # mismo cambio, y entonces ninguna prueba citada toco este arbol.
    local id c all_at_head=1
    for id in $(jq -r '.evidence[]?' "$v" 2>/dev/null); do
      c="$(jq -r '.commit // ""' "$WS/tasks/$TASK/evidence/$id.json" 2>/dev/null || true)"
      [ "$c" = "$head" ] || { all_at_head=0; break; }
    done
    [ "$all_at_head" -eq 1 ] && return 0
  fi
  want="$(python3 "$WS/scripts/harness-policy.py" --policy "$WS/harness-policy.json" \
    evidence-policy --field require_fresh_evidence 2>/dev/null || echo true)"
  [ "$want" = "true" ] || return 0
  [ "$(cat "$WS/tasks/$TASK/.langseen-$REPO" 2>/dev/null || echo 1)" != "0" ] || {
    echo "⚠️  el árbol integrado de $REPO NO se pudo verificar: su stack no lo"
    echo "   reconoce ningún gate de lenguaje, así que no hay suite que correr"
    echo "   sobre el merge con los commits ajenos que aterrizaron."
    emit assumption "$REPO: merge result NO verificado (ninguna suite corrió) al reusar veredicto"
    return 0; }
  kinds="$(python3 "$WS/scripts/harness-policy.py" --policy "$WS/harness-policy.json" \
    evidence-policy --field required_evidence_kinds 2>/dev/null || echo test)"
  for kind in $kinds; do
    [ "$kind" = "test" ] && flags="$flags --require-fresh-kind $kind"
  done
  [ -n "$flags" ] || return 0
  gate "evidencia fresca del árbol integrado"
  # shellcheck disable=SC2086
  python3 "$WS/scripts/evidence.py" verify \
    --task-dir "$WS/tasks/$TASK" --repo "$REPO" --commit "$head" \
    --reviewed-commit "$reviewed" --verdict "$v" $flags
}

# ── Preflight del ship: lo HEAD-independiente, ANTES del lock ─────────
# Un veredicto roto (JSON reescrito, EV de otro cambio, qa pending) se
# descubría tras pagar lock + rebase + la suite completa EN PARALELO con el
# slot de veredicto, y el vecino que esperaba el lock moría de hambre a los
# 600s (exit 6). Todo esto se comprueba contra el commit del PROPIO
# veredicto, así que no depende del rebase: cuesta segundos y cero lock.
# NO es la autoridad: la corrida autoritativa es la fase 0 post-rebase (el
# rebase puede cambiar el patch_id o borrar un artefacto citado). Es un
# early-reject de cortesía, fail-closed igual.
gate_ship_preflight() {
  local v="$WS/tasks/$TASK/verdict-$REPO.json" vc kinds kind kind_flags=""
  echo "── preflight (sin lock): el veredicto se valida ANTES de retener nada ──"
  gate_espacio_en_disco
  check_verdict
  gate_evidence
  vc="$(jq -r '.commit // ""' "$v" 2>/dev/null)"
  [ -n "$vc" ] || { echo "❌ el veredicto no declara commit"
    echo "   ↳ remediación: re-corre scripts/verdict-scaffold.sh $TASK $REPO"; exit 3; }
  gate "preflight: policy + evidencia contra el commit revisado"
  # validate-ship con --commit = verdict.commit: la rama de igualdad de
  # check_verdict_commit, así corren fase/estado/rondas/roles/pass-pass con
  # sus mensajes canónicos sin duplicar una línea de policy.
  python3 "$WS/scripts/harness-policy.py" --policy "$WS/harness-policy.json" \
    validate-ship "$WS/tasks/$TASK" --commit "$vc" --verdict "$v" >/dev/null
  kinds="$(python3 "$WS/scripts/harness-policy.py" --policy "$WS/harness-policy.json" \
    evidence-policy --field required_evidence_kinds 2>/dev/null || echo test)"
  for kind in $kinds; do kind_flags="$kind_flags --require-kind $kind"; done
  # shellcheck disable=SC2086
  python3 "$WS/scripts/evidence.py" verify \
    --task-dir "$WS/tasks/$TASK" --repo "$REPO" --commit "$vc" --verdict "$v" $kind_flags
  if [ -z "$(jq -r '.patch_id // ""' "$v" 2>/dev/null)" ]; then
    echo "⚠️  veredicto sin patch_id: si el trunk se movió, este ship exige SHA"
    echo "   exacto. Suele ser un reviewer que reescribió el JSON (ver reviewer.md)."
  fi
}

# ── Gates en paralelo ─────────────────────────────────────────────────
# Los grupos no comparten orden real entre sí (cada uno es read-only sobre
# el worktree o corre su propia toolchain); DENTRO de un grupo el orden se
# conserva (check_verdict antes que evidence). Cada grupo corre en subshell
# con su propio CURRENT_GATE y escribe su exit a un archivo: un rojo no
# oculta a los demás, y el implementer recibe TODOS los errores en un solo
# prompt de fix en vez de descubrirlos ronda por ronda.
#
# Y en DOS FASES: primero los baratos (subsegundo: tests-no-debilitados,
# veredicto, compliance, policy), después los caros (suites, scanners).
# Caso de campo: un requirements_uncovered=1 (200ms de jq) se descubría
# tras pagar una suite de 10 minutos que corría en paralelo.
GDIR=""; PAR_PIDS=""; PAR_SLOTS=""
par() {  # par <slot> <gate-fn>... — corre un grupo de gates en background
  local slot="$1"; shift
  (
    # PAR_SLOT: copia a scope de subshell. El trap EXIT de un subshell que
    # muere por set -e corre DESPUÉS de desmontar los locals de la función
    # (bash 3.2 y 5.x): referenciar $slot ahí es unbound variable.
    PAR_SLOT="$slot"
    CURRENT_GATE=""
    # SECONDS sigue contando dentro del subshell (arranca en el mismo cero que
    # el padre), así que el delta contra un _G0 tomado ACÁ mide lo que corrió
    # en ESTE slot, no lo que llevaba el ship. Se toma antes del primer gate()
    # por si el grupo muere sin llegar a abrir ninguno.
    _G0=$SECONDS
    group_exit() {
      local rc=$?
      if [ "$rc" -eq 0 ]; then
        [ -n "${CURRENT_GATE:-}" ] && emit gate "$CURRENT_GATE" true "" "$((SECONDS - ${_G0:-$SECONDS}))"
      else
        emit gate "$CURRENT_GATE — BLOQUEÓ el ship de $REPO (exit $rc)" false "" "$((SECONDS - ${_G0:-$SECONDS}))"
        echo "⛔ gate '$CURRENT_GATE' falló (exit $rc)"
      fi
      echo "$rc" > "$GDIR/$PAR_SLOT.rc"
    }
    trap group_exit EXIT
    local fn; for fn in "$@"; do "$fn"; done
  ) > "$GDIR/$slot.out" 2>&1 &
  PAR_PIDS="$PAR_PIDS $!"
  PAR_SLOTS="$PAR_SLOTS $slot"
}

close_serial_gate() {
  # cierra el gate serial anterior (mismo contrato que gate(), `dur` incluido)
  [ -n "${CURRENT_GATE:-}" ] && [ "$CURRENT_GATE" != "preflight" ] \
    && emit gate "$CURRENT_GATE" true "" "$((SECONDS - ${_G0:-$SECONDS}))"
  CURRENT_GATE=""; _G0=$SECONDS
}

# known_bug_cubre <slot> → 0 SOLO si el knob declara ESE slot y pasa los cuatro
# candados. Es un predicado: se llama desde la condición de un `if`, así que
# jamás debe salir != 0 por otra cosa que no sea "no cubre". Cada rechazo
# imprime su motivo CON la remediación: un "no" mudo devolvería al agente al
# bucle de tocar el harness, que es justo lo que este camino existe para evitar.
known_bug_cubre() {  # known_bug_cubre <slot>
  local slot="$1" decl_slot decl_url estado
  [ -n "$KNOWN_BUG" ] || return 1
  case "$KNOWN_BUG" in
    *=*) ;;
    *) echo "❌ HARNESS_KNOWN_BUG='$KNOWN_BUG' no tiene forma '<slot>=<url>'."
       echo "   ↳ hay que NOMBRAR el slot: un salto-todo sería una puerta trasera."
       return 1 ;;
  esac
  decl_slot="${KNOWN_BUG%%=*}"
  decl_url="${KNOWN_BUG#*=}"
  # Silencioso si el knob habla de OTRO slot: el motivo se imprime una vez, en
  # el slot al que apunta, no una vez por slot de la fase.
  [ "$decl_slot" = "$slot" ] || return 1

  # CANDADO 1 (la defensa principal): hay slots que no se rodean nunca.
  case "$decl_slot" in
    security|veredicto)
      echo "❌ los slots 'security' y 'veredicto' no se rodean JAMÁS, ni con issue abierto."
      echo "   · security: un secreto filtrado jamás es un bug del harness, y ese"
      echo "     slot junta gitleaks con semgrep (abrir uno sería abrir los dos)."
      echo "   · veredicto: sin veredicto no hubo review, y entonces no hay nada"
      echo "     que shippear todavía."
      echo "   ↳ si el gate de ese slot está roto de verdad: reportalo con"
      echo "     scripts/harness-bug.sh report y ESPERÁ el fix. Ese es el precio."
      return 1 ;;
  esac

  # CANDADO 2: forma de issue del forge. Un '<slot>=porque-si' no es una
  # declaración, es un salto sin rastro que nadie puede auditar después.
  case "$decl_url" in
    https://github.com/*/issues/*) ;;
    *) echo "❌ HARNESS_KNOWN_BUG apunta a '$decl_url', que no es la url de un issue."
       echo "   ↳ forma esperada: https://github.com/<org>/<repo>/issues/<n>"
       return 1 ;;
  esac

  # CANDADO 3: el issue tiene que estar YA en el ledger local, y ahí solo lo
  # pone harness-bug.sh (report verifica propiedad del artefacto, drift contra
  # el template, versión y repro; record anota uno abierto a mano). O sea:
  # REPORTAR ES LA PRECONDICIÓN DE DESBLOQUEARSE. Sin esto el knob sería un
  # "confía en mí" y el canal de vuelta al plugin se quedaría vacío, que es el
  # problema que este harness lleva rato intentando cerrar.
  if ! grep -qF "\"url\":\"$decl_url\"" "$WS/.harness/upstream-issues.jsonl" 2>/dev/null; then
    echo "❌ $decl_url no está en .harness/upstream-issues.jsonl: ese bug no fue reportado."
    echo "   Reportar es la PRECONDICIÓN de desbloquearse, no un trámite posterior."
    echo "   ↳ remediación:"
    echo "     scripts/harness-bug.sh report --title '...' --file <artefacto-del-plugin> \\"
    echo "       --repro <archivo-con-la-salida> --impact '<a quién más le pasa>'"
    echo "     (si el issue ya existe y lo abriste a mano: harness-bug.sh record --url $decl_url ...)"
    return 1
  fi

  # CANDADO 4: un issue CERRADO significa que el fix ya existe. Seguir
  # declarándolo sería congelar el harness roto en esta máquina para siempre.
  # Sin gh o sin red no se puede saber: se acepta, pero DICIÉNDOLO (un
  # "verificado" que no verificó nada es peor que un desconocido declarado).
  estado=""
  if command -v gh >/dev/null 2>&1; then
    estado="$(gh issue view "$decl_url" --json state --jq .state 2>/dev/null || echo "")"
  fi
  if [ "$estado" = "CLOSED" ]; then
    echo "❌ el issue $decl_url está CERRADO: el workaround venció."
    echo "   El fix del harness ya existe; declararlo otra vez lo dejaría fuera."
    echo "   ↳ remediación: corré /harness-update y re-corré este ship."
    return 1
  fi
  [ -n "$estado" ] || echo "   (estado del issue sin verificar: no hay gh o no hubo red)"
  return 0
}

collect_gate_slots() {  # collect_gate_slots <etiqueta>: espera, imprime TODO, agrega
  local pid slot rc failed=""
  for pid in $PAR_PIDS; do wait "$pid" 2>/dev/null || true; done
  for slot in $PAR_SLOTS; do
    cat "$GDIR/$slot.out"
    rc="$(cat "$GDIR/$slot.rc" 2>/dev/null || echo 1)"
    # El knob se consulta ACÁ y no dentro de cada gate: este es el único punto
    # donde el harness ya conoce el slot por nombre, que es la granularidad que
    # el mensaje de error imprime y por lo tanto la única que un agente puede
    # citar sin adivinar. `if !` sobre un predicado es seguro; envolver un gate
    # serial no lo sería (desactiva errexit adentro).
    if [ "$rc" -ne 0 ] && known_bug_cubre "$slot"; then
      KNOWN_BUG_USED="$KNOWN_BUG"
      echo "⚠️  slot '$slot' rojo por BUG CONOCIDO del harness: ${KNOWN_BUG#*=}"
      echo "   NO es un verde: es una condición DECLARADA. Queda en el bus, en el"
      echo "   sello del precheck, en el veredicto y en ship.log. Quitá el"
      echo "   workaround cuando el issue cierre."
      emit assumption "$REPO: slot '$slot' rojo declarado como bug conocido del harness (${KNOWN_BUG#*=})" false
      rc=0
    fi
    [ "$rc" -eq 0 ] || failed="$failed $slot"
  done
  rm -rf "$GDIR"; PAR_PIDS=""; PAR_SLOTS=""
  if [ -n "$failed" ]; then
    CURRENT_GATE="$1:$failed"
    echo "❌ gates rojos ($1):$failed — TODOS los errores están arriba. Corrige TODO"
    echo "   en UNA iteración (cada gate trae su remediación) y re-corre ship.sh."
    exit 3
  fi
}

run_phase0_gates() {
  close_serial_gate
  GDIR="$(mktemp -d "${TMPDIR:-/tmp}/ship-gates.XXXXXX")"
  PAR_PIDS=""; PAR_SLOTS=""
  # En precheck no hay veredicto todavía (ese es justamente el punto: correr
  # lo mecánico ANTES de gastar una ronda de reviewer). Los slots del
  # veredicto van SEPARADOS: dentro de uno solo, set -e aborta en el primer
  # die y se perdería el "todos los rojos juntos".
  if [ "${PRECHECK:-0}" -eq 1 ]; then
    echo "── fase 0: gates baratos: tests (sin veredicto: precheck) ──"
  else
    echo "── fase 0: gates baratos: tests ∥ veredicto ∥ compliance ∥ policy ──"
  fi
  par tests gate_tests_untouched
  if [ "${PRECHECK:-0}" -ne 1 ]; then
    par veredicto   check_verdict
    par compliance  gate_evidence
    par policy      gate_policy_and_evidence
  fi
  collect_gate_slots "fase 0 (ninguna suite corrió: esto costó segundos)"
}

run_parallel_gates() {
  close_serial_gate
  GDIR="$(mktemp -d "${TMPDIR:-/tmp}/ship-gates.XXXXXX")"
  PAR_PIDS=""; PAR_SLOTS=""
  echo "── gates caros en paralelo: lang ∥ security ──"
  par lang      run_lang_gates_sealed
  par security  run_security_gates
  collect_gate_slots "gates paralelos"
}

# ── Modo interno --lang-gates ─────────────────────────────────────────
# Va acá, después de TODAS las definiciones de función, porque bash resuelve
# funciones en tiempo de ejecución. Sin lock, sin rebase, sin veredicto:
# solo la corrida que evidence.py va a sellar.
if [ "$LANG_ONLY" -eq 1 ]; then
  cd "$WT"
  # SIN `|| rc=$?` NI NADA QUE LO ENVUELVA: eso desactivaria `set -e` dentro de
  # run_lang_gates y un gate rojo dejaria de abortar. El exit de esta invocacion
  # ES el veredicto que evidence.py sella, asi que tiene que ser el de verdad.
  # El marcador de "verifique algo" lo escribe el trap on_exit, que corre pase
  # lo que pase.
  run_lang_gates
  exit 0
fi

# ── Modo CI: los gates mecánicos sobre el checkout actual ─────────────
# Mismo codigo que el precheck, sin nada que dependa del workspace. Es lo que
# la cola de merge del forge ejecuta como required check.
if [ "$CI_MODE" -eq 1 ]; then
  cd "$WT"
  echo "══ gates del harness sobre $REPO (modo CI) ══"
  echo "   base: origin/$BASE_REF · commit: $(git rev-parse --short HEAD)"
  # PRECHECK=1 hace que la fase 0 omita los slots de veredicto (que aqui no
  # existen) y que el sellado de evidencia no intente escribir en tasks/.
  # Se reusa esa bandera en vez de inventar una tercera.
  PRECHECK=1
  run_phase0_gates
  gate_test_muerde
  run_parallel_gates
  echo "✅ gates verdes sobre el merge result. Este check es el que la cola de"
  echo "   merge exige, y corre en infra neutral: no depende de la laptop de nadie."
  exit 0
fi

# ── Precheck: los gates mecánicos ANTES de gastar una ronda de review ─
# Sin lock (no toca main), sin rebase (no reescribe la historia del
# implementer) y sin veredicto. Solo responde una pregunta: ¿este worktree
# pasaría hoy los gates que no dependen de juicio humano ni de review?
#
# TRAILER Y CARRIL TAMBIÉN VAN ACÁ. Antes vivían SOLO en el camino de ship, o
# sea que un commit sin `Task:` o un express que tocó un .proto se descubrían
# después de pagar review y QA completos. Los dos son operaciones de git que
# cuestan milisegundos, y el carril rojo es el retroceso más caro del pipeline
# (escala de carril → vuelta a /rfc → re-planear → re-implementar). Descubrirlo
# en el momento de máximo costo hundido era el peor orden posible.
# ── "NO ES TU CÓDIGO, ES EL DISCO" ───────────────────────────────────
# Caso de campo medido: un lote de 8 corridas de la misma suite dio 3 rojas con
# el disco al 100 por ciento (56K libres de 193G). Dos ni llegaron a colectar el
# archivo de test (los workers murieron por ENOSPC, 99 de 113 tests) y la
# tercera falló un assert por contención. Con 29G libres, 16 corridas seguidas
# salieron verdes.
#
# El daño no es la corrida perdida: es que un rojo por disco se lee IGUAL que un
# defecto de código, así que manda al agente a arreglar lo que no está roto y le
# quema rondas del presupuesto. Es el mismo patrón que el rojo por ceguera de
# deploy-watch: una causa ambiental disfrazada de causa de código.
#
# Corre ANTES de los gates, no después: la gracia es no pagar la suite entera
# para descubrir que el resultado no significaba nada. Es fail-CLOSED a
# propósito (se niega a correr en vez de producir un resultado que no vale), y
# el mensaje dice exactamente qué borrar. El umbral es configurable porque una
# suite de Go con cachés y una de docs no necesitan lo mismo.
gate_espacio_en_disco() {
  local libre_kb min_gb libre_gb
  min_gb="${HARNESS_MIN_FREE_GB:-2}"
  case "$min_gb" in ''|*[!0-9]*) min_gb=2 ;; esac
  [ "$min_gb" -gt 0 ] || return 0            # 0 = apagado explícito
  # Se miran DOS sistemas de archivos y manda el más apretado: el worktree y el
  # de temporales. El caso de campo fue el disco RAÍZ, y los workers de test
  # escriben su spill en TMPDIR, que muy seguido está en otro filesystem que el
  # worktree (o al revés). Mirar uno solo dejaba pasar exactamente el escenario
  # reportado: worktree holgado, raíz al 100 por ciento, suite roja por ENOSPC.
  #
  # -P: formato POSIX de una sola línea (sin él, un punto de montaje largo
  # parte la salida en dos y el awk lee la columna equivocada). BSD y GNU.
  local punto otro_kb
  libre_kb=""
  for punto in "$WT" "${TMPDIR:-/tmp}"; do
    otro_kb="$(df -Pk "$punto" 2>/dev/null | awk 'NR==2 {print $4}')"
    case "$otro_kb" in ''|*[!0-9]*) continue ;; esac
    if [ -z "$libre_kb" ] || [ "$otro_kb" -lt "$libre_kb" ]; then libre_kb="$otro_kb"; fi
  done
  case "$libre_kb" in ''|*[!0-9]*) return 0 ;; esac   # sin df legible: no se inventa
  libre_gb=$((libre_kb / 1024 / 1024))
  [ "$libre_kb" -lt $((min_gb * 1024 * 1024)) ] || return 0
  gate "espacio en disco"
  echo "⛔ quedan ${libre_gb}G libres (mínimo ${min_gb}G): NO corro los gates."
  echo "   NO ES TU CÓDIGO, ES EL DISCO. Con el disco lleno los workers de test"
  echo "   mueren por ENOSPC y ni colectan los archivos: el rojo que verías no"
  echo "   diría nada sobre el cambio, y arreglarlo te costaría rondas."
  echo "   Medido: 3 de 8 corridas rojas con el disco al 100 por ciento; 16 de 16"
  echo "   verdes con 29G libres, mismo código."
  echo "   ↳ remediación, lo que más crece primero:"
  echo "     du -sh \"$WS\"/.cache \"$WS\"/worktrees 2>/dev/null | sort -h"
  echo "     scripts/worktree-task.sh --rm <task-id>   # worktrees ya shippeados"
  echo "     docker system prune -a                    # si usás docker"
  echo "   ↳ si de verdad querés correr así: HARNESS_MIN_FREE_GB=0 (y no confíes"
  echo "     en el resultado)."
  # SIN `dur`, a propósito (y lo mismo en los tres emit `gate` de más abajo que
  # tampoco lo llevan: el resumen del precheck y el reintento de push). `dur`
  # significa "cuánto tardó ESTE gate", y estos eventos no cierran un tramo:
  # aquí nada corrió. Ponerle el delta contra _G0 sería inventar una medición.
  emit gate "gates de $REPO NO corridos: ${libre_gb}G libres de disco" false
  exit 3
}

gate_entry_precheck() {
  gate_espacio_en_disco
  local total
  total="$(git rev-list --count "origin/$BASE_REF..HEAD" 2>/dev/null || echo 0)"
  if [ "${total:-0}" -eq 0 ]; then
    echo "ℹ️  todavía no hay commits sobre origin/$BASE_REF: sin trailer ni carril que verificar."
    return 0
  fi
  gate_trailer
  gate_lane
}

if [ "$PRECHECK" -eq 1 ]; then
  cd "$WT"
  # El marcador de "algo se verificó" es de ESTA corrida. Sobrevive entre
  # corridas (vive en tasks/<task>/), así que uno viejo dejaría que un precheck
  # que ni llegó a los gates de lenguaje heredara el "completo" del anterior y
  # lo sellara como propio. Se borra ANTES de mirar, no después.
  #
  # SALVO QUE HAYA UN SHIP EN VUELO. El marcador es UN archivo por task+repo y
  # el ship lo usa igual: su hijo --lang-gates lo escribe y su padre lo lee dos
  # veces (al sellar evidencia y en gate_fresh_evidence). Borrarlo desde acá en
  # medio de esa ventana le arranca la evidencia al vecino y encima en la
  # dirección cara: el ship ve "no hay rastro", tira su EV-TEST recién acuñado
  # y repite la suite entera. El lock del repo es el único indicio de que hay
  # un ship vivo, así que se respeta. Heredar un marcador viejo es el daño
  # MENOR y además se declara acá y en el sello ("verificado" puede venir de la
  # otra corrida), en vez de pisar en silencio lo ajeno.
  if [ -d "$LOCKDIR" ]; then
    echo "⚠️  hay un ship de '$REPO' en vuelo (lock $LOCKDIR): NO borro el marcador"
    echo "   tasks/$TASK/.langseen-$REPO, que mientras dure ese ship es SUYO."
    echo "   El campo 'verificado' de este sello puede venir de esa corrida y no"
    echo "   de esta: no lo leas como que ESTOS gates compilaron y testearon."
    echo "   ↳ re-corré el precheck cuando el ship termine si querés el dato limpio."
    emit assumption "precheck de $REPO: marcador conservado, hay un ship en vuelo con el lock"
  else
    rm -f "$WS/tasks/$TASK/.langseen-$REPO"
  fi
  git fetch origin --quiet 2>/dev/null || true   # fail-open: sin red, compara contra el origin/$BASE_REF local
  echo "══ precheck $REPO (task $TASK) ══"
  gate_entry_precheck
  run_phase0_gates
  # Después de los baratos y ANTES de las suites completas: correr un test nuevo
  # contra el árbol base cuesta un checkout y esos tests, no la suite entera, y
  # si el test no muerde no tiene sentido pagar los gates caros para descubrirlo.
  gate_test_muerde
  run_parallel_gates
  # EL SELLO AFIRMA "LOS GATES PASARON SOBRE ESTE COMMIT" (issue #39). Con el
  # árbol sucio los gates corrieron sobre el WORKING TREE, no sobre HEAD:
  # sellarlo nombraría un commit que no contiene lo que se validó. El fix de
  # la evidencia (0.52.0) recibía este tratamiento y el sello no: mitad y
  # mitad. Los gates corren igual (feedback para el implementer); lo que no
  # se emite es la afirmación falsa.
  if [ -n "$(git status --porcelain -uno 2>/dev/null)" ]; then
    echo "⚠️  gates verdes sobre el WORKING TREE, no sobre HEAD: SIN sello."
    echo "   El árbol trae cambios sin commitear, y el sello del precheck"
    echo "   nombraría un commit que no contiene lo que se validó."
    echo "   ↳ commitea (con el trailer Task: $TASK) y re-corre el precheck:"
    echo "     /review exige el sello del HEAD que va a revisar."
    emit gate "precheck de $REPO verde SIN sello (árbol sucio)" true
  else
    stamp_precheck true
    emit gate "precheck de $REPO verde, listo para review" true
    echo "✅ precheck verde. Sello: tasks/$TASK/precheck-$REPO.json"
    # La ÚLTIMA LÍNEA es la que alguien lee, así que no puede afirmar más de lo
    # que el sello dice. Verde con verificado != completo sigue siendo verde (no
    # bloquea), pero no es un verde verificado, y callarlo acá volvería a
    # convertir un "no miré" en un "pasó".
    v_estado="$(precheck_verificado)"
    case "$v_estado" in
      completo) ;;
      ninguno)
        echo "   ⚠️  verificado: ninguno. Verde acá significa 'ningún gate dijo que"
        echo "      no', NO 'la suite pasó': no corrió un solo gate de lenguaje"
        echo "      (motivo arriba). El sello lo declara y /review debe decirlo." ;;
      *)
        echo "   ⚠️  verificado: $v_estado. No pude saber si algún gate de lenguaje"
        echo "      llegó a correr: falta el marcador que deja la corrida sellada."
        echo "      Va así en el sello, sin disfrazarlo de verde ni de rojo." ;;
    esac
    aviso_evidencia_desalineada
    echo "→ siguiente: /review $TASK $REPO"
  fi
  exit 0
fi

# ── EL MERGE QUE ATERRIZA DECLARA EL BUMP QUE TRAE ────────────────────
# Caso de campo (#68): con flow trunk-merge-commit el mensaje era
# "merge: <task> en <repo>", que no matchea ningún prefijo de conventional
# commits. El CI del repo condiciona el build al bump semver del commit que
# aterriza, así que salió bump_type=none, build SKIPPED, notify SKIPPED: la
# trunk avanzó con el cambio y NO se construyó ni se desplegó nada. El run
# cerró en success (un job saltado no mancha la conclusión), y solo lo cazó
# deploy-watch mirando job por job.
#
# El fast-forward no tenía el problema porque el CI ve los commits de la rama,
# con sus prefijos. El merge commit los esconde detrás de UN mensaje, así que
# ese mensaje tiene que decir lo mismo: el tipo más FUERTE de lo que aterriza.
# No se inventa un bump (un `fix:` de oficio convertiría un docs-only en un
# release), y no se pierde uno: si la rama trae un breaking, el merge lo
# declara con `!`.
merge_bump_type() {  # merge_bump_type <rango> → feat! | feat | fix | <tipo> | vacío
  local range="$1" subjects bodies breaking=0
  subjects="$(git log --format='%s' "$range" 2>/dev/null || true)"
  [ -n "$subjects" ] || return 0
  bodies="$(git log --format='%b' "$range" 2>/dev/null || true)"
  # Las dos grafías del breaking de conventional commits: el `!` del asunto
  # (lo mira el awk) y el footer del cuerpo.
  case "$bodies" in *"BREAKING CHANGE"*) breaking=1 ;; esac
  # awk y no `grep -q`: acá se lee TODA la entrada. Un grep que corta al primer
  # match cierra el pipe, el productor muere con SIGPIPE y bajo `set -o pipefail`
  # el `if` vería un fallo justo cuando SÍ hubo match.
  printf '%s\n' "$subjects" | awk -v breaking="$breaking" '
    BEGIN { rank["feat"] = 3; rank["fix"] = 2; rank["perf"] = 1; best = -1 }
    {
      if (match($0, /^[a-z]+(\([^)]*\))?!?:/) == 0) next
      head = substr($0, 1, RLENGTH)
      if (index(head, "!:") > 0) breaking = 1
      sub(/[(!:].*$/, "", head)              # el tipo pelado, sin scope
      if (nuevo == "") nuevo = head          # git log ordena del más nuevo al más viejo
      r = (head in rank) ? rank[head] : 0
      if (r > best) { best = r; fuerte = head }
    }
    END {
      if (best < 0) exit 0                   # ni un commit con tipo: no hay bump que declarar
      if (breaking) { print "feat!"; exit 0 }
      if (best > 0) print fuerte; else print nuevo
    }'
}

merge_commit_message() {  # merge_commit_message <tipo> <task> <repo> <base> → mensaje
  local type="$1" task="$2" repo="$3" base="$4" subject
  if [ -n "$type" ]; then subject="$type: $task en $repo (merge)"
  else                    subject="merge: $task en $repo"; fi
  printf '%s\n\n' "$subject"
  printf 'Aterriza la rama de la tarea sobre %s con merge commit. El primer padre\n' "$base"
  printf 'es la trunk, así que se deshace entero con git revert -m 1.\n\n'
  printf 'Task: %s\n' "$task"
}

# ── Loop de ship ──────────────────────────────────────────────────────
cd "$WT"
gate_ship_preflight
acquire_lock
attempt=0
while [ "$attempt" -lt "$PUSH_RETRY_BUDGET" ]; do
  attempt=$((attempt+1))
  echo "══ ship $REPO (task $TASK) intento $attempt/$PUSH_RETRY_BUDGET ══"
  git fetch origin
  # EL CAMINO DE ERROR TAMBIEN TIENE QUE FUNCIONAR. Antes esto era
  # `git rebase ... || { git rebase --abort; echo ...; exit 4; }`, y cuando el
  # rebase fallaba SIN dejar un rebase en curso (arbol sucio, que es el caso
  # comun), el `--abort` salia 128, `set -e` mataba el script ahi mismo, y el
  # humano recibia "exit 128" sin una sola linea de diagnostico. Reproducido
  # pasando una feature de verdad por el harness.
  #
  # Y el mensaje unico tampoco servia: "conflicto de rebase" es falso cuando la
  # causa fue un archivo versionado que los tests reescribieron (.pyc, un
  # snapshot, un reporte de coverage). Son dos causas con remediaciones
  # distintas, asi que se diagnostican por separado.
  if ! rebase_out="$(git rebase origin/$BASE_REF 2>&1)"; then
    git rebase --abort >/dev/null 2>&1 || true
    echo "❌ no pude rebasear sobre origin/$BASE_REF:"
    printf '%s\n' "$rebase_out" | sed 's/^/   /'
    case "$rebase_out" in
      *"unstaged changes"*|*"local changes"*|*"cambios sin"*|*"would be overwritten"*)
        echo "   ↳ el worktree tiene cambios SIN COMMITEAR sobre archivos versionados."
        echo "     Suele ser un artefacto que los propios tests reescriben (.pyc,"
        echo "     snapshots, coverage) y que el repo versiona por accidente."
        echo "     Commiteálo, o agregalo al .gitignore de $REPO y re-corré." ;;
      *)
        echo "   ↳ conflicto real: resolvélo en el worktree $WT y re-corré ship.sh." ;;
    esac
    exit 4
  fi
  gate_trailer
  gate_lane
  run_phase0_gates
  run_parallel_gates
  gate_fresh_evidence
  # ── flow: prs — la rama y el PR, NUNCA main ─────────────────────────
  # Los gates son los MISMOS: lo unico que cambia es la puerta. Y cambia algo
  # mas, que es lo que hace falta decir sin ambiguedad: con PRs, cuando ship.sh
  # termina el cambio NO esta en main todavia. El sha que se verifico aqui
  # tampoco es el que va a aterrizar, porque la cola de merge del forge rebasea
  # o hace squash. Por eso ship.log NO registra un sha "shippeado" a secas:
  # registra el PR y deja `landed:false`, y deploy-watch resuelve el commit real
  # cuando el PR se mergee. Fingir aqui un ship producirla un /archive que
  # fusiona specs de un cambio que sigue sin mergear.
  if [ "$FLOW_MODE" = "prs" ]; then
    branch="$(git rev-parse --abbrev-ref HEAD)"
    [ "$branch" != "HEAD" ] || { echo "❌ el worktree está en detached HEAD: no hay rama que pushear"; exit 4; }
    # El rebase de arriba reescribio la historia de la rama, asi que a partir
    # del segundo intento el push necesita forzar. --force-with-lease y no
    # --force: si alguien mas movio ESA rama, se para en vez de pisarla.
    if ! git push origin "HEAD:refs/heads/$branch" 2>/dev/null; then
      git push --force-with-lease origin "HEAD:refs/heads/$branch" || {
        echo "❌ no pude publicar la rama $branch (¿alguien más la movió?)"
        echo "   ↳ --force-with-lease se niega a pisar trabajo ajeno: mirá la rama remota"
        exit 4; }
    fi
    sha="$(git rev-parse HEAD)"; short="$(git rev-parse --short HEAD)"
    # shellcheck source=/dev/null
    . "$WS/scripts/forge.sh" 2>/dev/null || true
    pr=""
    if command -v forge_pr_url >/dev/null 2>&1 || type forge_pr_url >/dev/null 2>&1; then
      pr="$(forge_pr_url "$WT" "$branch" 2>/dev/null || true)"
      if [ -z "$pr" ]; then
        pr="$(forge_pr_create "$WT" "$branch" \
              "$TASK: $REPO" \
              "Abierto por el harness tras pasar los gates de ship.sh.

Task: $TASK
Commit verificado: $sha
Veredicto: tasks/$TASK/verdict-$REPO.json

El sha que aterrice NO sera este si la cola de merge rebasea o hace squash." 2>/dev/null || true)"
      fi
    fi
    if [ -z "$pr" ]; then
      echo "⚠️  rama publicada, pero NO pude abrir ni encontrar el PR"
      echo "   (el forge no tiene driver acá, o falta su CLI, o no hay acceso)."
      emit assumption "$REPO: rama $branch publicada, PR no confirmado"
    fi
    printf '{"repo":"%s","sha":"%s","short":"%s","branch":"%s","pr":"%s","landed":false,"shipped_at":"%s"%s}\n' \
      "$REPO" "$sha" "$short" "$branch" "${pr:-}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      "$(known_bug_frag)" >> "$WS/tasks/$TASK/ship.log"
    stamp_provenance "$sha"
    [ -n "${CURRENT_GATE:-}" ] && emit gate "$CURRENT_GATE" true "" "$((SECONDS - ${_G0:-$SECONDS}))" && CURRENT_GATE=""
    emit ship "$REPO: PR abierto desde $branch @ $short (falta el merge)" true
    # El anuncio final NO puede afirmar lo que el aviso de arriba acaba de
    # negar: si no hubo PR, decir "PR abierto" seria la mentira mas barata de
    # todas, la de la ultima linea que alguien lee.
    if [ -n "$pr" ]; then
      echo "✅ gates verdes y PR abierto: $pr"
      echo "   ⚠️  el cambio NO esta en $BASE_REF todavia: falta que el PR se mergee."
    else
      echo "✅ gates verdes y rama publicada en origin/$branch, SIN PR confirmado"
      echo "   ⚠️  el cambio NO esta en $BASE_REF y NO hay PR que lo lleve. Abrilo"
      echo "      a mano desde esa rama, o esto no llega a ningun lado."
    fi
    echo "→ siguiente: cuando mergee, scripts/deploy-watch.sh $TASK $REPO resuelve"
    echo "   el commit real y recien ahi corresponde /archive."
    request_ship_phase
    exit 0
  fi

  # ── El objeto que se publica ─────────────────────────────────────────
  # Con LAND_MERGE se arma un merge commit SIN tocar el árbol de trabajo: nada
  # de checkout ni de ramas temporales. HEAD ya viene rebaseado sobre el trunk,
  # así que su ÁRBOL es exactamente el resultado que se quiere publicar, y
  # `commit-tree` lo sella con dos padres. El orden de los padres no es
  # decorativo: primero el trunk, para que `git revert -m 1` deshaga el trabajo
  # de la tarea y no al revés. Va DENTRO del loop de reintentos porque cada
  # rebase por contención cambia HEAD y el trunk, y el merge hay que rehacerlo.
  push_ref="HEAD"
  if [ "$LAND_MERGE" -eq 1 ]; then
    # El rango es el de ESTE intento: cada rebase por contención cambia HEAD y
    # el trunk, y con ellos lo que el merge está aterrizando.
    merge_type="$(merge_bump_type "origin/$BASE_REF..HEAD")"
    if [ -z "$merge_type" ]; then
      echo "⚠️  ningún commit de $TASK declara tipo de conventional commits, así que"
      echo "   el merge que aterriza tampoco puede declararlo sin inventarlo. Si tu"
      echo "   CI condiciona el build al bump semver del commit que llega a"
      echo "   $BASE_REF, va a SALTARSE el build: la trunk avanza y no se despliega"
      echo "   nada (el run cierra en success con los jobs saltados; deploy-watch"
      echo "   lo reporta como rojo)."
      echo "   ↳ remediación: prefijá los commits de la tarea (fix:/feat:) y"
      echo "     re-corré el ship, o disparás el build a mano en tu CI."
    fi
    if ! merge_sha="$(git commit-tree "$(git rev-parse 'HEAD^{tree}')" \
                        -p "$(git rev-parse "origin/$BASE_REF")" \
                        -p "$(git rev-parse HEAD)" \
                        -m "$(merge_commit_message "$merge_type" "$TASK" "$REPO" "$BASE_REF")")"; then
      echo "❌ no pude armar el merge commit para aterrizar $TASK en $BASE_REF."
      echo "   ↳ el ship NO publicó nada. Con flow 'trunk' (sin merge commit) el"
      echo "     camino sigue abierto; este modo existe para poder revertir de un"
      echo "     tirón, y publicar un fast-forward en su lugar sería entregar algo"
      echo "     distinto de lo que la política declara."
      exit 2
    fi
    push_ref="$merge_sha"
  fi
  if git push origin "$push_ref:$BASE_REF"; then
    sha="$(git rev-parse "$push_ref")"    # COMPLETO: deploy-watch lo compara
    short="$(git rev-parse --short "$push_ref")" # contra el headSha del forge,
                                          # que siempre viene completo. Con el sha
                                          # corto la comparación no matcheaba nunca.
    echo "{\"repo\":\"$REPO\",\"sha\":\"$sha\",\"short\":\"$short\",\"shipped_at\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"$(known_bug_frag)}" >> "$WS/tasks/$TASK/ship.log"
    stamp_provenance "$sha"
    # Cierra el último gate ANTES de anunciar el ship: si lo dejara al trap,
    # el "veredicto ✅" saldría en el bus DESPUÉS del "shippeé" y la historia
    # tendría el penúltimo paso después del último.
    [ -n "${CURRENT_GATE:-}" ] && emit gate "$CURRENT_GATE" true "" "$((SECONDS - ${_G0:-$SECONDS}))" && CURRENT_GATE=""
    emit ship "$REPO @ $short — pasó los gates y está en main" true
    echo "✅ shipped $REPO @ $short"
    # El comando de revert es la RAZÓN de este modo, así que se entrega acá y
    # no se deja para que el humano lo derive. Con fast-forward habría que
    # conocer el rango exacto; con el merge commit es una línea, y esa línea
    # tiene que estar donde se lee el resultado del ship, no en un ticket.
    if [ "$LAND_MERGE" -eq 1 ]; then
      echo "   ↩︎  para deshacerlo entero: git -C repos/$REPO revert -m 1 $short"
      echo "      (aterrizó con merge commit; el primer padre es $BASE_REF)"
      # Lo que el CI va a leer, dicho acá: es la única línea del mensaje que
      # existe, y de ella depende que el build corra (#68).
      if [ -n "${merge_type:-}" ]; then
        echo "   🏷️  el merge declara '$merge_type:' (el bump más fuerte que traen sus commits)"
      fi
    fi
    request_ship_phase
    echo "→ siguiente: scripts/deploy-watch.sh $TASK $REPO (o /ship se encarga)"
    exit 0
  fi
  # ── Perder la carrera es NORMAL, no un error ────────────────────────
  # Con varios workspaces contra el mismo trunk, que otro llegue primero entre
  # el último gate y el push es rutina. Antes esto consumía el presupuesto de
  # RONDAS DE REVIEW y a la tercera escalaba a humano por pura contención.
  # El backoff va ACÁ (antes del próximo fetch), y lleva jitter: sin él, los
  # que pierden la misma carrera reintentan en fase y se vuelven a pisar.
  if [ "$attempt" -lt "$PUSH_RETRY_BUDGET" ]; then
    base_wait=$(( attempt * attempt ))
    [ "$base_wait" -gt "$PUSH_BACKOFF_MAX" ] && base_wait="$PUSH_BACKOFF_MAX"
    jitter=$(( RANDOM % (base_wait + 1) ))
    wait_s=$(( base_wait + jitter ))
    echo "⚠️ push rechazado: otro workspace llegó primero a origin/$BASE_REF."
    echo "   Reintento en ${wait_s}s (intento $attempt/$PUSH_RETRY_BUDGET, con jitter para no pisarnos)."
    emit gate "ship de $REPO: perdí la carrera de push, reintento $((attempt+1))/$PUSH_RETRY_BUDGET" ""
    sleep "$wait_s"
  fi
done
echo "❌ agotados $PUSH_RETRY_BUDGET intentos de push contra origin/$BASE_REF."
echo "   El trunk se mueve más rápido de lo que tarda esta suite en correr. Esto"
echo "   NO es un problema del cambio: es contención. Opciones, en orden:"
echo "   · subí el presupuesto: HARNESS_PUSH_RETRIES=40 scripts/ship.sh $TASK $REPO"
echo "   · pasá a flow: prs (la cola de merge del forge serializa por vos, y la"
echo "     suite corre una vez sobre el merge result en vez de una vez por intento)"
exit 5
