#!/usr/bin/env bash
# bootstrap.sh — onboarding del harness en UNA pasada, idempotente.
# Instala/verifica las dependencias ELEGIDAS en la entrevista, pide el
# token de secretos (fuera del chat), materializa .secrets, construye el
# grafo de código y corre el doctor. Se puede correr N veces: solo actúa
# sobre lo que falta.
#
# Uso: bootstrap.sh [--check] [--skip-secrets]
#   --check         solo reporta qué falta, no instala nada
#   --skip-secrets  no toca token ni .secrets
set -uo pipefail
WS="$(cd "$(dirname "$0")/.." && pwd)"
CHECK=0; SKIP_SECRETS=0; MISSING=0; INSTALLED=0
for a in "$@"; do case "$a" in
  --check) CHECK=1 ;;
  --skip-secrets) SKIP_SECRETS=1 ;;
esac; done

ok()   { echo "✅ $1"; }
inst() { echo "📦 instalando: $1"; }
warn() { echo "⚠️  $1"; }

# link_into_path <bin> — go install/uv tool instalan fuera del PATH típico;
# busca el binario recién instalado y enlázalo a un directorio que SÍ esté en
# el PATH. Solo devuelve 0 si el binario quedó realmente invocable: esta
# función es lo único que separa "instalado" de "instalado pero invisible" en
# ensure(), y cantaba éxito en dos casos donde no había enlace ninguno:
#   · sin brew, "$(brew --prefix)/bin" colapsaba a "/bin" (el del SISTEMA);
#     `[ -d /bin ]` es verdadero, así que la guarda no cortaba, el `ln` moría
#     con Permission denied y el ok() se imprimía igual.
#   · el exit de `ln` no se miraba nunca.
# Resultado medido en una VPS sin sudo: "ln: Permission denied" seguido de
# "✅ go-arch-lint instalado", y el doctor contradiciéndolo cuatro líneas
# después. Falso verde, que es justo lo que el resto del harness persigue.
link_into_path() {
  local bin="$1" cand dest gobin
  if command -v brew >/dev/null 2>&1; then dest="$(brew --prefix)/bin"
  else dest="$HOME/.local/bin"; fi   # el mismo dir de usuario que usa uv tool
  mkdir -p "$dest" 2>/dev/null || return 1
  # sin go, "$(go env GOPATH)/bin" es la MISMA sustitución vacía que apuntaba a
  # "/bin": el candidato se omite en vez de mirar el /bin del sistema.
  gobin="$(go env GOPATH 2>/dev/null)"
  for cand in ${gobin:+"$gobin/bin/$bin"} "$HOME/go/bin/$bin" "$HOME/.local/bin/$bin"; do
    [ -x "$cand" ] || continue
    # cand == dest/bin: ya está donde toca, enlazarlo a sí mismo es un error
    # de `ln` y no arregla nada; lo que falta ahí es el PATH, y de eso decide
    # el `command -v` de abajo.
    if [ "$cand" != "$dest/$bin" ]; then ln -sf "$cand" "$dest/$bin" 2>/dev/null || continue; fi
    hash -r 2>/dev/null || true
    command -v "$bin" >/dev/null 2>&1 || continue   # dest fuera del PATH: no es éxito
    ok "$bin enlazado a $dest (estaba fuera del PATH)"
    return 0
  done
  return 1
}

# ── LAS RECETAS DE LINUX VIVEN ACA, NO EN EL CATALOGO ─────────────────
# El catalogo declara UN comando por capacidad y el generador lo escribe TAL
# CUAL detras de `ensure <bin> ...`. Un comando con `&&`, `|` o `$( )` adentro
# NO llega entero a ensure: el shell parte la linea al leer el archivo y solo
# el primer pedazo queda como argumento; el resto corre SUELTO, al margen de
# ensure. Medido con el install_linux que tenia kubectl:
#   · con kubectl YA instalado, la cadena se ejecuta igual y lo reinstala en
#     cada corrida;
#   · con --check, cuyo contrato es "solo reporta que falta, no instala nada",
#     tambien descarga e instala;
#   · lo que ensure cuenta como la instalacion es `d=$(mktemp -d)`, un no-op,
#     asi que INSTALLED y MISSING quedan mintiendo.
# Es la misma clase que el issue #22 (prosa con parentesis en `install:`): ya
# estaba prohibida para `install:` y nadie la habia prohibido para install_linux.
#
# Por eso la receta vive de este lado, que es shell de verdad, y el catalogo la
# NOMBRA con un solo argv: `install_linux: "bs_install kubectl"`. Asi corre
# DENTRO de ensure (respeta --check, cuenta bien, no reinstala) y sirve para los
# dos generadores, sin pedirle a ninguno que aprenda a citar.
#
# Todas escriben en $BINDIR, un directorio del USUARIO, y ese es el punto del
# issue #199: install_linux existe para el host que no puede usar brew, y ese
# host es casi siempre uno donde no se es root (si se pudiera ser root, brew
# tampoco seria un problema). Apuntar a /usr/local/bin ahi tira a la basura la
# descarga y su verificacion en la ultima linea.
#
# El nombre dice "de Linux" porque el catalogo las declara en `install_linux`,
# o sea como alternativa a brew. Lo que bajan NO es de Linux: desde el #236 cada
# receta resuelve la plataforma de ESTA maquina (ver bs_platform).
BINDIR="$HOME/.local/bin"

# _bs_sha256 <archivo>: imprime su sha256, con la herramienta que haya.
# Se COMPARA el hash en vez de delegar en `--check`: ese flag es de coreutils,
# y el `sha256sum` de macOS no lo conoce (falla con "usage:", que se lee igual
# que un checksum que no coincide). El formato "<hash>  <archivo>" sí es común
# a los tres, así que el primer campo es el dato.
_bs_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi | awk '{print $1}'
}

# _bs_fetch <dir> <url> [<url del sums>]: baja el asset con SU nombre y, si el
# fabricante publica sha256, lo COMPRUEBA. Imprime la ruta de lo bajado.
# El sums viene en dos formatos: el hash solo (kubectl) o "<hash>  <nombre>"
# (hashicorp, github). Los avisos van a stderr porque el stdout ES el valor.
_bs_fetch() {
  local d="$1" u="$2" s="${3:-}" n="${2##*/}" want got
  curl -fsSLo "$d/$n" "$u" || { warn "no pude bajar $u" >&2; return 1; }
  [ -n "$s" ] || { printf '%s' "$d/$n"; return 0; }
  curl -fsSL "$s" > "$d/SUMS" || { warn "no pude bajar el sha256 de $n" >&2; return 1; }
  want="$(awk -v n="$n" 'NF==1 {print $1; exit} $2==n || $2=="*"n {print $1; exit}' "$d/SUMS")"
  [ -n "$want" ] || { warn "$n: hay sums publicado pero no encuentro su linea" >&2; return 1; }
  got="$(_bs_sha256 "$d/$n")"
  [ "$got" = "$want" ] \
    || { warn "$n: el sha256 NO coincide con el publicado; no lo instalo" >&2; return 1; }
  printf '%s' "$d/$n"
}

# ── UNA RECETA QUE NO MIRA LA PLATAFORMA INSTALA UN BINARIO AJENO ─────
# Estas recetas bajaban SIEMPRE el artefacto de linux/amd64, con la plataforma
# escrita a mano dentro de cada URL. En un host macOS eso no falla al instalar:
# el ELF de Linux se copia a $BINDIR con permiso de ejecucion, `command -v` lo
# encuentra y el doctor canta verde. El fallo aparece mucho despues y lejos,
# cuando un agente en medio de una tarea corre `bd`, `kubectl` o `terraform` y
# recibe "exec format error". Es el falso verde que el resto del harness
# persigue, esta vez fabricado por el propio bootstrap (issue #236).
#
# bs_platform resuelve el par UNA vez y las recetas lo interpolan. Lo que NO se
# hace es inventar un nombre unico: cada proveedor bautiza sus artefactos como
# quiere, y traducir mal es volver a bajar el binario de otra maquina. El
# naming vive en la receta de cada uno, verificado contra los assets reales:
#   · dl.k8s.io ........ $os/$arch          (linux/amd64, darwin/arm64)
#   · hashicorp ........ ${os}_${arch}      (terraform_1.9.0_darwin_arm64.zip)
#   · argo-cd .......... argocd-$os-$arch
#   · beads ............ beads_<ver>_${os}_${arch}.tar.gz
#   · nodejs ........... node-$v-$os-$narch con x64 donde el resto dice amd64
#   · observeinc/cli ... observe-$os-$narch.gz (mismo x64 que node)
#   · Google Cloud ..... google-cloud-cli-$os-$garch con x86_64 y arm
#   · AWS .............. awscli-exe-$os-$aarch con x86_64 y aarch64
# helm y uv no aparecen en la lista porque sus instaladores oficiales detectan
# la plataforma solos: ahi la receta baja el script, no un binario.
#
# Y donde el proveedor NO publica artefacto para la plataforma detectada, se
# falla RUIDOSO. Bajar el de otra arquitectura "por si acaso" es exactamente el
# bug que esto cierra.
bs_platform() {  # imprime "<os> <arch>": os en darwin|linux, arch en amd64|arm64
  local s m os arch
  s="$(uname -s)"; m="$(uname -m)"
  case "$s" in
    Darwin) os=darwin ;;
    Linux)  os=linux ;;
    # Un os desconocido (FreeBSD, MINGW) NO se traduce a linux: se pasa tal
    # cual en minusculas para que _bs_plat_ok lo rechace por su nombre real.
    *)      os="$(printf '%s' "$s" | tr '[:upper:]' '[:lower:]')" ;;
  esac
  case "$m" in
    x86_64|amd64)  arch=amd64 ;;
    arm64|aarch64) arch=arm64 ;;
    *)             arch="$m" ;;
  esac
  printf '%s %s' "$os" "$arch"
}

# _bs_plat_ok <bin> <os/arch> <soportadas...>: 0 si el proveedor publica ese
# artefacto. Si no, nombra el par detectado Y la lista real, y devuelve 1 para
# que la cadena de la receta corte antes de descargar nada. El mensaje ES la
# remediacion (regla 5); callarse aca se cobra como "exec format error" en
# medio de una tarea, a kilometros de la causa.
_bs_plat_ok() {
  local bin="$1" want="$2"; shift 2
  local p
  for p in "$@"; do [ "$p" = "$want" ] && return 0; done
  warn "no hay binario de '$bin' para $want; el proveedor publica: $*"
  warn "  ↳ instalalo desde su fuente oficial (catalog/capabilities.yaml: install / install_alt)"
  return 1
}

# bs_install <bin>: la receta de descarga directa de esa capacidad, para lo que
# ningun package manager portable resuelve. Todo lo que baja un binario verifica
# su checksum cuando el fabricante lo publica al lado (#192) y baja el artefacto
# de LA plataforma de esta maquina (#236).
bs_install() {
  local bin="$1" d f v rc=1 plat os arch narch garch aarch
  plat="$(bs_platform)"; os="${plat% *}"; arch="${plat#* }"
  # Los alias por proveedor, resueltos una vez. Un arch que no conocemos se
  # copia tal cual: no hay traduccion que inventar, y _bs_plat_ok ya lo corta.
  case "$arch" in
    amd64) narch=x64;    garch=x86_64; aarch=x86_64 ;;
    arm64) narch=arm64;  garch=arm;    aarch=aarch64 ;;
    *)     narch="$arch"; garch="$arch"; aarch="$arch" ;;
  esac
  d="$(mktemp -d)" || return 1
  mkdir -p "$BINDIR" || { rm -rf "$d"; return 1; }
  case "$bin" in
    kubectl)
      _bs_plat_ok kubectl "$os/$arch" linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 \
        && v="$(curl -fsSL https://dl.k8s.io/release/stable.txt)" \
        && f="$(_bs_fetch "$d" "https://dl.k8s.io/release/$v/bin/$os/$arch/kubectl" "https://dl.k8s.io/release/$v/bin/$os/$arch/kubectl.sha256")" \
        && install -m 0755 "$f" "$BINDIR/kubectl" && rc=0 ;;
    terraform|vault)
      _bs_plat_ok "$bin" "$os/$arch" linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 \
        && v="$(curl -fsSL "https://api.releases.hashicorp.com/v1/releases/$bin/latest" | jq -r .version)" \
        && f="$(_bs_fetch "$d" "https://releases.hashicorp.com/$bin/$v/${bin}_${v}_${os}_${arch}.zip" "https://releases.hashicorp.com/$bin/$v/${bin}_${v}_SHA256SUMS")" \
        && unzip -oq "$f" "$bin" -d "$BINDIR" && chmod 0755 "$BINDIR/$bin" && rc=0 ;;
    argocd)
      _bs_plat_ok argocd "$os/$arch" linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 \
        && f="$(_bs_fetch "$d" "https://github.com/argoproj/argo-cd/releases/latest/download/argocd-$os-$arch" "https://github.com/argoproj/argo-cd/releases/latest/download/cli_checksums.txt")" \
        && install -m 0755 "$f" "$BINDIR/argocd" && rc=0 ;;
    bd)
      _bs_plat_ok bd "$os/$arch" linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 \
        && v="$(curl -fsSL https://api.github.com/repos/steveyegge/beads/releases/latest | jq -r .tag_name)" \
        && f="$(_bs_fetch "$d" "https://github.com/steveyegge/beads/releases/download/$v/beads_${v#v}_${os}_${arch}.tar.gz" "https://github.com/steveyegge/beads/releases/download/$v/checksums.txt")" \
        && tar -xzf "$f" -C "$d" bd && install -m 0755 "$d/bd" "$BINDIR/bd" && rc=0 ;;
    npm)
      # node no es un binario suelto: trae su lib/. Se instala el prefijo y se
      # enlazan los ejecutables. Y `npm i -g` usa el prefijo de NODE, asi que
      # sin el `npm config set prefix` de la ultima linea los CLIs de npm
      # quedan instalados e INVISIBLES, sin un solo error. Va con
      # --location=user porque npm SE NIEGA a cambiar el prefix cuando lo
      # encuentra en un .npmrc de proyecto (cualquier ancestro del cwd), y el
      # bootstrap corre desde el workspace.
      # El directorio que sale del tarball lleva la plataforma en el NOMBRE, asi
      # que el `mv` usa las mismas variables que la URL: cablear "linux-x64" ahi
      # rompe el paso siguiente aunque la descarga haya sido la correcta.
      _bs_plat_ok node "$os/$arch" linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 \
        && v="$(curl -fsSL https://nodejs.org/dist/index.json | jq -r 'map(select(.lts != false))[0].version')" \
        && f="$(_bs_fetch "$d" "https://nodejs.org/dist/$v/node-$v-$os-$narch.tar.xz" "https://nodejs.org/dist/$v/SHASUMS256.txt")" \
        && mkdir -p "$HOME/.local/lib" && tar -xJf "$f" -C "$d" \
        && rm -rf "$HOME/.local/lib/node" && mv "$d/node-$v-$os-$narch" "$HOME/.local/lib/node" \
        && ln -sf "$HOME/.local/lib/node/bin/node" "$HOME/.local/lib/node/bin/npm" "$HOME/.local/lib/node/bin/npx" "$BINDIR/" \
        && PATH="$BINDIR:$PATH" "$HOME/.local/lib/node/bin/npm" config set prefix "$HOME/.local" --location=user && rc=0 ;;
    gcloud)
      # el unico sin sha256 publicado al lado del artefacto; trae su propio
      # Python, asi que tampoco es un binario suelto.
      # Google escribe el arm de 64 bits como "arm" a secas, no "arm64".
      _bs_plat_ok gcloud "$os/$arch" linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 \
        && f="$(_bs_fetch "$d" "https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-$os-$garch.tar.gz")" \
        && mkdir -p "$HOME/.local/lib" && rm -rf "$HOME/.local/lib/google-cloud-sdk" \
        && tar -xzf "$f" -C "$HOME/.local/lib" \
        && "$HOME/.local/lib/google-cloud-sdk/install.sh" --quiet --usage-reporting=false --path-update=false >/dev/null \
        && ln -sf "$HOME/.local/lib/google-cloud-sdk/bin/gcloud" "$HOME/.local/lib/google-cloud-sdk/bin/gsutil" "$BINDIR/" && rc=0 ;;
    helm)
      # Su instalador escribe en /usr/local/bin CON SUDO salvo que se le diga.
      # El PATH va delante porque el script TERMINA verificando con `command -v
      # helm`: instala bien y despues sale 1 con "helm not found. Is ... on your
      # $PATH?". El prefijo es por comando a proposito: meter $BINDIR en el PATH
      # del bootstrap haria pasar el `command -v` de ensure aunque el PATH del
      # humano no lo tenga, o sea justo el falso verde del #198.
      curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 > "$d/get-helm-3" \
        && PATH="$BINDIR:$PATH" HELM_INSTALL_DIR="$BINDIR" USE_SUDO=false bash "$d/get-helm-3" >/dev/null && rc=0 ;;
    uv)
      curl -fsSL https://astral.sh/uv/install.sh > "$d/uv.sh" \
        && UV_INSTALL_DIR="$BINDIR" sh "$d/uv.sh" >/dev/null && rc=0 ;;
    awscli)
      # El instalador oficial: trae su propio Python, no es binario suelto. La
      # firma que AWS publica es PGP (no un .sha256 al lado), así que
      # _bs_fetch no puede verificarla; se instala con --install-dir/--bin-dir
      # para no necesitar sudo.
      #
      # Y este zip existe SOLO para Linux (x86_64 y aarch64): en macOS AWS
      # publica un .pkg, que es otro instalador y pide sudo. Antes se bajaba el
      # de Linux igual, se descomprimia, y `aws/install` copiaba binarios ELF a
      # un directorio del PATH sin quejarse una sola vez.
      if _bs_plat_ok awscli "$os/$arch" linux/amd64 linux/arm64; then
        f="$(_bs_fetch "$d" "https://awscli.amazonaws.com/awscli-exe-$os-$aarch.zip")" \
          && unzip -oq "$f" -d "$d" \
          && "$d/aws/install" --install-dir "$HOME/.local/lib/aws-cli" --bin-dir "$BINDIR" --update >/dev/null && rc=0
      elif [ "$os" = darwin ]; then
        warn "  en macOS el instalador de AWS es un .pkg que pide permisos de administrador:"
        warn "      brew install awscli    (o el .pkg: https://awscli.amazonaws.com/AWSCLIV2.pkg)"
      fi ;;
    observe)
      # El repo es observeinc/cli (observeinc/observe-cli NO existe: da 404, y
      # con él la receta entera). El artefacto es un gzip del binario suelto,
      # no un tarball, así que va gunzip y no tar. El sums lleva la versión en
      # el nombre (observe_<ver>_checksums.txt), por eso se pide el tag primero.
      # El arch va con el naming de node (x64, no amd64), que es el que usan sus
      # assets: observe-darwin-arm64.gz, observe-linux-x64.gz.
      _bs_plat_ok observe "$os/$arch" linux/amd64 linux/arm64 darwin/amd64 darwin/arm64 \
        && v="$(curl -fsSL https://api.github.com/repos/observeinc/cli/releases/latest | jq -r .tag_name)" \
        && f="$(_bs_fetch "$d" "https://github.com/observeinc/cli/releases/download/$v/observe-$os-$narch.gz" "https://github.com/observeinc/cli/releases/download/$v/observe_${v#v}_checksums.txt")" \
        && gunzip -c "$f" > "$d/observe" && install -m 0755 "$d/observe" "$BINDIR/observe" && rc=0 ;;
    *) warn "no tengo receta de descarga directa para '$bin'" ;;
  esac
  rm -rf "$d"
  return "$rc"
}

# ── ESTE BOOTSTRAP SE GENERO PARA UNA PLATAFORMA ──────────────────────
# Los comandos de abajo se eligieron cuando se genero la instancia, mirando la
# maquina que la genero. Si esta instancia se clona a otra plataforma, algunos
# no aplican: las formulas normales de Homebrew sobreviven (brew corre en Linux
# tambien), pero los `--cask` no existen fuera de macOS y las entradas con
# variante Linux propia quedaron con la de mac. Se avisa una vez, al arrancar,
# en vez de fallar comando por comando sin explicar por que.
_bs_platform_note() {
  local here; here="$(uname -s)"
  # El patron matchea SOLO lineas de instalacion reales. Con un `grep --cask`
  # a secas, la funcion encontraba su PROPIO mensaje de aviso (que menciona
  # --cask) y avisaba siempre, incluso en un bootstrap sin un solo cask.
  # Verificado: un detector que se detecta a si mismo es un detector roto.
  if [ "$here" = "Linux" ] && grep -qE '^(ensure|require) .*--cask' "$0" 2>/dev/null; then
    warn "este bootstrap trae instalaciones con 'brew --cask', que NO existen en Linux"
    echo "   ↳ se generaron en macOS. Instala esas a mano, o regenera la instancia"
    echo "     declarando la plataforma destino (ver /harness-init, tabla de generación)."
  fi
}
_bs_platform_note

# ── EL GESTOR TIENE QUE EXISTIR ANTES DEL PRIMER ensure ───────────────
# Este bootstrap instala la mayoria de sus capacidades con `brew`, y hasta aqui
# NINGUNA linea comprobaba que brew existiera. En una maquina Linux recien
# creada (contenedor, CI, VPS de dev) no viene, asi que cada `ensure` fallaba
# por separado con "falló la instalación de X" y el usuario terminaba con un
# doctor en rojo cuya remediación era "corre scripts/bootstrap.sh": el que
# acababa de correr. Caso de campo medido: 14 de 24 lineas de instalacion no
# ejecutaron nada y quedaron 18 capacidades sin instalar, `bd` y el grafo
# incluidos, sin que apareciera la palabra "brew" una sola vez en la salida.
#
# Son dos fallas distintas y se tratan distinto:
#   1. brew esta instalado pero no en ESTE PATH (sesion no interactiva, que no
#      lee ~/.zshrc). Se resuelve solo, cargando su shellenv: es la misma
#      leccion que doctor.sh ya aprendio ("no esta en mi PATH" no es "no esta
#      instalado"), y reinstalar lo que ya esta es peor que no hacer nada.
#   2. brew no esta. Eso NO se resuelve solo por defecto: instalar un gestor de
#      paquetes entero es una decision de cadena de suministro del humano, no
#      de un script de onboarding. Se falla CERRADO con el comando exacto
#      (regla 3 y 5 del repo), y quien quiera automatizarlo lo declara con
#      HARNESS_BOOTSTRAP_INSTALL_BREW=1.
_bs_brew_preflight() {
  # Igual que _bs_platform_note: el patron matchea lineas de instalacion
  # REALES, para que esta funcion no se detecte a si misma ni a los comentarios
  # de ejemplo que trae el template.
  grep -qE '^(ensure|require) .*[[:space:]]brew[[:space:]]' "$0" 2>/dev/null || return 0
  command -v brew >/dev/null 2>&1 && return 0

  local p
  for p in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew "$HOME/.linuxbrew"; do
    if [ -x "$p/bin/brew" ]; then
      eval "$("$p/bin/brew" shellenv)" 2>/dev/null || true
      if command -v brew >/dev/null 2>&1; then
        ok "brew estaba instalado en $p pero fuera de este PATH: cargado para esta corrida"
        echo "   ↳ para que persista, 'eval \"\$($p/bin/brew shellenv)\"' va en ~/.zshenv"
        echo "     (zsh lo lee SIEMPRE, tambien en cron y en 'ssh host cmd'), no solo en ~/.zshrc"
        return 0
      fi
    fi
  done

  local cmd='/bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"'

  # ── COMO ROOT NO HAY BREW, Y NO ES UN FLAG QUE SE PUEDA SALTAR ──────
  # El instalador de Homebrew aborta con "Don't run this as root!" y no tiene
  # override: es decision de upstream, no una comprobacion nuestra. Eso deja al
  # caso mas comun del harness en Linux (un contenedor root-only: CI, devcontainer,
  # una VM de dev que se usa como root) SIN ningun camino con brew.
  #
  # Se detecta aqui porque el mensaje de abajo, sin esto, es un callejon sin
  # salida: manda a correr un comando que va a fallar siempre, y quien lo lea
  # va a perder el rato averiguando por que. Un mensaje de error que no
  # funciona es peor que no tener mensaje (regla 5: los errores son prompts).
  if [ "$(id -u)" = "0" ]; then
    warn "este bootstrap instala con 'brew', y Homebrew se NIEGA a correr como root"
    echo "   ↳ el instalador aborta con \"Don't run this as root!\" y no admite override."
    echo "     O sea: en esta máquina no hay camino con brew, ni instalándolo."
    echo "     Las salidas, en orden de menos a más trabajo:"
    echo "       1. correr el harness como usuario normal (con sudo donde haga falta)"
    echo "       2. instalar cada CLI desde su fuente oficial (ver install_alt e"
    echo "          install_linux en catalog/capabilities.yaml)"
    echo "     Lo que NO sirve: reintentar el instalador de Homebrew."
    [ "$CHECK" -eq 1 ] && return 1
    echo "   ↳ se corta aquí en vez de encadenar $(grep -cE '^(ensure|require) .*[[:space:]]brew[[:space:]]' "$0") fallos sin explicación."
    exit 1
  fi

  if [ "${HARNESS_BOOTSTRAP_INSTALL_BREW:-0}" = "1" ] && [ "$CHECK" -eq 0 ]; then
    inst "Homebrew (declarado con HARNESS_BOOTSTRAP_INSTALL_BREW=1)"
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
      || { warn "falló la instalación de Homebrew, hazla a mano: $cmd"; return 1; }
    for p in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew "$HOME/.linuxbrew"; do
      [ -x "$p/bin/brew" ] && { eval "$("$p/bin/brew" shellenv)" 2>/dev/null || true; break; }
    done
    command -v brew >/dev/null 2>&1 && { ok "Homebrew instalado"; return 0; }
    warn "Homebrew instalado pero no lo encuentro en el PATH"; return 1
  fi

  warn "este bootstrap instala con 'brew' y brew NO está en esta máquina"
  echo "   ↳ sin él, TODAS las líneas 'brew install' de abajo fallan una por una."
  echo "     Instálalo (corre en Linux y en macOS):"
  echo "       $cmd"
  echo "     Y en Linux, cárgalo en la shell:"
  echo "       eval \"\$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)\""
  echo "     Para que este bootstrap lo instale solo: HARNESS_BOOTSTRAP_INSTALL_BREW=1 $0"
  # --check REPORTA, no bloquea: es su contrato ("solo reporta qué falta").
  [ "$CHECK" -eq 1 ] && return 1
  echo "   ↳ se corta aquí en vez de encadenar $(grep -cE '^(ensure|require) .*[[:space:]]brew[[:space:]]' "$0") fallos sin explicación."
  exit 1
}
_bs_brew_preflight || true

# ensure <bin> <cmd de instalación...> — instala si falta (o reporta en --check)
ensure() {
  local bin="$1"; shift
  if command -v "$bin" >/dev/null 2>&1; then ok "$bin"; return 0; fi
  MISSING=$((MISSING+1))
  if [ "$CHECK" -eq 1 ]; then warn "falta: $bin (instalaría: $*)"; return 0; fi
  inst "$bin ($*)"
  if "$@"; then
    if command -v "$bin" >/dev/null 2>&1 || link_into_path "$bin"; then
      INSTALLED=$((INSTALLED+1)); ok "$bin instalado"
    else
      warn "$bin instalado pero no lo encuentro — agrega ~/go/bin y ~/.local/bin a tu PATH"
    fi
  else
    warn "falló la instalación de $bin — instálalo a mano: $*"
  fi
}

# require <bin> <instrucción> — NO auto-instala (SDKs pesados); solo verifica
require() {
  local bin="$1"; shift
  command -v "$bin" >/dev/null 2>&1 && ok "$bin" || { MISSING=$((MISSING+1)); warn "falta: $bin — instalación manual: $*"; }
}

echo "══ bootstrap: dependencias del harness ══"
# ── núcleo (siempre) ──────────────────────────────────────────────────
# jq es la única dependencia DURA: doctor.sh se muere en su línea 21 sin él, o
# sea antes de poder decir qué más falta. Por eso es el único `ensure` que no
# se delega a brew a ciegas y despacha por el gestor que la máquina tenga: era
# la primera línea del bootstrap y la primera en fallar en una máquina sin
# brew, dejando al usuario sin jq y sin diagnóstico. El catálogo ya declara
# esta misma alternativa en el `install_alt` de jq.
if command -v jq >/dev/null 2>&1;      then ok jq
elif command -v brew >/dev/null 2>&1;  then ensure jq brew install jq
elif command -v apt-get >/dev/null 2>&1; then ensure jq apt-get install -y jq
elif command -v dnf >/dev/null 2>&1;   then ensure jq dnf install -y jq
elif command -v apk >/dev/null 2>&1;   then ensure jq apk add --no-cache jq
else ensure jq brew install jq
fi

