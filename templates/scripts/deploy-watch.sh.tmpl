#!/usr/bin/env bash
# deploy-watch.sh — el DEPLOYER es script, no agente. Cero tokens en verde;
# los agentes solo despiertan en rojo (este script les deja el diagnóstico
# inicial en tasks/<id>/deploy-<repo>.log).
#
# Vigila: Actions → Kargo (si aplica) → health de ArgoCD → smoke.
# ROJO: rollback PRIMERO ({{ROLLBACK_MODE}}), diagnóstico después.
#
# Uso: deploy-watch.sh <task-id> <repo>
# Córrelo autenticado: scripts/with-secrets.sh scripts/deploy-watch.sh ...
set -uo pipefail

TASK="${1:?uso: deploy-watch.sh <task-id> <repo>}"
REPO="${2:?uso: deploy-watch.sh <task-id> <repo>}"
WS="$(cd "$(dirname "$0")/.." && pwd)"

# El bus: el humano mira el panel, no esta consola. Fail-open.
# (Va DESPUÉS de definir WS: con set -u, referenciar $WS antes de asignarlo
# mata el script — y un bus que tumba el deploy-watch es lo contrario de
# lo que promete. Nos pasó: la primera versión de esta línea iba arriba.)
# shellcheck source=/dev/null
[ -f "$WS/scripts/emit.sh" ] && . "$WS/scripts/emit.sh" || emit() { :; }
LOG="$WS/tasks/$TASK/deploy-$REPO.log"; mkdir -p "$WS/tasks/$TASK"
ORG="{{GITHUB_ORG}}"
# Un prefijo es un PREFIJO, no una concatenación ciega. Dos trampas reales:
#  · sin separador, prefijo "acme" + repo "acme-landing" daba
#    "acmeacme-landing": una app que no existe en ningún cluster, y el
#    watcher esperaba 900 s por ella y proponía revertir un deploy sano.
#  · si el repo YA empieza con el prefijo, el prefijo sobra.
app_name() {  # app_name <repo> → nombre de la app de ArgoCD
  local pre="{{ARGO_APP_PREFIX}}" repo="$1"
  [ -n "$pre" ] || { printf '%s' "$repo"; return 0; }
  case "$repo" in
    "$pre"|"${pre%[-_]}"-*|"${pre%[-_]}"_*) printf '%s' "$repo"; return 0 ;;
  esac
  printf '%s-%s' "${pre%[-_]}" "$repo"
}
APP="$(app_name "$REPO")"
TIMEOUT="${DEPLOY_TIMEOUT:-900}"
ROLLBACK_MODE="{{ROLLBACK_MODE}}"   # auto | manual

say() { echo "$1" | tee -a "$LOG"; }

# ── ¿ESTE REPO DESPLIEGA POR AQUÍ? ────────────────────────────────────
# Este watcher modela UNA forma de desplegar: Actions → Kargo → ArgoCD →
# smoke, o sea GitOps sobre Kubernetes. Un repo de terraform no despliega
# así, y hasta ahora nadie se lo preguntaba: se construía APP=<prefijo><repo>
# y se esperaba una app de ArgoCD que jamás iba a existir. El wait fallaba
# igual que si la app estuviera enferma, y de ahí salía una propuesta de
# revertir commits CORRECTOS. Pasó en campo con el primer repo de infra que
# cruzó el pipeline.
#
# El dato ya existía: manifest.yaml declara el kind de cada repo desde el
# discovery. Solo había que leerlo.
repo_kind() {  # repo_kind <repo> → kind declarado en manifest.yaml, o vacío
  [ -f "$WS/manifest.yaml" ] || return 0
  awk -v r="$1" '
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*-[[:space:]]*name:[[:space:]]*/ {
      n=$0; sub(/^[^:]*:[[:space:]]*/,"",n); gsub(/["\047]/,"",n)
      sub(/[[:space:]]+$/,"",n); cur=(n==r)
    }
    cur && /^[[:space:]]*kind:[[:space:]]*/ {
      k=$0; sub(/^[^:]*:[[:space:]]*/,"",k); gsub(/["\047]/,"",k)
      sub(/[[:space:]]+$/,"",k); print k; exit
    }' "$WS/manifest.yaml" 2>/dev/null
}

# ── DRIVERS DE DEPLOY ─────────────────────────────────────────────────
# Un driver contesta tres preguntas, y son las mismas para CUALQUIER
# tecnología: ¿llegó el cambio?, ¿está sano?, ¿cómo se revierte?
#
#   gitops   Actions → Kargo → health de ArgoCD → smoke del canary.
#   actions  solo la conclusión del workflow. El más universal: sirve para
#            cualquiera que despliegue desde CI, sin Kubernetes de por medio.
#   none     este repo no se verifica por aquí, y se DICE.
#
# POR QUÉ ESTO ES UN DISPATCH Y NO UN if: el harness ya resuelve así todos
# sus otros ejes que varían entre proyectos (secretos con pull_*, package
# manager por lockfile, gates por marcador de lenguaje, proveedor de
# modelos). Deploy era el único cableado a un solo vendor, y eso convierte
# a un instalador universal en el instalador de quien lo escribió. Agregar
# fly, vercel, terraform o lo que sea es una función más, no un fork.
#
# Resolución, de más explícita a más inferida:
#   1. deploy.<repo>.driver en harness-answers.yaml (lo que el humano dijo)
#   2. el kind del repo en manifest.yaml
#   3. gitops, por compatibilidad con instancias previas a esta regla
answers_driver() {  # answers_driver <repo> → driver declarado, o vacío
  [ -f "$WS/harness-answers.yaml" ] || return 0
  awk -v r="$1" '
    /^[[:space:]]*#/ { next }
    /^deploy:/ { ind=1; next }
    ind && /^[^[:space:]]/ { ind=0 }
    ind && $0 ~ "^[[:space:]]+" r ":" { cur=1; next }
    ind && cur && /^[[:space:]]+driver:[[:space:]]*/ {
      d=$0; sub(/^[^:]*:[[:space:]]*/,"",d); gsub(/["\047]/,"",d)
      sub(/[[:space:]]+$/,"",d); print d; exit }
    ind && cur && /^[[:space:]]{2}[a-zA-Z0-9_-]+:/ { cur=0 }
  ' "$WS/harness-answers.yaml" 2>/dev/null
}

KIND="$(repo_kind "$REPO")"
DRIVER="$(answers_driver "$REPO")"
if [ -z "$DRIVER" ]; then
  case "${KIND:-}" in
    service|frontend|mobile|"") DRIVER=gitops ;;
    *)                          DRIVER=none ;;
  esac
fi
say "── driver de deploy: $DRIVER${KIND:+ (kind=$KIND)} ──"

if [ "$DRIVER" = "none" ]; then
  say "ℹ️  $REPO no se verifica con este watcher."
  say "   NO reviso nada, y por lo tanto tampoco propongo revertir nada:"
  say "   un modelo que no aplica no puede declarar un deploy rojo."
  say "   Si este repo SÍ despliega, declaralo en harness-answers.yaml:"
  say "     deploy:"
  say "       $REPO:"
  say "         driver: actions   # o gitops"
  emit assumption "deploy de $REPO NO verificado: driver=none${KIND:+ (kind=$KIND)}"
  exit 0
fi

# Jerarquía de rollback (rollback PRIMERO, diagnóstico después):
#  1. Si el workload usa Argo Rollouts: el AnalysisTemplate ya abortó a
#     stable SOLO (tráfico, sin mutar git) — el único rollback
#     totalmente automático que es seguro. Aquí solo se verifica.
#  2. Revert en GIT (PR/commit de revert vía ship.sh) — lo propone este
#     script; lo ejecuta el agente/humano.
#  3. `argocd app rollback` es el ÚLTIMO recurso MANUAL: crea drift
#     git↔cluster y exige desactivar auto-sync. Nunca automático.
red() { # red <motivo>
  say "🔴 $1"
  emit deploy "$REPO — $1" false
  emit stop "deploy rojo de $REPO: rollback primero; diagnóstico en tasks/$TASK/deploy-$REPO.log"
  if command -v kubectl >/dev/null && kubectl argo rollouts get rollout "$APP" >/dev/null 2>&1; then
    say "⏪ workload con Argo Rollouts: verifica el abort-to-stable automático:"
    say "   kubectl argo rollouts status $APP"
  fi
  # El sha a revertir es el último ship DE ESTE REPO, no la última línea del
  # log. ship.log lleva una línea por repo shippeado de la tarea, así que un
  # `tail -1` en una tarea multi-repo devolvía el sha de OTRO repo: revertirlo
  # dentro de este falla con "bad object", o peor, si el objeto existe en los
  # dos, revierte un commit equivocado y el ship del revert lo lleva a main.
  last_sha="$(jq -r --arg r "$REPO" 'select(.repo == $r) | .sha // empty' \
    "$WS/tasks/$TASK/ship.log" 2>/dev/null | tail -1)"
  if [ -z "$last_sha" ]; then
    # Sin sha no hay revert que proponer, y sugerirlo con el campo vacío es
    # peor que callarse: manda al agente a improvisar sobre produccion.
    say "⏪ NO sé qué revertir: no hay ship de $REPO en tasks/$TASK/ship.log."
    say "   Puede que este deploy no venga de un ship de esta tarea. Diagnostica"
    say "   primero y decide vos: no propongo una acción destructiva a ciegas."
  elif [ "$ROLLBACK_MODE" = "auto" ]; then
    say "⏪ preparando revert en git de $last_sha (GitOps-safe; ArgoCD lo sincroniza solo):"
    say "   cd repos/$REPO && git revert --no-edit $last_sha  → luego ship.sh del revert"
  else
    say "⏪ revert manual sugerido del commit $last_sha (git revert, NUNCA argocd app rollback salvo emergencia humana)"
  fi
  say "🩺 diagnóstico inicial en $LOG — despierta al agente con este contexto"
  exit 1
}

# 1 · GitHub Actions del push a main
if command -v gh >/dev/null; then
  say "── actions: $ORG/$REPO@main ──"
  run_id="$(gh run list --repo "$ORG/$REPO" --branch main --limit 1 --json databaseId --jq '.[0].databaseId' 2>/dev/null || echo "")"
  if [ -n "$run_id" ]; then
    gh run watch --repo "$ORG/$REPO" "$run_id" --exit-status >>"$LOG" 2>&1 \
      || red "Actions falló (run $run_id). Logs: gh run view --repo $ORG/$REPO $run_id --log-failed"
    say "✅ actions verde (run $run_id)"
  else
    say "⚠️ no encontré runs — ¿el repo tiene workflows?"
  fi
fi

# ── Etapas 2 a 4: exclusivas del driver gitops ────────────────────────
# El driver `actions` termina en la etapa 1: la conclusión del workflow es
# toda la señal que tiene, y fingir más sería inventar.
if [ "$DRIVER" = "gitops" ]; then

# 2 · Kargo: promoción del freight (si el pipeline lo usa)
if command -v kargo >/dev/null; then
  say "── kargo: esperando promoción ──"
  # UNA VERIFICACIÓN QUE NO SE PUDO EJECUTAR NO SE CALLA. Antes esto era un
  # warning que moría en el log: el deploy seguía, ArgoCD daba Healthy, y nadie
  # se enteraba de que el tramo de promoción NUNCA se miró. El silencio de un
  # verificador ciego se lee igual que un verde.
  #
  # "No pude verificar" ya tiene categoría en el harness: un supuesto. Emitirlo
  # lo pone arriba del resumen de sesión, bajo "audita esto primero", y en el
  # ledger de supuestos de /auto. No bloquea: el health de ArgoCD sigue siendo
  # la señal dura. Solo deja de fingir que este tramo se verificó.
  #
  # El stderr se captura en vez de irse a $LOG: el motivo real (auth, proyecto
  # inexistente) era justo lo que no se veía.
  if kargo_out="$(kargo get promotions --project "{{KARGO_PROJECT}}" 2>&1)"; then
    printf '%s\n' "$kargo_out" | tail -5 | tee -a "$LOG"
  else
    printf '%s\n' "$kargo_out" >> "$LOG"
    reason="$(printf '%s' "$kargo_out" | head -1 | cut -c1-160)"
    say "⚠️ kargo no respondió: ${reason:-sin salida}"
    say "   la promoción del freight NO se verificó; el deploy sigue por health de ArgoCD"
    emit assumption "promoción de Kargo NO verificada en $REPO: ${reason:-kargo no respondió}"
  fi
fi

# ¿Podemos siquiera hablar con ArgoCD? Se responde ANTES de esperar, no
# después: 900 segundos para descubrir que faltaba un token es tiempo
# regalado, y el rojo que sale al final parece un deploy enfermo.
argocd_configured() {
  [ -n "${ARGOCD_AUTH_TOKEN:-}" ] && return 0
  [ -n "${ARGOCD_USERNAME:-}" ] && [ -n "${ARGOCD_PASSWORD:-}" ] \
    && [ -n "${ARGOCD_URL:-}" ] && return 0
  [ -f "$HOME/.config/argocd/config" ] && return 0   # sesión previa de argocd login
  return 1
}

# 3 · Health de ArgoCD con timeout
# Auth: ARGOCD_AUTH_TOKEN (ideal) o fallback user/pass si el Vault del
# proyecto guarda credenciales así — con login previo. Recomendado:
# migrar a token de cuenta (`argocd account generate-token`).
if command -v argocd >/dev/null && [ -z "${ARGOCD_AUTH_TOKEN:-}" ] \
   && [ -n "${ARGOCD_USERNAME:-}" ] && [ -n "${ARGOCD_PASSWORD:-}" ]; then
  srv="${ARGOCD_URL:-}"; srv="${srv#https://}"; srv="${srv#http://}"
  argocd login "$srv" --username "$ARGOCD_USERNAME" --password "$ARGOCD_PASSWORD" --grpc-web >/dev/null 2>&1 \
    && say "argocd: sesión iniciada con usuario (considera migrar a ARGOCD_AUTH_TOKEN)" \
    || say "⚠️ argocd login falló — health check probablemente falle también"
fi
if command -v argocd >/dev/null; then
  # "La app no existe" y "la app está enferma" NO son lo mismo, y `app wait`
  # falla igual en los dos casos. Confundirlos es lo que hacía que un repo sin
  # app propusiera revertir commits sanos. Se distingue ANTES de esperar.
  # TRIAGE DE TRES CASOS, porque son tres cosas distintas y antes eran una.
  # "No pude conectarme", "la app no existe" y "la app está enferma" daban
  # todas el mismo rojo, y solo la tercera justifica proponer un rollback.
  # Caso real: sin token ni servidor, y ni siquiera bajo with-secrets.sh, el
  # watcher esperó 900 s y propuso revertir un deploy que estaba sano.
  if ! argocd_configured; then
    say "⚠️ ArgoCD sin credenciales ni servidor: no hay ARGOCD_AUTH_TOKEN, ni"
    say "   usuario/clave con ARGOCD_URL, ni sesión previa de 'argocd login'."
    say "   NO espero $TIMEOUT s por algo que no puedo consultar, y NO propongo"
    say "   revertir nada: esto es ceguera, no un deploy rojo."
    say "   ↳ remediación: scripts/with-secrets.sh scripts/deploy-watch.sh $TASK $REPO"
    emit assumption "deploy de $REPO NO verificado: ArgoCD sin credenciales (el watcher corrió sin with-secrets.sh)"
  elif ! argocd app get "$APP" >/dev/null 2>&1; then
    say "⚠️ conecté a ArgoCD pero no existe la app '$APP'."
    say "   Suele ser el prefijo de apps mal configurado, o que este repo no"
    say "   despliega por aquí. Es un tramo que NO pude verificar, no un deploy"
    say "   rojo: no propongo revertir nada."
    say "   ↳ revisa ARGO_APP_PREFIX en harness-answers.yaml, o declara"
    say "     deploy.$REPO.driver si este repo usa otro camino."
    emit assumption "deploy de $REPO NO verificado: no existe la app de ArgoCD $APP"
  else
    say "── argocd: esperando $APP Healthy+Synced (timeout ${TIMEOUT}s) ──"
    argocd app wait "$APP" --health --sync --timeout "$TIMEOUT" >>"$LOG" 2>&1 \
      || red "$APP no llegó a Healthy+Synced en ${TIMEOUT}s"
    say "✅ $APP Healthy + Synced"
  fi
fi

# 4 · Smoke del canary tenant (si existe para el repo)
if [ -x "$WS/scripts/smoke/$REPO.sh" ]; then
  say "── smoke: $REPO ──"
  "$WS/scripts/smoke/$REPO.sh" >>"$LOG" 2>&1 || red "smoke del canary falló"
  say "✅ smoke verde"
else
  say "⚠️ sin smoke para $REPO (scripts/smoke/$REPO.sh) — agrégalo; el canary es la última defensa"
fi

fi   # ← fin de las etapas exclusivas de gitops

# El mensaje final dice QUÉ se verificó, no una lista fija: con driver
# `actions` no hubo argocd ni smoke, y afirmarlo seria mentir en el bus.
case "$DRIVER" in
  gitops)  VERIFIED="actions + argocd + smoke" ;;
  actions) VERIFIED="conclusión del workflow de Actions" ;;
  *)       VERIFIED="$DRIVER" ;;
esac
emit deploy "$REPO verificado ($DRIVER): $VERIFIED" true
say "🟢 deploy de $REPO verificado por driver=$DRIVER: $VERIFIED"
